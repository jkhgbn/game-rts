# The contested rich node alone (map-production.md 2.3, Resources; economy.md: 2 500 crystals): node + hall slot X2
# + the bot's Spire slot S4 (rich_pocket adds guild houses and a hollow). Local frame: (0,0) = the node, +z = toward
# the owner's keep.
template rich_node  title="Rich node 2 500, hall slot X2, tower slot S4"
param amount=2500
node  node   at=(0,0)       role=rich  amount=$amount
slot  hall   sub=rich_hall   at=(0,9.9)  clear=5
slot  tower  sub=tower_rich  at=(-6,3)   clear=0
