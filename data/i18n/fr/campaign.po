#. const MISSION_TITLE := "The First Crack"
#: scripts/campaign/mission_e6_04.gd:23
msgid "The First Crack"
msgstr "La première fissure"

#. [&"narrator", "Twelve years ago. The Master sent for two of his four. Only two."],
#: scripts/campaign/mission_e6_04.gd:80 data/voice/lines/e6m4.json:L1
msgid "Twelve years ago. The Master sent for two of his four. Only two."
msgstr "Il y a douze ans. Le Maître a fait venir deux de ses quatre apprentis. Seulement deux."

#. [&"master", "Ysolde. Torvald. Hold the isle. Whatever climbs out of the water must not touch this stone."],
#: scripts/campaign/mission_e6_04.gd:81 data/voice/lines/e6m4.json:L2
msgid "Ysolde. Torvald. Hold the isle. Whatever climbs out of the water must not touch this stone."
msgstr "Ysolde. Torvald. Tenez l'île. Rien de ce qui sort de l'eau ne doit toucher cette pierre."

#. [&"torvald", "What is under it?"],
#: scripts/campaign/mission_e6_04.gd:82 data/voice/lines/e6m4.json:L3
msgid "What is under it?"
msgstr "Qu'est-ce qu'il y a dessous ?"

#. [&"master", "My first mistake. His name was Obren."],
#: scripts/campaign/mission_e6_04.gd:83 data/voice/lines/e6m4.json:L4
msgid "My first mistake. His name was Obren."
msgstr "Ma première erreur. Il s'appelait Obren."

#. [&"ysolde", "Should we send for Vessa and Malrik?"],
#: scripts/campaign/mission_e6_04.gd:84 data/voice/lines/e6m4.json:L5
msgid "Should we send for Vessa and Malrik?"
msgstr "Est-ce qu'on fait venir Vessa et Malrik ?"

#. [&"master", "Vessa would burn it open to see inside. Malrik would ask what it pays. No."],
#: scripts/campaign/mission_e6_04.gd:85 data/voice/lines/e6m4.json:L6
msgid "Vessa would burn it open to see inside. Malrik would ask what it pays. No."
msgstr "Vessa l'ouvrirait par le feu pour voir dedans. Malrik demanderait ce que ça rapporte. Non."

#. [&"torvald", "Something under the isle is counting. Every one that falls, it counts."],
#: scripts/campaign/mission_e6_04.gd:86 data/voice/lines/e6m4.json:L7
msgid "Something under the isle is counting. Every one that falls, it counts."
msgstr "Quelque chose sous l'île compte. Chaque soldat qui tombe, il le compte."

#. [&"obren", "Master. You came yourself. I am honoured. Kneel a little longer."],
#: scripts/campaign/mission_e6_04.gd:87 data/voice/lines/e6m4.json:L8
msgid "Master. You came yourself. I am honoured. Kneel a little longer."
msgstr "Maître. Tu es venu en personne. Quel honneur. Reste à genoux encore un peu."

#. [&"narrator", "Then the isle split, and the amber came up through the stones."],
#: scripts/campaign/mission_e6_04.gd:88 data/voice/lines/e6m4.json:L9
msgid "Then the isle split, and the amber came up through the stones."
msgstr "Puis l'île s'est fendue, et l'ambre est montée entre les pierres."

#. [&"ysolde", "Torvald! It's breaking on our side!"],
#: scripts/campaign/mission_e6_04.gd:89 data/voice/lines/e6m4.json:L10
msgid "Torvald! It's breaking on our side!"
msgstr "Torvald ! Ça cède de notre côté !"

#. [&"torvald", "Then I am on your side. Hold."],
#: scripts/campaign/mission_e6_04.gd:90 data/voice/lines/e6m4.json:L11
msgid "Then I am on your side. Hold."
msgstr "Alors je suis de ton côté. Tiens bon."

#. [&"master", "It will not hold from up here. Not for long."],
#: scripts/campaign/mission_e6_04.gd:91 data/voice/lines/e6m4.json:L12
msgid "It will not hold from up here. Not for long."
msgstr "Ça ne tiendra pas d'ici. Pas longtemps."

#. [&"obren", "Come down, old man. Hold my door yourself. Learn how long a year is in the dark."],
#: scripts/campaign/mission_e6_04.gd:92 data/voice/lines/e6m4.json:L13
msgid "Come down, old man. Hold my door yourself. Learn how long a year is in the dark."
msgstr "Descends, vieil homme. Tiens ma porte toi-même. Apprends ce que dure une année dans le noir."

#. [&"ysolde", "Master. You can't go down there."],
#: scripts/campaign/mission_e6_04.gd:93 data/voice/lines/e6m4.json:L14
msgid "Master. You can't go down there."
msgstr "Maître. Vous ne pouvez pas descendre là-dedans."

#. [&"master", "Someone must. I have always been the one who must."],
#: scripts/campaign/mission_e6_04.gd:94 data/voice/lines/e6m4.json:L15
msgid "Someone must. I have always been the one who must."
msgstr "Quelqu'un doit le faire. Ça a toujours été moi."

#. [&"obren", "A wood-girl, a snowman and a tired old man. I can wait. Stone is patient."],
#: scripts/campaign/mission_e6_04.gd:95 data/voice/lines/e6m4.json:L16
msgid "A wood-girl, a snowman and a tired old man. I can wait. Stone is patient."
msgstr "Une fille des bois, un bonhomme de neige et un vieil homme fatigué. J'ai le temps. La pierre est patiente."

#. [&"master", "Listen, both of you. Tell no one what sleeps here. If the world knows, the world will dig."],
#: scripts/campaign/mission_e6_04.gd:96 data/voice/lines/e6m4.json:L17
msgid "Listen, both of you. Tell no one what sleeps here. If the world knows, the world will dig."
msgstr "Écoutez-moi, tous les deux. Ne dites à personne ce qui dort ici. Si le monde le sait, il va creuser."

#. [&"master", "My regalia are its keys. When I go, they will scatter. Never let them sit in one hand."],
#: scripts/campaign/mission_e6_04.gd:97 data/voice/lines/e6m4.json:L18
msgid "My regalia are its keys. When I go, they will scatter. Never let them sit in one hand."
msgstr "Mes insignes sont ses clés. Quand je partirai, ils vont se disperser. Jamais tous dans une seule main."

#. [&"master", "Ysolde, my heart: keep growing things. Torvald, my patience: wait for me."],
#: scripts/campaign/mission_e6_04.gd:98 data/voice/lines/e6m4.json:L19
msgid "Ysolde, my heart: keep growing things. Torvald, my patience: wait for me."
msgstr "Ysolde, mon cœur : continue de faire pousser. Torvald, ma patience : attends-moi."

#. [&"torvald", "How long?"],
#: scripts/campaign/mission_e6_04.gd:99 data/voice/lines/e6m4.json:L20
msgid "How long?"
msgstr "Combien de temps ?"

#. [&"master", "Not too long."],
#: scripts/campaign/mission_e6_04.gd:100 data/voice/lines/e6m4.json:L21
msgid "Not too long."
msgstr "Pas trop longtemps."

#. [&"narrator", "He went down that same night, to hold the door from below. He never said for how long."],
#: scripts/campaign/mission_e6_04.gd:101 data/voice/lines/e6m4.json:L22
msgid "He went down that same night, to hold the door from below. He never said for how long."
msgstr "Il est descendu cette nuit-là, tenir la porte d'en bas. Il n'a jamais dit pour combien de temps."

#. [&"master", "The seal! Keep them off the stone!"],
#: scripts/campaign/mission_e6_04.gd:102 data/voice/lines/e6m4.json:L23
msgid "The seal! Keep them off the stone!"
msgstr "Le sceau ! Tenez-les loin de la pierre !"

#. [&"ysolde", "Master... forgive me..."],
#: scripts/campaign/mission_e6_04.gd:103 data/voice/lines/e6m4.json:L24
msgid "Master... forgive me..."
msgstr "Maître... pardonnez-moi..."

#. [&"obren", "Open. At last, open."],
#: scripts/campaign/mission_e6_04.gd:104 data/voice/lines/e6m4.json:L25
msgid "Open. At last, open."
msgstr "Ouvert. Enfin, ouvert."

#. [&"ysolde", "That gate is closed. Roots don't forget."],
#: scripts/campaign/mission_e6_04.gd:105 data/voice/lines/e6m4.json:L26
msgid "That gate is closed. Roots don't forget."
msgstr "Cette porte est fermée. Les racines n'oublient pas."

#. [&"torvald", "One fewer door. Keep yours shut, Ysolde."],
#: scripts/campaign/mission_e6_04.gd:106 data/voice/lines/e6m4.json:L27
msgid "One fewer door. Keep yours shut, Ysolde."
msgstr "Une porte de moins. Garde la tienne fermée, Ysolde."

#. "Twelve years ago. For eighty-eight years nothing under Crown Hollow had stirred. Then, on the first warm nigh
#: scripts/campaign/mission_e6_04.gd:109
msgid "Twelve years ago. For eighty-eight years nothing under Crown Hollow had stirred. Then, on the first warm night of spring, the isle cracked, and amber light came up through the stones like water through ice."
msgstr "Il y a douze ans. Depuis quatre-vingt-huit ans, rien n'avait bougé sous Crown Hollow. Puis, par la première nuit douce du printemps, l'île s'est fendue, et une lumière ambrée est montée entre les pierres comme l'eau à travers la glace."

#. "The Master sent for two of his four apprentices, and only two: Ysolde from the west, Torvald from the north.
#: scripts/campaign/mission_e6_04.gd:110
msgid "The Master sent for two of his four apprentices, and only two: Ysolde from the west, Torvald from the north. When they arrived he was already on his knees at the old throne-stone, both hands pressed to the crack."
msgstr "Le Maître a fait venir deux de ses quatre apprentis, deux seulement : Ysolde de l'ouest, Torvald du nord. À leur arrivée, il était déjà à genoux devant la vieille pierre du trône, les deux mains pressées sur la fissure."

#. "Something is climbing out of the moat. Hold the isle, both banks and both bridges, until the crack is shut. D
#: scripts/campaign/mission_e6_04.gd:111
msgid "Something is climbing out of the moat. Hold the isle, both banks and both bridges, until the crack is shut. Do not let anything touch the stone."
msgstr "Quelque chose sort des douves. Tenez l'île, les deux rives et les deux ponts, jusqu'à ce que la fissure soit refermée. Ne laissez rien toucher la pierre."

#. const HINT_START := "Keep every enemy out of the white circle around the Master: the crack only closes while i
#: scripts/campaign/mission_e6_04.gd:113
msgid "Keep every enemy out of the white circle around the Master: the crack only closes while it is clear. Your bank is the west."
msgstr "Gardez tout ennemi hors du cercle blanc autour du Maître : la fissure ne se referme que s'il est dégagé. Votre rive est l'ouest."

#. const HINT_COUNTS := "The Hollow counts the dead: every soldier who falls near the isle weakens the seal."
#: scripts/campaign/mission_e6_04.gd:114
msgid "The Hollow counts the dead: every soldier who falls near the isle weakens the seal."
msgstr "Le Hollow compte les morts : chaque soldat qui tombe près de l'île affaiblit le sceau."

#. const HINT_STRONGHOLD := "Your Heartwood can become a Stronghold: select it and press X (200 crystals). It ope
#: scripts/campaign/mission_e6_04.gd:115
msgid "Your Heartwood can become a Stronghold: select it and press X (200 crystals). It opens Vinelasher, Greenheart Oathkeeper (Grove Hall) and the Bramblesage (Keep)."
msgstr "Votre Heartwood peut devenir une Forteresse : sélectionnez-le et appuyez sur X (200 cristaux). Elle ouvre Vinelasher, Greenheart Oathkeeper (Grove Hall) et le Bramblesage (Donjon)."

#. const HINT_SAGE := "Bramblesage: Z Snagroot drags one enemy 7 m toward it: pull Wardens out of the Master's ci
#: scripts/campaign/mission_e6_04.gd:116
msgid "Bramblesage: Z Snagroot drags one enemy 7 m toward it: pull Wardens out of the Master's circle. V Pollen Haze blinds the Ruin Slingers."
msgstr "Bramblesage : Z Snagroot traîne un ennemi de 7 m vers le Sage : tirez les Wardens hors du cercle du Maître. V Pollen Haze aveugle les Ruin Slingers."

#. const MSG_TORVALD_FELL := "Torvald falls back to the north shore"
#: scripts/campaign/mission_e6_04.gd:117
msgid "Torvald falls back to the north shore"
msgstr "Torvald se replie sur la rive nord"

#. const MSG_INTERRUPTED := "The Master is interrupted: clear the white circle!"
#: scripts/campaign/mission_e6_04.gd:118
msgid "The Master is interrupted: clear the white circle!"
msgstr "Le Maître est interrompu : dégagez le cercle blanc !"

#. const MSG_COUNTED := "The Hollow counts: {n}"
#: scripts/campaign/mission_e6_04.gd:119
msgid "The Hollow counts: {n}"
msgstr "Le Hollow compte : {n}"

