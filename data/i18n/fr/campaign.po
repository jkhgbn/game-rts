#. [&"vey", "Stay behind my sword, girl. Knives hate a long reach."],
#: scripts/campaign/mission_00.gd:115 data/voice/lines/m00.json:L01
msgid "Stay behind my sword, girl. Knives hate a long reach."
msgstr "Derrière mon épée, petite. Les couteaux détestent l'allonge."

#. [&"vessa", "I've been stabbed ONE time and I already hate it."],
#: scripts/campaign/mission_00.gd:116 data/voice/lines/m00.json:L02
msgid "I've been stabbed ONE time and I already hate it."
msgstr "On m'a poignardée UNE fois et je déteste déjà ça."

#. [&"vey", "Good. Light pushes back the dark. Always has."],
#: scripts/campaign/mission_00.gd:117 data/voice/lines/m00.json:L03
msgid "Good. Light pushes back the dark. Always has."
msgstr "Bien. La lumière repousse le noir. Toujours."

#. [&"vessa", "Dogs! Why is it always dogs?"],
#: scripts/campaign/mission_00.gd:118 data/voice/lines/m00.json:L04
msgid "Dogs! Why is it always dogs?"
msgstr "Des chiens ! Toujours des chiens !"

#. [&"hush", "Hold still, little queen. It's kinder."],
#: scripts/campaign/mission_00.gd:119 data/voice/lines/m00.json:L05
msgid "Hold still, little queen. It's kinder."
msgstr "Ne bouge pas, petite reine. C'est plus doux."

#. [&"vey", "Over my dead body, knife-woman."],
#: scripts/campaign/mission_00.gd:120 data/voice/lines/m00.json:L06
msgid "Over my dead body, knife-woman."
msgstr "Jamais, femme aux couteaux."

#. [&"hush", "The old man bites. How charming."],
#: scripts/campaign/mission_00.gd:121 data/voice/lines/m00.json:L07
msgid "The old man bites. How charming."
msgstr "Le vieux mord. Charmant."

#. [&"hush", "Another night, little queen. There is always another night."],
#: scripts/campaign/mission_00.gd:122 data/voice/lines/m00.json:L08
msgid "Another night, little queen. There is always another night."
msgstr "Une autre nuit, petite reine. Il y a toujours une autre nuit."

#. [&"vessa", "How many knives does one Bishop OWN?"],
#: scripts/campaign/mission_00.gd:123 data/voice/lines/m00.json:L09
msgid "How many knives does one Bishop OWN?"
msgstr "Il a COMBIEN de couteaux, l'Évêque ?"

#. [&"vey", "Two more hours, girl. Dawn always comes. It's the one thing it's good at."],
#: scripts/campaign/mission_00.gd:124 data/voice/lines/m00.json:L10
msgid "Two more hours, girl. Dawn always comes. It's the one thing it's good at."
msgstr "Encore deux heures, petite. L'aube vient toujours. C'est son seul talent."

#. [&"vessa", "You want me? Come and get me. ALL of you."],
#: scripts/campaign/mission_00.gd:125 data/voice/lines/m00.json:L11
msgid "You want me? Come and get me. ALL of you."
msgstr "Vous me voulez ? Venez me chercher. TOUS."

#. [&"vessa", "Vey... I'm sorry..."],
#: scripts/campaign/mission_00.gd:126 data/voice/lines/m00.json:L12
msgid "Vey... I'm sorry..."
msgstr "Vey... je suis désolée..."

#. [&"vessa", "You're going to explain the lightning."],
#: scripts/campaign/mission_00.gd:127 data/voice/lines/m00.json:L13
msgid "You're going to explain the lightning."
msgstr "Tu vas m'expliquer cet éclair."

#. [&"vey", "Later. Duck."],
#: scripts/campaign/mission_00.gd:128 data/voice/lines/m00.json:L14
msgid "Later. Duck."
msgstr "Plus tard. Baisse-toi."

#. [&"m0_fall", &"vey", "Vessa, MOVE!", 2.5],
#: scripts/campaign/mission_00.gd:132 data/voice/lines/m00.json:C1
msgid "Vessa, MOVE!"
msgstr "Vessa, BOUGE !"

#. [&"m0_fall", &"vessa", "VEY!", 2.0],
#: scripts/campaign/mission_00.gd:133 data/voice/lines/m00.json:C2
msgid "VEY!"
msgstr "VEY !"

#. [&"m0_fall", &"vessa", "...Malrik.", 2.5],
#: scripts/campaign/mission_00.gd:134 data/voice/lines/m00.json:C3
msgid "...Malrik."
msgstr "...Malrik."

#. [&"m0_dawn", &"narrator", "Dawn came to Emberfall, and so did the Emberguard.", 4.0],
#: scripts/campaign/mission_00.gd:135 data/voice/lines/m00.json:C4
msgid "Dawn came to Emberfall, and so did the Emberguard."
msgstr "L'aube vint sur Emberfall, et l'Emberguard avec elle."

#. [&"m0_dawn", &"ashby", "My queen! You're hurt-", 2.5],
#: scripts/campaign/mission_00.gd:136 data/voice/lines/m00.json:C5
msgid "My queen! You're hurt-"
msgstr "Ma reine ! Vous êtes blessée-"

#. [&"m0_dawn", &"vessa", "I'm not the one who's hurt, Captain.", 3.0],
#: scripts/campaign/mission_00.gd:137 data/voice/lines/m00.json:C6
msgid "I'm not the one who's hurt, Captain."
msgstr "Je ne suis pas la blessée, capitaine."

#. [&"m0_dawn", &"vessa", "Get the army up. We take the crown today.", 3.5],
#: scripts/campaign/mission_00.gd:138 data/voice/lines/m00.json:C7
msgid "Get the army up. We take the crown today."
msgstr "Debout, l'armée. On prend la couronne aujourd'hui."

#. const EP1_INTRO_TEXT := "The Master vanished and left four apprentices. Years later, Vessa of Fire answered he
#: scripts/campaign/mission_00.gd:141
msgid "The Master vanished and left four apprentices. Years later, Vessa of Fire answered her old teacher's letter and rode to Emberfall. That night Malrik of Shadow sent assassins to kill her. Old Vey's sword, and a crack of lightning no kingdom can explain, saved her life. Now they must survive until dawn."
msgstr "Le Maître a disparu en laissant quatre apprentis. Des années plus tard, Vessa du Feu a répondu à la lettre de son ancien professeur et chevauché jusqu'à Emberfall. Cette nuit-là, Malrik de l'Ombre a envoyé des assassins la tuer. L'épée d'Old Vey, et un coup de foudre qu'aucun royaume ne sait expliquer, lui ont sauvé la vie. Il faut maintenant survivre jusqu'à l'aube."

#. "Twelve years after the Master vanished, Old Vey, his old sword, wrote to the apprentice he once taught to str
#: scripts/campaign/mission_00.gd:144
msgid "Twelve years after the Master vanished, Old Vey, his old sword, wrote to the apprentice he once taught to strike a spark: the crown sealed in the ruins of Emberfall is waking. Vessa rode out that day with four guards."
msgstr "Douze ans après la disparition du Maître, Old Vey, sa vieille épée, a écrit à l'apprentie à qui il avait appris à faire jaillir une étincelle : la couronne scellée dans les ruines d'Emberfall s'éveille. Vessa est partie le jour même avec quatre gardes."

#. "Malrik of Shadow read the letter too. That night his knives came over the walls of the Emberfall watch: Mothe
#: scripts/campaign/mission_00.gd:145
msgid "Malrik of Shadow read the letter too. That night his knives came over the walls of the Emberfall watch: Mother Hush, the knife that never misses, and every assassin he owns. The first blade only grazed Vessa. Old Vey's sword, and a crack of lightning no kingdom can explain, turned the second."
msgstr "Malrik de l'Ombre a lu la lettre, lui aussi. Cette nuit-là, ses couteaux ont franchi les murs de la vigie d'Emberfall : Mère Hush, la lame qui ne rate jamais, et tous ses assassins. La première lame n'a qu'effleuré Vessa. L'épée d'Old Vey, et un coup de foudre qu'aucun royaume ne sait expliquer, ont détourné la seconde."

#. "Vessa is wounded and the watch is small. Light the watch-fires so the Emberguard can find you, keep behind Ve
#: scripts/campaign/mission_00.gd:146
msgid "Vessa is wounded and the watch is small. Light the watch-fires so the Emberguard can find you, keep behind Vey's sword, and live until dawn."
msgstr "Vessa est blessée et la vigie est petite. Allumez les feux de guet pour que l'Emberguard vous trouve, restez derrière l'épée de Vey et tenez jusqu'à l'aube."

#. const HINT_START := "Keep Vessa behind Old Vey's sword. Light the watch braziers to see the knives coming."
#: scripts/campaign/mission_00.gd:148
msgid "Keep Vessa behind Old Vey's sword. Light the watch braziers to see the knives coming."
msgstr "Gardez Vessa derrière l'épée d'Old Vey. Allumez les braseros de guet pour voir venir les couteaux."

#. const HINT_FIRST_LIT := "A lit brazier shows its side and warms whoever stands near it."
#: scripts/campaign/mission_00.gd:149
msgid "A lit brazier shows its side and warms whoever stands near it."
msgstr "Un brasero allumé éclaire son côté et réchauffe qui s'en approche."

#. const HINT_HUSH := "A violet ring means Hush is coming: Ember Step (Q) out of it."
#: scripts/campaign/mission_00.gd:150
msgid "A violet ring means Hush is coming: Ember Step (Q) out of it."
msgstr "Un cercle violet annonce Hush : sortez-en avec Ember Step (Q)."

#. const HINT_SPOTLIGHT := "Stand the Guards between Vessa and the gate: the hounds hit the shields, not her."
#: scripts/campaign/mission_00.gd:151
msgid "Stand the Guards between Vessa and the gate: the hounds hit the shields, not her."
msgstr "Placez les Flame Guards entre Vessa et la porte : les chiens frappent les boucliers, pas elle."

#. const HINT_LEVEL3 := "Level 3: Ctrl+F ranks up Fireball, Ctrl+Q ranks up Ember Step."
#: scripts/campaign/mission_00.gd:152
msgid "Level 3: Ctrl+F ranks up Fireball, Ctrl+Q ranks up Ember Step."
msgstr "Niveau 3 : Ctrl+F améliore Fireball, Ctrl+Q améliore Ember Step."

#. const MSG_FIRES := "The watch-fires burn. The Emberguard will see them at dawn."
#: scripts/campaign/mission_00.gd:153
msgid "The watch-fires burn. The Emberguard will see them at dawn."
msgstr "Les feux de guet brûlent. L'Emberguard les verra à l'aube."

#. const MSG_WATCH_FALLEN := "The watch has fallen."
#: scripts/campaign/mission_00.gd:154
msgid "The watch has fallen."
msgstr "La vigie est tombée."

#. const MSG_WARNING := "Knives from the %s!"
#: scripts/campaign/mission_00.gd:155
msgid "Knives from the %s!"
msgstr "Des couteaux, côté %s !"

#. const TEXT_DARK_HOLD := "Light the last watch-fires: the Emberguard is looking for your signal"
#: scripts/campaign/mission_00.gd:156
msgid "Light the last watch-fires: the Emberguard is looking for your signal"
msgstr "Allumez les derniers feux de guet : l'Emberguard cherche votre signal"

