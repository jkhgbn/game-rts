#. [&"narrator", "A quiet field. Something is about to happen."],
#: scripts/campaign/mission_skeleton.gd:14
msgid "A quiet field. Something is about to happen."
msgstr "Un champ tranquille. Quelque chose va se produire."

#. [&"vessa", "Then I'll be standing right where it happens."],
#: scripts/campaign/mission_skeleton.gd:15
msgid "Then I'll be standing right where it happens."
msgstr "Alors je serai pile où ça se produit."

#. [&"vessa", "Five seconds. I can hold anything for five seconds."],
#: scripts/campaign/mission_skeleton.gd:16
msgid "Five seconds. I can hold anything for five seconds."
msgstr "Cinq secondes. Je tiens n'importe quoi cinq secondes."

