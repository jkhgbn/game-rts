#. [&"narrator", "Spring at Crown Hollow. Three keys are still on the road. One is already here, of course."],
#: scripts/campaign/e8_lines.gd:17 data/voice/lines/e8m1_fire.json:L1
msgid "Spring at Crown Hollow. Three keys are still on the road. One is already here, of course."
msgstr "Le printemps à Crown Hollow. Trois clés sont encore en route. Une est déjà là, bien entendu."

#. [&"vessa", "Two days early. I'm always early. That's the problem, isn't it?"],
#: scripts/campaign/e8_lines.gd:18 data/voice/lines/e8m1_fire.json:L2
msgid "Two days early. I'm always early. That's the problem, isn't it?"
msgstr "Deux jours d'avance. Je suis toujours en avance. C'est ça, le problème, hein ?"

#. [&"vey", "Six stakes, one line. The Hollow can't feed on this bank. Don't hand it the other one."],
#: scripts/campaign/e8_lines.gd:19 data/voice/lines/e8m1_fire.json:L3
msgid "Six stakes, one line. The Hollow can't feed on this bank. Don't hand it the other one."
msgstr "Six pieux, une ligne. Le Hollow ne peut pas se nourrir sur cette rive. Ne lui donne pas l'autre."

#. [&"vessa", "So I just... stand here. For fourteen minutes."],
#: scripts/campaign/e8_lines.gd:20 data/voice/lines/e8m1_fire.json:L4
msgid "So I just... stand here. For fourteen minutes."
msgstr "Alors je reste juste... plantée là. Pendant quatorze minutes."

#. [&"vey", "The spark first, then the storm. Today the spark waits. I'll be below, talking to the sky."],
#: scripts/campaign/e8_lines.gd:21 data/voice/lines/e8m1_fire.json:L5
msgid "The spark first, then the storm. Today the spark waits. I'll be below, talking to the sky."
msgstr "L'étincelle d'abord, puis la tempête. Aujourd'hui, l'étincelle attend. Je serai en bas, à parler au ciel."

#. [&"obren", "Little ember. You came alone. You always come alone."],
#: scripts/campaign/e8_lines.gd:22 data/voice/lines/e8m1_fire.json:L6
msgid "Little ember. You came alone. You always come alone."
msgstr "Petite braise. Tu es venue seule. Tu viens toujours seule."

#. [&"vessa", "Not alone. Early. There's a difference. I'm told."],
#: scripts/campaign/e8_lines.gd:23 data/voice/lines/e8m1_fire.json:L7
msgid "Not alone. Early. There's a difference. I'm told."
msgstr "Pas seule. En avance. Il y a une différence. Paraît-il."

#. [&"obren", "My door is open, Queen of Fire. Come and close it. You know you want to."],
#: scripts/campaign/e8_lines.gd:24 data/voice/lines/e8m1_fire.json:L8
msgid "My door is open, Queen of Fire. Come and close it. You know you want to."
msgstr "Ma porte est ouverte, reine du Feu. Viens la fermer. Tu sais que tu en as envie."

#. [&"vessa", "I really do. I'm not going to. Somebody write that down."],
#: scripts/campaign/e8_lines.gd:25 data/voice/lines/e8m1_fire.json:L9
msgid "I really do. I'm not going to. Somebody write that down."
msgstr "J'en ai vraiment envie. Je ne le ferai pas. Que quelqu'un note ça."

#. [&"vey", "Girl! The water is the line. Every step past it, it eats."],
#: scripts/campaign/e8_lines.gd:26 data/voice/lines/e8m1_fire.json:L10
msgid "Girl! The water is the line. Every step past it, it eats."
msgstr "Petite ! L'eau, c'est la ligne. Chaque pas de l'autre côté, il le mange."

#. [&"obren", "Yes. Closer. Hungry fire feeds me best."],
#: scripts/campaign/e8_lines.gd:27 data/voice/lines/e8m1_fire.json:L11
msgid "Yes. Closer. Hungry fire feeds me best."
msgstr "Oui. Plus près. C'est le feu affamé qui me nourrit le mieux."

#. [&"ashby", "Scouts on the far bank, my queen! Pinned at the old wagon road!"],
#: scripts/campaign/e8_lines.gd:28 data/voice/lines/e8m1_fire.json:L12
msgid "Scouts on the far bank, my queen! Pinned at the old wagon road!"
msgstr "Des éclaireurs sur l'autre rive, ma reine ! Coincés sur le vieux chemin des chariots !"

#. [&"vessa", "Hold the ford for them. They run to us. We do NOT run to them."],
#: scripts/campaign/e8_lines.gd:29 data/voice/lines/e8m1_fire.json:L13
msgid "Hold the ford for them. They run to us. We do NOT run to them."
msgstr "Tenez le gué pour eux. Ils courent vers nous. Nous, on ne court PAS vers eux."

#. [&"ashby", "Did the queen just say \"we do not run\"? I'm putting that in the regiment book."],
#: scripts/campaign/e8_lines.gd:30 data/voice/lines/e8m1_fire.json:L14
msgid "Did the queen just say \"we do not run\"? I'm putting that in the regiment book."
msgstr "La reine vient de dire « on ne court pas » ? Je l'inscris dans le registre du régiment."

#. [&"ashby", "Every rider home! The queen waited! Somebody ring a bell!"],
#: scripts/campaign/e8_lines.gd:31 data/voice/lines/e8m1_fire.json:L15
msgid "Every rider home! The queen waited! Somebody ring a bell!"
msgstr "Tous les cavaliers sont rentrés ! La reine a attendu ! Qu'on sonne une cloche !"

#. [&"vessa", "Vey! I called. And look: still on my side of the river."],
#: scripts/campaign/e8_lines.gd:32 data/voice/lines/e8m1_fire.json:L16
msgid "Vey! I called. And look: still on my side of the river."
msgstr "Vey ! Je t'ai appelé. Et regarde : toujours de mon côté de la rivière."

#. [&"vey", "I see it. First time in twenty years. Don't spoil it."],
#: scripts/campaign/e8_lines.gd:33 data/voice/lines/e8m1_fire.json:L17
msgid "I see it. First time in twenty years. Don't spoil it."
msgstr "Je vois ça. Une première en vingt ans. Gâche pas tout."

#. [&"vey", "That's what waiting buys you, girl. Lightning, on time."],
#: scripts/campaign/e8_lines.gd:34 data/voice/lines/e8m1_fire.json:L18
msgid "That's what waiting buys you, girl. Lightning, on time."
msgstr "Voilà ce que l'attente t'achète, petite. La foudre, à l'heure."

#. [&"obren", "The line is broken. Feed me, little ember. Feed me everything."],
#: scripts/campaign/e8_lines.gd:35 data/voice/lines/e8m1_fire.json:L19
msgid "The line is broken. Feed me, little ember. Feed me everything."
msgstr "La ligne est brisée. Nourris-moi, petite braise. Nourris-moi de tout."

#. [&"narrator", "The last tide climbs out of the Hollow. On the hills behind it, three banners rise."],
#: scripts/campaign/e8_lines.gd:36 data/voice/lines/e8m1_fire.json:L20
msgid "The last tide climbs out of the Hollow. On the hills behind it, three banners rise."
msgstr "La dernière marée sort du Hollow. Sur les collines derrière elle, trois bannières se lèvent."

#. [&"torvald", "Ice, on the north road. You waited for us, child? Truly?"],
#: scripts/campaign/e8_lines.gd:37 data/voice/lines/e8m1_fire.json:L21
msgid "Ice, on the north road. You waited for us, child? Truly?"
msgstr "La Glace, sur la route du nord. Tu nous as attendus, petite ? Vraiment ?"

#. [&"ysolde", "She waited. I watched her do it. I may need to sit down."],
#: scripts/campaign/e8_lines.gd:38 data/voice/lines/e8m1_fire.json:L22
msgid "She waited. I watched her do it. I may need to sit down."
msgstr "Elle a attendu. Je l'ai vue faire. Je vais peut-être devoir m'asseoir."

#. [&"malrik", "Don't all stare. I was invited. Especially, I'm told."],
#: scripts/campaign/e8_lines.gd:39 data/voice/lines/e8m1_fire.json:L23
msgid "Don't all stare. I was invited. Especially, I'm told."
msgstr "Ne me fixez pas tous. J'ai été invité. Surtout moi, paraît-il."

#. [&"vessa", "Four keys. One hole in the ground. Let's go and knock."],
#: scripts/campaign/e8_lines.gd:40 data/voice/lines/e8m1_fire.json:L24
msgid "Four keys. One hole in the ground. Let's go and knock."
msgstr "Quatre clés. Un trou dans le sol. Allons frapper."

#. [&"vessa", "Too early... too early again..."],
#: scripts/campaign/e8_lines.gd:41 data/voice/lines/e8m1_fire.json:L25
msgid "Too early... too early again..."
msgstr "Trop tôt... encore trop tôt..."

#. [&"ashby", "They're at the keep! Emberguard, hold! HOLD!"],
#: scripts/campaign/e8_lines.gd:42 data/voice/lines/e8m1_fire.json:L26
msgid "They're at the keep! Emberguard, hold! HOLD!"
msgstr "Ils sont au donjon ! Emberguard, tenez bon ! TENEZ !"

#. [&"narrator", "Duskbarrow, city of crypts. Its bishop came home with a stone, and the dead got up to meet it."
#: scripts/campaign/e8_lines.gd:45 data/voice/lines/e8m1_shadow.json:L1
msgid "Duskbarrow, city of crypts. Its bishop came home with a stone, and the dead got up to meet it."
msgstr "Duskbarrow, cité des cryptes. L'évêque est rentré avec une pierre, et les morts se sont levés pour elle."

#. [&"malrik", "Every grave here, I dug, or my father did. They know my shovel. They don't know this."],
#: scripts/campaign/e8_lines.gd:46 data/voice/lines/e8m1_shadow.json:L2
msgid "Every grave here, I dug, or my father did. They know my shovel. They don't know this."
msgstr "Chaque tombe ici, c'est moi qui l'ai creusée, ou mon père. Ils connaissent ma pelle. Pas ceci."

#. [&"obren", "They are yours, Bishop. Take them back. Use me. Just a little."],
#: scripts/campaign/e8_lines.gd:47 data/voice/lines/e8m1_shadow.json:L3
msgid "They are yours, Bishop. Take them back. Use me. Just a little."
msgstr "Ils sont à toi, Évêque. Reprends-les. Sers-toi de moi. Juste un peu."

#. [&"malrik", "A little. You always say a little."],
#: scripts/campaign/e8_lines.gd:48 data/voice/lines/e8m1_shadow.json:L4
msgid "A little. You always say a little."
msgstr "Un peu. Tu dis toujours un peu."

#. [&"shade", "Bishop, the Old Ossuary is open. The dead are wearing amber."],
#: scripts/campaign/e8_lines.gd:49 data/voice/lines/e8m1_shadow.json:L5
msgid "Bishop, the Old Ossuary is open. The dead are wearing amber."
msgstr "Évêque, le Old Ossuary est ouvert. Les morts portent de l'ambre."

#. [&"malrik", "Then we put them back to bed. Gently. They were somebody's."],
#: scripts/campaign/e8_lines.gd:50 data/voice/lines/e8m1_shadow.json:L6
msgid "Then we put them back to bed. Gently. They were somebody's."
msgstr "Alors on les remet au lit. Doucement. Ils ont été à quelqu'un."

#. [&"obren", "There. Doesn't that feel like enough? It never is. Again."],
#: scripts/campaign/e8_lines.gd:51 data/voice/lines/e8m1_shadow.json:L7
msgid "There. Doesn't that feel like enough? It never is. Again."
msgstr "Voilà. Ça ne te semble pas assez ? Ça ne l'est jamais. Encore."

#. [&"malrik", "I know what you are. You're the last biscuit in the tin, forever."],
#: scripts/campaign/e8_lines.gd:52 data/voice/lines/e8m1_shadow.json:L8
msgid "I know what you are. You're the last biscuit in the tin, forever."
msgstr "Je sais ce que tu es. Le dernier biscuit de la boîte, pour toujours."

#. [&"malrik", "Rest. I'm sorry they woke you. It wasn't me. It was what I was holding."],
#: scripts/campaign/e8_lines.gd:53 data/voice/lines/e8m1_shadow.json:L9
msgid "Rest. I'm sorry they woke you. It wasn't me. It was what I was holding."
msgstr "Reposez-vous. Désolé qu'on vous ait réveillés. Ce n'était pas moi. C'était ce que je tenais."

#. [&"malrik", "Father. You taught me where to dig. You never taught me when to stop."],
#: scripts/campaign/e8_lines.gd:54 data/voice/lines/e8m1_shadow.json:L10
msgid "Father. You taught me where to dig. You never taught me when to stop."
msgstr "Père. Tu m'as appris où creuser. Tu ne m'as jamais appris quand m'arrêter."

#. [&"obren", "Use me, and he will stand up and answer you. One question. Any question."],
#: scripts/campaign/e8_lines.gd:55 data/voice/lines/e8m1_shadow.json:L10b
msgid "Use me, and he will stand up and answer you. One question. Any question."
msgstr "Sers-toi de moi, et il se lèvera pour te répondre. Une question. N'importe laquelle."

#. [&"malrik", "I'm learning, late. You'd say that's the family way. Sleep, old man."],
#: scripts/campaign/e8_lines.gd:56 data/voice/lines/e8m1_shadow.json:L11
msgid "I'm learning, late. You'd say that's the family way. Sleep, old man."
msgstr "J'apprends, sur le tard. Tu dirais que c'est de famille. Dors, vieil homme."

#. [&"hush", "Bishop. You taught me the knife. The stone taught me the rest."],
#: scripts/campaign/e8_lines.gd:57 data/voice/lines/e8m1_shadow.json:L12
msgid "Bishop. You taught me the knife. The stone taught me the rest."
msgstr "Évêque. Tu m'as appris le couteau. La pierre m'a appris le reste."

#. [&"hush", "Give it to me. You never use it right. You use it SMALL."],
#: scripts/campaign/e8_lines.gd:58 data/voice/lines/e8m1_shadow.json:L13
msgid "Give it to me. You never use it right. You use it SMALL."
msgstr "Donne-la-moi. Tu ne t'en sers jamais comme il faut. Tu t'en sers en PETIT."

#. [&"malrik", "That's the only way to use it, Hush. Small. Then never."],
#: scripts/campaign/e8_lines.gd:59 data/voice/lines/e8m1_shadow.json:L14
msgid "That's the only way to use it, Hush. Small. Then never."
msgstr "C'est la seule façon de s'en servir, Hush. En petit. Puis jamais."

#. [&"hush", "There is always another night, Bishop!"],
#: scripts/campaign/e8_lines.gd:60 data/voice/lines/e8m1_shadow.json:L15
msgid "There is always another night, Bishop!"
msgstr "Il y a toujours une autre nuit, Évêque !"

#. [&"malrik", "There is. I'd like to sleep through one of them."],
#: scripts/campaign/e8_lines.gd:61 data/voice/lines/e8m1_shadow.json:L16
msgid "There is. I'd like to sleep through one of them."
msgstr "C'est vrai. J'aimerais bien en dormir une au complet."

#. [&"hush", "You'll want me back. When the dark gets loud."],
#: scripts/campaign/e8_lines.gd:62 data/voice/lines/e8m1_shadow.json:L17
msgid "You'll want me back. When the dark gets loud."
msgstr "Tu voudras que je revienne. Quand le noir deviendra bruyant."

#. [&"malrik", "Go, then. Keep your knives sharp. I may need a friend who isn't a rock."],
#: scripts/campaign/e8_lines.gd:63 data/voice/lines/e8m1_shadow.json:L18
msgid "Go, then. Keep your knives sharp. I may need a friend who isn't a rock."
msgstr "Va, alors. Garde tes couteaux affûtés. J'aurai peut-être besoin d'une amie qui n'est pas un caillou."

#. [&"obren", "You will use me at the end. Everyone does. Your Master did."],
#: scripts/campaign/e8_lines.gd:64 data/voice/lines/e8m1_shadow.json:L19
msgid "You will use me at the end. Everyone does. Your Master did."
msgstr "Tu te serviras de moi à la fin. Tout le monde le fait. Ton Maître l'a fait."

#. [&"malrik", "Then I'll be the first who didn't. I do so like being first."],
#: scripts/campaign/e8_lines.gd:65 data/voice/lines/e8m1_shadow.json:L20
msgid "Then I'll be the first who didn't. I do so like being first."
msgstr "Alors je serai le premier à ne pas l'avoir fait. J'adore tellement être le premier."

#. [&"malrik", "I'm not using you. I'm carrying you. Like a parcel. To the hole you came from."],
#: scripts/campaign/e8_lines.gd:66 data/voice/lines/e8m1_shadow.json:L21
msgid "I'm not using you. I'm carrying you. Like a parcel. To the hole you came from."
msgstr "Je ne me sers pas de toi. Je te transporte. Comme un colis. Jusqu'au trou d'où tu viens."

#. [&"narrator", "The Bishop walked out of his city with the stone in his fist, and for once the fist stayed shut
#: scripts/campaign/e8_lines.gd:67 data/voice/lines/e8m1_shadow.json:L22
msgid "The Bishop walked out of his city with the stone in his fist, and for once the fist stayed shut."
msgstr "L'Évêque est sorti de sa ville, la pierre dans le poing, et pour une fois, le poing est resté fermé."

#. [&"malrik", "Hungry... to the very last..."],
#: scripts/campaign/e8_lines.gd:68 data/voice/lines/e8m1_shadow.json:L23
msgid "Hungry... to the very last..."
msgstr "Affamé... jusqu'au bout..."

#. [&"obren", "Not once? Not ONCE? ...What ARE you?"],
#: scripts/campaign/e8_lines.gd:69 data/voice/lines/e8m1_shadow.json:L24
msgid "Not once? Not ONCE? ...What ARE you?"
msgstr "Pas une fois ? Pas UNE SEULE ? ...Mais qu'est-ce que tu ES ?"

#. [&"malrik", "Full, apparently. Who knew."],
#: scripts/campaign/e8_lines.gd:70 data/voice/lines/e8m1_shadow.json:L25
msgid "Full, apparently. Who knew."
msgstr "Rassasié, apparemment. Qui l'eût cru."

#. [&"narrator", "The Hundredwinter Gate. Someone is knocking on it. Someone always was."],
#: scripts/campaign/e8_lines.gd:73 data/voice/lines/e8m1_ice.json:L1
msgid "The Hundredwinter Gate. Someone is knocking on it. Someone always was."
msgstr "La Hundredwinter Gate. Quelqu'un y frappe. Quelqu'un y a toujours frappé."

#. [&"aldra", "We don't know what follows them. We could wait. Just until we see."],
#: scripts/campaign/e8_lines.gd:74 data/voice/lines/e8m1_ice.json:L2
msgid "We don't know what follows them. We could wait. Just until we see."
msgstr "On ne sait pas ce qui les suit. On pourrait attendre. Juste le temps de voir."

#. [&"torvald", "I always waited until I saw. Then there was nothing left to see."],
#: scripts/campaign/e8_lines.gd:75 data/voice/lines/e8m1_ice.json:L3
msgid "I always waited until I saw. Then there was nothing left to see."
msgstr "J'ai toujours attendu de voir. Et ensuite, il n'y avait plus rien à voir."

#. [&"torvald", "Not this year. Open the gate, Aldra. Or no. I will. My hands, this time."],
#: scripts/campaign/e8_lines.gd:76 data/voice/lines/e8m1_ice.json:L4
msgid "Not this year. Open the gate, Aldra. Or no. I will. My hands, this time."
msgstr "Pas cette année. Ouvre la porte, Aldra. Ou non. Je vais le faire. De mes mains, cette fois."

#. [&"torvald", "Come in. Get warm. There is soup, I'm told. I've never been told that before."],
#: scripts/campaign/e8_lines.gd:77 data/voice/lines/e8m1_ice.json:L5
msgid "Come in. Get warm. There is soup, I'm told. I've never been told that before."
msgstr "Entrez. Réchauffez-vous. Il y a de la soupe, paraît-il. On ne m'avait jamais dit ça."

#. [&"narrator", "Out of the cracked north comes a long dark line: carts, old men, children, and the hunt behind.
#: scripts/campaign/e8_lines.gd:78 data/voice/lines/e8m1_ice.json:L6
msgid "Out of the cracked north comes a long dark line: carts, old men, children, and the hunt behind."
msgstr "Du nord fissuré arrive une longue ligne sombre : charrettes, vieillards, enfants, et la chasse derrière."

#. [&"narrator", "Kettlewick stands. It remembers who opened the gate once. Its shields come too."],
#: scripts/campaign/e8_lines.gd:79 data/voice/lines/e8m1_ice.json:L7
msgid "Kettlewick stands. It remembers who opened the gate once. Its shields come too."
msgstr "Kettlewick est debout. Elle se souvient de qui a ouvert la porte, une fois. Ses boucliers viennent aussi."

#. [&"torvald", "Kettlewick. Twice now. Perhaps it's a habit."],
#: scripts/campaign/e8_lines.gd:80 data/voice/lines/e8m1_ice.json:L8
msgid "Kettlewick. Twice now. Perhaps it's a habit."
msgstr "Kettlewick. Deux fois, maintenant. C'est peut-être une habitude."

#. [&"narrator", "Kettlewick is a ruin. The gate stayed shut that winter. This column is what's left."],
#: scripts/campaign/e8_lines.gd:81 data/voice/lines/e8m1_ice.json:L9b
msgid "Kettlewick is a ruin. The gate stayed shut that winter. This column is what's left."
msgstr "Kettlewick est en ruine. La porte est restée fermée cet hiver-là. Cette colonne, c'est ce qu'il en reste."

#. [&"aldra", "Torvald, they're at the gate. Whatever you're waiting for, it's here."],
#: scripts/campaign/e8_lines.gd:82 data/voice/lines/e8m1_ice.json:L9
msgid "Torvald, they're at the gate. Whatever you're waiting for, it's here."
msgstr "Torvald, ils sont à la porte. Ce que tu attends, quoi que ce soit, est arrivé."

#. [&"torvald", "That's the last of them. Close it behind them. Gates are for closing too."],
#: scripts/campaign/e8_lines.gd:83 data/voice/lines/e8m1_ice.json:L10
msgid "That's the last of them. Close it behind them. Gates are for closing too."
msgstr "C'est le dernier. Ferme-la derrière eux. Les portes, ça sert aussi à fermer."

#. [&"torvald", "They rest here. Four minutes. They walked for three days. We hold for four minutes."],
#: scripts/campaign/e8_lines.gd:84 data/voice/lines/e8m1_ice.json:L11
msgid "They rest here. Four minutes. They walked for three days. We hold for four minutes."
msgstr "Ils se reposent ici. Quatre minutes. Ils ont marché trois jours. On tient quatre minutes."

#. [&"aldra", "You called. Before I asked. Winter's changing."],
#: scripts/campaign/e8_lines.gd:85 data/voice/lines/e8m1_ice.json:L12
msgid "You called. Before I asked. Winter's changing."
msgstr "Tu m'as appelée. Avant que je le demande. L'hiver change."

#. [&"obren", "The ice cracks, Torvald. Even yours. Especially yours."],
#: scripts/campaign/e8_lines.gd:86 data/voice/lines/e8m1_ice.json:L13
msgid "The ice cracks, Torvald. Even yours. Especially yours."
msgstr "La glace se fend, Torvald. Même la tienne. Surtout la tienne."

#. [&"torvald", "Then it cracks. Ice was never the point. The line was."],
#: scripts/campaign/e8_lines.gd:87 data/voice/lines/e8m1_ice.json:L14
msgid "Then it cracks. Ice was never the point. The line was."
msgstr "Alors qu'elle se fende. La glace n'a jamais été l'essentiel. La ligne, oui."

#. [&"aldra", "Both flanks! They want the children. Hold the stair!"],
#: scripts/campaign/e8_lines.gd:88 data/voice/lines/e8m1_ice.json:L15
msgid "Both flanks! They want the children. Hold the stair!"
msgstr "Les deux flancs ! Ils veulent les enfants. Tenez l'escalier !"

#. [&"torvald", "Twenty. That's enough to be a town. Keep them coming."],
#: scripts/campaign/e8_lines.gd:89 data/voice/lines/e8m1_ice.json:L16
msgid "Twenty. That's enough to be a town. Keep them coming."
msgstr "Vingt. Assez pour faire une ville. Qu'ils continuent d'arriver."

#. [&"torvald", "Go south. Don't look back. There's nothing back there worth the look."],
#: scripts/campaign/e8_lines.gd:90 data/voice/lines/e8m1_ice.json:L17
msgid "Go south. Don't look back. There's nothing back there worth the look."
msgstr "Allez vers le sud. Ne regardez pas en arrière. Il n'y a rien là-bas qui vaille un regard."

#. [&"aldra", "The orb is warm. It hasn't been warm in a hundred years."],
#: scripts/campaign/e8_lines.gd:91 data/voice/lines/e8m1_ice.json:L18
msgid "The orb is warm. It hasn't been warm in a hundred years."
msgstr "L'orbe est tiède. Ça fait cent ans qu'il n'a pas été tiède."

#. [&"torvald", "Crown Hollow, then. Vessa waited. I can hurry. Watch me."],
#: scripts/campaign/e8_lines.gd:92 data/voice/lines/e8m1_ice.json:L19
msgid "Crown Hollow, then. Vessa waited. I can hurry. Watch me."
msgstr "Crown Hollow, alors. Vessa a attendu. Moi, je peux me dépêcher. Regardez-moi bien."

#. [&"torvald", "Too slow... once more..."],
#: scripts/campaign/e8_lines.gd:93 data/voice/lines/e8m1_ice.json:L20
msgid "Too slow... once more..."
msgstr "Trop lent... encore une fois..."

#. [&"aldra", "Too many lost. The road is closed to them now."],
#: scripts/campaign/e8_lines.gd:94 data/voice/lines/e8m1_ice.json:L21
msgid "Too many lost. The road is closed to them now."
msgstr "Trop de pertes. La route leur est fermée, maintenant."

#. [&"narrator", "The Closed Road. For a hundred years nobody came in. For a hundred years she never went out."],
#: scripts/campaign/e8_lines.gd:97 data/voice/lines/e8m1_nature.json:L1
msgid "The Closed Road. For a hundred years nobody came in. For a hundred years she never went out."
msgstr "La Closed Road. Pendant cent ans, personne n'est entré. Pendant cent ans, elle n'est jamais sortie."

#. [&"ysolde", "I grew these walls to keep the war out. They did. They kept everything out."],
#: scripts/campaign/e8_lines.gd:98 data/voice/lines/e8m1_nature.json:L2
msgid "I grew these walls to keep the war out. They did. They kept everything out."
msgstr "J'ai fait pousser ces murs pour garder la guerre dehors. Ils l'ont fait. Ils ont tout gardé dehors."

#. [&"maelis", "They'll fight you, child. They only know the one word you taught them."],
#: scripts/campaign/e8_lines.gd:99 data/voice/lines/e8m1_nature.json:L3
msgid "They'll fight you, child. They only know the one word you taught them."
msgstr "Ils vont te combattre, petite. Ils ne connaissent que le seul mot que tu leur as appris."

#. [&"ysolde", "Then I'll teach them a second word. It's a short one. Open."],
#: scripts/campaign/e8_lines.gd:100 data/voice/lines/e8m1_nature.json:L4
msgid "Then I'll teach them a second word. It's a short one. Open."
msgstr "Alors je vais leur en apprendre un deuxième. Il est court. Ouvrez."

#. [&"ysolde", "One down. It felt like pulling out my own hair. Two more."],
#: scripts/campaign/e8_lines.gd:101 data/voice/lines/e8m1_nature.json:L5
msgid "One down. It felt like pulling out my own hair. Two more."
msgstr "Un de tombé. C'était comme m'arracher mes propres cheveux. Encore deux."

#. [&"messenger", "My lady! Pipwell... Pipwell's burning. They... they asked for you. By name."],
#: scripts/campaign/e8_lines.gd:102 data/voice/lines/e8m1_nature.json:L6
msgid "My lady! Pipwell... Pipwell's burning. They... they asked for you. By name."
msgstr "Ma dame ! Pipwell brûle. Ils vous ont demandée. Par votre nom."

#. [&"ysolde", "Nobody burns while I watch. Not any more. Go home, Pipwell. Grow it back."],
#: scripts/campaign/e8_lines.gd:103 data/voice/lines/e8m1_nature.json:L7
msgid "Nobody burns while I watch. Not any more. Go home, Pipwell. Grow it back."
msgstr "Personne ne brûle sous mes yeux. Plus jamais. Rentrez chez vous, Pipwell. Faites-le repousser."

#. [&"ysolde", "Too slow. I was always too slow for the ones at the border."],
#: scripts/campaign/e8_lines.gd:104 data/voice/lines/e8m1_nature.json:L8
msgid "Too slow. I was always too slow for the ones at the border."
msgstr "Trop lente. J'ai toujours été trop lente pour ceux de la frontière."

#. [&"messenger", "Fernby! The... the old stones are walking. Into the houses!"],
#: scripts/campaign/e8_lines.gd:105 data/voice/lines/e8m1_nature.json:L9
msgid "Fernby! The... the old stones are walking. Into the houses!"
msgstr "Fernby ! Les vieilles pierres marchent. Dans les maisons !"

#. [&"ysolde", "Two. I'm taking a side, Maelis. It's theirs."],
#: scripts/campaign/e8_lines.gd:106 data/voice/lines/e8m1_nature.json:L10
msgid "Two. I'm taking a side, Maelis. It's theirs."
msgstr "Deux. Je prends parti, Maelis. Le leur."

#. [&"maelis", "You called me out of the wood. I've waited forty years to hear that."],
#: scripts/campaign/e8_lines.gd:107 data/voice/lines/e8m1_nature.json:L11
msgid "You called me out of the wood. I've waited forty years to hear that."
msgstr "Tu m'as appelée hors du bois. J'ai attendu quarante ans pour entendre ça."

#. [&"ysolde", "The last root. My first wall. Goodbye."],
#: scripts/campaign/e8_lines.gd:108 data/voice/lines/e8m1_nature.json:L12
msgid "The last root. My first wall. Goodbye."
msgstr "La dernière racine. Mon premier mur. Adieu."

#. [&"messenger", "Hollins Cross... please. Please, they're... they're at the mill."],
#: scripts/campaign/e8_lines.gd:109 data/voice/lines/e8m1_nature.json:L13
msgid "Hollins Cross... please. Please, they're... they're at the mill."
msgstr "Hollins Cross, s'il vous plaît ! Ils sont au moulin."

#. [&"ysolde", "Three messengers, three answers. I could get used to answering."],
#: scripts/campaign/e8_lines.gd:110 data/voice/lines/e8m1_nature.json:L14
msgid "Three messengers, three answers. I could get used to answering."
msgstr "Trois messagers, trois réponses. Je pourrais m'habituer à répondre."

#. [&"obren", "Stay in your garden, gardener. You were always so good at it."],
#: scripts/campaign/e8_lines.gd:111 data/voice/lines/e8m1_nature.json:L15
msgid "Stay in your garden, gardener. You were always so good at it."
msgstr "Reste dans ton jardin, jardinière. Tu as toujours été si douée pour ça."

#. [&"ysolde", "I've left the garden. Show me again, Master. I'm showing you."],
#: scripts/campaign/e8_lines.gd:112 data/voice/lines/e8m1_nature.json:L16
msgid "I've left the garden. Show me again, Master. I'm showing you."
msgstr "J'ai quitté le jardin. Montre-moi encore, Maître. C'est moi qui te montre."

#. [&"narrator", "For the first time in a hundred years, the green went out of its own border."],
#: scripts/campaign/e8_lines.gd:113 data/voice/lines/e8m1_nature.json:L17
msgid "For the first time in a hundred years, the green went out of its own border."
msgstr "Pour la première fois en cent ans, le vert est sorti de sa propre frontière."

#. [&"ysolde", "The Signet's warm. It's pointing at the others. Let's not keep them waiting."],
#: scripts/campaign/e8_lines.gd:114 data/voice/lines/e8m1_nature.json:L18
msgid "The Signet's warm. It's pointing at the others. Let's not keep them waiting."
msgstr "Le Signet est tiède. Il pointe vers les autres. Ne les faisons pas attendre."

#. [&"messenger", "My lady... you're really coming? Out here? With us?"],
#: scripts/campaign/e8_lines.gd:115 data/voice/lines/e8m1_nature.json:L19
msgid "My lady... you're really coming? Out here? With us?"
msgstr "Ma dame, vous venez vraiment ici ? Avec nous ?"

#. [&"ysolde", "Burn it, then. It grows back. That's the one thing I've always known."],
#: scripts/campaign/e8_lines.gd:116 data/voice/lines/e8m1_nature.json:L20
msgid "Burn it, then. It grows back. That's the one thing I've always known."
msgstr "Brûlez-le, alors. Ça repousse. C'est la seule chose que j'ai toujours sue."

#. [&"ysolde", "I left... too late..."],
#: scripts/campaign/e8_lines.gd:117 data/voice/lines/e8m1_nature.json:L21
msgid "I left... too late..."
msgstr "Je suis partie... trop tard..."

#. [&"narrator", "Four kingdoms on one field, and every banner pointed the same way. It had never happened."],
#: scripts/campaign/e8_lines.gd:120 data/voice/lines/e8m2.json:L1
msgid "Four kingdoms on one field, and every banner pointed the same way. It had never happened."
msgstr "Quatre royaumes sur un même champ, toutes les bannières tournées du même côté. Ça n'était jamais arrivé."

#. [&"vey", "Well. Look at the four of you. Thirty years I waited to see this, and it's ugly. I love it."],
#: scripts/campaign/e8_lines.gd:121 data/voice/lines/e8m2.json:L2
msgid "Well. Look at the four of you. Thirty years I waited to see this, and it's ugly. I love it."
msgstr "Eh bien. Regardez-vous, tous les quatre. Trente ans que j'attends de voir ça, et c'est laid. J'adore."

#. [&"vessa", "Fire takes its bank. Or wherever I'm standing. I'm flexible."],
#: scripts/campaign/e8_lines.gd:122 data/voice/lines/e8m2.json:L3
msgid "Fire takes its bank. Or wherever I'm standing. I'm flexible."
msgstr "Le Feu prend sa rive. Ou là où je me trouve. Je suis flexible."

#. [&"torvald", "Ice holds its bank. Malrik, if that stone so much as hums, I'm freezing your pocket."],
#: scripts/campaign/e8_lines.gd:123 data/voice/lines/e8m2.json:L4
msgid "Ice holds its bank. Malrik, if that stone so much as hums, I'm freezing your pocket."
msgstr "La Glace tient sa rive. Malrik, si cette pierre bourdonne le moindrement, je gèle ta poche."

#. [&"malrik", "Noted. Ysolde, try not to plant anything on my keyhole."],
#: scripts/campaign/e8_lines.gd:124 data/voice/lines/e8m2.json:L5
msgid "Noted. Ysolde, try not to plant anything on my keyhole."
msgstr "C'est noté. Ysolde, essaie de ne rien planter sur ma serrure."

#. [&"ysolde", "No promises. Spring is busy."],
#: scripts/campaign/e8_lines.gd:125 data/voice/lines/e8m2.json:L5b
msgid "No promises. Spring is busy."
msgstr "Je ne promets rien. Le printemps a beaucoup à faire."

#. [&"obren", "Four of you. FOUR. I only needed one to come close. You brought me a feast."],
#: scripts/campaign/e8_lines.gd:126 data/voice/lines/e8m2.json:L6
msgid "Four of you. FOUR. I only needed one to come close. You brought me a feast."
msgstr "Vous quatre. QUATRE. Il m'en fallait juste un qui s'approche. Vous m'apportez un festin."

#. [&"vey", "Gates on every road. He's been building while we argued. Mason to the end."],
#: scripts/campaign/e8_lines.gd:127 data/voice/lines/e8m2.json:L7
msgid "Gates on every road. He's been building while we argued. Mason to the end."
msgstr "Des portes sur chaque route. Il bâtissait pendant qu'on se chicanait. Maçon jusqu'au bout."

#. [&"vey", "The pylon's down! Now the Hollow knows your key is coming. Hold the ring!"],
#: scripts/campaign/e8_lines.gd:128 data/voice/lines/e8m2.json:L8
msgid "The pylon's down! Now the Hollow knows your key is coming. Hold the ring!"
msgstr "Le pylône est tombé ! Le Hollow sait maintenant que ta clé arrive. Tiens le cercle !"

#. [&"vessa", "They're all over my keyhole! I could use a hand. Or ten."],
#: scripts/campaign/e8_lines.gd:129 data/voice/lines/e8m2.json:L10
msgid "They're all over my keyhole! I could use a hand. Or ten."
msgstr "Ils sont partout sur ma serrure ! Un coup de main serait pas de refus. Ou dix."

#. [&"malrik", "The Bishop requests assistance. Politely. Once."],
#: scripts/campaign/e8_lines.gd:130 data/voice/lines/e8m2.json:L11
msgid "The Bishop requests assistance. Politely. Once."
msgstr "L'Évêque demande de l'aide. Poliment. Une fois."

#. [&"torvald", "My line is bending. Help me hold it. I'm asking. Note that."],
#: scripts/campaign/e8_lines.gd:131 data/voice/lines/e8m2.json:L12
msgid "My line is bending. Help me hold it. I'm asking. Note that."
msgstr "Ma ligne plie. Aide-moi à la tenir. Je le demande. Prends-en note."

#. [&"ysolde", "They're in my roots! Please. Now, not in a season."],
#: scripts/campaign/e8_lines.gd:132 data/voice/lines/e8m2.json:L13
msgid "They're in my roots! Please. Now, not in a season."
msgstr "Ils sont dans mes racines ! S'il te plaît. Maintenant, pas dans une saison."

#. [&"vessa", "That's what friends are for. Apparently. Don't tell Malrik."],
#: scripts/campaign/e8_lines.gd:133 data/voice/lines/e8m2.json:L14
msgid "That's what friends are for. Apparently. Don't tell Malrik."
msgstr "C'est à ça que servent les amis. Apparemment. Le dis pas à Malrik."

#. [&"malrik", "Hm. Help that arrives on time. Unsettling. Thank you."],
#: scripts/campaign/e8_lines.gd:134 data/voice/lines/e8m2.json:L15
msgid "Hm. Help that arrives on time. Unsettling. Thank you."
msgstr "Hum. De l'aide qui arrive à l'heure. Troublant. Merci."

#. [&"torvald", "You came quickly. I'll try to learn how that's done."],
#: scripts/campaign/e8_lines.gd:135 data/voice/lines/e8m2.json:L16
msgid "You came quickly. I'll try to learn how that's done."
msgstr "Tu as fait vite. Je vais essayer d'apprendre comment on fait."

#. [&"ysolde", "You came. I always hoped someone would, when it was me."],
#: scripts/campaign/e8_lines.gd:136 data/voice/lines/e8m2.json:L17
msgid "You came. I always hoped someone would, when it was me."
msgstr "Tu es là. J'ai toujours espéré que quelqu'un viendrait, quand ce serait mon tour."

#. [&"obren", "Every one who falls is a step on my stair. Keep climbing for me."],
#: scripts/campaign/e8_lines.gd:137 data/voice/lines/e8m2.json:L18
msgid "Every one who falls is a step on my stair. Keep climbing for me."
msgstr "Chacun qui tombe est une marche de mon escalier. Continuez de grimper pour moi."

#. [&"vey", "Stop feeding it! Fight smart, or fight later. Later is worse."],
#: scripts/campaign/e8_lines.gd:138 data/voice/lines/e8m2.json:L19
msgid "Stop feeding it! Fight smart, or fight later. Later is worse."
msgstr "Arrête de le nourrir ! Bats-toi intelligemment, ou bats-toi plus tard. Plus tard, c'est pire."

#. [&"vessa", "Marching now! Fire on the bridge. Somebody watch my back, I won't."],
#: scripts/campaign/e8_lines.gd:139 data/voice/lines/e8m2.json:L20
msgid "Marching now! Fire on the bridge. Somebody watch my back, I won't."
msgstr "On marche ! Le Feu sur le pont. Que quelqu'un surveille mes arrières, moi je le ferai pas."

#. [&"malrik", "Shadow marches. The stone stays in my pocket. Mostly I'm telling myself."],
#: scripts/campaign/e8_lines.gd:140 data/voice/lines/e8m2.json:L21
msgid "Shadow marches. The stone stays in my pocket. Mostly I'm telling myself."
msgstr "L'Ombre marche. La pierre reste dans ma poche. C'est surtout à moi que je le dis."

#. [&"torvald", "Ice is moving. I know. Write it down somewhere."],
#: scripts/campaign/e8_lines.gd:141 data/voice/lines/e8m2.json:L22
msgid "Ice is moving. I know. Write it down somewhere."
msgstr "La Glace bouge. Je sais. Note-le quelque part."

#. [&"ysolde", "Nature marches out. Again. It's getting easier."],
#: scripts/campaign/e8_lines.gd:142 data/voice/lines/e8m2.json:L23
msgid "Nature marches out. Again. It's getting easier."
msgstr "La Nature sort de chez elle. Encore. Ça devient plus facile."

#. [&"vessa", "Fire's key is in! Don't make me wait. I'm terrible at it."],
#: scripts/campaign/e8_lines.gd:143 data/voice/lines/e8m2.json:L24
msgid "Fire's key is in! Don't make me wait. I'm terrible at it."
msgstr "La clé du Feu est en place ! Me fais pas attendre. Je suis nulle là-dedans."

#. [&"malrik", "Shadow's lock is turned. You may thank me in writing."],
#: scripts/campaign/e8_lines.gd:144 data/voice/lines/e8m2.json:L25
msgid "Shadow's lock is turned. You may thank me in writing."
msgstr "La serrure de l'Ombre est tournée. Tu peux me remercier par écrit."

#. [&"torvald", "Ice is set. That was quick, for me."],
#: scripts/campaign/e8_lines.gd:145 data/voice/lines/e8m2.json:L26
msgid "Ice is set. That was quick, for me."
msgstr "La Glace est en place. C'était rapide, pour moi."

#. [&"ysolde", "Nature's key is home. The roots are holding it."],
#: scripts/campaign/e8_lines.gd:146 data/voice/lines/e8m2.json:L27
msgid "Nature's key is home. The roots are holding it."
msgstr "La clé de la Nature est chez elle. Les racines la tiennent."

#. [&"pell", "Last stall before the end of the world! Again! I'm getting good at these."],
#: scripts/campaign/e8_lines.gd:147 data/voice/lines/e8m2.json:L28
msgid "Last stall before the end of the world! Again! I'm getting good at these."
msgstr "Dernier étal avant la fin du monde ! Encore ! Je deviens bon là-dedans."

#. [&"pell", "Genuine relic polish! For your keys! Four keys, four customers, I can't lose."],
#: scripts/campaign/e8_lines.gd:148 data/voice/lines/e8m2.json:L28b
msgid "Genuine relic polish! For your keys! Four keys, four customers, I can't lose."
msgstr "Du vrai poli à reliques ! Pour vos clés ! Quatre clés, quatre clients, je peux pas perdre."

#. [&"malrik", "Those are mine. Were mine. They followed the stone. They'll follow it into the ground."],
#: scripts/campaign/e8_lines.gd:149 data/voice/lines/e8m2.json:L29
msgid "Those are mine. Were mine. They followed the stone. They'll follow it into the ground."
msgstr "Ce sont les miens. C'étaient les miens. Ils ont suivi la pierre. Ils la suivront sous terre."

#. [&"vey", "Renegades on the Shadow side! Whoever's nearest, lend the Bishop a blade."],
#: scripts/campaign/e8_lines.gd:150 data/voice/lines/e8m2.json:L30
msgid "Renegades on the Shadow side! Whoever's nearest, lend the Bishop a blade."
msgstr "Des renégats du côté de l'Ombre ! Le plus proche, prête une lame à l'Évêque."

#. [&"obren", "Too slow, all of you. I'm already climbing."],
#: scripts/campaign/e8_lines.gd:151 data/voice/lines/e8m2.json:L31
msgid "Too slow, all of you. I'm already climbing."
msgstr "Trop lents, vous tous. Je grimpe déjà."

#. [&"vey", "One gate less. Build something on the rubble. He'd hate that."],
#: scripts/campaign/e8_lines.gd:152 data/voice/lines/e8m2.json:L32
msgid "One gate less. Build something on the rubble. He'd hate that."
msgstr "Une porte de moins. Bâtis quelque chose sur les gravats. Il détesterait ça."

#. [&"narrator", "Four keyholes, four colours, one ring of light around the isle."],
#: scripts/campaign/e8_lines.gd:153 data/voice/lines/e8m2.json:L33
msgid "Four keyholes, four colours, one ring of light around the isle."
msgstr "Quatre serrures, quatre couleurs, un anneau de lumière autour de l'île."

#. [&"master", "Now. All four of you. Turn them, and do not let go."],
#: scripts/campaign/e8_lines.gd:154 data/voice/lines/e8m2.json:L34
msgid "Now. All four of you. Turn them, and do not let go."
msgstr "Maintenant. Tous les quatre. Tournez-les, et ne lâchez pas."

#. [&"vessa", "Master?! That's... that's him! Turn them!"],
#: scripts/campaign/e8_lines.gd:155 data/voice/lines/e8m2.json:L35
msgid "Master?! That's... that's him! Turn them!"
msgstr "Maître ?! C'est... c'est lui ! Tournez-les !"

#. [&"malrik", "Of course he waits until the last minute to speak. Family trait."],
#: scripts/campaign/e8_lines.gd:156 data/voice/lines/e8m2.json:L36
msgid "Of course he waits until the last minute to speak. Family trait."
msgstr "Évidemment, il attend la dernière minute pour parler. Un trait de famille."

#. [&"obren", "You opened my door with your own hands. Thank you. Now I come up."],
#: scripts/campaign/e8_lines.gd:157 data/voice/lines/e8m2.json:L37
msgid "You opened my door with your own hands. Thank you. Now I come up."
msgstr "Vous avez ouvert ma porte de vos propres mains. Merci. Maintenant, je monte."

#. [&"torvald", "Then let him come. We are four. We hold."],
#: scripts/campaign/e8_lines.gd:158 data/voice/lines/e8m2.json:L38
msgid "Then let him come. We are four. We hold."
msgstr "Alors qu'il vienne. Nous sommes quatre. Nous tenons."

#. [&"vey", "Your keep's burning! Pull back and hold it, then go again."],
#: scripts/campaign/e8_lines.gd:159 data/voice/lines/e8m2.json:L40
msgid "Your keep's burning! Pull back and hold it, then go again."
msgstr "Ton donjon brûle ! Replie-toi pour le tenir, puis repars."

#. [&"vessa", "My key's in. I waited for it, too. Who's next?"],
#: scripts/campaign/e8_lines.gd:160 data/voice/lines/e8m2.json:L9_vessa
msgid "My key's in. I waited for it, too. Who's next?"
msgstr "Ma clé est en place. J'ai attendu pour elle aussi. À qui le tour ?"

#. [&"malrik", "The stone is in its lock. Not in my hand. Who's next?"],
#: scripts/campaign/e8_lines.gd:161 data/voice/lines/e8m2.json:L9_malrik
msgid "The stone is in its lock. Not in my hand. Who's next?"
msgstr "La pierre est dans sa serrure. Pas dans ma main. À qui le tour ?"

#. [&"torvald", "The orb is turned. Quickly. For me. Who's next?"],
#: scripts/campaign/e8_lines.gd:162 data/voice/lines/e8m2.json:L9_torvald
msgid "The orb is turned. Quickly. For me. Who's next?"
msgstr "L'orbe est tourné. Vite. Pour moi. À qui le tour ?"

#. [&"ysolde", "The Signet is home. I'm still out here. Who's next?"],
#: scripts/campaign/e8_lines.gd:163 data/voice/lines/e8m2.json:L9_ysolde
msgid "The Signet is home. I'm still out here. Who's next?"
msgstr "Le Signet est chez lui. Moi, je suis encore dehors. À qui le tour ?"

#. [&"ysolde", "Together."],
#: scripts/campaign/e8_lines.gd:164 data/voice/lines/e8m2.json:L38b
#: data/voice/lines/ep8_ending_a.json:L3
msgid "Together."
msgstr "Ensemble."

#. [&"vessa", "Not now... not when we're finally together..."],
#: scripts/campaign/e8_lines.gd:165 data/voice/lines/e8m2.json:L39_vessa
msgid "Not now... not when we're finally together..."
msgstr "Pas maintenant... pas quand on est enfin ensemble..."

#. [&"malrik", "Of course. Just as it got interesting."],
#: scripts/campaign/e8_lines.gd:166 data/voice/lines/e8m2.json:L39_malrik
msgid "Of course. Just as it got interesting."
msgstr "Évidemment. Juste quand ça devenait intéressant."

#. [&"torvald", "Too late... again..."],
#: scripts/campaign/e8_lines.gd:167 data/voice/lines/e8m2.json:L39_torvald
msgid "Too late... again..."
msgstr "Trop tard... encore..."

#. [&"ysolde", "I came out... for this..."],
#: scripts/campaign/e8_lines.gd:168 data/voice/lines/e8m2.json:L39_ysolde
msgid "I came out... for this..."
msgstr "Je suis sortie... pour ça..."

#. [&"narrator", "The last thing Obren ever built climbed out of the dark, and it was wearing his throne."],
#: scripts/campaign/e8_lines.gd:171 data/voice/lines/e8m3.json:L1
msgid "The last thing Obren ever built climbed out of the dark, and it was wearing his throne."
msgstr "La dernière chose qu'Obren ait bâtie est sortie du noir, et elle portait son trône."

#. [&"obren", "A thousand years he held it. A hundred I lay under it. Now I hold everything."],
#: scripts/campaign/e8_lines.gd:172 data/voice/lines/e8m3.json:L2
msgid "A thousand years he held it. A hundred I lay under it. Now I hold everything."
msgstr "Mille ans, il l'a tenu. Cent ans, j'ai gisé dessous. Maintenant, c'est moi qui tiens tout."

#. [&"vey", "Chains on every limb. The keys are holding him. Keep the keys standing, and he stays bound."],
#: scripts/campaign/e8_lines.gd:173 data/voice/lines/e8m3.json:L3
msgid "Chains on every limb. The keys are holding him. Keep the keys standing, and he stays bound."
msgstr "Des chaînes à chaque membre. Les clés le retiennent. Gardez les clés debout, et il reste lié."

#. [&"vessa", "So we hit him when the chains pull. And we don't let go. I can do that. Probably."],
#: scripts/campaign/e8_lines.gd:174 data/voice/lines/e8m3.json:L4
msgid "So we hit him when the chains pull. And we don't let go. I can do that. Probably."
msgstr "Alors on le frappe quand les chaînes tirent. Et on ne lâche pas. Je peux faire ça. Probablement."

#. [&"torvald", "Hold the line. Ice knows how. The rest of you, copy me."],
#: scripts/campaign/e8_lines.gd:175 data/voice/lines/e8m3.json:L5
msgid "Hold the line. Ice knows how. The rest of you, copy me."
msgstr "Tenez la ligne. La Glace sait faire. Vous autres, imitez-moi."

#. [&"malrik", "Four people who hate each other, holding one rope. What could possibly go wrong."],
#: scripts/campaign/e8_lines.gd:176 data/voice/lines/e8m3.json:L6
msgid "Four people who hate each other, holding one rope. What could possibly go wrong."
msgstr "Quatre personnes qui se détestent, accrochées à une seule corde. Qu'est-ce qui pourrait bien mal tourner."

#. [&"ysolde", "They're coming up the ramps. Every keyhole, every side. Hold yours!"],
#: scripts/campaign/e8_lines.gd:177 data/voice/lines/e8m3.json:L7
msgid "They're coming up the ramps. Every keyhole, every side. Hold yours!"
msgstr "Ils montent par les rampes. Chaque serrure, chaque côté. Tenez la vôtre !"

#. [&"obren", "Pull, little keys. Pull all you like. Chains are stone, and stone is mine."],
#: scripts/campaign/e8_lines.gd:178 data/voice/lines/e8m3.json:L8
msgid "Pull, little keys. Pull all you like. Chains are stone, and stone is mine."
msgstr "Tirez, petites clés. Tirez tant que vous voulez. Les chaînes sont de pierre, et la pierre est à moi."

#. [&"vey", "Watch the chains! When all four pull, he's bound. That's your window."],
#: scripts/campaign/e8_lines.gd:179 data/voice/lines/e8m3.json:L9
msgid "Watch the chains! When all four pull, he's bound. That's your window."
msgstr "Surveillez les chaînes ! Quand les quatre tirent, il est lié. C'est votre moment."

#. [&"obren", "One chain gone. One limb free. Feel how much stronger I am already?"],
#: scripts/campaign/e8_lines.gd:180 data/voice/lines/e8m3.json:L12
msgid "One chain gone. One limb free. Feel how much stronger I am already?"
msgstr "Une chaîne de moins. Un membre libre. Vous sentez comme je suis déjà plus fort ?"

#. [&"malrik", "More of mine, wearing amber. I'm running out of ways to say I'm sorry about them."],
#: scripts/campaign/e8_lines.gd:181 data/voice/lines/e8m3.json:L14
msgid "More of mine, wearing amber. I'm running out of ways to say I'm sorry about them."
msgstr "D'autres des miens, vêtus d'ambre. Je manque de façons de dire que je suis désolé pour eux."

#. [&"obren", "Enough of your little ring. I will walk to the weakest of you and sit on it."],
#: scripts/campaign/e8_lines.gd:182 data/voice/lines/e8m3.json:L15
msgid "Enough of your little ring. I will walk to the weakest of you and sit on it."
msgstr "Assez de votre petit cercle. Je vais marcher jusqu'au plus faible d'entre vous et m'asseoir dessus."

#. [&"vey", "He's out! Don't feed him: whatever dies near him, he eats. Fight from range!"],
#: scripts/campaign/e8_lines.gd:183 data/voice/lines/e8m3.json:L16
msgid "He's out! Don't feed him: whatever dies near him, he eats. Fight from range!"
msgstr "Il est sorti ! Ne le nourrissez pas : ce qui meurt près de lui, il le mange. Battez-vous à distance !"

#. [&"aldra", "His leg is cracking! The glass sees it. Again, there!"],
#: scripts/campaign/e8_lines.gd:184 data/voice/lines/e8m3.json:L17
msgid "His leg is cracking! The glass sees it. Again, there!"
msgstr "Sa jambe se fend ! Le verre le voit. Encore, là !"

#. [&"maelis", "The chains! They're dragging him back! The keys remember who they belong to!"],
#: scripts/campaign/e8_lines.gd:185 data/voice/lines/e8m3.json:L18
msgid "The chains! They're dragging him back! The keys remember who they belong to!"
msgstr "Les chaînes ! Elles le ramènent ! Les clés se souviennent à qui elles appartiennent !"

#. [&"master", "Hold him there. I am almost with you."],
#: scripts/campaign/e8_lines.gd:186 data/voice/lines/e8m3.json:L19
msgid "Hold him there. I am almost with you."
msgstr "Retenez-le là. Je suis presque avec vous."

#. [&"hush", "I said you'd want me back, Bishop. The dark got very loud."],
#: scripts/campaign/e8_lines.gd:187 data/voice/lines/e8m3.json:L20
msgid "I said you'd want me back, Bishop. The dark got very loud."
msgstr "Je t'avais dit que tu voudrais me revoir, Évêque. Le noir est devenu très bruyant."

#. [&"malrik", "It did. Take my keyhole's left side. And Hush... thank you."],
#: scripts/campaign/e8_lines.gd:188 data/voice/lines/e8m3.json:L21
msgid "It did. Take my keyhole's left side. And Hush... thank you."
msgstr "C'est vrai. Prends le côté gauche de ma serrure. Et Hush... merci."

#. [&"master", "Again. All four. I am right beneath you."],
#: scripts/campaign/e8_lines.gd:189 data/voice/lines/e8m3.json:L22
msgid "Again. All four. I am right beneath you."
msgstr "Encore. Tous les quatre. Je suis juste sous vos pieds."

#. [&"obren", "His light? HIS? Through MY throne? You'll break it! You'll break everything!"],
#: scripts/campaign/e8_lines.gd:190 data/voice/lines/e8m3.json:L23
msgid "His light? HIS? Through MY throne? You'll break it! You'll break everything!"
msgstr "Sa lumière ? LA SIENNE ? À travers MON trône ? Vous allez le briser ! Vous allez tout briser !"

#. [&"torvald", "Some things should break. Once. Properly."],
#: scripts/campaign/e8_lines.gd:191 data/voice/lines/e8m3.json:L24
msgid "Some things should break. Once. Properly."
msgstr "Certaines choses doivent se briser. Une fois. Comme il faut."

#. [&"master", "One more turn, my four. Then I will come up, and we will talk."],
#: scripts/campaign/e8_lines.gd:192 data/voice/lines/e8m3.json:L25
msgid "One more turn, my four. Then I will come up, and we will talk."
msgstr "Encore un tour, mes quatre. Puis je remonterai, et nous parlerons."

#. [&"vey", "Keep your helpers close! If one of them's away, the pulse breaks the turn!"],
#: scripts/campaign/e8_lines.gd:193 data/voice/lines/e8m3.json:L26
msgid "Keep your helpers close! If one of them's away, the pulse breaks the turn!"
msgstr "Gardez vos assistants près de vous ! S'il en manque un, la pulsation brise le tour !"

#. [&"vey", "Your helper's down! Bring them back, or time the turn right after the pulse!"],
#: scripts/campaign/e8_lines.gd:194 data/voice/lines/e8m3.json:L27
msgid "Your helper's down! Bring them back, or time the turn right after the pulse!"
msgstr "Ton assistant est tombé ! Ranime-le, ou lance le tour juste après la pulsation !"

#. [&"obren", "Two chains, two limbs. I'm free. I was always going to be free."],
#: scripts/campaign/e8_lines.gd:195 data/voice/lines/e8m3.json:L29
msgid "Two chains, two limbs. I'm free. I was always going to be free."
msgstr "Deux chaînes, deux membres. Je suis libre. J'allais forcément être libre."

#. [&"vey", "He's coming for YOUR keep! Pull back and meet him at the walls!"],
#: scripts/campaign/e8_lines.gd:196 data/voice/lines/e8m3.json:L30
msgid "He's coming for YOUR keep! Pull back and meet him at the walls!"
msgstr "Il vient pour TON donjon ! Replie-toi et attends-le aux murailles !"

#. [&"ysolde", "He's bending! Everyone, everything you have!"],
#: scripts/campaign/e8_lines.gd:197 data/voice/lines/e8m3.json:L31
msgid "He's bending! Everyone, everything you have!"
msgstr "Il plie ! Tout le monde, tout ce que vous avez !"

#. [&"obren", "You fed me, Bishop. Every time you used me, I grew. Thank you."],
#: scripts/campaign/e8_lines.gd:198 data/voice/lines/e8m3.json:L32
msgid "You fed me, Bishop. Every time you used me, I grew. Thank you."
msgstr "Tu m'as nourri, Évêque. Chaque fois que tu t'es servi de moi, j'ai grandi. Merci."

#. [&"vessa", "NOW! Hit him while he's tied!"],
#: scripts/campaign/e8_lines.gd:199 data/voice/lines/e8m3.json:L10_vessa
msgid "NOW! Hit him while he's tied!"
msgstr "MAINTENANT ! Frappez-le pendant qu'il est attaché !"

#. [&"malrik", "There. Bound. Make it count."],
#: scripts/campaign/e8_lines.gd:200 data/voice/lines/e8m3.json:L10_malrik
msgid "There. Bound. Make it count."
msgstr "Voilà. Lié. Que ça compte."

#. [&"torvald", "He is held. Strike, all of you."],
#: scripts/campaign/e8_lines.gd:201 data/voice/lines/e8m3.json:L10_torvald
msgid "He is held. Strike, all of you."
msgstr "Il est retenu. Frappez, vous tous."

#. [&"ysolde", "The roots have him! Now!"],
#: scripts/campaign/e8_lines.gd:202 data/voice/lines/e8m3.json:L10_ysolde
msgid "The roots have him! Now!"
msgstr "Les racines le tiennent ! Maintenant !"

#. [&"vey", "A keyhole's below half! The chains won't pull until it's healed!"],
#: scripts/campaign/e8_lines.gd:203 data/voice/lines/e8m3.json:L11_vey
msgid "A keyhole's below half! The chains won't pull until it's healed!"
msgstr "Une serrure est sous la moitié ! Les chaînes ne tireront pas avant qu'elle soit soignée !"

#. [&"vessa", "My keyhole's cracking! No surge till you help!"],
#: scripts/campaign/e8_lines.gd:204 data/voice/lines/e8m3.json:L11_vessa
msgid "My keyhole's cracking! No surge till you help!"
msgstr "Ma serrure craque ! Les chaînes tireront pas tant que tu m'aides pas !"

#. [&"malrik", "My lock is wobbling. Assistance would be... efficient."],
#: scripts/campaign/e8_lines.gd:205 data/voice/lines/e8m3.json:L11_malrik
msgid "My lock is wobbling. Assistance would be... efficient."
msgstr "Ma serrure vacille. Un peu d'aide serait... efficace."

#. [&"torvald", "My ward is failing. Help me hold it."],
#: scripts/campaign/e8_lines.gd:206 data/voice/lines/e8m3.json:L11_torvald
msgid "My ward is failing. Help me hold it."
msgstr "Ma garde faiblit. Aide-moi à la tenir."

#. [&"ysolde", "My keyhole's bleeding sap! Please!"],
#: scripts/campaign/e8_lines.gd:207 data/voice/lines/e8m3.json:L11_ysolde
msgid "My keyhole's bleeding sap! Please!"
msgstr "Ma serrure saigne de la sève ! S'il te plaît !"

#. [&"vessa", "Back on! Sorry, chain."],
#: scripts/campaign/e8_lines.gd:208 data/voice/lines/e8m3.json:L13_vessa
msgid "Back on! Sorry, chain."
msgstr "Rallumée ! Désolée, la chaîne."

#. [&"malrik", "Relit. Nobody saw that."],
#: scripts/campaign/e8_lines.gd:209 data/voice/lines/e8m3.json:L13_malrik
msgid "Relit. Nobody saw that."
msgstr "Rallumée. Personne n'a rien vu."

#. [&"torvald", "Mended. Slowly. But mended."],
#: scripts/campaign/e8_lines.gd:210 data/voice/lines/e8m3.json:L13_torvald
msgid "Mended. Slowly. But mended."
msgstr "Réparée. Lentement. Mais réparée."

#. [&"ysolde", "It grew back. They always do."],
#: scripts/campaign/e8_lines.gd:211 data/voice/lines/e8m3.json:L13_ysolde
msgid "It grew back. They always do."
msgstr "Elle a repoussé. Elles repoussent toujours."

#. [&"vessa", "Hold... hold it... without me..."],
#: scripts/campaign/e8_lines.gd:212 data/voice/lines/e8m3.json:L28_vessa
msgid "Hold... hold it... without me..."
msgstr "Tenez... tenez-le... sans moi..."

#. [&"malrik", "Carry the stone... somebody..."],
#: scripts/campaign/e8_lines.gd:213 data/voice/lines/e8m3.json:L28_malrik
msgid "Carry the stone... somebody..."
msgstr "Portez la pierre... quelqu'un..."

#. [&"torvald", "Too slow... at the end..."],
#: scripts/campaign/e8_lines.gd:214 data/voice/lines/e8m3.json:L28_torvald
msgid "Too slow... at the end..."
msgstr "Trop lent... à la fin..."

#. [&"ysolde", "It grows back... it has to..."],
#: scripts/campaign/e8_lines.gd:215 data/voice/lines/e8m3.json:L28_ysolde
msgid "It grows back... it has to..."
msgstr "Ça repousse... il le faut..."

