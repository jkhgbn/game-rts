#: scripts/campaign/mission_e4_02.gd:681
msgid "Next convoy at {time} (ring the Lantern to send it now)"
msgstr "Prochain convoi à {time} (sonnez la Lanterne pour l'envoyer tout de suite)"

#. "detail": "%s · %s" % [Loc.t("{arrived} arrived · {lost} lost · {road} on the road",
#: scripts/campaign/mission_e4_02.gd:684
msgid "{arrived} arrived · {lost} lost · {road} on the road"
msgstr "{arrived} arrivés · {lost} perdus · {road} sur la route"

#. const MISSION_TITLE := "The Green Road"
#: scripts/campaign/mission_e4_02.gd:28
msgid "The Green Road"
msgstr "La Route verte"

#. [&"narrator", "The morning after Lark Hill. The wagons burned in the night. The people will have to walk."],
#: scripts/campaign/mission_e4_02.gd:127 data/voice/lines/e4m2.json:L1
msgid "The morning after Lark Hill. The wagons burned in the night. The people will have to walk."
msgstr "Le lendemain de Lark Hill. Les chariots ont brûlé dans la nuit. Les gens devront marcher."

#. [&"ysolde", "One road, the Fire border at the end of it, and everyone we kept alive. We walk them there."],
#: scripts/campaign/mission_e4_02.gd:128 data/voice/lines/e4m2.json:L2
msgid "One road, the Fire border at the end of it, and everyone we kept alive. We walk them there."
msgstr "Une route, la frontière du Feu au bout, et tous ceux qu'on a gardés en vie. On les mène là-bas."

#. [&"maelis", "The western woods are old and full of ears. Some of those ears are Malrik's."],
#: scripts/campaign/mission_e4_02.gd:129 data/voice/lines/e4m2.json:L3
msgid "The western woods are old and full of ears. Some of those ears are Malrik's."
msgstr "Les bois de l'ouest sont vieux et pleins d'oreilles. Certaines de ces oreilles sont à Malrik."

#. [&"messenger", "The first ones are... they're ready, my lady. Ring the lantern and... they'll go."],
#: scripts/campaign/mission_e4_02.gd:130 data/voice/lines/e4m2.json:L4
msgid "The first ones are... they're ready, my lady. Ring the lantern and... they'll go."
msgstr "Les premiers sont prêts, ma dame. Sonnez la lanterne et ils partiront."

#. [&"maelis", "I'll run ahead and smell the road. Call me when your tree grows tall enough to shout."],
#: scripts/campaign/mission_e4_02.gd:131 data/voice/lines/e4m2.json:L5
msgid "I'll run ahead and smell the road. Call me when your tree grows tall enough to shout."
msgstr "Je pars devant flairer la route. Appelle-moi quand ton arbre sera assez grand pour crier."

#. [&"ysolde", "Don't fight them all on your own. Leave me a few."],
#: scripts/campaign/mission_e4_02.gd:132 data/voice/lines/e4m2.json:L6
msgid "Don't fight them all on your own. Leave me a few."
msgstr "Ne les combats pas tous toute seule. Laisse-m'en quelques-uns."

#. [&"ysolde", "Torvald froze the brook. The old folk will slip, and his archers know it."],
#: scripts/campaign/mission_e4_02.gd:133 data/voice/lines/e4m2.json:L7
msgid "Torvald froze the brook. The old folk will slip, and his archers know it."
msgstr "Torvald a gelé le ruisseau. Les vieux vont glisser, et ses archers le savent."

#. [&"ysolde", "Stay on the road. If anything moves in the trees, stop, and let the thorns go first."],
#: scripts/campaign/mission_e4_02.gd:134 data/voice/lines/e4m2.json:L8
msgid "Stay on the road. If anything moves in the trees, stop, and let the thorns go first."
msgstr "Restez sur la route. Si ça bouge dans les arbres, arrêtez-vous et laissez les épines passer d'abord."

#. [&"ysolde", "Knives in the oak! Down, everyone down! Thornlings, into the ferns!"],
#: scripts/campaign/mission_e4_02.gd:135 data/voice/lines/e4m2.json:L10
msgid "Knives in the oak! Down, everyone down! Thornlings, into the ferns!"
msgstr "Des couteaux dans le chêne ! À terre, tout le monde ! Thornlings, dans les fougères !"

#. [&"hush", "Little lambs on a little road. The Bishop sends his regards."],
#: scripts/campaign/mission_e4_02.gd:136 data/voice/lines/e4m2.json:L11
msgid "Little lambs on a little road. The Bishop sends his regards."
msgstr "Petits agneaux sur une petite route. L'Évêque vous salue."

#. [&"ysolde", "You burned their wagons. You don't get their children."],
#: scripts/campaign/mission_e4_02.gd:137 data/voice/lines/e4m2.json:L12
msgid "You burned their wagons. You don't get their children."
msgstr "Tu as brûlé leurs chariots. Tu n'auras pas leurs enfants."

#. [&"ysolde", "Maelis! The Heartwood stands tall enough. Come home."],
#: scripts/campaign/mission_e4_02.gd:138 data/voice/lines/e4m2.json:L13
msgid "Maelis! The Heartwood stands tall enough. Come home."
msgstr "Maelis ! Le Heartwood est assez grand. Reviens à la maison."

#. [&"maelis", "I went to see the brook. It is cold, it is guarded, and it is very rude."],
#: scripts/campaign/mission_e4_02.gd:139 data/voice/lines/e4m2.json:L14
msgid "I went to see the brook. It is cold, it is guarded, and it is very rude."
msgstr "Je suis allée voir le ruisseau. Il est froid, il est gardé, et il est très impoli."

#. [&"ashby", "Nature folk at the gate! Open up, lads. Blankets, bread, and no questions."],
#: scripts/campaign/mission_e4_02.gd:140 data/voice/lines/e4m2.json:L15
msgid "Nature folk at the gate! Open up, lads. Blankets, bread, and no questions."
msgstr "Des gens de la Nature à la porte ! Ouvrez, les gars. Couvertures, pain, et pas de questions."

#. [&"hush", "Another night, then. There is always another night."],
#: scripts/campaign/mission_e4_02.gd:141 data/voice/lines/e4m2.json:L16
msgid "Another night, then. There is always another night."
msgstr "Une autre nuit, alors. Il y a toujours une autre nuit."

#. [&"ysolde", "They're through. Ring it again, Wren."],
#: scripts/campaign/mission_e4_02.gd:142 data/voice/lines/e4m2.json:L17
msgid "They're through. Ring it again, Wren."
msgstr "Ils sont passés. Sonne-la encore, Wren."

#. [&"ysolde", "No... Keep moving. We grieve at the border. Not here."],
#: scripts/campaign/mission_e4_02.gd:143 data/voice/lines/e4m2.json:L18
msgid "No... Keep moving. We grieve at the border. Not here."
msgstr "Non... Continuez d'avancer. On pleurera à la frontière. Pas ici."

#. [&"maelis", "Listen. The brook's talking again. It says thank you, roughly."],
#: scripts/campaign/mission_e4_02.gd:144 data/voice/lines/e4m2.json:L19
msgid "Listen. The brook's talking again. It says thank you, roughly."
msgstr "Écoutez. Le ruisseau parle de nouveau. Il dit merci, à sa façon."

#. [&"maelis", "Their nest is ash. Malrik will need new hunters, and new excuses."],
#: scripts/campaign/mission_e4_02.gd:145 data/voice/lines/e4m2.json:L20
msgid "Their nest is ash. Malrik will need new hunters, and new excuses."
msgstr "Leur nid est en cendres. Malrik va avoir besoin de nouveaux chasseurs, et de nouvelles excuses."

#. [&"hush", "The knife never misses, Ysolde. It only waits for the right neck."],
#: scripts/campaign/mission_e4_02.gd:146 data/voice/lines/e4m2.json:L21
msgid "The knife never misses, Ysolde. It only waits for the right neck."
msgstr "Le couteau ne manque jamais, Ysolde. Il attend seulement le bon cou."

#. [&"ysolde", "Then it can wait forever. Maelis, stay with the people."],
#: scripts/campaign/mission_e4_02.gd:147 data/voice/lines/e4m2.json:L22
msgid "Then it can wait forever. Maelis, stay with the people."
msgstr "Alors il peut attendre toujours. Maelis, reste avec les gens."

#. [&"maelis", "Make way for the old herd!"],
#: scripts/campaign/mission_e4_02.gd:148 data/voice/lines/e4m2.json:L23
msgid "Make way for the old herd!"
msgstr "Place au vieux troupeau !"

#. [&"narrator", "The last of them leave Larkrest. Behind them, the green road goes quiet."],
#: scripts/campaign/mission_e4_02.gd:149 data/voice/lines/e4m2.json:L24
msgid "The last of them leave Larkrest. Behind them, the green road goes quiet."
msgstr "Les derniers quittent Larkrest. Derrière eux, la route verte se tait."

#. [&"maelis", "Everything they have left is coming. Good. It means we're nearly there."],
#: scripts/campaign/mission_e4_02.gd:150 data/voice/lines/e4m2.json:L25
msgid "Everything they have left is coming. Good. It means we're nearly there."
msgstr "Tout ce qui leur reste arrive. Tant mieux. Ça veut dire qu'on y est presque."

#. [&"ashby", "That's the lot, my lady. The border's yours whenever you want it. The queen said so."],
#: scripts/campaign/mission_e4_02.gd:151 data/voice/lines/e4m2.json:L26
msgid "That's the lot, my lady. The border's yours whenever you want it. The queen said so."
msgstr "C'est tout le monde, ma dame. La frontière est à vous quand vous voulez. La reine l'a dit."

#. [&"ysolde", "Thank her for me. And tell her I'm not staying."],
#: scripts/campaign/mission_e4_02.gd:152 data/voice/lines/e4m2.json:L27
msgid "Thank her for me. And tell her I'm not staying."
msgstr "Remerciez-la pour moi. Et dites-lui que je ne reste pas."

#. [&"maelis", "The Sighing Wood, then? Burnt, frozen, and still ours."],
#: scripts/campaign/mission_e4_02.gd:153 data/voice/lines/e4m2.json:L28
msgid "The Sighing Wood, then? Burnt, frozen, and still ours."
msgstr "La Sighing Wood, alors ? Brûlée, gelée, et toujours à nous."

#. [&"ysolde", "A seed doesn't wait for the war to end, Maelis. Neither do I."],
#: scripts/campaign/mission_e4_02.gd:154 data/voice/lines/e4m2.json:L29
msgid "A seed doesn't wait for the war to end, Maelis. Neither do I."
msgstr "Une graine n'attend pas la fin de la guerre, Maelis. Moi non plus."

#. [&"ysolde", "Keep... walking..."],
#: scripts/campaign/mission_e4_02.gd:155 data/voice/lines/e4m2.json:L30
msgid "Keep... walking..."
msgstr "Continuez... de marcher..."

#. [&"messenger", "We... we lost too many on the road. My lady, we can't... we can't go on."],
#: scripts/campaign/mission_e4_02.gd:156 data/voice/lines/e4m2.json:L31
msgid "We... we lost too many on the road. My lady, we can't... we can't go on."
msgstr "On a perdu trop de monde sur la route. Ma dame, on ne peut pas continuer."

#. [&"maelis", "Larkrest is burning. There's nothing left to walk away from."],
#: scripts/campaign/mission_e4_02.gd:157 data/voice/lines/e4m2.json:L32
msgid "Larkrest is burning. There's nothing left to walk away from."
msgstr "Larkrest brûle. Il ne reste plus rien à quitter."

#. [&"hush", "The slow ones at the back, my knives. Always the slow ones."],
#: scripts/campaign/mission_e4_02.gd:158
msgid "The slow ones at the back, my knives. Always the slow ones."
msgstr "Les lents, à l'arrière, mes couteaux. Toujours les lents."

#. "Lark Hill held. The ford did not. By morning the people under the golden tree have nothing left in the valley
#: scripts/campaign/mission_e4_02.gd:161
msgid "Lark Hill held. The ford did not. By morning the people under the golden tree have nothing left in the valley but their names, and the supply wagons burned in the night."
msgstr "Lark Hill a tenu. Le gué, non. Au matin, les gens sous l'arbre doré n'ont plus rien dans la vallée à part leur nom, et les chariots de vivres ont brûlé dans la nuit."

#. "West of Evenmead the old woods run all the way to the Fire border. Vessa's fort, Cinderwatch, has opened its
#: scripts/campaign/mission_e4_02.gd:162
msgid "West of Evenmead the old woods run all the way to the Fire border. Vessa's fort, Cinderwatch, has opened its gate. Between here and there is one road, and Malrik's hunters know it as well as Ysolde does."
msgstr "À l'ouest d'Evenmead, les vieux bois s'étendent jusqu'à la frontière du Feu. Le fort de Vessa, Cinderwatch, a ouvert sa porte. Entre ici et là-bas, il n'y a qu'une route, et les chasseurs de Malrik la connaissent aussi bien qu'Ysolde."

#. "Walk them home, a lantern at a time. Somewhere in the trees, Mother Hush is counting.",
#: scripts/campaign/mission_e4_02.gd:163
msgid "Walk them home, a lantern at a time. Somewhere in the trees, Mother Hush is counting."
msgstr "Ramenez-les chez eux, une lanterne à la fois. Quelque part dans les arbres, Mère Hush compte."

#. const BRIEFING_LINE := "The villagers stop when the enemy is near them. Clear the road ahead, and they walk on
#: scripts/campaign/mission_e4_02.gd:165
msgid "The villagers stop when the enemy is near them. Clear the road ahead, and they walk on."
msgstr "Les villageois s'arrêtent quand l'ennemi est proche. Dégagez la route devant eux, et ils repartent."

#. const HINT_START := "The people walk the road on their own and stop when the enemy is near. Clear the road ahe
#: scripts/campaign/mission_e4_02.gd:166
msgid "The people walk the road on their own and stop when the enemy is near. Clear the road ahead of them. Ring the Lantern to send a convoy early."
msgstr "Les gens suivent la route seuls et s'arrêtent quand l'ennemi est proche. Dégagez la route devant eux. Sonnez la Lanterne pour envoyer un convoi plus tôt."

#. const HINT_SAGE := "Bramblesage: Snagroot pulls a hunter out of the trees. Pollen Haze silences archers across
#: scripts/campaign/mission_e4_02.gd:167
msgid "Bramblesage: Snagroot pulls a hunter out of the trees. Pollen Haze silences archers across the brook."
msgstr "Bramblesage : Snagroot tire un chasseur hors des arbres. Pollen Haze fait taire les archers de l'autre côté du ruisseau."

#. const HINT_CITADEL := "Your Stronghold can become a Citadel: select the Heartwood and press X (300 crystals, 9
#: scripts/campaign/mission_e4_02.gd:168
msgid "Your Stronghold can become a Citadel: select the Heartwood and press X (300 crystals, 90 s). It opens the Briar Roc (C) and lets you call Maelis (V)."
msgstr "Votre Forteresse peut devenir une Citadelle : sélectionnez le Heartwood et appuyez sur X (300 cristaux, 90 s). Elle ouvre le Briar Roc (C) et vous permet d'appeler Maelis (V)."

#. const HINT_CALL := "Call Maelis: select the Heartwood and press V. She fights on her own; her card sets where
#: scripts/campaign/mission_e4_02.gd:169
msgid "Call Maelis: select the Heartwood and press V. She fights on her own; her card sets where (Escort / Vanguard / Hold home)."
msgstr "Appeler Maelis : sélectionnez le Heartwood et appuyez sur V. Elle se bat seule ; sa carte choisit où (Escorte / Avant-garde / Garder la base)."

#. const MSG_RING_REFUSED := "The road isn't clear of the last convoy yet"
#: scripts/campaign/mission_e4_02.gd:170
msgid "The road isn't clear of the last convoy yet"
msgstr "La route n'est pas encore libérée du dernier convoi"

#. const MSG_CONVOY := "Convoy {n} sets out"
#: scripts/campaign/mission_e4_02.gd:171
msgid "Convoy {n} sets out"
msgstr "Le convoi {n} se met en route"

#. const MSG_KNIVES := "Hush's knives at the brook crossing! They are going for the stragglers of convoy {n}"
#: scripts/campaign/mission_e4_02.gd:172
msgid "Hush's knives at the brook crossing! They are going for the stragglers of convoy {n}"
msgstr "Les couteaux de Hush au gué du ruisseau ! Ils visent les traînards du convoi {n}"

#. c.keep_lost_message = "Larkrest has fallen"
#: scripts/campaign/mission_e4_02.gd:243
msgid "Larkrest has fallen"
msgstr "Larkrest est tombé"

#. c.victory_banner = "VICTORY\nThe people are across the border"
#: scripts/campaign/mission_e4_02.gd:260
msgid "VICTORY\nThe people are across the border"
msgstr "VICTOIRE\nLes gens ont passé la frontière"

#. c.spotlight = {"id": &"helper_maelis", "trigger": &"manual", "key_hint": "Heartwood: V",
#: scripts/campaign/mission_e4_02.gd:263
msgid "Heartwood: V"
msgstr "Heartwood : V"

