#. const MISSION_TITLE := "A Hundred Winters"
#: scripts/campaign/mission_e6_01.gd:28
msgid "A Hundred Winters"
msgstr "Cent hivers"

#. [&"narrator", "A hundred winters ago, the lake had no name, and the north had one keeper."],
#: scripts/campaign/mission_e6_01.gd:109 data/voice/lines/e6m1.json:L1
msgid "A hundred winters ago, the lake had no name, and the north had one keeper."
msgstr "Il y a cent hivers, le lac n'avait pas de nom, et le nord n'avait qu'un seul gardien."

#. [&"master", "Keep this cold, Torvald. Keep it until I come back for it."],
#: scripts/campaign/mission_e6_01.gd:110 data/voice/lines/e6m1.json:L2
msgid "Keep this cold, Torvald. Keep it until I come back for it."
msgstr "Garde ça au froid, Torvald. Garde-le jusqu'à ce que je revienne le chercher."

#. [&"torvald", "What is it?"],
#: scripts/campaign/mission_e6_01.gd:111 data/voice/lines/e6m1.json:L3
msgid "What is it?"
msgstr "Qu'est-ce que c'est ?"

#. [&"master", "A promise I made to a stone. Something will come for it. Every winter."],
#: scripts/campaign/mission_e6_01.gd:112 data/voice/lines/e6m1.json:L4
msgid "A promise I made to a stone. Something will come for it. Every winter."
msgstr "Une promesse faite à une pierre. Quelque chose viendra le chercher. Chaque hiver."

#. [&"aldra", "My lord? The ice is singing. Can you hear it?"],
#: scripts/campaign/mission_e6_01.gd:113 data/voice/lines/e6m1.json:L5
msgid "My lord? The ice is singing. Can you hear it?"
msgstr "Mon seigneur ? La glace chante. Vous l'entendez ?"

#. [&"torvald", "Go home, girl. Winter is coming, and it is bringing guests."],
#: scripts/campaign/mission_e6_01.gd:114 data/voice/lines/e6m1.json:L6
msgid "Go home, girl. Winter is coming, and it is bringing guests."
msgstr "Rentre chez toi, petite. L'hiver arrive, et il amène des invités."

#. [&"aldra", "This is my home. I'll stay, if it's all the same to you."],
#: scripts/campaign/mission_e6_01.gd:115 data/voice/lines/e6m1.json:L7
msgid "This is my home. I'll stay, if it's all the same to you."
msgstr "C'est ici, chez moi. Je reste, si ça ne vous dérange pas."

#. [&"narrator", "The first winter came down from the north, and it did not come alone."],
#: scripts/campaign/mission_e6_01.gd:116 data/voice/lines/e6m1.json:L8
msgid "The first winter came down from the north, and it did not come alone."
msgstr "Le premier hiver est descendu du nord, et il n'est pas venu seul."

#. [&"obren", "That is my key, frost-man. I made the lock. Give it back."],
#: scripts/campaign/mission_e6_01.gd:117 data/voice/lines/e6m1.json:L9
msgid "That is my key, frost-man. I made the lock. Give it back."
msgstr "C'est ma clé, homme de givre. C'est moi qui ai fait la serrure. Rends-la-moi."

#. [&"torvald", "A talking stone. Wonderful. I was hoping for a quiet century."],
#: scripts/campaign/mission_e6_01.gd:118 data/voice/lines/e6m1.json:L10
msgid "A talking stone. Wonderful. I was hoping for a quiet century."
msgstr "Une pierre qui parle. Merveilleux. J'espérais un siècle tranquille."

#. [&"torvald", "The ice holds for us, and not for them. Remember that, girl."],
#: scripts/campaign/mission_e6_01.gd:119 data/voice/lines/e6m1.json:L11
msgid "The ice holds for us, and not for them. Remember that, girl."
msgstr "La glace tient pour nous, pas pour eux. Souviens-t'en, petite."

#. [&"aldra", "Aldra. My name is Aldra. And I will remember."],
#: scripts/campaign/mission_e6_01.gd:120 data/voice/lines/e6m1.json:L12
msgid "Aldra. My name is Aldra. And I will remember."
msgstr "Aldra. Je m'appelle Aldra. Et je vais m'en souvenir."

#. [&"narrator", "Spring came late to the lake, and stayed only a little while."],
#: scripts/campaign/mission_e6_01.gd:121 data/voice/lines/e6m1.json:L13
msgid "Spring came late to the lake, and stayed only a little while."
msgstr "Le printemps est arrivé tard sur le lac, et il n'est pas resté longtemps."

#. [&"torvald", "You carved a giant out of my lake."],
#: scripts/campaign/mission_e6_01.gd:123 data/voice/lines/e6m1.json:L15
msgid "You carved a giant out of my lake."
msgstr "Tu as taillé un géant dans mon lac."

#. [&"aldra", "You weren't using it."],
#: scripts/campaign/mission_e6_01.gd:124 data/voice/lines/e6m1.json:L16
msgid "You weren't using it."
msgstr "Vous ne vous en serviez pas."

#. [&"obren", "Every winter, frost-man. I have nothing left but winters."],
#: scripts/campaign/mission_e6_01.gd:125 data/voice/lines/e6m1.json:L17
msgid "Every winter, frost-man. I have nothing left but winters."
msgstr "Chaque hiver, homme de givre. Il ne me reste rien d'autre que des hivers."

#. [&"torvald", "Bigger ones. Of course there are bigger ones."],
#: scripts/campaign/mission_e6_01.gd:126 data/voice/lines/e6m1.json:L18
msgid "Bigger ones. Of course there are bigger ones."
msgstr "Des plus gros. Évidemment qu'il y en a des plus gros."

#. [&"narrator", "The third winter was the longest. The Hollow sent everything it had left."],
#: scripts/campaign/mission_e6_01.gd:127 data/voice/lines/e6m1.json:L19
msgid "The third winter was the longest. The Hollow sent everything it had left."
msgstr "Le troisième hiver a été le plus long. Le Hollow a envoyé tout ce qui lui restait."

#. [&"obren", "Step aside, little king of snow. I built stairs before your mountains had names."],
#: scripts/campaign/mission_e6_01.gd:128 data/voice/lines/e6m1.json:L20
msgid "Step aside, little king of snow. I built stairs before your mountains had names."
msgstr "Écarte-toi, petit roi des neiges. Je bâtissais des escaliers avant que tes montagnes aient un nom."

#. [&"torvald", "Stone is patient. Ice is older."],
#: scripts/campaign/mission_e6_01.gd:129 data/voice/lines/e6m1.json:L21
msgid "Stone is patient. Ice is older."
msgstr "La pierre est patiente. La glace est plus vieille."

#. [&"master", "Three winters, and not one stone stood on your ice."],
#: scripts/campaign/mission_e6_01.gd:130 data/voice/lines/e6m1.json:L22
msgid "Three winters, and not one stone stood on your ice."
msgstr "Trois hivers, et pas une seule pierre n'a tenu debout sur ta glace."

#. [&"torvald", "They will come back."],
#: scripts/campaign/mission_e6_01.gd:131 data/voice/lines/e6m1.json:L23
msgid "They will come back."
msgstr "Elles vont revenir."

#. [&"master", "Then so will you. Every winter. You are my patience, Torvald."],
#: scripts/campaign/mission_e6_01.gd:132 data/voice/lines/e6m1.json:L24
msgid "Then so will you. Every winter. You are my patience, Torvald."
msgstr "Alors toi aussi. Chaque hiver. Tu es ma patience, Torvald."

#. [&"master", "Aldra Stillwater. Stay with it. The ice keeps its wardens."],
#: scripts/campaign/mission_e6_01.gd:133 data/voice/lines/e6m1.json:L25
msgid "Aldra Stillwater. Stay with it. The ice keeps its wardens."
msgstr "Aldra Stillwater. Reste auprès de lui. La glace garde ses gardiens."

#. [&"aldra", "Then I will keep it right back."],
#: scripts/campaign/mission_e6_01.gd:134 data/voice/lines/e6m1.json:L26
msgid "Then I will keep it right back."
msgstr "Alors je vais la garder en retour."

#. [&"narrator", "The lake froze around the Heartfrost that night. It did not thaw for a hundred winters."],
#: scripts/campaign/mission_e6_01.gd:135 data/voice/lines/e6m1.json:L27
msgid "The lake froze around the Heartfrost that night. It did not thaw for a hundred winters."
msgstr "Le lac a gelé autour du Heartfrost cette nuit-là. Il n'a pas dégelé pendant cent hivers."

#. [&"torvald", "Too slow... forgive me. Too slow."],
#: scripts/campaign/mission_e6_01.gd:136 data/voice/lines/e6m1.json:L28
msgid "Too slow... forgive me. Too slow."
msgstr "Trop lent... pardonnez-moi. Trop lent."

#. [&"aldra", "Cracked. Not broken."],
#: scripts/campaign/mission_e6_01.gd:137 scripts/campaign/mission_e6_02.gd:118
#: data/voice/lines/e6m1.json:L28b data/voice/lines/e6m2.json:L28
msgid "Cracked. Not broken."
msgstr "Fêlée. Pas brisée."

#. [&"aldra", "The longhouse... my mother's nets were in there."],
#: scripts/campaign/mission_e6_01.gd:138 data/voice/lines/e6m1.json:L29
msgid "The longhouse... my mother's nets were in there."
msgstr "La maison longue... les filets de ma mère étaient dedans."

#. [&"obren", "Mine. At last, mine."],
#: scripts/campaign/mission_e6_01.gd:139 data/voice/lines/e6m1.json:L30
msgid "Mine. At last, mine."
msgstr "À moi. Enfin, à moi."

#. "A hundred winters ago. The Master has just sealed something under Crown Hollow, and the four kingdoms are new
#: scripts/campaign/mission_e6_01.gd:142
msgid "A hundred winters ago. The Master has just sealed something under Crown Hollow, and the four kingdoms are new. The north belongs to his eldest apprentice, Torvald, who has a keep, a lake, and no great love of visitors."
msgstr "Il y a cent hivers. Le Maître vient de sceller quelque chose sous Crown Hollow, et les quatre royaumes sont jeunes. Le nord appartient à son aîné, Torvald, qui a un donjon, un lac, et pas beaucoup d'amour pour les visiteurs."

#. "Tonight the Master walks out onto the lake with a block of blue ice in his arms. Something inside it shines.
#: scripts/campaign/mission_e6_01.gd:143
msgid "Tonight the Master walks out onto the lake with a block of blue ice in his arms. Something inside it shines. He asks Torvald to keep it cold until he comes back for it, and warns him that something will come for it every winter."
msgstr "Ce soir, le Maître s'avance sur le lac avec un bloc de glace bleue dans les bras. Quelque chose brille à l'intérieur. Il demande à Torvald de le garder au froid jusqu'à son retour, et l'avertit que quelque chose viendra le chercher chaque hiver."

#. "A fisher girl from the Stillwater huts has followed him onto the ice and will not go home. Her name is Aldra.
#: scripts/campaign/mission_e6_01.gd:144
msgid "A fisher girl from the Stillwater huts has followed him onto the ice and will not go home. Her name is Aldra. Three winters are coming. Keep the Heartfrost."
msgstr "Une fille de pêcheur des cabanes de Stillwater l'a suivi sur la glace et refuse de rentrer. Elle s'appelle Aldra. Trois hivers arrivent. Gardez le Heartfrost."

#. const HINT_START := "Keep the Heartfrost alive through three winters. Wardens come from the cracks in the nort
#: scripts/campaign/mission_e6_01.gd:146
msgid "Keep the Heartfrost alive through three winters. Wardens come from the cracks in the north-east. Ice Walls (V) can close a gap."
msgstr "Gardez le Heartfrost intact pendant trois hivers. Les Wardens sortent des fissures au nord-est. Les Murs de glace (V) peuvent fermer une brèche."

#. const HINT_FLOE := "The ice is cracking under the Wardens. Rime Bolt and Flash Freeze crack it further: stone
#: scripts/campaign/mission_e6_01.gd:147
msgid "The ice is cracking under the Wardens. Rime Bolt and Flash Freeze crack it further: stone does not swim."
msgstr "La glace craque sous les Wardens. Rime Bolt et Flash Freeze la fendent encore plus : la pierre ne nage pas."

#. const HINT_LAKE := "Deep Wardens climb out of the lake. On land they shrug off blows, but stone that stands st
#: scripts/campaign/mission_e6_01.gd:148
msgid "Deep Wardens climb out of the lake. On land they shrug off blows, but stone that stands still on a floe cracks it: block them on the ice (Rimeshields in their path, Flash Freeze) and the floe sinks them."
msgstr "Des Deep Wardens sortent du lac. Sur la terre ferme, les coups glissent sur eux, mais la pierre qui reste immobile sur une banquise la fend : bloquez-les sur la glace (des Rimeshields sur leur chemin, Flash Freeze) et la banquise les engloutit."

#. const LINE_LAKE_ALDRA := "They're coming up through the ice! Stop them out there, my lord. Stone that stands s
#: scripts/campaign/mission_e6_01.gd:149
msgid "They're coming up through the ice! Stop them out there, my lord. Stone that stands still on the ice goes under."
msgstr "Ils remontent à travers la glace ! Arrêtez-les là-bas, monseigneur. La pierre qui reste immobile sur la glace coule."

#. const LINE_LAKE_TORVALD := "Then nobody walks past the floes. Shields onto the ice."
#: scripts/campaign/mission_e6_01.gd:150
msgid "Then nobody walks past the floes. Shields onto the ice."
msgstr "Alors personne ne passe les banquises. Les boucliers sur la glace."

#. const HINT_CARVE := "Walk Torvald to a Sentinel stone (south-west shore): Aldra will carve it while no enemy i
#: scripts/campaign/mission_e6_01.gd:151
msgid "Walk Torvald to a Sentinel stone (south-west shore): Aldra will carve it while no enemy is near."
msgstr "Menez Torvald près d'une pierre de Sentinel (rive sud-ouest) : Aldra la taille tant qu'aucun ennemi n'est proche."

#. const MSG_WINTER := "Winter comes."
#: scripts/campaign/mission_e6_01.gd:152
msgid "Winter comes."
msgstr "L'hiver arrive."

#. const MSG_THAW := "The thaw."
#: scripts/campaign/mission_e6_01.gd:153
msgid "The thaw."
msgstr "Le dégel."

#. const MSG_ONE_LODGE := "The shore has room for three lodges"
#: scripts/campaign/mission_e6_01.gd:154
msgid "The shore has room for three lodges"
msgstr "La rive n'a de place que pour trois huttes"

#. const MSG_WALLS := "No more ice for walls this winter"
#: scripts/campaign/mission_e6_01.gd:155 scripts/campaign/mission_e6_02.gd:133
msgid "No more ice for walls this winter"
msgstr "Plus de glace pour des murs cet hiver"

#. const MSG_ALDRA_BACK := "Aldra is back at the keep"
#: scripts/campaign/mission_e6_01.gd:156
msgid "Aldra is back at the keep"
msgstr "Aldra est de retour au donjon"

