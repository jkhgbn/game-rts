#. const MISSION_TITLE := "Winter's End"
#: scripts/campaign/mission_e4_04.gd:28
msgid "Winter's End"
msgstr "La Fin de l'hiver"

#. &"aldra": "Aldra", &"shade": "Shadow Captain", &"narrator": "Narrator"}
#: scripts/campaign/mission_e4_04.gd:122
msgid "Shadow Captain"
msgstr "Capitaine de l'Ombre"

#. [&"narrator", "Torvald's frontier, a week before the snows. A wall older than any of the four."],
#: scripts/campaign/mission_e4_04.gd:127 data/voice/lines/e4m4.json:L1
msgid "Torvald's frontier, a week before the snows. A wall older than any of the four."
msgstr "La frontière de Torvald, une semaine avant les neiges. Un mur plus vieux qu'aucun des quatre."

#. [&"ysolde", "The Wall of a Hundred Winters. While it stands, this war never has to stop for weather."],
#: scripts/campaign/mission_e4_04.gd:128 data/voice/lines/e4m4.json:L2
msgid "The Wall of a Hundred Winters. While it stands, this war never has to stop for weather."
msgstr "Le Mur des Cent Hivers. Tant qu'il tient, cette guerre n'a jamais à s'arrêter pour la météo."

#. [&"vessa", "So we knock it down. I brought fire. You brought... a tree?"],
#: scripts/campaign/mission_e4_04.gd:129 data/voice/lines/e4m4.json:L3
msgid "So we knock it down. I brought fire. You brought... a tree?"
msgstr "Alors on le jette à terre. J'ai apporté le feu. Toi, tu as apporté... un arbre ?"

#. [&"ysolde", "Several. They're very patient, and they hit like a landslide."],
#: scripts/campaign/mission_e4_04.gd:130 data/voice/lines/e4m4.json:L4
msgid "Several. They're very patient, and they hit like a landslide."
msgstr "Plusieurs. Ils sont très patients, et ils frappent comme un glissement de terrain."

#. [&"maelis", "Under the ice by the west gate, something old is sleeping. Wake it, and it will owe you."],
#: scripts/campaign/mission_e4_04.gd:131 data/voice/lines/e4m4.json:L5
msgid "Under the ice by the west gate, something old is sleeping. Wake it, and it will owe you."
msgstr "Sous la glace, près de la porte ouest, quelque chose d'ancien dort. Réveille-le, et il te devra quelque chose."

#. [&"maelis", "Good morning, grandfather. There's a wall that needs leaning on."],
#: scripts/campaign/mission_e4_04.gd:132 data/voice/lines/e4m4.json:L6
msgid "Good morning, grandfather. There's a wall that needs leaning on."
msgstr "Bonjour, grand-père. Il y a un mur qui a besoin qu'on s'appuie dessus."

#. [&"torvald", "Ysolde. I warned you about the cold. Turn back while the passes are open."],
#: scripts/campaign/mission_e4_04.gd:133 data/voice/lines/e4m4.json:L7
msgid "Ysolde. I warned you about the cold. Turn back while the passes are open."
msgstr "Ysolde. Je t'ai prévenue pour le froid. Fais demi-tour tant que les cols sont ouverts."

#. [&"shade", "The Bishop sends his tithe, Lord Torvald. He asks for nothing in return. Yet."],
#: scripts/campaign/mission_e4_04.gd:134 data/voice/lines/e4m4.json:L8
msgid "The Bishop sends his tithe, Lord Torvald. He asks for nothing in return. Yet."
msgstr "L'Évêque envoie sa dîme, seigneur Torvald. Il ne demande rien en retour. Pour l'instant."

#. [&"torvald", "Nothing is what Malrik always asks for. At first."],
#: scripts/campaign/mission_e4_04.gd:135 data/voice/lines/e4m4.json:L9
msgid "Nothing is what Malrik always asks for. At first."
msgstr "Rien, c'est ce que Malrik demande toujours. Au début."

#. [&"ysolde", "The Heartwood stands tall again. Let the elders come."],
#: scripts/campaign/mission_e4_04.gd:136 data/voice/lines/e4m4.json:L10
msgid "The Heartwood stands tall again. Let the elders come."
msgstr "Le Heartwood se dresse de nouveau. Que les anciens viennent."

#. [&"maelis", "Now that is a tree with opinions."],
#: scripts/campaign/mission_e4_04.gd:137 data/voice/lines/e4m4.json:L11
msgid "Now that is a tree with opinions."
msgstr "Ça, c'est un arbre qui a des opinions."

#. [&"vessa", "I'm taking the east gate. Don't wait for me. I definitely won't wait for you."],
#: scripts/campaign/mission_e4_04.gd:138 data/voice/lines/e4m4.json:L12
msgid "I'm taking the east gate. Don't wait for me. I definitely won't wait for you."
msgstr "Je prends la porte est. Ne m'attends pas. Moi, je ne t'attendrai sûrement pas."

#. [&"torvald", "I built this wall so nobody would ever have to choose. You are making me choose."],
#: scripts/campaign/mission_e4_04.gd:139 data/voice/lines/e4m4.json:L13
msgid "I built this wall so nobody would ever have to choose. You are making me choose."
msgstr "J'ai bâti ce mur pour que personne n'ait jamais à choisir. Tu m'obliges à choisir."

#. [&"ysolde", "No, Torvald. Malrik made you choose. I'm only here to hear the answer."],
#: scripts/campaign/mission_e4_04.gd:140 data/voice/lines/e4m4.json:L14
msgid "No, Torvald. Malrik made you choose. I'm only here to hear the answer."
msgstr "Non, Torvald. C'est Malrik qui t'a obligé à choisir. Moi, je suis seulement venue entendre la réponse."

#. [&"vessa", "A gate's down! Your trees punch harder than my fire, Ysolde. I hate it. Keep going."],
#: scripts/campaign/mission_e4_04.gd:141 data/voice/lines/e4m4.json:L15
msgid "A gate's down! Your trees punch harder than my fire, Ysolde. I hate it. Keep going."
msgstr "Une porte est tombée ! Tes arbres frappent plus fort que mon feu, Ysolde. Je déteste ça. Continue."

#. [&"aldra", "Wake, old guards. Somebody is knocking."],
#: scripts/campaign/mission_e4_04.gd:142 data/voice/lines/e4m4.json:L16
msgid "Wake, old guards. Somebody is knocking."
msgstr "Réveillez-vous, vieux gardiens. Quelqu'un frappe."

#. [&"ysolde", "Colossi. Tall, slow, and stubborn. So are we."],
#: scripts/campaign/mission_e4_04.gd:143 data/voice/lines/e4m4.json:L17
msgid "Colossi. Tall, slow, and stubborn. So are we."
msgstr "Des colosses. Grands, lents et têtus. Nous aussi."

#. [&"vessa", "Shadow at my hearths, Ysolde! If your trees can walk, now's the time."],
#: scripts/campaign/mission_e4_04.gd:144 data/voice/lines/e4m4.json:L18
msgid "Shadow at my hearths, Ysolde! If your trees can walk, now's the time."
msgstr "L'Ombre est à mes foyers, Ysolde ! Si tes arbres savent marcher, c'est le moment."

#. [&"maelis", "One mountain fewer. Mountains are overrated."],
#: scripts/campaign/mission_e4_04.gd:145 data/voice/lines/e4m4.json:L19
msgid "One mountain fewer. Mountains are overrated."
msgstr "Une montagne de moins. Les montagnes, c'est surfait."

#. [&"shade", "The second tithe, Lord Torvald. The Bishop says: no more excuses."],
#: scripts/campaign/mission_e4_04.gd:146 data/voice/lines/e4m4.json:L20
msgid "The second tithe, Lord Torvald. The Bishop says: no more excuses."
msgstr "La deuxième dîme, seigneur Torvald. L'Évêque dit : plus d'excuses."

#. [&"narrator", "The wardens are rubble. The Winterheart stands alone, and it is cracking."],
#: scripts/campaign/mission_e4_04.gd:147 data/voice/lines/e4m4.json:L21
msgid "The wardens are rubble. The Winterheart stands alone, and it is cracking."
msgstr "Les gardiens ne sont plus que des gravats. Le Winterheart est seul, et il se fissure."

#. [&"aldra", "You thawed his wood, Ysolde. You will not thaw his wall."],
#: scripts/campaign/mission_e4_04.gd:148 data/voice/lines/e4m4.json:L22
msgid "You thawed his wood, Ysolde. You will not thaw his wall."
msgstr "Tu as dégelé son bois, Ysolde. Tu ne dégèleras pas son mur."

#. [&"aldra", "You broke my glass once, Ysolde. Once was enough."],
#: scripts/campaign/mission_e4_04.gd:149 data/voice/lines/e4m4.json:L22b
msgid "You broke my glass once, Ysolde. Once was enough."
msgstr "Tu as brisé mon verre une fois, Ysolde. Une fois, c'était assez."

#. [&"narrator", "A hundred winters, broken in one afternoon. The Wall begins to weep."],
#: scripts/campaign/mission_e4_04.gd:150 data/voice/lines/e4m4.json:L23
msgid "A hundred winters, broken in one afternoon. The Wall begins to weep."
msgstr "Cent hivers, brisés en un après-midi. Le Mur commence à pleurer."

#. [&"vessa", "Look at it melt! Fire always wins in the end."],
#: scripts/campaign/mission_e4_04.gd:151 data/voice/lines/e4m4.json:L24
msgid "Look at it melt! Fire always wins in the end."
msgstr "Regarde-le fondre ! Le feu gagne toujours, à la fin."

#. [&"ysolde", "That was the tree, Vessa."],
#: scripts/campaign/mission_e4_04.gd:152 data/voice/lines/e4m4.json:L25
msgid "That was the tree, Vessa."
msgstr "C'était l'arbre, Vessa."

#. [&"maelis", "The glass spire. Aldra will be waiting. She always is."],
#: scripts/campaign/mission_e4_04.gd:153 data/voice/lines/e4m4.json:L26
msgid "The glass spire. Aldra will be waiting. She always is."
msgstr "La flèche de verre. Aldra nous attendra. Elle attend toujours."

#. [&"vessa", "Both halls! Torvald's soldiers will have to train in the snow. Good."],
#: scripts/campaign/mission_e4_04.gd:154 data/voice/lines/e4m4.json:L27
msgid "Both halls! Torvald's soldiers will have to train in the snow. Good."
msgstr "Les deux salles ! Les soldats de Torvald vont devoir s'entraîner dans la neige. Tant mieux."

#. [&"aldra", "One strike, Torvald, and the green war is over. Let me finish it."],
#: scripts/campaign/mission_e4_04.gd:155 data/voice/lines/e4m4.json:L28
msgid "One strike, Torvald, and the green war is over. Let me finish it."
msgstr "Un seul coup, Torvald, et la guerre verte est finie. Laisse-moi l'achever."

#. [&"torvald", "Enough, Aldra."],
#: scripts/campaign/mission_e4_04.gd:156 data/voice/lines/e4m4.json:L29
msgid "Enough, Aldra."
msgstr "Assez, Aldra."

#. [&"aldra", "She broke your wall!"],
#: scripts/campaign/mission_e4_04.gd:157 data/voice/lines/e4m4.json:L30
msgid "She broke your wall!"
msgstr "Elle a brisé ton mur !"

#. [&"torvald", "It was only ever ice. Let her up."],
#: scripts/campaign/mission_e4_04.gd:158 data/voice/lines/e4m4.json:L31
msgid "It was only ever ice. Let her up."
msgstr "Ce n'était que de la glace. Laisse-la se relever."

#. [&"ysolde", "Why?"],
#: scripts/campaign/mission_e4_04.gd:159 data/voice/lines/e4m4.json:L32
msgid "Why?"
msgstr "Pourquoi ?"

#. [&"torvald", "Because a hundred winters is long enough. Go home, Ysolde. Spring will keep."],
#: scripts/campaign/mission_e4_04.gd:160 data/voice/lines/e4m4.json:L33
msgid "Because a hundred winters is long enough. Go home, Ysolde. Spring will keep."
msgstr "Parce que cent hivers, c'est assez long. Rentre chez toi, Ysolde. Le printemps attendra."

#. [&"narrator", "That night the first blizzard closed the passes. Both sides sat down to wait for spring."],
#: scripts/campaign/mission_e4_04.gd:161 data/voice/lines/e4m4.json:L34
msgid "That night the first blizzard closed the passes. Both sides sat down to wait for spring."
msgstr "Cette nuit-là, le premier blizzard a fermé les cols. Les deux camps se sont assis pour attendre le printemps."

#. [&"ysolde", "Plant me... somewhere warm..."],
#: scripts/campaign/mission_e4_04.gd:162 data/voice/lines/e4m4.json:L35
msgid "Plant me... somewhere warm..."
msgstr "Plante-moi... quelque part au chaud..."

#. [&"maelis", "The Heartwood's fallen. Winter wins this one."],
#: scripts/campaign/mission_e4_04.gd:163 data/voice/lines/e4m4.json:L36
msgid "The Heartwood's fallen. Winter wins this one."
msgstr "Le Heartwood est tombé. L'hiver gagne cette fois-ci."

#. "On Torvald's frontier stands a wall older than any of the four: the Wall of a Hundred Winters. When the snows
#: scripts/campaign/mission_e4_04.gd:166
msgid "On Torvald's frontier stands a wall older than any of the four: the Wall of a Hundred Winters. When the snows come it closes the passes, and behind it the north can feed Malrik's war all winter long."
msgstr "Sur la frontière de Torvald se dresse un mur plus vieux qu'aucun des quatre : le Mur des Cent Hivers. Quand la neige arrive, il ferme les cols, et derrière lui le nord peut nourrir la guerre de Malrik tout l'hiver."

#. "The first blizzard is a week away. Vessa has brought fire and siege. Ysolde has brought something slower and
#: scripts/campaign/mission_e4_04.gd:167
msgid "The first blizzard is a week away. Vessa has brought fire and siege. Ysolde has brought something slower and much heavier: the elders of the wood, if she can wake them."
msgstr "Le premier blizzard est à une semaine. Vessa a apporté le feu et le siège. Ysolde a apporté quelque chose de plus lent et de bien plus lourd : les anciens du bois, si elle arrive à les réveiller."

#. "Break the Wall's two wardens and the Winterheart that feeds it. Then go to Aldra's Glass Spire and end this b
#: scripts/campaign/mission_e4_04.gd:168
msgid "Break the Wall's two wardens and the Winterheart that feeds it. Then go to Aldra's Glass Spire and end this before the snow does."
msgstr "Brisez les deux gardiens du Mur et le Winterheart qui le nourrit. Puis allez à la Glass Spire d'Aldra et finissez-en avant la neige."

#. const BRIEFING_LINE := "Soldiers barely scratch the Wall. Siege, titans and spells break it."
#: scripts/campaign/mission_e4_04.gd:170
msgid "Soldiers barely scratch the Wall. Siege, titans and spells break it."
msgstr "Les soldats égratignent à peine le Mur. Le siège, les titans et les sorts le brisent."

#. const HINT_START := "The Wall shrugs off soldiers. Ash Hurlers, Elder Treants and spells break it. The Winterh
#: scripts/campaign/mission_e4_04.gd:171
msgid "The Wall shrugs off soldiers. Ash Hurlers, Elder Treants and spells break it. The Winterheart behind the middle gate makes it heal."
msgstr "Le Mur se moque des soldats. Les Ash Hurlers, les Elder Treants et les sorts le brisent. Le Winterheart derrière la porte du milieu le fait guérir."

#. const HINT_SAGE := "Bramblesage: Pollen Haze over a gate's garrison stops their archers shooting over the Wall
#: scripts/campaign/mission_e4_04.gd:172
msgid "Bramblesage: Pollen Haze over a gate's garrison stops their archers shooting over the Wall."
msgstr "Bramblesage : Pollen Haze sur la garnison d'une porte empêche ses archers de tirer par-dessus le Mur."

#. const HINT_CITADEL := "Your Stronghold can become a Citadel: select the Heartwood and press X (300 crystals, 9
#: scripts/campaign/mission_e4_04.gd:173
msgid "Your Stronghold can become a Citadel: select the Heartwood and press X (300 crystals, 90 s). It calls an Elder Treant: Elder Treants break walls."
msgstr "Votre Forteresse peut devenir une Citadelle : sélectionnez le Heartwood et appuyez sur X (300 cristaux, 90 s). Elle appelle un Elder Treant : les Elder Treants brisent les murs."

#. const HINT_TREANT := "Elder Treant: it hits the Wall far harder than soldiers. Send it at a gate."
#: scripts/campaign/mission_e4_04.gd:174
msgid "Elder Treant: it hits the Wall far harder than soldiers. Send it at a gate."
msgstr "Elder Treant : il frappe le Mur bien plus fort que les soldats. Envoyez-le sur une porte."

#. const MSG_HEART_BOUND := "The Winterheart is still frost-bound. Its frost breaks after the glass host comes (1
#: scripts/campaign/mission_e4_04.gd:177
msgid "The Winterheart is still frost-bound. Its frost breaks after the glass host comes (19:00)."
msgstr "Le Winterheart est encore lié par le givre. Son givre se brisera après l'arrivée de l'armée de verre (19:00)."

#. const MSG_HEART_OPEN := "The Winterheart's frost cracks: break it now"
#: scripts/campaign/mission_e4_04.gd:178
msgid "The Winterheart's frost cracks: break it now"
msgstr "Le givre du Winterheart se fissure : brisez-le maintenant"

#. c.victory_banner = "VICTORY\nWinter's End"
#: scripts/campaign/mission_e4_04.gd:274
msgid "VICTORY\nWinter's End"
msgstr "VICTOIRE\nLa Fin de l'hiver"

#. "card": "Elder Treant. A walking forest: root it, and it breaks walls that armies can't scratch."}
#: scripts/campaign/mission_e4_04.gd:281
msgid "Elder Treant. A walking forest: root it, and it breaks walls that armies can't scratch."
msgstr "Elder Treant. Une forêt qui marche : enracinez-le, et il brise des murs que des armées n'arrivent pas à égratigner."

