#: scripts/campaign/mission_e4_03.gd:641
msgid "Regrow the groves of the Sighing Wood (%d / 5 green at once)"
msgstr "Faire repousser les bosquets du Sighing Wood (%d / 5 verts en même temps)"

#. return "Regrow the groves of the Sighing Wood"
#: scripts/campaign/mission_e4_03.gd:642
msgid "Regrow the groves of the Sighing Wood"
msgstr "Faire repousser les bosquets du Sighing Wood"

#. return "Hold the groves until the wood answers (%d:%02d · at least %d standing, paused)" % [s / 60, s % 60, ne
#: scripts/campaign/mission_e4_03.gd:648
msgid "Hold the groves until the wood answers (%d:%02d · at least %d standing, paused)"
msgstr "Tenir les bosquets jusqu'à ce que le bois réponde (%d:%02d · au moins %d debout, en pause)"

#. return "Hold the groves until the wood answers (%d:%02d · at least %d standing)" % [s / 60, s % 60, need]
#: scripts/campaign/mission_e4_03.gd:649
msgid "Hold the groves until the wood answers (%d:%02d · at least %d standing)"
msgstr "Tenir les bosquets jusqu'à ce que le bois réponde (%d:%02d · au moins %d debout)"

