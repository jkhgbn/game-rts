#. const MISSION_TITLE := "The Dragon Auction"
#: scripts/campaign/mission_e7_01.gd:23
msgid "The Dragon Auction"
msgstr "L'Enchère des dragons"

#. const A_NAMES: Array[String] = ["Kesh", "Morrow-of-Glass", "Ossavar"]
#: scripts/campaign/mission_e7_01.gd:27 scripts/campaign/mission_e7_04.gd:47
#: scripts/campaign/mission_e7_base.gd:155
msgid "Kesh"
msgstr "Kesh"

#. const A_NAMES: Array[String] = ["Kesh", "Morrow-of-Glass", "Ossavar"]
#: scripts/campaign/mission_e7_01.gd:27 scripts/campaign/mission_e7_base.gd:156
msgid "Morrow-of-Glass"
msgstr "Morrow-of-Glass"

#. [&"ossavar", "Two harbours, one rock, a sky for sale. Bring gold. I take no promises."],
#: scripts/campaign/mission_e7_01.gd:77 data/voice/lines/e7m1.json:L1
msgid "Two harbours, one rock, a sky for sale. Bring gold. I take no promises."
msgstr "Deux ports, un rocher, un ciel à vendre. Apportez de l'or. Je ne prends pas de promesses."

#. [&"malrik", "The west harbour is yours, Torvald, the east is mine. Together we outbid the sun."],
#: scripts/campaign/mission_e7_01.gd:78 data/voice/lines/e7m1.json:L2
msgid "The west harbour is yours, Torvald, the east is mine. Together we outbid the sun."
msgstr "Le port ouest est à toi, Torvald, l'est est à moi. Ensemble, on surenchérit sur le soleil."

#. [&"torvald", "I came to keep the Coinwater's peace, Malrik. Not to buy a dragon like a cart-horse."],
#: scripts/campaign/mission_e7_01.gd:79 data/voice/lines/e7m1.json:L3
msgid "I came to keep the Coinwater's peace, Malrik. Not to buy a dragon like a cart-horse."
msgstr "Je suis venu garder la paix du Coinwater, Malrik. Pas acheter un dragon comme un cheval de trait."

#. [&"aldra", "Then keep it with gold, my lord. Winter is patient. Markets are not."],
#: scripts/campaign/mission_e7_01.gd:80 data/voice/lines/e7m1.json:L4
msgid "Then keep it with gold, my lord. Winter is patient. Markets are not."
msgstr "Alors garde-la avec de l'or, seigneur. L'hiver est patient. Les marchés, non."

#. [&"aldra", "Send the wagons to the harbour. And watch the shoals. The sun's riders are faster than ice."],
#: scripts/campaign/mission_e7_01.gd:81 data/voice/lines/e7m1.json:L5
msgid "Send the wagons to the harbour. And watch the shoals. The sun's riders are faster than ice."
msgstr "Envoie les chariots au port. Et surveille les gués : les cavaliers du soleil sont plus rapides que la glace."

#. [&"aldra", "The first coin is home. It smells of fish and diamonds."],
#: scripts/campaign/mission_e7_01.gd:82 data/voice/lines/e7m1.json:L6
msgid "The first coin is home. It smells of fish and diamonds."
msgstr "La première pièce est rentrée. Elle sent le poisson et le diamant."

#. [&"vessa", "Torvald! You came south for the sunshine? I'll show you sunshine."],
#: scripts/campaign/mission_e7_01.gd:83 data/voice/lines/e7m1.json:L7
msgid "Torvald! You came south for the sunshine? I'll show you sunshine."
msgstr "Torvald ! Tu es descendu au sud pour le soleil ? Je vais t'en montrer, moi, du soleil."

#. [&"torvald", "Vessa. Still never waiting. One day, child, the road will be longer than you are."],
#: scripts/campaign/mission_e7_01.gd:84 data/voice/lines/e7m1.json:L8
msgid "Vessa. Still never waiting. One day, child, the road will be longer than you are."
msgstr "Vessa. Toujours incapable d'attendre. Un jour, petite, la route sera plus longue que toi."

#. [&"herald", "The rock is held! By the old law, its master speaks last at the hammer."],
#: scripts/campaign/mission_e7_01.gd:85 data/voice/lines/e7m1.json:L9
msgid "The rock is held! By the old law, its master speaks last at the hammer."
msgstr "Le rocher est tenu ! Selon la vieille loi, son maître parle en dernier au coup de marteau !"

#. [&"ossavar", "The first of my brood. Kesh burns bright, and cheap. Who pays?"],
#: scripts/campaign/mission_e7_01.gd:86 data/voice/lines/e7m1.json:L10
msgid "The first of my brood. Kesh burns bright, and cheap. Who pays?"
msgstr "Le premier de ma couvée. Kesh brûle fort, et pas cher. Qui paie ?"

#. [&"torvald", "Fly with us, then. And try not to enjoy it."],
#: scripts/campaign/mission_e7_01.gd:87 data/voice/lines/e7m1.json:L11
msgid "Fly with us, then. And try not to enjoy it."
msgstr "Vole avec nous, alors. Et essaie de ne pas y prendre plaisir."

#. [&"ossavar", "Gold from the south. Kesh, burn the north."],
#: scripts/campaign/mission_e7_01.gd:88 data/voice/lines/e7m1.json:L12
msgid "Gold from the south. Kesh, burn the north."
msgstr "L'or vient du sud. Kesh, brûle le nord."

#. [&"herald", "The Laurel at noon! By the Truce of the Stilled Sea: first blood, and no further!"],
#: scripts/campaign/mission_e7_01.gd:89 data/voice/lines/e7m1.json:L13
msgid "The Laurel at noon! By the Truce of the Stilled Sea: first blood, and no further!"
msgstr "Le Laurel à midi ! Par la Trêve de la Mer Figée : premier sang, et rien de plus !"

#. [&"dacian", "No crowd worth the name today, Diamond Wall. Just us, and a great deal of money."],
#: scripts/campaign/mission_e7_01.gd:90 data/voice/lines/e7m1.json:L14
msgid "No crowd worth the name today, Diamond Wall. Just us, and a great deal of money."
msgstr "Pas de foule digne de ce nom aujourd'hui, Diamond Wall. Juste nous, et beaucoup d'argent."

#. [&"seraphine", "Then let us disappoint the money."],
#: scripts/campaign/mission_e7_01.gd:91 data/voice/lines/e7m1.json:L15
msgid "Then let us disappoint the money."
msgstr "Alors décevons l'argent."

#. [&"seraphine", "Gold cloaks, behind me. So this is how Aurivane wins now."],
#: scripts/campaign/mission_e7_01.gd:92 data/voice/lines/e7m1.json:L16
msgid "Gold cloaks, behind me. So this is how Aurivane wins now."
msgstr "Des manteaux dorés, derrière moi. C'est donc comme ça qu'Aurivane gagne, maintenant."

#. [&"dacian", "Those aren't mine! Seraphine, those are NOT mine!"],
#: scripts/campaign/mission_e7_01.gd:93 data/voice/lines/e7m1.json:L17
msgid "Those aren't mine! Seraphine, those are NOT mine!"
msgstr "Ce ne sont pas les miens ! Seraphine, ce ne sont PAS les miens !"

#. [&"torvald", "That smoke is violet. Gold cloaks do not bleed violet."],
#: scripts/campaign/mission_e7_01.gd:94 data/voice/lines/e7m1.json:L16b
msgid "That smoke is violet. Gold cloaks do not bleed violet."
msgstr "Cette fumée est violette. Les manteaux dorés ne saignent pas violet."

#. [&"seraphine", "Walls don't run, Ice-king. But they can walk, if you walk beside them."],
#: scripts/campaign/mission_e7_01.gd:95 data/voice/lines/e7m1.json:L18
msgid "Walls don't run, Ice-king. But they can walk, if you walk beside them."
msgstr "Les murs ne courent pas, roi de glace. Mais ils peuvent marcher, si tu marches à côté d'eux."

#. [&"seraphine", "The harbour, then. I will hold it. It is the one thing today that hasn't lied to me."],
#: scripts/campaign/mission_e7_01.gd:96 data/voice/lines/e7m1.json:L19
msgid "The harbour, then. I will hold it. It is the one thing today that hasn't lied to me."
msgstr "Le port, alors. Je le tiendrai. C'est la seule chose aujourd'hui qui ne m'a pas menti."

#. [&"malrik", "For the second bid, Torvald. A gift. Two hundred, in good gold."],
#: scripts/campaign/mission_e7_01.gd:97 data/voice/lines/e7m1.json:L20
msgid "For the second bid, Torvald. A gift. Two hundred, in good gold."
msgstr "Pour la deuxième enchère, Torvald. Un cadeau. Deux cents, en bon or."

#. [&"torvald", "This coin carries the Outwall's stamp, Malrik. Dockers' wages. Where did you find it?"],
#: scripts/campaign/mission_e7_01.gd:98 data/voice/lines/e7m1.json:L21
msgid "This coin carries the Outwall's stamp, Malrik. Dockers' wages. Where did you find it?"
msgstr "Ces pièces portent le sceau de l'Outwall, Malrik. Des salaires de débardeurs. Où les as-tu trouvées ?"

#. [&"malrik", "Lying in the street, Torvald. Where coin usually lies."],
#: scripts/campaign/mission_e7_01.gd:99 data/voice/lines/e7m1.json:L22
msgid "Lying in the street, Torvald. Where coin usually lies."
msgstr "Par terre, dans la rue, Torvald. Là où traîne d'habitude l'argent."

#. [&"obren", "Count it, Ice-king. Count all of it. Someone is counting you."],
#: scripts/campaign/mission_e7_01.gd:100 data/voice/lines/e7m1.json:L22b
msgid "Count it, Ice-king. Count all of it. Someone is counting you."
msgstr "Compte-les, roi de glace. Compte-les toutes. Quelqu'un te compte, toi."

#. [&"ossavar", "Morrow-of-Glass, my daughter. She remembers both your grandfathers' coin."],
#: scripts/campaign/mission_e7_01.gd:101 data/voice/lines/e7m1.json:L23a
msgid "Morrow-of-Glass, my daughter. She remembers both your grandfathers' coin."
msgstr "Morrow-of-Glass, ma fille. Elle se souvient de l'or de vos deux grands-pères."

#. [&"torvald", "Glass and frost. At least one of us will match the banners."],
#: scripts/campaign/mission_e7_01.gd:102 data/voice/lines/e7m1.json:L23
msgid "Glass and frost. At least one of us will match the banners."
msgstr "Verre et givre. Au moins un de nous sera assorti aux bannières."

#. [&"ossavar", "Diamonds were never enough for her. Morrow, fly south."],
#: scripts/campaign/mission_e7_01.gd:103 data/voice/lines/e7m1.json:L24
msgid "Diamonds were never enough for her. Morrow, fly south."
msgstr "Les diamants ne lui ont jamais suffi. Morrow, vole vers le sud."

#. [&"ysolde", "Torvald. You let me go once, on your wall. I remember. I will not hold back today."],
#: scripts/campaign/mission_e7_01.gd:104 data/voice/lines/e7m1.json:L25
msgid "Torvald. You let me go once, on your wall. I remember. I will not hold back today."
msgstr "Torvald. Tu m'as laissée partir une fois, sur ton mur. Je m'en souviens. Je ne me retiendrai pas aujourd'hui."

#. [&"torvald", "Good. Holding back has always been my fault, not yours."],
#: scripts/campaign/mission_e7_01.gd:105 data/voice/lines/e7m1.json:L26
msgid "Good. Holding back has always been my fault, not yours."
msgstr "Bien. Se retenir a toujours été mon défaut, pas le tien."

#. [&"ossavar", "And now the old price. Me. Whoever pays the most, I burn for."],
#: scripts/campaign/mission_e7_01.gd:106 data/voice/lines/e7m1.json:L27
msgid "And now the old price. Me. Whoever pays the most, I burn for."
msgstr "Et maintenant, le vieux prix. Moi. Celui qui paie le plus, je brûle pour lui."

#. [&"torvald", "I have never owned anything this old. Except my regrets."],
#: scripts/campaign/mission_e7_01.gd:107 data/voice/lines/e7m1.json:L28
msgid "I have never owned anything this old. Except my regrets."
msgstr "Je n'ai jamais rien possédé d'aussi vieux. À part mes regrets."

#. [&"ossavar", "Twice each, I said. Let us make it three."],
#: scripts/campaign/mission_e7_01.gd:108 data/voice/lines/e7m1.json:L29
msgid "Twice each, I said. Let us make it three."
msgstr "Deux fois chacun, j'avais dit. Allons pour trois."

#. [&"vessa", "Everything we have, Ysolde! Take that harbour while the sky is still for sale!"],
#: scripts/campaign/mission_e7_01.gd:109 data/voice/lines/e7m1.json:L30
msgid "Everything we have, Ysolde! Take that harbour while the sky is still for sale!"
msgstr "Tout ce qu'on a, Ysolde ! Prends ce port pendant que le ciel est encore à vendre !"

#. [&"seraphine", "Adamarch will remember who stood on the quay with her. Even if the Archon will not."],
#: scripts/campaign/mission_e7_01.gd:110 data/voice/lines/e7m1.json:L31
msgid "Adamarch will remember who stood on the quay with her. Even if the Archon will not."
msgstr "Adamarch se souviendra de qui s'est tenu sur le quai avec elle. Même si l'Archonte l'oublie."

#. [&"torvald", "Remember who paid for it, Seraphine. I would like to know myself."],
#: scripts/campaign/mission_e7_01.gd:111 data/voice/lines/e7m1.json:L32
msgid "Remember who paid for it, Seraphine. I would like to know myself."
msgstr "Souviens-toi de qui a payé pour ça, Seraphine. J'aimerais bien le savoir moi-même."

#. [&"ossavar", "The Laurel was broken by knives. Gold cloaks. Violet smoke. Somebody lied on my rock."],
#: scripts/campaign/mission_e7_01.gd:112 data/voice/lines/e7m1.json:L34
msgid "The Laurel was broken by knives. Gold cloaks. Violet smoke. Somebody lied on my rock."
msgstr "Le Laurel brisé par des couteaux. Des manteaux dorés. De la fumée violette. On a menti sur mon rocher."

#. [&"ossavar", "The sky has chosen its master, and it is not you."],
#: scripts/campaign/mission_e7_01.gd:113 data/voice/lines/e7m1.json:L33
msgid "The sky has chosen its master, and it is not you."
msgstr "Le ciel a choisi son maître, et ce n'est pas toi."

#. [&"aldra", "The harbour is burning, my lord. Adamarch does not forgive a guest who loses its harbour."],
#: scripts/campaign/mission_e7_01.gd:114 data/voice/lines/e7m1.json:L35
msgid "The harbour is burning, my lord. Adamarch does not forgive a guest who loses its harbour."
msgstr "Le port brûle, seigneur. Adamarch ne pardonne pas à un invité qui perd son port."

#. [&"dacian", "No... she was the best of us. Both cities killed her today."],
#: scripts/campaign/mission_e7_01.gd:115 data/voice/lines/e7m1.json:L36
msgid "No... she was the best of us. Both cities killed her today."
msgstr "Non... c'était la meilleure d'entre nous. Les deux villes l'ont tuée aujourd'hui."

#. [&"torvald", "Too slow. Again... the ice gives way."],
#: scripts/campaign/mission_e7_01.gd:116 data/voice/lines/e7m1.json:L37
msgid "Too slow. Again... the ice gives way."
msgstr "Trop lent. Encore... la glace cède."

#. [&"aldra", "Steel and quilting. Adamarch's coin, wearing our colours."],
#: scripts/campaign/mission_e7_01.gd:117 data/voice/lines/e7m1.json:L38
msgid "Steel and quilting. Adamarch's coin, wearing our colours."
msgstr "De l'acier et du matelassé. L'argent d'Adamarch, à nos couleurs."

#. "The winter truce holds on the green fields of Evenmead. It says nothing about the south. On the Coinwater, tw
#: scripts/campaign/mission_e7_01.gd:120
msgid "The winter truce holds on the green fields of Evenmead. It says nothing about the south. On the Coinwater, two harbour cities who have hated each other for a thousand years have just watched their duel end, and a dragon land on the Master's empty chair."
msgstr "La trêve d'hiver tient dans les champs verts d'Evenmead. Elle ne dit rien du sud. Sur le Coinwater, deux cités portuaires qui se haïssent depuis mille ans viennent de voir leur duel finir, et un dragon se poser sur le siège vide du Maître."

#. "Ossavar the Twice-Sold has named the old price: gold for fire. Three auctions, three skies for sale. Adamarch
#: scripts/campaign/mission_e7_01.gd:121
msgid "Ossavar the Twice-Sold has named the old price: gold for fire. Three auctions, three skies for sale. Adamarch, the Diamond City, has opened its harbour to Malrik and to Torvald. Across the water, Aurivane flies Vessa's red sails and Ysolde's green ones."
msgstr "Ossavar le Deux-Fois-Vendu a fixé le vieux prix : de l'or pour du feu. Trois enchères, trois ciels à vendre. Adamarch, la Cité de diamant, a ouvert son port à Malrik et à Torvald. De l'autre côté de l'eau, Aurivane hisse les voiles rouges de Vessa et les vertes d'Ysolde."

#. "Torvald came to keep a peace. Malrik came to buy a war. Hold the Diamond Harbour, win the sky, and count the
#: scripts/campaign/mission_e7_01.gd:122
msgid "Torvald came to keep a peace. Malrik came to buy a war. Hold the Diamond Harbour, win the sky, and count the coin carefully. Somebody else is counting too."
msgstr "Torvald est venu garder une paix. Malrik est venu acheter une guerre. Tiens le Port de diamant, gagne le ciel et compte bien ton or. Quelqu'un d'autre compte aussi."

#. const BRIEFING_LINE := "Gold comes by caravan from the Diamond Harbour. Bid when a dragon lands on the Tollroc
#: scripts/campaign/mission_e7_01.gd:124
msgid "Gold comes by caravan from the Diamond Harbour. Bid when a dragon lands on the Tollrock (the Bid buttons, top right)."
msgstr "L'or arrive en caravane du Port de diamant. Enchéris quand un dragon se pose sur le Tollrock (les boutons Enchérir, en haut à droite)."

#. const HINT_START := "Your gold comes from the Diamond Harbour. Build a Frost Bazaar near the Keep (worker B, t
#: scripts/campaign/mission_e7_01.gd:125
msgid "Your gold comes from the Diamond Harbour. Build a Frost Bazaar near the Keep (worker B, then B) and train caravans (Z)."
msgstr "Ton or vient du Port de diamant. Bâtis un Bazar de givre près du donjon (ouvrier B, puis B) et forme des caravanes (Z)."

#. const HINT_POSTS := "Posts open at 2:00. Caravans walk the ring road: the Diamond Harbour is near, the Admiral
#: scripts/campaign/mission_e7_01.gd:126
msgid "Posts open at 2:00. Caravans walk the ring road: the Diamond Harbour is near, the Admiralty Quay pays more per trip."
msgstr "Les comptoirs ouvrent à 2:00. Les caravanes suivent la route circulaire : le Port de diamant est proche, le Quai de l'Amirauté paie plus par voyage."

#. const HINT_STRONGHOLD := "Your Rime Keep can become a Stronghold: select it and press X (200 crystals). It ope
#: scripts/campaign/mission_e7_01.gd:127
msgid "Your Rime Keep can become a Stronghold: select it and press X (200 crystals). It opens Hoarlight Magebow, Frost Mortar (Frost Hall) and the Rimecarver (Keep)."
msgstr "Ton Rime Keep peut devenir une Forteresse : sélectionne-le et appuie sur X (200 cristaux). Elle débloque le Hoarlight Magebow, le Frost Mortar (Frost Hall) et le Rimecarver (donjon)."

#. const HINT_ROCK := "Hold the Tollrock when the hammer falls: its master wins a bid within 10 %."
#: scripts/campaign/mission_e7_01.gd:128
msgid "Hold the Tollrock when the hammer falls: its master wins a bid within 10 %."
msgstr "Tiens le Tollrock quand tombe le marteau : son maître gagne une enchère à 10 % près."

#. const HINT_CARVER := "Rimecarver: Z Rime Bulwark raises a wall for 8 s (two close a causeway). V Scrying Rune
#: scripts/campaign/mission_e7_01.gd:129
msgid "Rimecarver: Z Rime Bulwark raises a wall for 8 s (two close a causeway). V Scrying Rune sees through fog."
msgstr "Rimecarver : Z Rime Bulwark dresse un mur 8 s (deux ferment une chaussée). V Scrying Rune voit à travers le brouillard."

#. const MSG_RIDERS := "Riders on the Gold Shoal: they want your caravans"
#: scripts/campaign/mission_e7_01.gd:130
msgid "Riders on the Gold Shoal: they want your caravans"
msgstr "Des cavaliers au Haut-fond d'or : ils veulent tes caravanes"

#. const MSG_AUCTION_SOON := "A dragon is landing on the Tollrock. Auction in 0:30: bid with the Bid buttons"
#: scripts/campaign/mission_e7_01.gd:131 scripts/campaign/mission_e7_04.gd:154
msgid "A dragon is landing on the Tollrock. Auction in 0:30: bid with the Bid buttons"
msgstr "Un dragon se pose sur le Tollrock. Enchère dans 0:30 : enchéris avec les boutons Enchérir"

#. const MSG_LAUREL := "The Laurel duel begins at noon on the Tollrock (12:00)"
#: scripts/campaign/mission_e7_01.gd:132
msgid "The Laurel duel begins at noon on the Tollrock (12:00)"
msgstr "Le duel du Laurel commence à midi sur le Tollrock (12:00)"

#. const MSG_RING := "The Laurel ring is closed to soldiers."
#: scripts/campaign/mission_e7_01.gd:133
msgid "The Laurel ring is closed to soldiers."
msgstr "Le cercle du Laurel est fermé aux soldats."

#. const MSG_GIFT := "Malrik adds 200 gold to your coffers"
#: scripts/campaign/mission_e7_01.gd:134
msgid "Malrik adds 200 gold to your coffers"
msgstr "Malrik ajoute 200 pièces d'or à tes coffres"

#. const MSG_MALRIK_FELL := "Malrik falls back to the Admiralty"
#: scripts/campaign/mission_e7_01.gd:135
msgid "Malrik falls back to the Admiralty"
msgstr "Malrik se replie vers l'Amirauté"

#. c.keep_lost_message = "The Rime Keep has fallen."
#: scripts/campaign/mission_e7_01.gd:181 scripts/campaign/mission_e7_02.gd:217
#: scripts/campaign/mission_e7_04.gd:215 scripts/campaign/mission_e8_01_ice.gd:117
msgid "The Rime Keep has fallen."
msgstr "Le donjon de Givre est tombé."

#. c.victory_banner = "VICTORY\nThe sky is Adamarch's"
#: scripts/campaign/mission_e7_01.gd:190
msgid "VICTORY\nThe sky is Adamarch's"
msgstr "VICTOIRE\nLe ciel est à Adamarch"

#. c.spotlight = {"id": &"rimecarver", "trigger": &"manual", "key_hint": "Rime Keep: B",
#: scripts/campaign/mission_e7_01.gd:196
msgid "Rime Keep: B"
msgstr "Rime Keep : B"

#. "card": "Rimecarver. The wall comes to you: close a door in front of the charge, see what hides behind it."}
#: scripts/campaign/mission_e7_01.gd:197
msgid "Rimecarver. The wall comes to you: close a door in front of the charge, see what hides behind it."
msgstr "Rimecarver. Le mur vient à toi : ferme une porte devant la charge, vois ce qui se cache derrière."

