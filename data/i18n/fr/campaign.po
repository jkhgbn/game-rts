#: scripts/campaign/mission_03.gd:16
msgid "The Signet in the Sighing Wood"
msgstr "Le Signet du Sighing Wood"

#. &"rh1": ["Mossgate", Vector3(-44.0, 0.0, -18.0)],
#: scripts/campaign/mission_03.gd:64 scripts/campaign/mission_e4_03.gd:63
msgid "Mossgate"
msgstr "Mossgate"

#. &"rh2": ["Hollowfen", Vector3(18.0, 0.0, 44.0)],
#: scripts/campaign/mission_03.gd:65 scripts/campaign/mission_e4_03.gd:56
msgid "Hollowfen"
msgstr "Hollowfen"

#. &"rh3": ["Stagwatch", Vector3(44.0, 0.0, 14.0)],
#: scripts/campaign/mission_03.gd:66 scripts/campaign/mission_e4_03.gd:57
msgid "Stagwatch"
msgstr "Stagwatch"

#. [&"narrator", "The Sighing Wood has kept out of every quarrel for a hundred years. Today two armies walked in.
#: scripts/campaign/mission_03.gd:162 data/voice/lines/m03.json:L1
msgid "The Sighing Wood has kept out of every quarrel for a hundred years. Today two armies walked in."
msgstr "Le Sighing Wood est resté hors de toute querelle depuis cent ans. Aujourd'hui, deux armées y entrent."

#. [&"vessa", "Malrik's already here. Of course he is. Then I'll borrow a forest."],
#: scripts/campaign/mission_03.gd:163 data/voice/lines/m03.json:L2
msgid "Malrik's already here. Of course he is. Then I'll borrow a forest."
msgstr "Malrik est déjà là. Évidemment. Alors j'emprunte une forêt."

#. [&"whisper", "The third one sleeps in the old tree. Wake it before he does."],
#: scripts/campaign/mission_03.gd:164 data/voice/lines/m03.json:L3
msgid "The third one sleeps in the old tree. Wake it before he does."
msgstr "La troisième dort dans le vieil arbre. Réveille-la avant lui."

#. [&"pell", "A war! Terrible. Wonderful for business. Terrible."],
#: scripts/campaign/mission_03.gd:165 data/voice/lines/m03.json:L20
msgid "A war! Terrible. Wonderful for business. Terrible."
msgstr "Une guerre ! Terrible. Excellent pour les affaires. Terrible."

#. [&"bettany", "The Crooked Lantern is open! Sellswords, cheap ale, no questions. First hire's on the house."],
#: scripts/campaign/mission_03.gd:166 data/voice/lines/m03.json:L4
msgid "The Crooked Lantern is open! Sellswords, cheap ale, no questions. First hire's on the house."
msgstr "La Crooked Lantern est ouverte ! Mercenaires, bière pas chère, aucune question. Premier contrat offert."

#. [&"vessa", "Sellswords who won't take orders. Perfect. I'll pay them to want what I want."],
#: scripts/campaign/mission_03.gd:167 data/voice/lines/m03.json:L5
msgid "Sellswords who won't take orders. Perfect. I'll pay them to want what I want."
msgstr "Des mercenaires qui refusent les ordres. Parfait. Je les paierai pour vouloir ce que je veux."

#. [&"bettany", "Mind the flags, Firelady. Coin on a flag is the only order that lot understands."],
#: scripts/campaign/mission_03.gd:168 data/voice/lines/m03.json:L6
msgid "Mind the flags, Firelady. Coin on a flag is the only order that lot understands."
msgstr "Gare aux drapeaux, Dame de feu. De l'or sur un drapeau, c'est le seul ordre qu'ils comprennent."

#. [&"vessa", "A heart made of roots, pumping green. Only Ysolde would grow a thing like that."],
#: scripts/campaign/mission_03.gd:169 data/voice/lines/m03.json:L7
msgid "A heart made of roots, pumping green. Only Ysolde would grow a thing like that."
msgstr "Un cœur de racines qui pompe du vert. Il n'y a qu'Ysolde pour faire pousser un truc pareil."

#. [&"vessa", "His Thralls are draining the hearts. If he opens that tree first, I lose it."],
#: scripts/campaign/mission_03.gd:170 data/voice/lines/m03.json:L21
msgid "His Thralls are draining the hearts. If he opens that tree first, I lose it."
msgstr "Ses Thralls vident les cœurs. S'il ouvre cet arbre le premier, je la perds."

#. [&"ysolde", "Fire and Shadow, burning my wood for a trinket. I will remember you both."],
#: scripts/campaign/mission_03.gd:171 data/voice/lines/m03.json:L8
msgid "Fire and Shadow, burning my wood for a trinket. I will remember you both."
msgstr "Feu et Ombre, qui brûlent mon bois pour une babiole. Je me souviendrai de vous deux."

#. [&"narrator", "Old Mossjaw wakes in the Hollowfen, and he is hungry."],
#: scripts/campaign/mission_03.gd:172 data/voice/lines/m03.json:L10
msgid "Old Mossjaw wakes in the Hollowfen, and he is hungry."
msgstr "Old Mossjaw s'éveille dans le Hollowfen, et il a faim."

#. [&"vessa", "Somebody tell the sellswords their bounty's ready. And tell the bear I'm sorry."],
#: scripts/campaign/mission_03.gd:173 data/voice/lines/m03.json:L11
msgid "Somebody tell the sellswords their bounty's ready. And tell the bear I'm sorry."
msgstr "Dites aux mercenaires que leur prime est prête. Et dites à l'ours que je suis désolée."

#. [&"maelis", "Turn back, fire-child. The wolves already have your scent."],
#: scripts/campaign/mission_03.gd:174 data/voice/lines/m03.json:L12
msgid "Turn back, fire-child. The wolves already have your scent."
msgstr "Fais demi-tour, enfant du feu. Les loups ont déjà ton odeur."

#. [&"ysolde", "Stop, both of you! You don't know what you're opening!"],
#: scripts/campaign/mission_03.gd:175 data/voice/lines/m03.json:L13
msgid "Stop, both of you! You don't know what you're opening!"
msgstr "Arrêtez, tous les deux ! Vous ignorez ce que vous ouvrez !"

#. [&"vessa", "A tree. I'm opening a tree. Before HE does."],
#: scripts/campaign/mission_03.gd:176 data/voice/lines/m03.json:L14
msgid "A tree. I'm opening a tree. Before HE does."
msgstr "Un arbre. J'ouvre un arbre. Avant LUI."

#. [&"malrik", "Mine. Thank you for the escort, little ember."],
#: scripts/campaign/mission_03.gd:177 data/voice/lines/m03.json:L19
msgid "Mine. Thank you for the escort, little ember."
msgstr "À moi. Merci pour l'escorte, petite braise."

#. [&"vessa", "Dropped something, Bishop? Finders keepers."],
#: scripts/campaign/mission_03.gd:178 data/voice/lines/m03.json:L22
msgid "Dropped something, Bishop? Finders keepers."
msgstr "Échappé quelque chose, l'Évêque ? Qui trouve garde."

#. [&"obren", "Three. Thank you, little ember. I'll take it from here."],
#: scripts/campaign/mission_03.gd:179 data/voice/lines/m03.json:L15
msgid "Three. Thank you, little ember. I'll take it from here."
msgstr "Trois. Merci, petite braise. Je prends le relais."

#. [&"malrik", "Rubble with eyes. Your mess, Vessa. I'll be at my camp, enjoying the view."],
#: scripts/campaign/mission_03.gd:180 data/voice/lines/m03.json:L16
msgid "Rubble with eyes. Your mess, Vessa. I'll be at my camp, enjoying the view."
msgstr "Des gravats avec des yeux. Ton dégât, Vessa. Je serai au camp, à profiter de la vue."

#. [&"vessa", "One gate down. Stone breaks. Good to know."],
#: scripts/campaign/mission_03.gd:181 data/voice/lines/m03.json:L17
msgid "One gate down. Stone breaks. Good to know."
msgstr "Une porte de tombée. La pierre casse. Bon à savoir."

#. [&"vessa", "Tell Malrik... he still dresses like a funeral."],
#: scripts/campaign/mission_03.gd:182 data/voice/lines/m03.json:L18
msgid "Tell Malrik... he still dresses like a funeral."
msgstr "Dites à Malrik... qu'il s'habille encore en enterrement."

#. [&"m3_plea", &"ysolde", "Vessa. Stop. Please.", 4.0],
#: scripts/campaign/mission_03.gd:186
msgid "Vessa. Stop. Please."
msgstr "Vessa. Arrête. Je t'en prie."

#. [&"m3_plea", &"vessa", "NOW you want to talk? Your wood tried to eat me.", 4.0],
#: scripts/campaign/mission_03.gd:187
msgid "NOW you want to talk? Your wood tried to eat me."
msgstr "MAINTENANT tu veux parler ? Ton bois a voulu me manger."

#. [&"m3_plea", &"ysolde", "My wood tries to eat everyone. It's very fair.", 4.0],
#: scripts/campaign/mission_03.gd:188
msgid "My wood tries to eat everyone. It's very fair."
msgstr "Mon bois veut manger tout le monde. C'est très juste."

#. [&"m3_plea", &"ysolde", "Those relics aren't a prize. They're a lock.", 4.0],
#: scripts/campaign/mission_03.gd:189
msgid "Those relics aren't a prize. They're a lock."
msgstr "Ces reliques ne sont pas un trophée. C'est une serrure."

#. [&"m3_plea", &"ysolde", "Put three together near the Hollow and the door opens.", 4.5],
#: scripts/campaign/mission_03.gd:190
msgid "Put three together near the Hollow and the door opens."
msgstr "Réunis-en trois près du Hollow et la porte s'ouvre."

#. [&"m3_plea", &"vessa", "Everyone says that about the things I want. And if I leave it, Malrik takes it.", 7.0]
#: scripts/campaign/mission_03.gd:191
msgid "Everyone says that about the things I want. And if I leave it, Malrik takes it."
msgstr "Tout le monde dit ça de ce que je veux. Et si je la laisse, Malrik la prend."

#. [&"m3_memory", &"ysolde", "The Master had a first apprentice. Before any of us. Obren. The Mason.", 4.0],
#: scripts/campaign/mission_03.gd:192
msgid "The Master had a first apprentice. Before any of us. Obren. The Mason."
msgstr "Le Maître avait un premier apprenti. Avant nous tous. Obren. Le Maçon."

#. [&"m3_memory", &"ysolde", "He wanted the Master's seat. So the Master sealed him under the earth, with the reg
#: scripts/campaign/mission_03.gd:193
msgid "He wanted the Master's seat. So the Master sealed him under the earth, with the regalia as the lock."
msgstr "Il voulait le trône du Maître. Le Maître l'a scellé sous terre, les regalia pour serrure."

#. [&"m3_memory", &"obren", "And you picked them up. All three. Thank you, little ember.", 2.5],
#: scripts/campaign/mission_03.gd:194
msgid "And you picked them up. All three. Thank you, little ember."
msgstr "Et tu les as ramassées. Les trois. Merci, petite braise."

#. [&"m3_parting", &"ysolde", "I warned you. You didn't listen. Neither did he.", 5.0],
#: scripts/campaign/mission_03.gd:195
msgid "I warned you. You didn't listen. Neither did he."
msgstr "Je t'avais prévenue. Tu n'as pas écouté. Lui non plus."

#. [&"m3_parting", &"vessa", "Then help me stop it. Please.", 3.5],
#: scripts/campaign/mission_03.gd:196
msgid "Then help me stop it. Please."
msgstr "Alors aide-moi. Je t'en prie."

#. [&"m3_parting", &"ysolde", "Nature doesn't take sides, Vessa.", 4.0],
#: scripts/campaign/mission_03.gd:197
msgid "Nature doesn't take sides, Vessa."
msgstr "La Nature ne prend pas parti, Vessa."

#. [&"m3_parting", &"ysolde", "But when your war comes for my wood, and it will, remember that I warned you both.
#: scripts/campaign/mission_03.gd:198
msgid "But when your war comes for my wood, and it will, remember that I warned you both."
msgstr "Mais quand ta guerre viendra pour mon bois, et elle viendra, rappelle-toi que je vous ai prévenus."

#. [&"m3_parting", &"narrator", "Fire is at war with Shadow, while Ice and Nature watch. Under the world, somethi
#: scripts/campaign/mission_03.gd:199
msgid "Fire is at war with Shadow, while Ice and Nature watch. Under the world, something is counting."
msgstr "Le Feu est en guerre contre l'Ombre, et la Glace et la Nature regardent. Sous le monde, quelque chose compte."

#. "Two relics answer to fire now, and both hum toward the same place: the Sighing Wood, Ysolde's border forest,
#: scripts/campaign/mission_03.gd:202
msgid "Two relics answer to fire now, and both hum toward the same place: the Sighing Wood, Ysolde's border forest, which has kept out of every quarrel for a hundred years."
msgstr "Deux reliques répondent désormais au feu, et toutes deux bourdonnent vers le même lieu : le Sighing Wood, la forêt frontalière d'Ysolde, restée hors de toute querelle depuis cent ans."

#. "The Master's third relic, the Master's Signet, sleeps inside the Oldroot, an oak older than the kingdoms. Thr
#: scripts/campaign/mission_03.gd:203
msgid "The Master's third relic, the Master's Signet, sleeps inside the Oldroot, an oak older than the kingdoms. Three Root Hearts feed the thorns that guard it. Malrik's scouts are already in the wood, and his Thralls are draining them."
msgstr "La troisième relique, le Master's Signet, dort dans l'Oldroot, un chêne plus vieux que les royaumes. Trois Root Hearts nourrissent les ronces qui le gardent. Les éclaireurs de Malrik sont déjà dans le bois, et ses Thralls les vident."

#. "Vessa cannot burn a whole forest and win. So she will do what Malrik never would: pay people. The Crooked Lan
#: scripts/campaign/mission_03.gd:204
msgid "Vessa cannot burn a whole forest and win. So she will do what Malrik never would: pay people. The Crooked Lantern is full of sellswords who take no orders, only coin."
msgstr "Vessa ne peut pas brûler toute une forêt et gagner. Elle fera donc ce que Malrik ne ferait jamais : payer les gens. La Crooked Lantern est pleine de mercenaires qui ne prennent pas d'ordres, seulement de l'or."

#. const BRIEFING_RACE_LINE := "Malrik is racing you. If he carries the Signet home, the mission is lost."
#: scripts/campaign/mission_03.gd:206
msgid "Malrik is racing you. If he carries the Signet home, the mission is lost."
msgstr "Malrik fait la course avec vous. S'il rapporte le Signet chez lui, la mission est perdue."

#. const HINT_START := "Hire champions at the Crooked Lantern. Find the Root Hearts in the fog before Malrik does
#: scripts/campaign/mission_03.gd:207
msgid "Hire champions at the Crooked Lantern. Find the Root Hearts in the fog before Malrik does."
msgstr "Engagez des champions à la Crooked Lantern. Trouvez les Root Hearts dans le brouillard avant Malrik."

#. const HINT_HIRE := "%s: hire a champion. Champions choose their own jobs; bounty flags (%s) pay them to do you
#: scripts/campaign/mission_03.gd:208
msgid "%s: hire a champion. Champions choose their own jobs; bounty flags (%s) pay them to do yours."
msgstr "%s : engagez un champion. Il choisit ses tâches ; les drapeaux de prime (%s) le paient pour les vôtres."

#. const HINT_EXPLORE := "%s, then click the fog: an Explore flag. Explorers find the Root Hearts."
#: scripts/campaign/mission_03.gd:209
msgid "%s, then click the fog: an Explore flag. Explorers find the Root Hearts."
msgstr "%s, puis cliquez sur le brouillard : un drapeau d'exploration. Ils trouvent les Root Hearts."

#. const HINT_HUNT := "Put a Hunt bounty on the drain squad (%s, then click a Thrall)."
#: scripts/campaign/mission_03.gd:210
msgid "Put a Hunt bounty on the drain squad (%s, then click a Thrall)."
msgstr "Mettez une prime de chasse sur l'escouade (%s, puis cliquez sur un Thrall)."

#. const HINT_GUARD := "Guard your Ember Stake (%s, then click it): it shows you who is coming."
#: scripts/campaign/mission_03.gd:211
msgid "Guard your Ember Stake (%s, then click it): it shows you who is coming."
msgstr "Gardez votre Ember Stake (%s, puis cliquez dessus) : il vous montre qui arrive."

#. const HINT_E11 := "The Wardens come for the Signet. Break both gates."
#: scripts/campaign/mission_03.gd:212
msgid "The Wardens come for the Signet. Break both gates."
msgstr "Les Wardens viennent pour le Signet. Brisez les deux portes."

#. const MSG_TAVERN := "The Crooked Lantern opens its doors"
#: scripts/campaign/mission_03.gd:213
msgid "The Crooked Lantern opens its doors"
msgstr "La Crooked Lantern ouvre ses portes"

#. const MSG_DRAINED := "Malrik's Thralls drained the Root Heart of %s"
#: scripts/campaign/mission_03.gd:214
msgid "Malrik's Thralls drained the Root Heart of %s"
msgstr "Les Thralls de Malrik ont vidé le Root Heart de %s"

#. const MSG_MARCH := "Malrik marches on the Oldroot"
#: scripts/campaign/mission_03.gd:215
msgid "Malrik marches on the Oldroot"
msgstr "Malrik marche sur l'Oldroot"

#. const MSG_MOSSJAW := "Old Mossjaw wakes"
#: scripts/campaign/mission_03.gd:217
msgid "Old Mossjaw wakes"
msgstr "Old Mossjaw s'éveille"

#. c.victory_banner = "VICTORY\nThe Master's Signet is yours"
#: scripts/campaign/mission_03.gd:307
msgid "VICTORY\nThe Master's Signet is yours"
msgstr "VICTOIRE\nLe Master's Signet est à vous"

#. c.spotlight = {"id": &"wayfinder", "trigger": &"unlock", "key_hint": "Crooked Lantern: Y",
#: scripts/campaign/mission_03.gd:312
