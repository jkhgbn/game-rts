msgstr "Fernhollow"

#. &"S2": ["Charred Glade", Vector3(26.0, 0.0, 28.0), [["rimeshield", 2], ["shardcaster", 2]], 4.0],
#: scripts/campaign/mission_e2_01.gd:61
