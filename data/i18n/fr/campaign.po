msgid "Already built"
msgstr "Déjà construit"

#. const REFUSE_WORKER := "No free Cinder Hand"
#: scripts/campaign/mission_e2_05.gd:241
msgid "No free Cinder Hand"
msgstr "Aucun Cinder Hand libre"

#. const REFUSE_SPOT := "No room for the Roost"
#: scripts/campaign/mission_e2_05.gd:242
msgid "No room for the Roost"
msgstr "Pas de place pour le Perchoir"

#. c.victory_banner = "VICTORY\nThe Door held"
#: scripts/campaign/mission_e2_05.gd:352
msgid "VICTORY\nThe Door held"
msgstr "VICTOIRE\nLa Porte a tenu"

#. c.spotlight = {"id": &"cinder_dragon", "trigger": &"unlock", "key_hint": "Dragon Roost: Z",
#: scripts/campaign/mission_e2_05.gd:361
msgid "Dragon Roost: Z"
msgstr "Perchoir du dragon : Z"

#. "card": "Cinder Dragon. Fire from the sky: it flies over the Rift and burns what walks below."}
#: scripts/campaign/mission_e2_05.gd:362
msgid "Cinder Dragon. Fire from the sky: it flies over the Rift and burns what walks below."
msgstr "Dragon de cendre. Le feu du ciel : il survole la Faille et brûle ce qui marche en dessous."

