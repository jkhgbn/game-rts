#. const MISSION_TITLE := "The Outwall"
#: scripts/campaign/mission_e7_03.gd:23
msgid "The Outwall"
msgstr "L'Outwall"

#. const ROW_NAMES := {&"R1": "Rope Row", &"R2": "Net Lane", &"R3": "Saltpan Court", &"R4": "Low Quay", &"R5": "T
#: scripts/campaign/mission_e7_03.gd:38
msgid "Rope Row"
msgstr "Rang des Cordiers"

#. const ROW_NAMES := {&"R1": "Rope Row", &"R2": "Net Lane", &"R3": "Saltpan Court", &"R4": "Low Quay", &"R5": "T
#: scripts/campaign/mission_e7_03.gd:38
msgid "Net Lane"
msgstr "Ruelle des Filets"

#. const ROW_NAMES := {&"R1": "Rope Row", &"R2": "Net Lane", &"R3": "Saltpan Court", &"R4": "Low Quay", &"R5": "T
#: scripts/campaign/mission_e7_03.gd:38
msgid "Saltpan Court"
msgstr "Cour des Salines"

#. const ROW_NAMES := {&"R1": "Rope Row", &"R2": "Net Lane", &"R3": "Saltpan Court", &"R4": "Low Quay", &"R5": "T
#: scripts/campaign/mission_e7_03.gd:38
msgid "Low Quay"
msgstr "Quai bas"

#. const ROW_NAMES := {&"R1": "Rope Row", &"R2": "Net Lane", &"R3": "Saltpan Court", &"R4": "Low Quay", &"R5": "T
#: scripts/campaign/mission_e7_03.gd:38
msgid "Tar Steps"
msgstr "Marches du Goudron"

#. [&"ossavar", "The Outwall. Where the coin is earned, and never spent."],
#: scripts/campaign/mission_e7_03.gd:91 data/voice/lines/e7m3.json:L1
msgid "The Outwall. Where the coin is earned, and never spent."
msgstr "L'Outwall. Là où l'argent se gagne, et ne se dépense jamais."

#. [&"brannet", "You're the ice-king? We've had kings before. They stand on the wall and watch."],
#: scripts/campaign/mission_e7_03.gd:92 data/voice/lines/e7m3.json:L2
msgid "You're the ice-king? We've had kings before. They stand on the wall and watch."
msgstr "C'est vous, le roi de glace ? On en a déjà eu, des rois. Ils restent sur le mur et ils regardent."

#. [&"torvald", "Then I will stand down here. Ring your bells when I tell you, and bring your people to me."],
#: scripts/campaign/mission_e7_03.gd:93 data/voice/lines/e7m3.json:L3
msgid "Then I will stand down here. Ring your bells when I tell you, and bring your people to me."
msgstr "Alors je resterai en bas. Sonnez vos cloches quand je vous le dirai, et amenez-moi vos gens."

#. [&"aldra", "The Glass Hall is open, my lord. It holds more than you think. Winter is roomy."],
#: scripts/campaign/mission_e7_03.gd:94 data/voice/lines/e7m3.json:L4
msgid "The Glass Hall is open, my lord. It holds more than you think. Winter is roomy."
msgstr "Le Glass Hall est ouvert, seigneur. Il contient plus que tu crois. L'hiver a de la place."

#. [&"brannet", "Rope Row's coming. Mind the old ones, they walk slow. Like you, no offence."],
#: scripts/campaign/mission_e7_03.gd:95 data/voice/lines/e7m3.json:L5
msgid "Rope Row's coming. Mind the old ones, they walk slow. Like you, no offence."
msgstr "Rope Row s'en vient. Attention aux vieux, ils marchent lentement. Comme vous, sans offense."

#. [&"aldra", "Crimson lanterns on the water. Aurivane burns what it cannot buy."],
#: scripts/campaign/mission_e7_03.gd:96 data/voice/lines/e7m3.json:L6
msgid "Crimson lanterns on the water. Aurivane burns what it cannot buy."
msgstr "Des lanternes rouges sur l'eau. Aurivane brûle ce qu'elle ne peut pas acheter."

#. [&"brannet", "Facetguards, turned back by an ice-king. I'll be telling that one in the tavern for years."],
#: scripts/campaign/mission_e7_03.gd:97 data/voice/lines/e7m3.json:L7
msgid "Facetguards, turned back by an ice-king. I'll be telling that one in the tavern for years."
msgstr "Des Facetguards renvoyés par un roi de glace. Celle-là, je vais la raconter à la taverne pendant des années."

#. [&"brannet", "The Archon's press took a whole lane. They'll dig till they drop, and nobody'll count them."],
#: scripts/campaign/mission_e7_03.gd:98 data/voice/lines/e7m3.json:L7b
msgid "The Archon's press took a whole lane. They'll dig till they drop, and nobody'll count them."
msgstr "La presse de l'Archonte a pris toute une ruelle. Ils creuseront jusqu'à tomber, et personne les comptera."

#. [&"aldra", "Men in grey masks, out of the old adit. They do not take coin. They take people."],
#: scripts/campaign/mission_e7_03.gd:99 data/voice/lines/e7m3.json:L8
msgid "Men in grey masks, out of the old adit. They do not take coin. They take people."
msgstr "Des masques gris, sortis de la vieille galerie. Ils ne prennent pas l'argent. Ils prennent les gens."

#. [&"diamond_archon", "Ice-king. Adamarch did not open its harbour to you so you could herd fishermen."],
#: scripts/campaign/mission_e7_03.gd:100 data/voice/lines/e7m3.json:L9
msgid "Ice-king. Adamarch did not open its harbour to you so you could herd fishermen."
msgstr "Roi de glace. Adamarch ne vous a pas ouvert son port pour que vous meniez des pêcheurs comme du bétail."

#. [&"diamond_archon", "Guard my pits. The diamonds pay for your dragons. The Outwall can look after itself."],
#: scripts/campaign/mission_e7_03.gd:101 data/voice/lines/e7m3.json:L10
msgid "Guard my pits. The diamonds pay for your dragons. The Outwall can look after itself."
msgstr "Gardez mes mines. Les diamants paient vos dragons. L'Outwall peut se débrouiller seul."

#. [&"torvald", "It has been looking after itself for a thousand years, Your Radiance. Look where it got them."],
#: scripts/campaign/mission_e7_03.gd:102 data/voice/lines/e7m3.json:L11
msgid "It has been looking after itself for a thousand years, Your Radiance. Look where it got them."
msgstr "Il se débrouille seul depuis mille ans, Votre Éclat. Voyez où ça l'a mené."

#. [&"aldra", "Diamond tithe. Every minute you stand there, my lord, the Archon pays. Every minute."],
#: scripts/campaign/mission_e7_03.gd:103 data/voice/lines/e7m3.json:L12
msgid "Diamond tithe. Every minute you stand there, my lord, the Archon pays. Every minute."
msgstr "La dîme des diamants. Chaque minute que tu restes là, seigneur, l'Archonte paie. Chaque minute."

#. [&"diamond_archon", "Those beasts are the property of the Diamond Hall. You will answer for them."],
#: scripts/campaign/mission_e7_03.gd:104 data/voice/lines/e7m3.json:L13
msgid "Those beasts are the property of the Diamond Hall. You will answer for them."
msgstr "Ces bêtes sont la propriété du Diamond Hall. Vous en répondrez."

#. [&"torvald", "Then I will answer for them. They will answer to nobody."],
#: scripts/campaign/mission_e7_03.gd:105 data/voice/lines/e7m3.json:L14
msgid "Then I will answer for them. They will answer to nobody."
msgstr "Alors j'en répondrai. Elles, elles ne répondront à personne."

#. [&"brannet", "Net Lane, out! Follow the cold, it's the only thing tonight that isn't lying to us."],
#: scripts/campaign/mission_e7_03.gd:106 data/voice/lines/e7m3.json:L15
msgid "Net Lane, out! Follow the cold, it's the only thing tonight that isn't lying to us."
msgstr "Net Lane, dehors ! Suivez le froid, c'est la seule chose cette nuit qui nous ment pas."

#. [&"brannet", "The boats are in. Two crews, sixteen souls, and the whole night coming for them."],
#: scripts/campaign/mission_e7_03.gd:107 data/voice/lines/e7m3.json:L16
msgid "The boats are in. Two crews, sixteen souls, and the whole night coming for them."
msgstr "Les bateaux sont rentrés. Deux équipages, seize âmes, et toute la nuit qui s'en vient pour eux."

#. [&"seraphine", "The Archon forbade this. The Hall of Silence can fine me. These are Adamarch's people too."],
#: scripts/campaign/mission_e7_03.gd:108 data/voice/lines/e7m3.json:L17
msgid "The Archon forbade this. The Hall of Silence can fine me. These are Adamarch's people too."
msgstr "L'Archonte l'a interdit. Le Hall of Silence peut me mettre à l'amende. Ce sont aussi les gens d'Adamarch."

#. [&"torvald", "Pits to the east, fishers to the south. Aldra, I cannot stand in two places."],
#: scripts/campaign/mission_e7_03.gd:109 data/voice/lines/e7m3.json:L18
msgid "Pits to the east, fishers to the south. Aldra, I cannot stand in two places."
msgstr "Les mines à l'est, les pêcheurs au sud. Aldra, je ne peux pas être à deux places."

#. [&"aldra", "Their captain comes himself. Break his mask, my lord. I want to see what is under it."],
#: scripts/campaign/mission_e7_03.gd:110 data/voice/lines/e7m3.json:L19
msgid "Their captain comes himself. Break his mask, my lord. I want to see what is under it."
msgstr "Leur capitaine vient en personne. Brise son masque, seigneur. Je veux voir ce qu'il y a dessous."

#. [&"torvald", "Violet. And a candle sigil. Malrik, you are taking rowers from the gutter now."],
#: scripts/campaign/mission_e7_03.gd:111 data/voice/lines/e7m3.json:L20
msgid "Violet. And a candle sigil. Malrik, you are taking rowers from the gutter now."
msgstr "Violet. Et un sceau de chandelle. Malrik, tu prends des rameurs dans le caniveau, maintenant."

#. [&"aldra", "His gift at the auction was their wages. Tonight he came back for the men."],
#: scripts/campaign/mission_e7_03.gd:112 data/voice/lines/e7m3.json:L21
msgid "His gift at the auction was their wages. Tonight he came back for the men."
msgstr "Son cadeau à l'enchère, c'était leurs salaires. Cette nuit, il est revenu chercher les hommes."

#. [&"ossavar", "The last tide, Ice-king. The cities always send the biggest boats just before morning."],
#: scripts/campaign/mission_e7_03.gd:113 data/voice/lines/e7m3.json:L22
msgid "The last tide, Ice-king. The cities always send the biggest boats just before morning."
msgstr "La dernière marée, roi de glace. Les villes envoient toujours les plus gros bateaux juste avant le matin."

#. [&"brannet", "Half the Outwall gone! Ice-king, whatever you're guarding, it isn't us!"],
#: scripts/campaign/mission_e7_03.gd:114 data/voice/lines/e7m3.json:L23
msgid "Half the Outwall gone! Ice-king, whatever you're guarding, it isn't us!"
msgstr "La moitié de l'Outwall partie ! Roi de glace, ce que vous gardez, c'est pas nous !"

#. [&"brannet", "Every bell's rung. I never heard all five at once. Sounds like a festival."],
#: scripts/campaign/mission_e7_03.gd:115 data/voice/lines/e7m3.json:L24
msgid "Every bell's rung. I never heard all five at once. Sounds like a festival."
msgstr "Toutes les cloches ont sonné. Je les avais jamais entendues toutes les cinq. On dirait une fête."

#. [&"brannet", "Dawn, and the Outwall's still here. Nobody on the wall will ever thank you. So: thank you."],
#: scripts/campaign/mission_e7_03.gd:116 data/voice/lines/e7m3.json:L25
msgid "Dawn, and the Outwall's still here. Nobody on the wall will ever thank you. So: thank you."
msgstr "L'aube, et l'Outwall est encore là. Personne sur le mur vous dira merci. Alors : merci."

#. [&"diamond_archon", "The pits held. Adamarch pays its debts, Ice-king. It never forgets them, either."],
#: scripts/campaign/mission_e7_03.gd:117 data/voice/lines/e7m3.json:L26
msgid "The pits held. Adamarch pays its debts, Ice-king. It never forgets them, either."
msgstr "Les mines ont tenu. Adamarch paie ses dettes, roi de glace. Elle ne les oublie jamais non plus."

#. [&"diamond_archon", "My pits stood empty all night. Remember that I asked you, and that you chose."],
#: scripts/campaign/mission_e7_03.gd:118 data/voice/lines/e7m3.json:L27
msgid "My pits stood empty all night. Remember that I asked you, and that you chose."
msgstr "Mes mines sont restées vides toute la nuit. Souvenez-vous : je vous l'ai demandé, et vous avez choisi."

#. [&"ossavar", "You did not pay for that, Ice-king. Nobody paid for that. I will remember."],
#: scripts/campaign/mission_e7_03.gd:119 data/voice/lines/e7m3.json:L28
msgid "You did not pay for that, Ice-king. Nobody paid for that. I will remember."
msgstr "Tu n'as pas été payé pour ça, roi de glace. Personne n'a payé pour ça. Je m'en souviendrai."

#. [&"torvald", "I waited too long again. The lanes are quiet. Too quiet, for a morning."],
#: scripts/campaign/mission_e7_03.gd:120 data/voice/lines/e7m3.json:L29
msgid "I waited too long again. The lanes are quiet. Too quiet, for a morning."
msgstr "J'ai encore attendu trop longtemps. Les ruelles sont calmes. Trop calmes, pour un matin."

#. [&"torvald", "Not here... not in front of them..."],
#: scripts/campaign/mission_e7_03.gd:121 data/voice/lines/e7m3.json:L30
msgid "Not here... not in front of them..."
msgstr "Pas ici... pas devant eux..."

#. [&"aldra", "The lanes are empty, my lord. There is nobody left to shelter."],
#: scripts/campaign/mission_e7_03.gd:122 data/voice/lines/e7m3.json:L31
msgid "The lanes are empty, my lord. There is nobody left to shelter."
msgstr "Les ruelles sont vides, seigneur. Il ne reste plus personne à abriter."

#. "Adamarch admits nobody who has not paid in gold and proved it in blood. Everyone else lives outside the white
#: scripts/campaign/mission_e7_03.gd:125
msgid "Adamarch admits nobody who has not paid in gold and proved it in blood. Everyone else lives outside the white wall, in the Outwall: dockers, net-menders, rowers, the hands that make the Diamond City rich. Tonight nobody is guarding them."
msgstr "Adamarch n'admet personne qui n'a pas payé en or et ne l'a pas prouvé dans le sang. Tous les autres vivent hors du mur blanc, dans l'Outwall : débardeurs, ravaudeurs de filets, rameurs, les mains qui font la richesse de la Cité de diamant. Cette nuit, personne ne les garde."

#. "Aurivane's boats are landing raiders on the quays. Adamarch's own press-gangs are emptying the lanes to dig t
#: scripts/campaign/mission_e7_03.gd:126
msgid "Aurivane's boats are landing raiders on the quays. Adamarch's own press-gangs are emptying the lanes to dig the pits deeper. And masked men come out of the old diamond adit and take people into the dark."
msgstr "Les bateaux d'Aurivane débarquent des pillards sur les quais. Les racoleurs d'Adamarch elle-même vident les ruelles pour creuser les mines plus profond. Et des hommes masqués sortent de la vieille galerie de diamants et emmènent des gens dans le noir."

#. "Torvald camps against the wall with Aldra and what is left of his army. The Diamond Archon will send her orde
#: scripts/campaign/mission_e7_03.gd:127
msgid "Torvald camps against the wall with Aldra and what is left of his army. The Diamond Archon will send her orders soon. He already knows what she will ask. He does not yet know what he will answer."
msgstr "Torvald campe contre le mur avec Aldra et ce qui reste de son armée. L'Archonte de diamant enverra bientôt ses ordres. Il sait déjà ce qu'elle demandera. Il ne sait pas encore ce qu'il répondra."

#. const BRIEFING_LINE := "Ring a Dock Bell and its lane follows you to the shelter by your Keep."
#: scripts/campaign/mission_e7_03.gd:129
msgid "Ring a Dock Bell and its lane follows you to the shelter by your Keep."
msgstr "Sonne une cloche des quais et sa ruelle te suit jusqu'à l'abri près de ton donjon."

#. const HINT_START := "Ring a Dock Bell: hold Torvald beside it (3 s). Its lane walks to the shelter by your Kee
#: scripts/campaign/mission_e7_03.gd:130
msgid "Ring a Dock Bell: hold Torvald beside it (3 s). Its lane walks to the shelter by your Keep. Raiders hunt anyone walking."
msgstr "Sonne une cloche des quais : garde Torvald à côté (3 s). Sa ruelle marche jusqu'à l'abri près de ton donjon. Les pillards traquent quiconque marche."

#. const MSG_MASKS := "Masked men out of the old adit"
#: scripts/campaign/mission_e7_03.gd:131
msgid "Masked men out of the old adit"
msgstr "Des hommes masqués sortent de la vieille galerie"

#. const MSG_DUSK := "The fishing crews are home. The Night Tide comes at 17:00."
#: scripts/campaign/mission_e7_03.gd:132
msgid "The fishing crews are home. The Night Tide comes at 17:00."
msgstr "Les équipages de pêche sont rentrés. La Marée de nuit arrive à 17:00."

#. const MSG_EMPTYING := "The Outwall is emptying: 10 more lost and the night is lost"
#: scripts/campaign/mission_e7_03.gd:133
msgid "The Outwall is emptying: 10 more lost and the night is lost"
msgstr "L'Outwall se vide : 10 de plus perdus et la nuit est perdue"

#. const MSG_BELL_REFUSED := "The lane won't open its doors with raiders in the street"
#: scripts/campaign/mission_e7_03.gd:134
msgid "The lane won't open its doors with raiders in the street"
msgstr "La ruelle n'ouvrira pas ses portes avec des pillards dans la rue"

#. const MSG_BURNT := "%s burns"
#: scripts/campaign/mission_e7_03.gd:135
msgid "%s burns"
msgstr "%s brûle"

#. const MSG_SEIZED := "Masks take %s into the dark"
#: scripts/campaign/mission_e7_03.gd:136
msgid "Masks take %s into the dark"
msgstr "Les masques emmènent %s dans le noir"

#. const MSG_PRESSED := "The Archon's press takes %s"
#: scripts/campaign/mission_e7_03.gd:137
msgid "The Archon's press takes %s"
msgstr "Les racoleurs de l'Archonte prennent %s"

#. const MSG_TITHE := "Every pit you hold pays gold (+%d / min each). Every row you leave costs lives."
#: scripts/campaign/mission_e7_03.gd:138
msgid "Every pit you hold pays gold (+%d / min each). Every row you leave costs lives."
msgstr "Chaque mine que tu tiens rapporte de l'or (+%d / min chacune). Chaque rang que tu abandonnes coûte des vies."

#. const MSG_TAKING := "{row} is being taken: send soldiers to its bell!"
#: scripts/campaign/mission_e7_03.gd:139
msgid "{row} is being taken: send soldiers to its bell!"
msgstr "On s'empare de {row} : envoie des soldats à sa cloche !"

#. const HINT_MAMMOTHS := "Two hauling mammoths are chained in the Hauling Yard: hold Torvald at the chain post (
#: scripts/campaign/mission_e7_03.gd:143
msgid "Two hauling mammoths are chained in the Hauling Yard: hold Torvald at the chain post (4 s) to free them."
msgstr "Deux mammouths de halage sont enchaînés dans la Cour de halage : garde Torvald au poteau des chaînes (4 s) pour les libérer."

#. c.keep_lost_message = "The Glass Hall has fallen."
#: scripts/campaign/mission_e7_03.gd:199
msgid "The Glass Hall has fallen."
msgstr "Le Glass Hall est tombé."

#. c.victory_banner = "VICTORY\nDawn over the Outwall"
#: scripts/campaign/mission_e7_03.gd:209
msgid "VICTORY\nDawn over the Outwall"
msgstr "VICTOIRE\nL'aube sur l'Outwall"

#. c.spotlight = {"id": &"war_mammoth", "trigger": &"manual", "key_hint": "Free them at the Hauling Yard",
#: scripts/campaign/mission_e7_03.gd:212
msgid "Free them at the Hauling Yard"
msgstr "Libère-les dans la Cour de halage"

#. "card": "War Mammoth. A titan of the far north: it walks through a line like snow through a fence."}
#: scripts/campaign/mission_e7_03.gd:213
msgid "War Mammoth. A titan of the far north: it walks through a line like snow through a fence."
msgstr "War Mammoth. Un titan du Grand Nord : il traverse une ligne comme la neige une clôture."

#. return "Episode 7, Mission 3: %s" % MISSION_TITLE
#: scripts/campaign/mission_e7_03.gd:226
msgid "Episode 7, Mission 3: %s"
msgstr "Épisode 7, mission 3 : %s"

#. return "Ring the Dock Bells (%d / 5): sheltered %d, lost %d, pressed %d (of 40)" % [bells_rung.size(), shelter
#: scripts/campaign/mission_e7_03.gd:422
msgid "Ring the Dock Bells (%d / 5): sheltered %d, lost %d, pressed %d (of 40)"
msgstr "Sonne les cloches des quais (%d / 5) : abrités %d, perdus %d, enrôlés %d (sur 40)"

#. return "Ring the Dock Bells"
#: scripts/campaign/mission_e7_03.gd:423
msgid "Ring the Dock Bells"
msgstr "Sonne les cloches des quais"

#. return "Hold the Outwall until dawn (%s)" % mmss(DAWN_AT - mission_time())
#: scripts/campaign/mission_e7_03.gd:426
msgid "Hold the Outwall until dawn (%s)"
msgstr "Tiens l'Outwall jusqu'à l'aube (%s)"

#. return "Hold the Outwall until dawn"
#: scripts/campaign/mission_e7_03.gd:427
msgid "Hold the Outwall until dawn"
msgstr "Tiens l'Outwall jusqu'à l'aube"

#. return "Do not lose %d of the Outwall's 40 people (lost %d)" % [lost_limit(), lost]
#: scripts/campaign/mission_e7_03.gd:430
msgid "Do not lose %d of the Outwall's 40 people (lost %d)"
msgstr "Ne perds pas %d des 40 habitants de l'Outwall (perdus %d)"

#. return "Do not lose %d of the Outwall's 40 people" % lost_limit()
#: scripts/campaign/mission_e7_03.gd:431
msgid "Do not lose %d of the Outwall's 40 people"
msgstr "Ne perds pas %d des 40 habitants de l'Outwall"

#. return "Shelter %d of the Outwall's people" % int(by_difficulty(PEOPLE_NEED))
#: scripts/campaign/mission_e7_03.gd:435
msgid "Shelter %d of the Outwall's people"
msgstr "Abrite %d habitants de l'Outwall"

#. return "Hold the Diamond Archon's pits at dawn (%d / 3)" % _held_count()
#: scripts/campaign/mission_e7_03.gd:438
msgid "Hold the Diamond Archon's pits at dawn (%d / 3)"
msgstr "Tiens les mines de l'Archonte de diamant à l'aube (%d / 3)"

#. return "Hold the Diamond Archon's pits at dawn"
#: scripts/campaign/mission_e7_03.gd:439
msgid "Hold the Diamond Archon's pits at dawn"
msgstr "Tiens les mines de l'Archonte de diamant à l'aube"

#. return "Free the hauling mammoths"
#: scripts/campaign/mission_e7_03.gd:441
msgid "Free the hauling mammoths"
msgstr "Libère les mammouths de halage"

#. return "Unmask the Mask Captain"
#: scripts/campaign/mission_e7_03.gd:443
msgid "Unmask the Mask Captain"
msgstr "Démasque le Capitaine masqué"

#. return "Not while the Outwall's people are walking"
#: scripts/campaign/mission_e7_03.gd:1154
msgid "Not while the Outwall's people are walking"
msgstr "Pas pendant que les gens de l'Outwall marchent"

#. rows.append([Loc.t("Pay {name} home ({price})", {"name": PAY_NAMES[id], "price": pay_price(id)}),
#: scripts/campaign/mission_e7_04.gd:717
msgid "Pay {name} home ({price})"
msgstr "Renvoyer {name} chez lui ({price})"

#. const MISSION_TITLE := "The Year of Two Skies"
#: scripts/campaign/mission_e7_04.gd:26
msgid "The Year of Two Skies"
msgstr "L'Année des deux ciels"

#. const PAY_NAMES := {"gilt_dragon": "Kesh", "prism_dragon": "Morrow", "sunwake": "Sunwake"}
#: scripts/campaign/mission_e7_04.gd:47
msgid "Morrow"
msgstr "Morrow"

#. const PAY_NAMES := {"gilt_dragon": "Kesh", "prism_dragon": "Morrow", "sunwake": "Sunwake"}
#: scripts/campaign/mission_e7_04.gd:47 scripts/campaign/mission_e7_04.gd:501
#: scripts/campaign/mission_e7_base.gd:157
msgid "Sunwake"
msgstr "Sunwake"

#. [&"ossavar", "The Year of Two Skies comes round again. Every ship. Every dragon. One strait."],
#: scripts/campaign/mission_e7_04.gd:90 data/voice/lines/e7m4.json:L1
msgid "The Year of Two Skies comes round again. Every ship. Every dragon. One strait."
msgstr "L'Année des Deux Ciels revient. Chaque navire. Chaque dragon. Un seul détroit."

#. [&"malrik", "Today we finish Aurivane, Torvald. Take the rock. I will handle the sky."],
#: scripts/campaign/mission_e7_04.gd:91 data/voice/lines/e7m4.json:L2
msgid "Today we finish Aurivane, Torvald. Take the rock. I will handle the sky."
msgstr "Aujourd'hui, on achève Aurivane, Torvald. Prends le rocher. Je m'occupe du ciel."

#. [&"torvald", "You handled the Laurel too, Malrik. I have not forgotten whose knives they were."],
#: scripts/campaign/mission_e7_04.gd:92 data/voice/lines/e7m4.json:L3
msgid "You handled the Laurel too, Malrik. I have not forgotten whose knives they were."
msgstr "Tu t'es occupé du Laurel aussi, Malrik. Je n'ai pas oublié à qui étaient ces couteaux."

#. [&"malrik", "Then remember it after we win. Victory is a wonderful eraser."],
#: scripts/campaign/mission_e7_04.gd:93 data/voice/lines/e7m4.json:L4
msgid "Then remember it after we win. Victory is a wonderful eraser."
msgstr "Alors souviens-t'en après la victoire. La victoire est une merveilleuse efface."

#. [&"aldra", "Crimson sails on the water. They will shell the shore road. Sink them, or stay off it."],
#: scripts/campaign/mission_e7_04.gd:94 data/voice/lines/e7m4.json:L5
msgid "Crimson sails on the water. They will shell the shore road. Sink them, or stay off it."
msgstr "Des voiles rouges sur l'eau. Elles vont bombarder la route du rivage. Coule-les, ou restes-en loin."

#. [&"vessa", "Last chance to pick the right side, Torvald! I'm told I'm very forgiving!"],
#: scripts/campaign/mission_e7_04.gd:95 data/voice/lines/e7m4.json:L6
msgid "Last chance to pick the right side, Torvald! I'm told I'm very forgiving!"
msgstr "Dernière chance de choisir le bon côté, Torvald ! Il paraît que je pardonne facilement !"

#. [&"torvald", "You are told many things, Vessa. Most of them by people standing behind you."],
#: scripts/campaign/mission_e7_04.gd:96 data/voice/lines/e7m4.json:L7
msgid "You are told many things, Vessa. Most of them by people standing behind you."
msgstr "On te dit bien des choses, Vessa. Surtout des gens qui se tiennent derrière toi."

#. [&"ossavar", "One small sale before the great one. Sunwake, Aurivane's pride. Who pays?"],
#: scripts/campaign/mission_e7_04.gd:97 data/voice/lines/e7m4.json:L8
msgid "One small sale before the great one. Sunwake, Aurivane's pride. Who pays?"
msgstr "Une petite vente avant la grande. Sunwake, la fierté d'Aurivane. Qui paie ?"

#. [&"torvald", "Sunwake flies with us. For the morning, at least."],
#: scripts/campaign/mission_e7_04.gd:98 data/voice/lines/e7m4.json:L9
msgid "Sunwake flies with us. For the morning, at least."
msgstr "Sunwake vole avec nous. Pour la matinée, au moins."

#. [&"ossavar", "Sunwake keeps her old masters. For now."],
#: scripts/campaign/mission_e7_04.gd:99 data/voice/lines/e7m4.json:L10
msgid "Sunwake keeps her old masters. For now."
msgstr "Sunwake garde ses anciens maîtres. Pour l'instant."

#. [&"ysolde", "Malrik! Every grave you dig, I will plant over. Every single one!"],
#: scripts/campaign/mission_e7_04.gd:100 data/voice/lines/e7m4.json:L11
msgid "Malrik! Every grave you dig, I will plant over. Every single one!"
msgstr "Malrik ! Chaque tombe que tu creuses, je vais la planter. Chacune !"

#. [&"malrik", "Then you will be a very busy gardener, Ysolde."],
#: scripts/campaign/mission_e7_04.gd:101 data/voice/lines/e7m4.json:L12
msgid "Then you will be a very busy gardener, Ysolde."
msgstr "Alors tu vas être une jardinière très occupée, Ysolde."

#. [&"aldra", "One red sail under. The sea keeps the coin, as usual."],
#: scripts/campaign/mission_e7_04.gd:102 data/voice/lines/e7m4.json:L13
msgid "One red sail under. The sea keeps the coin, as usual."
msgstr "Une voile rouge sous l'eau. La mer garde l'argent, comme d'habitude."

#. [&"seraphine", "The rock is Adamarch's! The Archon is watching from the spire, Ice-king. So is everyone."],
#: scripts/campaign/mission_e7_04.gd:103 data/voice/lines/e7m4.json:L14
msgid "The rock is Adamarch's! The Archon is watching from the spire, Ice-king. So is everyone."
msgstr "Le rocher est à Adamarch ! L'Archonte regarde depuis la flèche, roi de glace. Tout le monde regarde."

#. [&"diamond_archon", "Empty the pits. All of them. Let the sky be white and silver by noon."],
#: scripts/campaign/mission_e7_04.gd:104 data/voice/lines/e7m4.json:L15
msgid "Empty the pits. All of them. Let the sky be white and silver by noon."
msgstr "Videz les mines. Toutes. Que le ciel soit blanc et argent avant midi."

#. [&"ossavar", "Every dragon on the Coinwater changes sides in one morning. I have seen this before."],
#: scripts/campaign/mission_e7_04.gd:105 data/voice/lines/e7m4.json:L16
msgid "Every dragon on the Coinwater changes sides in one morning. I have seen this before."
msgstr "Tous les dragons du Coinwater changent de camp en un matin. J'ai déjà vu ça."

#. [&"vessa", "He bought the whole SKY? Ysolde, pull back! Everyone, back to the ships!"],
#: scripts/campaign/mission_e7_04.gd:106 data/voice/lines/e7m4.json:L17
msgid "He bought the whole SKY? Ysolde, pull back! Everyone, back to the ships!"
msgstr "Il a acheté tout le CIEL ? Ysolde, recule ! Tout le monde, aux navires !"

#. [&"dacian", "Enough. Seraphine, the cloth. We end this on the sand, the old way."],
#: scripts/campaign/mission_e7_04.gd:107 data/voice/lines/e7m4.json:L18
msgid "Enough. Seraphine, the cloth. We end this on the sand, the old way."
msgstr "Assez. Seraphine, le drap. On finit ça sur le sable, à l'ancienne."

#. [&"seraphine", "A truce, Sunblade. No bets. No knives. Just us."],
#: scripts/campaign/mission_e7_04.gd:108 data/voice/lines/e7m4.json:L19
msgid "A truce, Sunblade. No bets. No knives. Just us."
msgstr "Une trêve, Sunblade. Pas de paris. Pas de couteaux. Juste nous."

#. [&"malrik", "Burn them. Both fleets, the sand, the cloth. A strait of dead feeds the stone for years."],
#: scripts/campaign/mission_e7_04.gd:109 data/voice/lines/e7m4.json:L20
msgid "Burn them. Both fleets, the sand, the cloth. A strait of dead feeds the stone for years."
msgstr "Brûlez-les. Les deux flottes, le sable, le drap. Un détroit de morts nourrit la pierre pour des années."

#. [&"obren", "Yes, Bishop. A whole sea of them. Feed me, and I will crown you king of the deep."],
#: scripts/campaign/mission_e7_04.gd:110 data/voice/lines/e7m4.json:L21
msgid "Yes, Bishop. A whole sea of them. Feed me, and I will crown you king of the deep."
msgstr "Oui, Évêque. Toute une mer de morts. Nourris-moi, et je te couronnerai roi des profondeurs."

#. [&"torvald", "No."],
#: scripts/campaign/mission_e7_04.gd:111 data/voice/lines/c_e4_frontier.json:L4
#: data/voice/lines/e7m4.json:L22
msgid "No."
msgstr "Non."

#. [&"malrik", "You said that once before, in your hall. \"For now,\" you said."],
#: scripts/campaign/mission_e7_04.gd:112 data/voice/lines/e7m4.json:L23
msgid "You said that once before, in your hall. \"For now,\" you said."
msgstr "Tu l'as déjà dit une fois, dans ta salle. « Pour l'instant », que tu disais."

#. [&"torvald", "I am done waiting, Malrik. Aldra. Everyone. To the rock."],
#: scripts/campaign/mission_e7_04.gd:113 data/voice/lines/e7m4.json:L24
msgid "I am done waiting, Malrik. Aldra. Everyone. To the rock."
msgstr "J'ai fini d'attendre, Malrik. Aldra. Tout le monde. Au rocher."

#. [&"ossavar", "You paid me once, Ice-king, in clean coin. That bond still holds. I fly with you."],
#: scripts/campaign/mission_e7_04.gd:114 data/voice/lines/e7m4.json:L25
msgid "You paid me once, Ice-king, in clean coin. That bond still holds. I fly with you."
msgstr "Tu m'as payé une fois, roi de glace, en argent propre. Ce lien tient toujours. Je vole avec toi."

#. [&"ossavar", "You never bought me, Ice-king. That is why I will fly with you."],
#: scripts/campaign/mission_e7_04.gd:115 data/voice/lines/e7m4.json:L25a
msgid "You never bought me, Ice-king. That is why I will fly with you."
msgstr "Tu ne m'as jamais acheté, roi de glace. C'est pour ça que je vole avec toi."

#. [&"ossavar", "And you sheltered the Outwall when nobody paid. I remember debts."],
#: scripts/campaign/mission_e7_04.gd:116 data/voice/lines/e7m4.json:L25b
msgid "And you sheltered the Outwall when nobody paid. I remember debts."
msgstr "Et tu as abrité l'Outwall quand personne ne payait. Je me souviens de mes dettes."

#. [&"vessa", "Torvald? You're fighting HIM? ...Fine. Aurivane stands down. Don't make me regret it."],
#: scripts/campaign/mission_e7_04.gd:117 data/voice/lines/e7m4.json:L26
msgid "Torvald? You're fighting HIM? ...Fine. Aurivane stands down. Don't make me regret it."
msgstr "Torvald ? Tu te bats contre LUI ? ...Bon. Aurivane se retire. Fais-moi pas regretter ça."

#. [&"malrik", "Kesh. Morrow. Sunwake. I filled your hoards to the brim. Earn them."],
#: scripts/campaign/mission_e7_04.gd:118 data/voice/lines/e7m4.json:L27
msgid "Kesh. Morrow. Sunwake. I filled your hoards to the brim. Earn them."
msgstr "Kesh. Morrow. Sunwake. J'ai rempli vos trésors à ras bord. Méritez-les."

#. [&"aldra", "My lord, the Bazaar. A dragon serves whoever filled the hoard last. Pay them to fly away."],
#: scripts/campaign/mission_e7_04.gd:119 data/voice/lines/e7m4.json:L28
msgid "My lord, the Bazaar. A dragon serves whoever filled the hoard last. Pay them to fly away."
msgstr "Seigneur, le Bazar. Un dragon sert celui qui a rempli son trésor en dernier. Paie-les pour qu'ils partent."

#. [&"ossavar", "Paid to go home. The one price he never tried."],
#: scripts/campaign/mission_e7_04.gd:120 data/voice/lines/e7m4.json:L29
msgid "Paid to go home. The one price he never tried."
msgstr "Payés pour rentrer chez eux. Le seul prix qu'il n'avait jamais essayé."

#. [&"hush", "There is always another night, Ice-king. Tonight it is yours."],
#: scripts/campaign/mission_e7_04.gd:121 data/voice/lines/e7m4.json:L30
msgid "There is always another night, Ice-king. Tonight it is yours."
msgstr "Il y a toujours une autre nuit, roi de glace. Cette nuit, elle est à toi."

#. [&"torvald", "Then I will spend it awake."],
#: scripts/campaign/mission_e7_04.gd:122 data/voice/lines/e7m4.json:L31
msgid "Then I will spend it awake."
msgstr "Alors je la passerai éveillé."

#. [&"brannet", "Those oars were ours! Nobody from the Outwall rows for the candle-man!"],
#: scripts/campaign/mission_e7_04.gd:123 data/voice/lines/e7m4.json:L32
msgid "Those oars were ours! Nobody from the Outwall rows for the candle-man!"
msgstr "Ces rames étaient à nous ! Personne de l'Outwall rame pour l'homme à la chandelle !"

#. [&"aldra", "Silver sinks the same as crimson, my lord. Slower, perhaps. Heavier pride."],
#: scripts/campaign/mission_e7_04.gd:124 data/voice/lines/e7m4.json:L32b
msgid "Silver sinks the same as crimson, my lord. Slower, perhaps. Heavier pride."
msgstr "L'argent coule aussi bien que le cramoisi, seigneur. Plus lentement, peut-être. Plus lourd d'orgueil."

#. [&"obren", "More, Bishop. The sea is generous tonight."],
#: scripts/campaign/mission_e7_04.gd:125 data/voice/lines/e7m4.json:L33
msgid "More, Bishop. The sea is generous tonight."
msgstr "Encore, Évêque. La mer est généreuse cette nuit."

#. [&"malrik", "Do you hear it, Torvald? Every one of them is mine now. Every single one."],
#: scripts/campaign/mission_e7_04.gd:126 data/voice/lines/e7m4.json:L33b
msgid "Do you hear it, Torvald? Every one of them is mine now. Every single one."
msgstr "Tu l'entends, Torvald ? Chacun d'eux est à moi, maintenant. Chacun."

#. [&"ossavar", "He walked out once, and the sea went still. Your turn, Ice-king. Go to the light."],
#: scripts/campaign/mission_e7_04.gd:127 data/voice/lines/e7m4.json:L34
msgid "He walked out once, and the sea went still. Your turn, Ice-king. Go to the light."
msgstr "Il est sorti une fois, et la mer s'est figée. À ton tour, roi de glace. Va vers la lumière."

#. [&"aldra", "The west water is glass. Their galleys are stuck fast."],
#: scripts/campaign/mission_e7_04.gd:128 data/voice/lines/e7m4.json:L35
msgid "The west water is glass. Their galleys are stuck fast."
msgstr "L'eau de l'ouest est du verre. Leurs galères sont prises."

#. [&"seraphine", "The east is frozen! Dacian, back to back!"],
#: scripts/campaign/mission_e7_04.gd:129 data/voice/lines/e7m4.json:L36
msgid "The east is frozen! Dacian, back to back!"
msgstr "L'est est gelé ! Dacian, dos à dos !"

#. [&"malrik", "Torvald! You never said no to anyone in your life. Why start with me?"],
#: scripts/campaign/mission_e7_04.gd:130 data/voice/lines/e7m4.json:L37
msgid "Torvald! You never said no to anyone in your life. Why start with me?"
msgstr "Torvald ! Tu n'as jamais dit non à personne de ta vie. Pourquoi commencer par moi ?"

#. [&"torvald", "Because I finally saw what you were buying."],
#: scripts/campaign/mission_e7_04.gd:131 data/voice/lines/e7m4.json:L38
msgid "Because I finally saw what you were buying."
msgstr "Parce que j'ai enfin vu ce que tu achetais."

#. [&"torvald", "Enough."],
#: scripts/campaign/mission_e7_04.gd:132 data/voice/lines/e7m4.json:L39
#: data/voice/lines/ep7_opening.json:L22
msgid "Enough."
msgstr "Assez."

#. [&"ossavar", "I have heard that word once before. It sounded better from you."],
#: scripts/campaign/mission_e7_04.gd:133 data/voice/lines/e7m4.json:L40
msgid "I have heard that word once before. It sounded better from you."
msgstr "J'ai déjà entendu ce mot une fois. Il sonnait mieux dans ta bouche."

#. [&"torvald", "The sea... was never mine to hold."],
#: scripts/campaign/mission_e7_04.gd:134 data/voice/lines/e7m4.json:L41
msgid "The sea... was never mine to hold."
msgstr "La mer... n'a jamais été à moi."

#. [&"aldra", "The rock is his. The stone will drink the whole strait now."],
#: scripts/campaign/mission_e7_04.gd:135 data/voice/lines/e7m4.json:L42
msgid "The rock is his. The stone will drink the whole strait now."
msgstr "Le rocher est à lui. La pierre va boire tout le détroit, maintenant."

#. [&"hush", "The Bishop sends his regrets. I will deliver them in person, later."],
#: scripts/campaign/mission_e7_04.gd:136 data/voice/lines/e7m4.json:L43
msgid "The Bishop sends his regrets. I will deliver them in person, later."
msgstr "L'Évêque envoie ses regrets. Je les livrerai en personne, plus tard."

#. "Nearly four hundred years ago, in the Year of Two Skies, Adamarch emptied its diamond pits in one night, and
#: scripts/campaign/mission_e7_04.gd:139
msgid "Nearly four hundred years ago, in the Year of Two Skies, Adamarch emptied its diamond pits in one night, and every dragon on the Coinwater changed sides by morning. Tonight the Diamond Archon signs the same order, with Malrik's hand on her pen."
msgstr "Il y a près de quatre cents ans, l'Année des deux ciels, Adamarch a vidé ses mines de diamants en une nuit, et tous les dragons du Coinwater ont changé de camp au matin. Cette nuit, l'Archonte de diamant signe le même ordre, avec la main de Malrik sur sa plume."

#. "At dawn both cities sail everything they own into the strait. Aurivane holds the Tollrock with Vessa and Ysol
#: scripts/campaign/mission_e7_04.gd:140
msgid "At dawn both cities sail everything they own into the strait. Aurivane holds the Tollrock with Vessa and Ysolde. Adamarch attacks it with Torvald and Malrik. The truce of the Stilled Sea is a hundred and thirty years old, and it ends today."
msgstr "À l'aube, les deux cités lancent tout ce qu'elles possèdent dans le détroit. Aurivane tient le Tollrock avec Vessa et Ysolde. Adamarch l'attaque avec Torvald et Malrik. La trêve de la Mer Figée a cent trente ans, et elle finit aujourd'hui."

#. "Torvald knows whose knives broke the Laurel. He knows whose masks walked out of the old adit. He has waited f
#: scripts/campaign/mission_e7_04.gd:141
msgid "Torvald knows whose knives broke the Laurel. He knows whose masks walked out of the old adit. He has waited for Malrik to become someone else. Today he will find out how long a patient man can wait."
msgstr "Torvald sait à qui étaient les couteaux qui ont brisé le Laurel. Il sait à qui étaient les masques sortis de la vieille galerie. Il a attendu que Malrik devienne quelqu'un d'autre. Aujourd'hui, il saura combien de temps un homme patient peut attendre."

#. const BRIEFING_LINE := "Crimson galleys shell the shore: sink them or stay off the shore road."
#: scripts/campaign/mission_e7_04.gd:143
msgid "Crimson galleys shell the shore: sink them or stay off the shore road."
msgstr "Des galères pourpres bombardent la rive : coule-les ou évite la route du rivage."

#. const HINT_START := "Crimson galleys shell the shore. Shardcasters on the bank, Frost Mortars and Rime Spires
#: scripts/campaign/mission_e7_04.gd:144
