#. [&"narrator", "Five years later, below the citadel. A friendly match. Supposedly."],
#: scripts/campaign/mission_e5_04.gd:99 data/voice/lines/e5m4.json:L1
msgid "Five years later, below the citadel. A friendly match. Supposedly."
msgstr "Cinq ans plus tard, sous la citadelle. Un match amical. En principe."

#. [&"master", "Five banners. The first to hold three while the bell counts thirty wins. Nobody gets hurt."],
#: scripts/campaign/mission_e5_04.gd:100 data/voice/lines/e5m4.json:L2
msgid "Five banners. The first to hold three while the bell counts thirty wins. Nobody gets hurt."
msgstr "Cinq bannières. Qui en tient trois pendant que la cloche compte trente gagne. Personne ne se blesse."

#. [&"vessa", "Define hurt. ...Kidding! Malrik, you take the shady side. You like it there."],
#: scripts/campaign/mission_e5_04.gd:101 data/voice/lines/e5m4.json:L3
msgid "Define hurt. ...Kidding! Malrik, you take the shady side. You like it there."
msgstr "Définis « blessé ». ...Je niaise ! Malrik, prends le côté ombragé. Tu l'aimes, là."

#. [&"malrik", "Of course. The side nobody picked. I have had a great deal of practice with those."],
#: scripts/campaign/mission_e5_04.gd:102 data/voice/lines/e5m4.json:L4
msgid "Of course. The side nobody picked. I have had a great deal of practice with those."
msgstr "Évidemment. Le côté que personne n'a choisi. J'ai beaucoup de pratique avec ceux-là."

#. [&"torvald", "She'll take the field in five minutes. He'll take it in the last one."],
#: scripts/campaign/mission_e5_04.gd:103 data/voice/lines/e5m4.json:L5
msgid "She'll take the field in five minutes. He'll take it in the last one."
msgstr "Elle prendra le terrain en cinq minutes. Lui, il le prendra dans la dernière."

#. [&"ysolde", "I'm cheering for the grass. Nobody ever cheers for the grass."],
#: scripts/campaign/mission_e5_04.gd:104 data/voice/lines/e5m4.json:L6
msgid "I'm cheering for the grass. Nobody ever cheers for the grass."
msgstr "Moi, j'encourage le gazon. Personne n'encourage jamais le gazon."

#. [&"vessa", "Three! Ring it, Vey! Ring it, ring it, ring it!"],
#: scripts/campaign/mission_e5_04.gd:105 data/voice/lines/e5m4.json:L7
msgid "Three! Ring it, Vey! Ring it, ring it, ring it!"
msgstr "Trois ! Sonne-la, Vey ! Sonne, sonne, sonne !"

#. [&"vey", "Thirty, girl. Count with me. One..."],
#: scripts/campaign/mission_e5_04.gd:106 data/voice/lines/e5m4.json:L8
msgid "Thirty, girl. Count with me. One..."
msgstr "Trente, petite. Compte avec moi. Un..."

#. [&"malrik", "There she goes. She never looks behind her. Somebody should."],
#: scripts/campaign/mission_e5_04.gd:107 data/voice/lines/e5m4.json:L9
msgid "There she goes. She never looks behind her. Somebody should."
msgstr "La voilà partie. Elle ne regarde jamais derrière elle. Quelqu'un devrait."

#. [&"vessa", "Hey! That's MY banner! You can't just take it!"],
#: scripts/campaign/mission_e5_04.gd:108 data/voice/lines/e5m4.json:L10
msgid "Hey! That's MY banner! You can't just take it!"
msgstr "Hé ! C'est MA bannière ! Tu peux pas juste la prendre !"

#. [&"malrik", "I was given the leftovers, Vessa. I have learned to take the rest."],
#: scripts/campaign/mission_e5_04.gd:109 data/voice/lines/e5m4.json:L11
msgid "I was given the leftovers, Vessa. I have learned to take the rest."
msgstr "On m'a donné les restes, Vessa. J'ai appris à prendre le reste."

#. [&"master", "The bell counts for Malrik."],
#: scripts/campaign/mission_e5_04.gd:110 data/voice/lines/e5m4.json:L12
msgid "The bell counts for Malrik."
msgstr "La cloche compte pour Malrik."

#. [&"vessa", "Ow! Fine! I yield! This counts as a tie!"],
#: scripts/campaign/mission_e5_04.gd:111 data/voice/lines/e5m4.json:L13
msgid "Ow! Fine! I yield! This counts as a tie!"
msgstr "Aïe ! Correct ! J'abandonne ! Ça compte comme une égalité !"

#. [&"vey", "It does not count as a tie."],
#: scripts/campaign/mission_e5_04.gd:112 data/voice/lines/e5m4.json:L14
msgid "It does not count as a tie."
msgstr "Ça ne compte pas comme une égalité."

#. [&"torvald", "Did anyone see him move? No. Nobody ever does."],
#: scripts/campaign/mission_e5_04.gd:113 data/voice/lines/e5m4.json:L15
msgid "Did anyone see him move? No. Nobody ever does."
msgstr "Quelqu'un l'a vu bouger ? Non. Personne ne le voit jamais."

#. [&"malrik", "Her banner, her crystals. Fire is generous when it isn't looking."],
#: scripts/campaign/mission_e5_04.gd:114 data/voice/lines/e5m4.json:L16
msgid "Her banner, her crystals. Fire is generous when it isn't looking."
msgstr "Sa bannière, ses cristaux. Le feu est généreux quand il ne regarde pas."

#. [&"master", "Malrik wins. By taking."],
#: scripts/campaign/mission_e5_04.gd:115 data/voice/lines/e5m4.json:L17
msgid "Malrik wins. By taking."
msgstr "Malrik gagne. En prenant."

#. [&"malrik", "You taught us to use what we were given. I was given leftovers. I used them."],
#: scripts/campaign/mission_e5_04.gd:116 data/voice/lines/e5m4.json:L18
msgid "You taught us to use what we were given. I was given leftovers. I used them."
msgstr "Vous nous avez appris à utiliser ce qu'on nous donnait. On m'a donné les restes. Je m'en suis servi."

#. [&"master", "...Yes. Well played."],
#: scripts/campaign/mission_e5_04.gd:117 data/voice/lines/e5m4.json:L19
msgid "...Yes. Well played."
msgstr "...Oui. Bien joué."

#. [&"vessa", "Rematch. Now. Best of three. Best of five!"],
#: scripts/campaign/mission_e5_04.gd:118 data/voice/lines/e5m4.json:L20
msgid "Rematch. Now. Best of three. Best of five!"
msgstr "Revanche. Tout de suite. Deux de trois. Trois de cinq !"

#. [&"master", "Later, my joy. Both of you, come up to the orrery. I have something for you."],
#: scripts/campaign/mission_e5_04.gd:119 data/voice/lines/e5m4.json:L21
msgid "Later, my joy. Both of you, come up to the orrery. I have something for you."
msgstr "Plus tard, ma joie. Montez tous les deux sous le dôme. J'ai quelque chose pour vous."

#. [&"malrik", "I yield. ...This time."],
#: scripts/campaign/mission_e5_04.gd:120 data/voice/lines/e5m4.json:L22
msgid "I yield. ...This time."
msgstr "J'abandonne. ...Cette fois-ci."

#. [&"vessa", "Thirty! Fair and square! Malrik, you can keep the shade!"],
#: scripts/campaign/mission_e5_04.gd:121 data/voice/lines/e5m4.json:L23
msgid "Thirty! Fair and square! Malrik, you can keep the shade!"
msgstr "Trente ! Gagné honnêtement ! Malrik, tu peux garder l'ombre !"

#. "Winter, the truce. Malrik counts something on his fingers. It is always the same list.",
#: scripts/campaign/mission_e5_04.gd:124
msgid "Winter, the truce. Malrik counts something on his fingers. It is always the same list."
msgstr "L'hiver, la trêve. Malrik compte quelque chose sur ses doigts. C'est toujours la même liste."

#. "Five years after Wickmoor, the Master's youngest apprentices were nearly grown, and still keeping score. Belo
#: scripts/campaign/mission_e5_04.gd:125
msgid "Five years after Wickmoor, the Master's youngest apprentices were nearly grown, and still keeping score. Below the citadel lies the Proving Green, his practice field. On the terrace above it, the Master, Torvald and Ysolde sat to watch, and Old Vey took the bell-rope."
msgstr "Cinq ans après Wickmoor, les plus jeunes apprentis du maître étaient presque adultes, et comptaient toujours les points. Sous la citadelle s'étend le Proving Green, son terrain d'entraînement. Sur la terrasse au-dessus, le maître, Torvald et Ysolde s'assirent pour regarder, et le vieux Vey prit la corde de la cloche."

#. "Five banners. The first to hold three while the bell counts thirty wins. Vessa chose her side first, the sunn
#: scripts/campaign/mission_e5_04.gd:126
msgid "Five banners. The first to hold three while the bell counts thirty wins. Vessa chose her side first, the sunny one. Malrik got the other. He was used to that."
msgstr "Cinq bannières. Le premier à en tenir trois pendant que la cloche compte trente gagne. Vessa choisit son côté en premier, le côté ensoleillé. Malrik eut l'autre. Il avait l'habitude."

#. const HINT_START := "Hold three of the five banners while the bell counts 30. Stand in a banner's ring to take
#: scripts/campaign/mission_e5_04.gd:128
msgid "Hold three of the five banners while the bell counts 30. Stand in a banner's ring to take it; more soldiers take it faster."
msgstr "Tenez trois des cinq bannières pendant que la cloche compte jusqu'à 30. Restez dans le cercle d'une bannière pour la prendre; plus de soldats la prennent plus vite."

#. const HINT_SHADOW := "The citadel's shadow is yours: in the violet shade your units are hidden unless an enemy
#: scripts/campaign/mission_e5_04.gd:129
msgid "The citadel's shadow is yours: in the violet shade your units are hidden unless an enemy comes within 2.5 m."
msgstr "L'ombre de la citadelle est à vous : dans l'ombre violette, vos unités sont cachées, sauf si un ennemi vient à moins de 2,5 m."

#. const HINT_STEAL := "Your side takes Vessa's banners twice as fast, and each one pays 100 crystals. She takes
#: scripts/campaign/mission_e5_04.gd:130
msgid "Your side takes Vessa's banners twice as fast, and each one pays 100 crystals. She takes empty banners faster."
msgstr "Votre camp prend les bannières de Vessa deux fois plus vite, et chacune rapporte 100 cristaux. Elle prend plus vite les bannières libres."

#. const HINT_CHARGE := "She left her home banner thin. The Old Orchard's shade is 11 m from it."
#: scripts/campaign/mission_e5_04.gd:131
msgid "She left her home banner thin. The Old Orchard's shade is 11 m from it."
msgstr "Elle a dégarni sa propre bannière. L'ombre du vieux verger est à 11 m."

#. const HINT_SHROUD := "Ctrl+E learns Umbral Shroud: E halves the damage Malrik takes for 5 s and speeds him up.
#: scripts/campaign/mission_e5_04.gd:132
msgid "Ctrl+E learns Umbral Shroud: E halves the damage Malrik takes for 5 s and speeds him up."
msgstr "Ctrl+E apprend Umbral Shroud : E réduit de moitié les dégâts subis par Malrik pendant 5 s et le rend plus rapide."

#. const MSG_YARDS_OPEN := "The sixth bell: the practice yards may be burned."
#: scripts/campaign/mission_e5_04.gd:133
msgid "The sixth bell: the practice yards may be burned."
msgstr "La sixième cloche : les cours d'entraînement peuvent brûler."

#. const MSG_SPOILS := "Spoils! +{n}"
#: scripts/campaign/mission_e5_04.gd:134
msgid "Spoils! +{n}"
msgstr "Butin! +{n}"

#. const MSG_VESSA_ASH := "Vessa's yard is ash. The banners still decide."
#: scripts/campaign/mission_e5_04.gd:135
msgid "Vessa's yard is ash. The banners still decide."
msgstr "La cour de Vessa est en cendres. Les bannières décident toujours."

#. const MSG_TWO_HOUSES := "Two houses at most on the practice field"
#: scripts/campaign/mission_e5_04.gd:136
msgid "Two houses at most on the practice field"
msgstr "Deux maisons au plus sur le terrain d'entraînement"

#. c.keep_lost_message = "Malrik's yard has burned"
#: scripts/campaign/mission_e5_04.gd:185
msgid "Malrik's yard has burned"
msgstr "La cour de Malrik a brûlé"

#. c.victory_banner = "VICTORY\nMalrik wins. By taking."
#: scripts/campaign/mission_e5_04.gd:194
msgid "VICTORY\nMalrik wins. By taking."
msgstr "VICTOIRE\nMalrik gagne. En prenant."

#. c.spotlight = {"id": &"grave_hound", "trigger": &"manual", "key_hint": "Gloom Hall: C",
