#: scripts/campaign/mission_e3_03.gd:470
msgid "Relight the barrow vigils"
msgstr "Rallumer les veilles des tertres"

#. return "Lay the Sexton to rest (%d %%)" % int(100.0 * sexton.hp / maxf(1.0, sexton.max_hp))
#: scripts/campaign/mission_e3_03.gd:473
