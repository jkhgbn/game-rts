msgstr "Pauper's Field"

#. &"B4": ["Bishops' Rest", Vector3(34.0, 0.0, 38.0), Vector3(30.7, 0.0, 34.3)],
#: scripts/campaign/mission_e3_03.gd:41
msgid "Bishops' Rest"
msgstr "Bishops' Rest"

#. const MSG_STILL_FULL := "The barrow is still full of the dead. Lay more of them to rest first."
#: scripts/campaign/mission_e3_03.gd:59
msgid "The barrow is still full of the dead. Lay more of them to rest first."
msgstr "Le tertre est encore plein de morts. Mettez-en d'abord plus au repos."

#. [&"narrator", "Duskbarrow. The city of the dead, where Malrik learned to read by tombstone light."],
#: scripts/campaign/mission_e3_03.gd:88
msgid "Duskbarrow. The city of the dead, where Malrik learned to read by tombstone light."
msgstr "Duskbarrow. La cité des morts, où Malrik a appris à lire à la lueur des pierres tombales."

#. [&"malrik", "Every vigil out at once. Someone has been very rude to my dead."],
#: scripts/campaign/mission_e3_03.gd:89
msgid "Every vigil out at once. Someone has been very rude to my dead."
msgstr "Toutes les veilles éteintes d'un coup. Quelqu'un a été très impoli envers mes morts."

#. [&"shade", "Bishop. The barrows are stirring. The living are in the Great Crypt. All of them."],
#: scripts/campaign/mission_e3_03.gd:90
msgid "Bishop. The barrows are stirring. The living are in the Great Crypt. All of them."
msgstr "Évêque. Les tertres s'agitent. Les vivants sont dans la Grande Crypte. Tous."

#. [&"malrik", "Then the living stay in the crypt, and the dead go back to bed."],
#: scripts/campaign/mission_e3_03.gd:91
msgid "Then the living stay in the crypt, and the dead go back to bed."
msgstr "Alors les vivants restent dans la crypte, et les morts retournent se coucher."

#. [&"obren", "They are mine now, Bishop. Ask me nicely, and they kneel."],
#: scripts/campaign/mission_e3_03.gd:92
msgid "They are mine now, Bishop. Ask me nicely, and they kneel."
msgstr "Ils sont à moi, maintenant, Évêque. Demande-le gentiment, et ils s'agenouillent."

#. [&"malrik", "You raised my dead, and now you sell me the shovel."],
#: scripts/campaign/mission_e3_03.gd:93
msgid "You raised my dead, and now you sell me the shovel."
msgstr "Tu as levé mes morts, et maintenant tu me vends la pelle."

#. [&"obren", "Not sell. Lend. You will hardly notice the price."],
#: scripts/campaign/mission_e3_03.gd:94
msgid "Not sell. Lend. You will hardly notice the price."
msgstr "Pas vendre. Prêter. Tu remarqueras à peine le prix."

#. [&"malrik", "Sleep. You did your share of standing."],
#: scripts/campaign/mission_e3_03.gd:95
msgid "Sleep. You did your share of standing."
msgstr "Dors. Tu as fait ta part debout."

#. [&"obren", "There. Was that so hard? Again, whenever you like."],
#: scripts/campaign/mission_e3_03.gd:96
msgid "There. Was that so hard? Again, whenever you like."
msgstr "Voilà. C'était si difficile ? Encore, quand tu veux."

#. [&"malrik", "Useful. Do not get comfortable in there."],
#: scripts/campaign/mission_e3_03.gd:97
msgid "Useful. Do not get comfortable in there."
msgstr "Utile. Ne t'installe pas trop confortablement là-dedans."

#. [&"obren", "Half yours, half mine. We share so nicely, you and I."],
#: scripts/campaign/mission_e3_03.gd:98
msgid "Half yours, half mine. We share so nicely, you and I."
msgstr "Moitié à toi, moitié à moi. On partage si bien, toi et moi."

#. [&"obren", "MINE. Hold still. Let me look out of your eyes."],
#: scripts/campaign/mission_e3_03.gd:99
msgid "MINE. Hold still. Let me look out of your eyes."
msgstr "À MOI. Ne bouge pas. Laisse-moi regarder par tes yeux."

#. [&"malrik", "Out. OUT. I decide. I have always decided."],
#: scripts/campaign/mission_e3_03.gd:100
msgid "Out. OUT. I decide. I have always decided."
msgstr "Dehors. DEHORS. C'est moi qui décide. J'ai toujours décidé."

#. [&"shade", "The Pauper's Field and the Bishops' Rest are open! Everything is walking!"],
#: scripts/campaign/mission_e3_03.gd:101
msgid "The Pauper's Field and the Bishops' Rest are open! Everything is walking!"
msgstr "Le Pauper's Field et le Bishops' Rest sont ouverts ! Tout se met à marcher !"

#. [&"malrik", "Even the bishops. Of course even the bishops."],
#: scripts/campaign/mission_e3_03.gd:102
msgid "Even the bishops. Of course even the bishops."
msgstr "Même les évêques. Évidemment, même les évêques."

#. [&"malrik", "The dead are up, Hush. My dead."],
#: scripts/campaign/mission_e3_03.gd:103
msgid "The dead are up, Hush. My dead."
msgstr "Les morts sont debout, Hush. Mes morts."

#. [&"hush", "Then they can lie down again. I'll help them."],
#: scripts/campaign/mission_e3_03.gd:104
msgid "Then they can lie down again. I'll help them."
msgstr "Alors ils peuvent se recoucher. Je vais les aider."

#. [&"shade", "The crypt doors are cracking! The families are inside!"],
#: scripts/campaign/mission_e3_03.gd:105
msgid "The crypt doors are cracking! The families are inside!"
msgstr "Les portes de la crypte cèdent ! Les familles sont à l'intérieur !"

#. [&"narrator", "Two barrows sleep. The stone does not like the quiet."],
#: scripts/campaign/mission_e3_03.gd:106
msgid "Two barrows sleep. The stone does not like the quiet."
msgstr "Deux tertres dorment. La pierre n'aime pas le silence."

#. [&"obren", "Your father dug these graves, Bishop. Shall I show you what I built from his work?"],
#: scripts/campaign/mission_e3_03.gd:107
msgid "Your father dug these graves, Bishop. Shall I show you what I built from his work?"
msgstr "Ton père a creusé ces tombes, Évêque. Veux-tu voir ce que j'ai bâti avec son ouvrage ?"

#. [&"obren", "Forty years he dug here. Let me give him a body."],
#: scripts/campaign/mission_e3_03.gd:108
msgid "Forty years he dug here. Let me give him a body."
msgstr "Quarante ans qu'il a creusé ici. Laisse-moi lui donner un corps."

#. [&"malrik", "He had one. He wore it out honestly."],
#: scripts/campaign/mission_e3_03.gd:109
msgid "He had one. He wore it out honestly."
msgstr "Il en avait un. Il l'a usé honnêtement."

#. [&"malrik", "That bell. He rang it every dusk. Stop wearing my father's bell."],
#: scripts/campaign/mission_e3_03.gd:110
msgid "That bell. He rang it every dusk. Stop wearing my father's bell."
msgstr "Cette cloche. Il la sonnait chaque soir. Arrête de porter la cloche de mon père."

#. [&"hush", "Light it, Bishop. Just this once."],
#: scripts/campaign/mission_e3_03.gd:111
msgid "Light it, Bishop. Just this once."
msgstr "Allume-la, Évêque. Juste cette fois."

#. [&"malrik", "Not yet. Not while it is listening."],
#: scripts/campaign/mission_e3_03.gd:112
msgid "Not yet. Not while it is listening."
msgstr "Pas encore. Pas tant qu'elle écoute."

#. [&"narrator", "The vigils burned again in Duskbarrow. In the Bishop's pocket, the stone kept count."],
#: scripts/campaign/mission_e3_03.gd:113
msgid "The vigils burned again in Duskbarrow. In the Bishop's pocket, the stone kept count."
msgstr "Les veilles brûlaient de nouveau à Duskbarrow. Dans la poche de l'Évêque, la pierre tenait le compte."

#. [&"malrik", "Bury me... somewhere quiet."],
#: scripts/campaign/mission_e3_03.gd:114
msgid "Bury me... somewhere quiet."
msgstr "Enterrez-moi... quelque part de tranquille."

#. [&"shade", "The crypt is open... the dead are among the living!"],
#: scripts/campaign/mission_e3_03.gd:115
msgid "The crypt is open... the dead are among the living!"
msgstr "La crypte est ouverte... les morts sont parmi les vivants !"

#. "Duskbarrow keeps its dead the old way: a candle at every barrow door, lit at dusk by the gravediggers. Two ni
#: scripts/campaign/mission_e3_03.gd:118
msgid "Duskbarrow keeps its dead the old way: a candle at every barrow door, lit at dusk by the gravediggers. Two nights ago the candles went out, all four at once, and the dead stood up."
msgstr "Duskbarrow garde ses morts à l'ancienne : une chandelle à chaque porte de tertre, allumée au crépuscule par les fossoyeurs. Il y a deux nuits, les chandelles se sont éteintes, les quatre d'un coup, et les morts se sont levés."

#. "The living of the city have shut themselves inside the Great Crypt. The Bishop's Seat still stands above the
#: scripts/campaign/mission_e3_03.gd:119
msgid "The living of the city have shut themselves inside the Great Crypt. The Bishop's Seat still stands above the Lantern Road. Malrik rode home through two nights to find his own dead walking toward his own people."
msgstr "Les vivants de la cité se sont enfermés dans la Grande Crypte. Le Bishop's Seat se dresse toujours au-dessus de la Lantern Road. Malrik a chevauché deux nuits pour trouver ses propres morts en marche vers son propre peuple."

#. "Light the vigils again and the dead will lie down. The stone in his pocket says there is a faster way. It is
#: scripts/campaign/mission_e3_03.gd:120
msgid "Light the vigils again and the dead will lie down. The stone in his pocket says there is a faster way. It is very eager to show him."
msgstr "Rallumez les veilles et les morts se recoucheront. La pierre dans sa poche dit qu'il existe un moyen plus rapide. Elle a très hâte de le lui montrer."

#. const BRIEFING_LINE := "Only Malrik can relight a vigil candle. Clear the barrow first."
#: scripts/campaign/mission_e3_03.gd:122
msgid "Only Malrik can relight a vigil candle. Clear the barrow first."
msgstr "Seul Malrik peut rallumer une chandelle de veille. Dégagez d'abord le tertre."

#. const HINT_START := "The barrows will open. Keep the dead away from the Great Crypt, then walk Malrik to each
#: scripts/campaign/mission_e3_03.gd:123
msgid "The barrows will open. Keep the dead away from the Great Crypt, then walk Malrik to each vigil candle."
msgstr "Les tertres vont s'ouvrir. Tenez les morts loin de la Grande Crypte, puis menez Malrik à chaque chandelle de veille."

#. const HINT_OFFER := "The stone offers its power: J. Wardens near Malrik kneel and the rest are struck. Every u
#: scripts/campaign/mission_e3_03.gd:124
msgid "The stone offers its power: J. Wardens near Malrik kneel and the rest are struck. Every use tightens its hold."
msgstr "La pierre offre son pouvoir : J. Les Wardens près de Malrik s'agenouillent et les autres sont frappés. Chaque usage resserre son emprise."

#. const HINT_SEXTON := "The Sexton walks on the crypt. Step out of the gravestone circles."
#: scripts/campaign/mission_e3_03.gd:125
msgid "The Sexton walks on the crypt. Step out of the gravestone circles."
msgstr "Le Sexton marche sur la crypte. Sortez des cercles de pierres tombales."

#. const HINT_REAVER := "Nightblood Reavers drink: in a long fight with no fire, they never fall."
#: scripts/campaign/mission_e3_03.gd:126
msgid "Nightblood Reavers drink: in a long fight with no fire, they never fall."
msgstr "Les Nightblood Reavers boivent : dans un long combat sans feu, ils ne tombent jamais."

#. const MSG_FIRST_OPEN := "The Lantern and Weeping Barrows open."
#: scripts/campaign/mission_e3_03.gd:127
msgid "The Lantern and Weeping Barrows open."
msgstr "Le Lantern Barrow et le Weeping Barrow s'ouvrent."

#. const MSG_BLOCKED := "The dead won't sleep while they stand over the candle. Clear the barrow first."
#: scripts/campaign/mission_e3_03.gd:128
msgid "The dead won't sleep while they stand over the candle. Clear the barrow first."
msgstr "Les morts ne dormiront pas tant qu'ils se tiennent près de la chandelle. Dégagez d'abord le tertre."

#. const MSG_PATIENCE := "The stone has lost patience."
#: scripts/campaign/mission_e3_03.gd:129
msgid "The stone has lost patience."
msgstr "La pierre a perdu patience."

#. const MSG_STAGGER := "The Sexton staggers!"
#: scripts/campaign/mission_e3_03.gd:130
msgid "The Sexton staggers!"
msgstr "Le Sexton chancelle !"

#. const MSG_FALLS_EARLY := "The Sexton falls. Relight the last vigils."
#: scripts/campaign/mission_e3_03.gd:131
msgid "The Sexton falls. Relight the last vigils."
msgstr "Le Sexton tombe. Rallumez les dernières veilles."

#. const BUTTON_HEART := "Heart of the Hollow (J)"
#: scripts/campaign/mission_e3_03.gd:132 scripts/campaign/mission_e3_04.gd:170
msgid "Heart of the Hollow (J)"
msgstr "Heart of the Hollow (J)"

#. const REFUSE_HELD := "The stone holds you"
#: scripts/campaign/mission_e3_03.gd:134 scripts/campaign/mission_e3_04.gd:177
msgid "The stone holds you"
msgstr "La pierre vous tient"

#. const REFUSE_NOT_YET := "Not yet"
#: scripts/campaign/mission_e3_03.gd:136
msgid "Not yet"
msgstr "Pas encore"

#. const REFUSE_ENDING := "The fight is over"   ## the mission is ending (the victory / defeat delay)
#: scripts/campaign/mission_e3_03.gd:137 scripts/campaign/mission_e3_04.gd:179
msgid "The fight is over"
msgstr "Le combat est fini"

#. c.keep_lost_message = "The Bishop's Seat has fallen"
#: scripts/campaign/mission_e3_03.gd:204
msgid "The Bishop's Seat has fallen"
msgstr "Le Bishop's Seat est tombé"

#. c.victory_banner = "VICTORY\nThe dead lie down"
#: scripts/campaign/mission_e3_03.gd:219
msgid "VICTORY\nThe dead lie down"
msgstr "VICTOIRE\nLes morts se recouchent"

#. c.spotlight = {"id": &"nightblood_reaver", "trigger": &"start", "key_hint": "Bishop's Seat: C",
#: scripts/campaign/mission_e3_03.gd:222
msgid "Bishop's Seat: C"
msgstr "Bishop's Seat : C"

#. "card": "Nightblood Reaver. A duelist that drinks: the longer the fight, the stronger it stands. Fear fire."}
#: scripts/campaign/mission_e3_03.gd:223
msgid "Nightblood Reaver. A duelist that drinks: the longer the fight, the stronger it stands. Fear fire."
msgstr "Nightblood Reaver. Un duelliste qui boit : plus le combat dure, plus il tient. Craignez le feu."

#. return "Episode 3, Mission 3: %s" % MISSION_TITLE
#: scripts/campaign/mission_e3_03.gd:240
msgid "Episode 3, Mission 3: %s"
msgstr "Épisode 3, mission 3 : %s"

#. t.display_name = "Great Crypt"
#: scripts/campaign/mission_e3_03.gd:261
msgid "Great Crypt"
msgstr "Grande Crypte"

#. t.display_name = "Gravewarden"
#: scripts/campaign/mission_e3_03.gd:278 scripts/campaign/mission_e5_03.gd:258
msgid "Gravewarden"
msgstr "Gravewarden"

#. t.display_name = "The Sexton"
#: scripts/campaign/mission_e3_03.gd:295
msgid "The Sexton"
msgstr "Le Sexton"

#. return "The Great Crypt must stand (%d %%)" % int(100.0 * crypt.hp / maxf(1.0, crypt.max_hp))
#: scripts/campaign/mission_e3_03.gd:462
msgid "The Great Crypt must stand (%d %%)"
msgstr "La Grande Crypte doit tenir (%d %%)"

#. return "The Great Crypt must stand"
#: scripts/campaign/mission_e3_03.gd:463
msgid "The Great Crypt must stand"
msgstr "La Grande Crypte doit tenir"

#. var head := "Relight the barrow vigils (%d / 4)" % candles_lit()
#: scripts/campaign/mission_e3_03.gd:466
msgid "Relight the barrow vigils (%d / 4)"
msgstr "Rallumer les veilles des tertres (%d / 4)"

#. return "%s\n%s" % [head, "The stone's hold: %d %%" % int(stone_hold)]
#: scripts/campaign/mission_e3_03.gd:468 scripts/campaign/mission_e3_04.gd:652
