#: scripts/campaign/mission_e6_01.gd:283
msgid "VICTORY\nThe lake froze around the Heartfrost"
msgstr "VICTOIRE\nLe lac a gelé autour du Heartfrost"

#. c.spotlight = {"id": &"rimeshield", "trigger": &"manual", "key_hint": "Frost Hall: Z",
#: scripts/campaign/mission_e6_01.gd:286
