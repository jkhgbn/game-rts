#. const SPEAKER_NAMES := {&"malrik": "Malrik", &"reeve": "Reeve Pike", &"master": "The Master", &"narrator": "Na
#: scripts/campaign/mission_e5_03.gd:122
msgid "Reeve Pike"
msgstr "Reeve Pike"

#. [&"narrator", "Wickmoor buried its dead with their rings on. Lately, someone had been taking them back."],
#: scripts/campaign/mission_e5_03.gd:127 data/voice/lines/e5m3.json:L1
msgid "Wickmoor buried its dead with their rings on. Lately, someone had been taking them back."
msgstr "Wickmoor enterrait ses morts avec leurs bagues. Depuis peu, quelqu'un venait les reprendre."

#. [&"malrik", "They say my father robs graves. My father can't rob a pie off a windowsill."],
#: scripts/campaign/mission_e5_03.gd:128 data/voice/lines/e5m3.json:L2
msgid "They say my father robs graves. My father can't rob a pie off a windowsill."
msgstr "On dit que mon père pille les tombes. Mon père ne saurait même pas voler une tarte sur une fenêtre."

#. [&"malrik", "The Reeve hangs him at dawn. So tonight I ask the dead. The dead don't lie to me."],
#: scripts/campaign/mission_e5_03.gd:129 data/voice/lines/e5m3.json:L3
msgid "The Reeve hangs him at dawn. So tonight I ask the dead. The dead don't lie to me."
msgstr "Le Reeve le pend à l'aube. Alors cette nuit, je questionne les morts. Les morts ne me mentent pas."

#. [&"reeve", "Lanterns up, lads! If the gravedigger's brat comes sniffing, bring him to me."],
#: scripts/campaign/mission_e5_03.gd:130 data/voice/lines/e5m3.json:L4
msgid "Lanterns up, lads! If the gravedigger's brat comes sniffing, bring him to me."
msgstr "Les lanternes en l'air, les gars ! Si le morveux du fossoyeur vient fouiner, amenez-le-moi."

#. [&"malrik", "There. Dark again. The dark never asks me what I'm doing here."],
#: scripts/campaign/mission_e5_03.gd:131 data/voice/lines/e5m3.json:L5
msgid "There. Dark again. The dark never asks me what I'm doing here."
msgstr "Voilà. Le noir, encore. Le noir ne me demande jamais ce que je fais ici."

#. [&"malrik", "...Hello. You came when I called. Nobody comes when I call."],
#: scripts/campaign/mission_e5_03.gd:132 data/voice/lines/e5m3.json:L6
msgid "...Hello. You came when I called. Nobody comes when I call."
msgstr "...Bonjour. Vous êtes venus quand j'ai appelé. Personne ne vient quand j'appelle."

#. [&"narrator", "The shadows of the old graves stood up, and waited for him to speak."],
#: scripts/campaign/mission_e5_03.gd:133 data/voice/lines/e5m3.json:L7
msgid "The shadows of the old graves stood up, and waited for him to speak."
msgstr "Les ombres des vieilles tombes se sont levées, et ont attendu qu'il parle."

#. [&"malrik", "\"Here lies Edda Brack. She was right about the roof.\" I believe you, Edda."],
#: scripts/campaign/mission_e5_03.gd:134 data/voice/lines/e5m3.json:L8
msgid "\"Here lies Edda Brack. She was right about the roof.\" I believe you, Edda."
msgstr "« Ci-gît Edda Brack. Elle avait raison pour le toit. » Je te crois, Edda."

#. [&"reeve", "There! Something in the yews! Hoy! Hoy!"],
#: scripts/campaign/mission_e5_03.gd:135 data/voice/lines/e5m3.json:L9
msgid "There! Something in the yews! Hoy! Hoy!"
msgstr "Là ! Quelque chose dans les ifs ! Hé ! Hé !"

#. [&"reeve", "Every lantern in Wickmoor, up! Find me that boy!"],
#: scripts/campaign/mission_e5_03.gd:136 data/voice/lines/e5m3.json:L10
msgid "Every lantern in Wickmoor, up! Find me that boy!"
msgstr "Toutes les lanternes de Wickmoor, debout ! Trouvez-moi ce garçon !"

#. [&"malrik", "They don't need it any more. I do. That isn't stealing. It's... inheritance."],
#: scripts/campaign/mission_e5_03.gd:137 data/voice/lines/e5m3.json:L11
msgid "They don't need it any more. I do. That isn't stealing. It's... inheritance."
msgstr "Ils n'en ont plus besoin. Moi, oui. Ce n'est pas du vol. C'est... un héritage."

#. [&"narrator", "He told himself it was only one ring. It was never only one."],
#: scripts/campaign/mission_e5_03.gd:138 data/voice/lines/e5m3.json:L12
msgid "He told himself it was only one ring. It was never only one."
msgstr "Il s'est dit que ce n'était qu'une bague. Ce n'était jamais qu'une seule."

#. [&"malrik", "A thief's purse, sealed with the Reeve's own seal. You pay robbers, Reeve?"],
#: scripts/campaign/mission_e5_03.gd:139 data/voice/lines/e5m3.json:L13
msgid "A thief's purse, sealed with the Reeve's own seal. You pay robbers, Reeve?"
msgstr "Une bourse de voleur, scellée du propre sceau du Reeve. Vous payez des voleurs, Reeve ?"

#. [&"malrik", "Magpies. In my father's ossuary. Digging up my father's work."],
#: scripts/campaign/mission_e5_03.gd:140 data/voice/lines/e5m3.json:L14
msgid "Magpies. In my father's ossuary. Digging up my father's work."
msgstr "Des Magpies. Dans l'ossuaire de mon père. À déterrer le travail de mon père."

#. [&"malrik", "Every ring in Wickmoor, in one sack. With a receipt. Thieves are so tidy."],
#: scripts/campaign/mission_e5_03.gd:141 data/voice/lines/e5m3.json:L15
msgid "Every ring in Wickmoor, in one sack. With a receipt. Thieves are so tidy."
msgstr "Toutes les bagues de Wickmoor, dans un seul sac. Avec un reçu. Les voleurs sont si soigneux."

#. [&"malrik", "A ledger. Graves, rings and prices. He sold the dead by the pound."],
#: scripts/campaign/mission_e5_03.gd:142 data/voice/lines/e5m3.json:L16
msgid "A ledger. Graves, rings and prices. He sold the dead by the pound."
msgstr "Un registre. Des tombes, des bagues et des prix. Il vendait les morts à la livre."

#. [&"malrik", "Three secrets. Now the whole town can hear them. Where's that bell?"],
#: scripts/campaign/mission_e5_03.gd:143 data/voice/lines/e5m3.json:L17
msgid "Three secrets. Now the whole town can hear them. Where's that bell?"
msgstr "Trois secrets. Maintenant, toute la ville peut les entendre. Où est cette cloche ?"

#. [&"narrator", "At midnight the bell of Wickmoor rang, and every window in the town lit."],
#: scripts/campaign/mission_e5_03.gd:144 data/voice/lines/e5m3.json:L18
msgid "At midnight the bell of Wickmoor rang, and every window in the town lit."
msgstr "À minuit, la cloche de Wickmoor a sonné, et chaque fenêtre de la ville s'est allumée."

#. [&"reeve", "Clever boy. Clever boys have accidents in graveyards."],
#: scripts/campaign/mission_e5_03.gd:145 data/voice/lines/e5m3.json:L19
msgid "Clever boy. Clever boys have accidents in graveyards."
msgstr "Malin, le garçon. Les garçons malins ont des accidents dans les cimetières."

#. [&"malrik", "You're not one of the Reeve's. Who are you? ...You're very tall."],
#: scripts/campaign/mission_e5_03.gd:146 data/voice/lines/e5m3.json:L20
msgid "You're not one of the Reeve's. Who are you? ...You're very tall."
msgstr "Vous n'êtes pas un des hommes du Reeve. Qui êtes-vous ? ...Vous êtes très grand."

#. [&"master", "Reading tombstones by one candle, at midnight. And they told you everything."],
#: scripts/campaign/mission_e5_03.gd:147 data/voice/lines/e5m3.json:L21
msgid "Reading tombstones by one candle, at midnight. And they told you everything."
msgstr "Lire des pierres tombales à la lueur d'une chandelle, à minuit. Et elles t'ont tout dit."

#. [&"malrik", "The dead don't lie. They've got nothing left to want."],
#: scripts/campaign/mission_e5_03.gd:148 data/voice/lines/e5m3.json:L22
msgid "The dead don't lie. They've got nothing left to want."
msgstr "Les morts ne mentent pas. Ils n'ont plus rien à vouloir."

#. [&"master", "This one, too."],
#: scripts/campaign/mission_e5_03.gd:149 data/voice/lines/e5m3.json:L23
msgid "This one, too."
msgstr "Lui aussi."

#. [&"narrator", "He pinched out his candle. In the dark, he was not afraid. He never had been."],
#: scripts/campaign/mission_e5_03.gd:150 data/voice/lines/e5m3.json:L24
msgid "He pinched out his candle. In the dark, he was not afraid. He never had been."
msgstr "Il a pincé sa chandelle. Dans le noir, il n'avait pas peur. Il n'avait jamais eu peur."

#. [&"malrik", "Let go! He's lying! He's the one- let GO!"],
#: scripts/campaign/mission_e5_03.gd:151 data/voice/lines/e5m3.json:L25
msgid "Let go! He's lying! He's the one- let GO!"
msgstr "Lâchez-moi ! Il ment ! C'est lui qui... LÂCHEZ-MOI !"

#. [&"malrik", "Back! Out of the light! It eats you."],
#: scripts/campaign/mission_e5_03.gd:152 data/voice/lines/e5m3.json:L26
msgid "Back! Out of the light! It eats you."
msgstr "Reculez ! Sortez de la lumière ! Elle vous dévore."

#. "Winter, the truce. In the crypt city, Malrik lights a candle and lets it burn longer than he needs to.",
#: scripts/campaign/mission_e5_03.gd:155
msgid "Winter, the truce. In the crypt city, Malrik lights a candle and lets it burn longer than he needs to."
msgstr "L'hiver, la trêve. Dans la cité des cryptes, Malrik allume une chandelle et la laisse brûler plus longtemps qu'il n'en a besoin."

#. "Wickmoor buried its dead with their rings on, and lately someone had been taking them back. Reeve Aldous Pike
#: scripts/campaign/mission_e5_03.gd:156
msgid "Wickmoor buried its dead with their rings on, and lately someone had been taking them back. Reeve Aldous Pike, keeper of the lanterns, named the gravedigger, and locked him in the stocks to hang at dawn."
msgstr "Wickmoor enterrait ses morts avec leurs bagues, et depuis peu quelqu'un les reprenait. Le prévôt Aldous Pike, gardien des lanternes, accusa le fossoyeur et l'enferma au pilori, pour le pendre à l'aube."

#. "The gravedigger's son was thirteen. He knew every grave in Wickmoor by heart, and every dark corner between t
#: scripts/campaign/mission_e5_03.gd:157
msgid "The gravedigger's son was thirteen. He knew every grave in Wickmoor by heart, and every dark corner between them. He took a candle and his father's two dogs, and went to ask the dead who was lying."
msgstr "Le fils du fossoyeur avait treize ans. Il connaissait par cœur chaque tombe de Wickmoor, et chaque coin d'ombre entre elles. Il prit une chandelle et les deux chiens de son père, et alla demander aux morts qui mentait."

#. const HINT_CANDLE := "Malrik's candle: J (or the button on his card). Lit, he sees far and can read. Pinched,
#: scripts/campaign/mission_e5_03.gd:159
msgid "Malrik's candle: J (or the button on his card). Lit, he sees far and can read. Pinched, he hides in the dark."
msgstr "La chandelle de Malrik : J (ou le bouton sur sa carte). Allumée, il voit loin et peut lire. Mouchée, il se cache dans le noir."

#. const HINT_SHADOW := "Violet ground is shadow: there your units are hidden unless a light touches them, and Ma
#: scripts/campaign/mission_e5_03.gd:160
msgid "Violet ground is shadow: there your units are hidden unless a light touches them, and Malrik heals. Lamps and lanterns show you to the wardens."
msgstr "Le sol violet est de l'ombre : vos unités y sont cachées, sauf si une lumière les touche, et Malrik s'y soigne. Les lampes et les lanternes vous montrent aux gardiens."

#. const HINT_SNUFF := "A snuffed lamp leaves a pool of shadow. Wardens relight lamps they pass."
#: scripts/campaign/mission_e5_03.gd:161
msgid "A snuffed lamp leaves a pool of shadow. Wardens relight lamps they pass."
msgstr "Une lampe éteinte laisse une flaque d'ombre. Les gardiens rallument les lampes qu'ils croisent."

#. const HINT_SHADES := "Shades burn in any light. Keep them in the dark; send them to breathe out lamps."
#: scripts/campaign/mission_e5_03.gd:162
msgid "Shades burn in any light. Keep them in the dark; send them to breathe out lamps."
msgstr "Les Shades brûlent dans toute lumière. Gardez-les dans le noir; envoyez-les souffler les lampes."

#. const HINT_SEEN := "Seen! Get back into the dark and stay there: the wardens lose you after {n} seconds."
#: scripts/campaign/mission_e5_03.gd:163
msgid "Seen! Get back into the dark and stay there: the wardens lose you after {n} seconds."
msgstr "Repéré ! Retournez dans le noir et restez-y : les gardiens vous perdent après {n} secondes."

#. const HINT_BELL := "The Bell is on the Lantern House porch, between two lamps and two wardens."
#: scripts/campaign/mission_e5_03.gd:164
msgid "The Bell is on the Lantern House porch, between two lamps and two wardens."
msgstr "La cloche est sur le porche de la maison des Lanternes, entre deux lampes et deux gardiens."

#. const HINT_SIPHON := "Ctrl+Q learns Soul Siphon: Q, then click a crowd. It heals Malrik for half of what it dr
#: scripts/campaign/mission_e5_03.gd:165
msgid "Ctrl+Q learns Soul Siphon: Q, then click a crowd. It heals Malrik for half of what it drains."
msgstr "Ctrl+Q apprend Soul Siphon : Q, puis clic sur un groupe. Malrik récupère la moitié de ce qu'il draine."

