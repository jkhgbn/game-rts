#. const MISSION_TITLE := "The Storm on the Ridge"
#: scripts/campaign/mission_e3_04.gd:29
msgid "The Storm on the Ridge"
msgstr "La tempête sur la crête"

#. const WATCH := {&"W1": ["Bishop's Crest", Vector3(0.0, 0.0, -36.0)], &"W2": ["Reed Watch", Vector3(-34.0, 0.0,
#: scripts/campaign/mission_e3_04.gd:51
msgid "Bishop's Crest"
msgstr "Bishop's Crest"

