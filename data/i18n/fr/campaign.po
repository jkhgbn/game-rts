#. &"heartglade": ["Heartglade", Vector3(0.0, 0.0, 9.0), [Vector3(-7.0, 0.0, 9.0), Vector3(7.0, 0.0, 9.0), Vector
#: scripts/campaign/mission_e4_03.gd:59
msgid "Heartglade"
msgstr "Heartglade"

#. [&"narrator", "The Sighing Wood, at the edge of winter. Burnt by Shadow, frozen by Ice, and not dead yet."],
#: scripts/campaign/mission_e4_03.gd:125 data/voice/lines/e4m3.json:L1
msgid "The Sighing Wood, at the edge of winter. Burnt by Shadow, frozen by Ice, and not dead yet."
msgstr "La Sighing Wood, au seuil de l'hiver. Brûlée par l'Ombre, gelée par la Glace, et pas encore morte."

#. [&"ysolde", "Five glades still remember being green. Break the rime, plant, and keep them warm."],
#: scripts/campaign/mission_e4_03.gd:126 data/voice/lines/e4m3.json:L2
msgid "Five glades still remember being green. Break the rime, plant, and keep them warm."
msgstr "Cinq clairières se souviennent encore d'avoir été vertes. Brisez le givre, plantez, et gardez-les au chaud."

#. [&"maelis", "Torvald holds the west. His glass warden holds the east. They're both very tidy."],
#: scripts/campaign/mission_e4_03.gd:127 data/voice/lines/e4m3.json:L3
msgid "Torvald holds the west. His glass warden holds the east. They're both very tidy."
msgstr "Torvald tient l'ouest. Sa gardienne de verre tient l'est. Ils sont très ordonnés, tous les deux."

#. [&"messenger", "My lady, the hollow by the camp... it's frosted, but it's... it's still breathing."],
#: scripts/campaign/mission_e4_03.gd:128 data/voice/lines/e4m3.json:L4
msgid "My lady, the hollow by the camp... it's frosted, but it's... it's still breathing."
msgstr "Ma dame, le creux près du camp est givré, mais il respire encore."

#. [&"ysolde", "Grow. Slowly, if you must. Just grow."],
#: scripts/campaign/mission_e4_03.gd:129 data/voice/lines/e4m3.json:L5
msgid "Grow. Slowly, if you must. Just grow."
msgstr "Pousse. Lentement, s'il le faut. Mais pousse."

#. [&"narrator", "Green, in the Sighing Wood. For the first time since the fire."],
#: scripts/campaign/mission_e4_03.gd:130 data/voice/lines/e4m3.json:L6
msgid "Green, in the Sighing Wood. For the first time since the fire."
msgstr "Du vert, dans la Sighing Wood. Pour la première fois depuis l'incendie."

#. [&"aldra", "They're planting. Go and put the frost back. Gently. Nothing here should grow strong."],
#: scripts/campaign/mission_e4_03.gd:131 data/voice/lines/e4m3.json:L7
msgid "They're planting. Go and put the frost back. Gently. Nothing here should grow strong."
msgstr "Ils plantent. Allez remettre le givre. Doucement. Rien ici ne doit devenir fort."

#. [&"aldra", "Ysolde. Torvald asked me to keep this wood quiet. I keep what I'm asked to keep."],
#: scripts/campaign/mission_e4_03.gd:132 data/voice/lines/e4m3.json:L8
msgid "Ysolde. Torvald asked me to keep this wood quiet. I keep what I'm asked to keep."
msgstr "Ysolde. Torvald m'a demandé de garder ce bois tranquille. Je garde ce qu'on me demande de garder."

#. [&"ysolde", "You froze a grave, Aldra. I've come to open it."],
#: scripts/campaign/mission_e4_03.gd:133 data/voice/lines/e4m3.json:L9
msgid "You froze a grave, Aldra. I've come to open it."
msgstr "Tu as gelé une tombe, Aldra. Je suis venue l'ouvrir."

#. [&"ysolde", "They broke it. Then we plant it again. Roots don't count how often."],
#: scripts/campaign/mission_e4_03.gd:134 data/voice/lines/e4m3.json:L10
msgid "They broke it. Then we plant it again. Roots don't count how often."
msgstr "Ils l'ont brisée. Alors on la replante. Les racines ne comptent pas les fois."

#. [&"maelis", "Tall enough for birds now. Big ones, with thorns."],
#: scripts/campaign/mission_e4_03.gd:135 data/voice/lines/e4m3.json:L11
msgid "Tall enough for birds now. Big ones, with thorns."
msgstr "Assez grand pour les oiseaux, maintenant. Des gros, avec des épines."

#. [&"ysolde", "The Last Heartwood. You held on all winter, didn't you?"],
#: scripts/campaign/mission_e4_03.gd:136 data/voice/lines/e4m3.json:L12
msgid "The Last Heartwood. You held on all winter, didn't you?"
msgstr "Le Last Heartwood. Tu as tenu tout l'hiver, hein ?"

#. [&"torvald", "Aldra. Let her plant. We will see what the frost thinks of it."],
#: scripts/campaign/mission_e4_03.gd:137 data/voice/lines/e4m3.json:L13
msgid "Aldra. Let her plant. We will see what the frost thinks of it."
msgstr "Aldra. Laisse-la planter. On verra ce que le givre en pense."

#. [&"aldra", "Cracked. Not broken. I'll be back before your seedlings are."],
#: scripts/campaign/mission_e4_03.gd:138 data/voice/lines/e4m3.json:L14
msgid "Cracked. Not broken. I'll be back before your seedlings are."
msgstr "Fêlée. Pas brisée. Je serai de retour avant tes jeunes pousses."

#. [&"hush", "One more night, Ysolde. The Bishop pays for every one."],
#: scripts/campaign/mission_e4_03.gd:139 data/voice/lines/e4m3.json:L15
msgid "One more night, Ysolde. The Bishop pays for every one."
msgstr "Encore une nuit, Ysolde. L'Évêque les paie toutes."

#. [&"aldra", "Enough green. This wood is ours by treaty, and by winter."],
#: scripts/campaign/mission_e4_03.gd:140 data/voice/lines/e4m3.json:L16
msgid "Enough green. This wood is ours by treaty, and by winter."
msgstr "Assez de vert. Ce bois est à nous par traité, et par l'hiver."

#. [&"maelis", "Her glass is sand now. She'll have to sulk somewhere warmer."],
#: scripts/campaign/mission_e4_03.gd:141 data/voice/lines/e4m3.json:L17
msgid "Her glass is sand now. She'll have to sulk somewhere warmer."
msgstr "Son verre n'est plus que du sable. Elle ira bouder ailleurs, au chaud."

#. [&"torvald", "Ysolde. You were always the patient one. Why can you not wait for spring?"],
#: scripts/campaign/mission_e4_03.gd:142 data/voice/lines/e4m3.json:L18
msgid "Ysolde. You were always the patient one. Why can you not wait for spring?"
msgstr "Ysolde. Tu as toujours été la patiente. Pourquoi ne peux-tu pas attendre le printemps ?"

#. [&"ysolde", "Because you froze the spring, Torvald. Somebody has to go and get it."],
#: scripts/campaign/mission_e4_03.gd:143 data/voice/lines/e4m3.json:L19
msgid "Because you froze the spring, Torvald. Somebody has to go and get it."
msgstr "Parce que tu as gelé le printemps, Torvald. Il faut bien que quelqu'un aille le chercher."

#. [&"narrator", "Five glades, green at once. Deep under the ash, something old turns over."],
#: scripts/campaign/mission_e4_03.gd:144 data/voice/lines/e4m3.json:L20
msgid "Five glades, green at once. Deep under the ash, something old turns over."
msgstr "Cinq clairières, vertes en même temps. Loin sous la cendre, quelque chose d'ancien se retourne."

#. [&"ysolde", "Hold them. All of them. Just a little longer."],
#: scripts/campaign/mission_e4_03.gd:145 data/voice/lines/e4m3.json:L21
msgid "Hold them. All of them. Just a little longer."
msgstr "Tenez-les. Toutes. Encore un peu."

#. [&"torvald", "Aldra. Look. A shoot, in the ash. After all of that."],
#: scripts/campaign/mission_e4_03.gd:146 data/voice/lines/e4m3.json:L22
msgid "Aldra. Look. A shoot, in the ash. After all of that."
msgstr "Aldra. Regarde. Une pousse, dans la cendre. Après tout ça."

#. [&"aldra", "It's a weed, Torvald."],
#: scripts/campaign/mission_e4_03.gd:147 data/voice/lines/e4m3.json:L23
msgid "It's a weed, Torvald."
msgstr "C'est une mauvaise herbe, Torvald."

#. [&"torvald", "We were all weeds once. Pull back."],
#: scripts/campaign/mission_e4_03.gd:148 data/voice/lines/e4m3.json:L24
msgid "We were all weeds once. Pull back."
msgstr "Nous avons tous été de mauvaises herbes. Repliez-vous."

#. [&"ysolde", "You see, Maelis? It always comes back."],
#: scripts/campaign/mission_e4_03.gd:149 data/voice/lines/e4m3.json:L25
msgid "You see, Maelis? It always comes back."
msgstr "Tu vois, Maelis ? Ça revient toujours."

#. [&"maelis", "Mm. And it brought you a present."],
#: scripts/campaign/mission_e4_03.gd:150 data/voice/lines/e4m3.json:L26
msgid "Mm. And it brought you a present."
msgstr "Mm. Et ça t'a apporté un cadeau."

#. [&"ysolde", "The wood can, now. Thank you, Vessa."],
#: scripts/campaign/mission_e4_03.gd:151 data/voice/lines/e4m3.json:L27
msgid "The wood can, now. Thank you, Vessa."
msgstr "Le bois peut, maintenant. Merci, Vessa."

#. [&"narrator", "Under the frost, very slowly, the Sighing Wood began to breathe again."],
#: scripts/campaign/mission_e4_03.gd:152 data/voice/lines/e4m3.json:L28
msgid "Under the frost, very slowly, the Sighing Wood began to breathe again."
msgstr "Sous le givre, très lentement, la Sighing Wood s'est remise à respirer."

#. [&"ysolde", "The wood... will remember..."],
#: scripts/campaign/mission_e4_03.gd:153 data/voice/lines/e4m3.json:L29
msgid "The wood... will remember..."
msgstr "Le bois... se souviendra..."

#. [&"maelis", "The new Heartwood's fallen. The wood has nothing left to grow from."],
#: scripts/campaign/mission_e4_03.gd:154 data/voice/lines/e4m3.json:L30
msgid "The new Heartwood's fallen. The wood has nothing left to grow from."
msgstr "Le nouveau Heartwood est tombé. Le bois n'a plus rien d'où repousser."

#. "The people are safe behind Vessa's border. Ysolde did not stay. She walked back east, into the wood she was b
#: scripts/campaign/mission_e4_03.gd:157
msgid "The people are safe behind Vessa's border. Ysolde did not stay. She walked back east, into the wood she was born to keep, with a seed-pod in her hand that Vessa had kept for her all year."
msgstr "Les gens sont à l'abri derrière la frontière de Vessa. Ysolde n'est pas restée. Elle est repartie vers l'est, dans le bois qu'elle est née pour garder, avec dans la main une cosse que Vessa lui a gardée toute l'année."

#. "The Sighing Wood is still ash under rime. Torvald holds its west; Aldra Stillwater, his Glass Warden, holds i
#: scripts/campaign/mission_e4_03.gd:158
msgid "The Sighing Wood is still ash under rime. Torvald holds its west; Aldra Stillwater, his Glass Warden, holds its east, and her totems keep five old glades frozen so that nothing grows there again."
msgstr "Le Sighing Wood n'est encore que cendre sous le givre. Torvald en tient l'ouest ; Aldra Stillwater, sa Gardienne de verre, en tient l'est, et ses totems gardent cinq vieilles clairières gelées pour que plus rien n'y pousse."

#. "Break the frost. Plant. Keep the young groves alive until all five are green at once. A wood that grows back
#: scripts/campaign/mission_e4_03.gd:159
msgid "Break the frost. Plant. Keep the young groves alive until all five are green at once. A wood that grows back cannot be held by anyone who wants it dead."
msgstr "Brisez le givre. Plantez. Gardez les jeunes bosquets en vie jusqu'à ce que les cinq soient verts en même temps. Un bois qui repousse ne peut pas être tenu par qui le veut mort."

#. const BRIEFING_LINE := "Groves grow only while no enemy stands in them. Guard them while they grow."
#: scripts/campaign/mission_e4_03.gd:161
msgid "Groves grow only while no enemy stands in them. Guard them while they grow."
msgstr "Les bosquets ne poussent que si aucun ennemi n'y est. Gardez-les pendant qu'ils poussent."

#. const HINT_START := "Break the Rime Totems at a glade, then hold Ysolde at its centre to plant. Keep enemies o
#: scripts/campaign/mission_e4_03.gd:162
msgid "Break the Rime Totems at a glade, then hold Ysolde at its centre to plant. Keep enemies out while it grows."
msgstr "Brisez les Rime Totems d'une clairière, puis gardez Ysolde en son centre pour planter. Tenez l'ennemi dehors pendant que ça pousse."

#. const HINT_SAGE := "Bramblesage: Snagroot pulls a shield-caster out of the frost. Pollen Haze silences archers
#: scripts/campaign/mission_e4_03.gd:163
msgid "Bramblesage: Snagroot pulls a shield-caster out of the frost. Pollen Haze silences archers while you break totems."
msgstr "Bramblesage : Snagroot tire un lanceur de boucliers hors du givre. Pollen Haze fait taire les archers pendant que vous brisez les totems."

#. const HINT_GROWN := "A green grove heals your soldiers. The Ice will come to freeze it again."
#: scripts/campaign/mission_e4_03.gd:164
msgid "A green grove heals your soldiers. The Ice will come to freeze it again."
msgstr "Un bosquet vert soigne vos soldats. La Glace viendra le geler de nouveau."

#. const HINT_CITADEL := "Your Stronghold can become a Citadel: select the Heartwood and press X (300 crystals, 9
#: scripts/campaign/mission_e4_03.gd:165
msgid "Your Stronghold can become a Citadel: select the Heartwood and press X (300 crystals, 90 s). It opens the Briar Roc (C): its Seed Storm roots from the air, out of the totems' reach."
msgstr "Votre Forteresse peut devenir une Citadelle : sélectionnez le Heartwood et appuyez sur X (300 cristaux, 90 s). Elle ouvre le Briar Roc (C) : sa Seed Storm enracine depuis les airs, hors de portée des totems."

#. const HINT_ROOTING := "A grove that has grown out must take root: keep soldiers or Ysolde in it for 30 s with
#: scripts/campaign/mission_e4_03.gd:166
msgid "A grove that has grown out must take root: keep soldiers or Ysolde in it for 30 s with no enemy inside."
msgstr "Un bosquet qui a fini de pousser doit prendre racine : gardez-y des soldats ou Ysolde pendant 30 s, sans ennemi à l'intérieur."

#. c.keep_lost_message = "The new Heartwood has fallen"
#: scripts/campaign/mission_e4_03.gd:232
msgid "The new Heartwood has fallen"
msgstr "Le nouveau Heartwood est tombé"

#. c.victory_banner = "VICTORY\nThe Sighing Wood breathes again"
#: scripts/campaign/mission_e4_03.gd:249
msgid "VICTORY\nThe Sighing Wood breathes again"
msgstr "VICTOIRE\nLe Sighing Wood respire de nouveau"

#. c.spotlight = {"id": &"briar_roc", "trigger": &"manual", "key_hint": "Heartwood: C",
#: scripts/campaign/mission_e4_03.gd:252
msgid "Heartwood: C"
msgstr "Heartwood : C"

#. "card": "Briar Roc. A thorn bird: walls don't stop it, and its seed storm roots the crowd below."}
#: scripts/campaign/mission_e4_03.gd:253
msgid "Briar Roc. A thorn bird: walls don't stop it, and its seed storm roots the crowd below."
msgstr "Briar Roc. Un oiseau d'épines : les murs ne l'arrêtent pas, et sa tempête de graines enracine la foule en dessous."

