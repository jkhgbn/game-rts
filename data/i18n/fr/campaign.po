#. return "Arm Adamarch's guests: buy 2 wares"
#: scripts/campaign/mission_e7_01.gd:395
msgid "Arm Adamarch's guests: buy 2 wares"
msgstr "Équipe les invités d'Adamarch : achète 2 marchandises"

#. const MISSION_TITLE := "First Blood, and No Further"
#: scripts/campaign/mission_e7_02.gd:26
msgid "First Blood, and No Further"
msgstr "Premier sang, et rien de plus"

#. [&"ossavar", "Two cities, two lies, one rock. The rock, at least, is honest."],
#: scripts/campaign/mission_e7_02.gd:91 data/voice/lines/e7m2.json:L1
msgid "Two cities, two lies, one rock. The rock, at least, is honest."
msgstr "Deux villes, deux mensonges, un rocher. Le rocher, au moins, est honnête."

#. [&"seraphine", "They say Adamarch staged it. I bled on that sand, Ice-king. I would like to know for whom."],
#: scripts/campaign/mission_e7_02.gd:92 data/voice/lines/e7m2.json:L2
msgid "They say Adamarch staged it. I bled on that sand, Ice-king. I would like to know for whom."
msgstr "On dit qu'Adamarch a tout monté. J'ai saigné sur ce sable, roi de glace. J'aimerais savoir pour qui."

#. [&"torvald", "So would I. Malrik sailed home before the blood was dry. That is not mourning."],
#: scripts/campaign/mission_e7_02.gd:93 data/voice/lines/e7m2.json:L3
msgid "So would I. Malrik sailed home before the blood was dry. That is not mourning."
msgstr "Moi aussi. Malrik est rentré avant que le sang sèche. Ce n'est pas du deuil, ça."

#. [&"aldra", "The bettors fled with their strongboxes and dropped half of them. Coin always runs downhill."],
#: scripts/campaign/mission_e7_02.gd:94 data/voice/lines/e7m2.json:L4
msgid "The bettors fled with their strongboxes and dropped half of them. Coin always runs downhill."
msgstr "Les parieurs ont fui avec leurs coffres et en ont échappé la moitié. L'argent roule toujours vers le bas."

#. [&"vessa", "Back again, Torvald? You're the slowest man I know, and you're still everywhere."],
#: scripts/campaign/mission_e7_02.gd:95 data/voice/lines/e7m2.json:L5
msgid "Back again, Torvald? You're the slowest man I know, and you're still everywhere."
msgstr "Encore toi, Torvald ? T'es l'homme le plus lent que je connais, et t'es partout quand même."

#. [&"torvald", "The Citadel stands. Aldra. I would rather not do this one alone."],
#: scripts/campaign/mission_e7_02.gd:96 data/voice/lines/e7m2.json:L6
msgid "The Citadel stands. Aldra. I would rather not do this one alone."
msgstr "La Citadelle est debout. Aldra. J'aimerais mieux ne pas faire celle-ci seul."

#. [&"aldra", "You never do anything alone, my lord. You only think you do."],
#: scripts/campaign/mission_e7_02.gd:97 data/voice/lines/e7m2.json:L7
msgid "You never do anything alone, my lord. You only think you do."
msgstr "Tu ne fais jamais rien seul, seigneur. Tu crois seulement que oui."

#. [&"seraphine", "The barricade is down. Walls should know when to fall. Ours never did."],
#: scripts/campaign/mission_e7_02.gd:98 data/voice/lines/e7m2.json:L8
msgid "The barricade is down. Walls should know when to fall. Ours never did."
msgstr "La barricade est tombée. Les murs devraient savoir quand tomber. Les nôtres ne l'ont jamais su."

#. [&"ossavar", "You hold my rock. Look under the cloths. The dead are poor liars."],
#: scripts/campaign/mission_e7_02.gd:99 data/voice/lines/e7m2.json:L9
msgid "You hold my rock. Look under the cloths. The dead are poor liars."
msgstr "Tu tiens mon rocher. Regarde sous les draps. Les morts mentent mal."

#. [&"torvald", "Aurivane's cloaks, on knives forged in the dark. The edges drink the light. Shadow steel."],
#: scripts/campaign/mission_e7_02.gd:100 data/voice/lines/e7m2.json:L10
msgid "Aurivane's cloaks, on knives forged in the dark. The edges drink the light. Shadow steel."
msgstr "Des manteaux d'Aurivane sur des lames forgées dans le noir. Elles boivent la lumière. De l'acier d'Ombre."

#. [&"torvald", "The boat my rune saw left violet smoke. Gold cloaks do not row from the north."],
#: scripts/campaign/mission_e7_02.gd:101 data/voice/lines/e7m2.json:L10b
msgid "The boat my rune saw left violet smoke. Gold cloaks do not row from the north."
msgstr "La barque que ma rune a vue laissait une fumée violette. Les manteaux dorés ne rament pas depuis le nord."

#. [&"aldra", "The bettors' ledger. Someone wagered against both cities, on the same night, before the duel."],
#: scripts/campaign/mission_e7_02.gd:102 data/voice/lines/e7m2.json:L11
msgid "The bettors' ledger. Someone wagered against both cities, on the same night, before the duel."
msgstr "Le registre des parieurs. Quelqu'un a parié contre les deux villes, la même nuit, avant le duel."

#. [&"torvald", "A man who bets on the war, not the winner. I know only one with that much patience."],
#: scripts/campaign/mission_e7_02.gd:103 data/voice/lines/e7m2.json:L12
msgid "A man who bets on the war, not the winner. I know only one with that much patience."
msgstr "Un homme qui parie sur la guerre, pas sur le gagnant. Je n'en connais qu'un d'aussi patient."

#. [&"herald", "Don't hurt me! I only read the names! I saw the boat, a black boat, from the north side!"],
#: scripts/campaign/mission_e7_02.gd:104 data/voice/lines/e7m2.json:L13
msgid "Don't hurt me! I only read the names! I saw the boat, a black boat, from the north side!"
msgstr "Ne me faites pas de mal ! Je lisais juste les noms ! J'ai vu une barque noire, du côté nord !"

#. [&"torvald", "Easy. Who stepped out of it?"],
#: scripts/campaign/mission_e7_02.gd:105 data/voice/lines/e7m2.json:L14
msgid "Easy. Who stepped out of it?"
msgstr "Du calme. Qui en est sorti ?"

#. [&"herald", "A woman in a white mask. She never said a word. The knives followed her like ducklings."],
#: scripts/campaign/mission_e7_02.gd:106 data/voice/lines/e7m2.json:L15
msgid "A woman in a white mask. She never said a word. The knives followed her like ducklings."
msgstr "Une femme au masque blanc. Elle n'a pas dit un mot. Les couteaux la suivaient comme des canetons."

#. [&"torvald", "A white mask. Then I know the knife, and I know the hand that throws it."],
#: scripts/campaign/mission_e7_02.gd:107 data/voice/lines/e7m2.json:L16
msgid "A white mask. Then I know the knife, and I know the hand that throws it."
msgstr "Un masque blanc. Alors je connais le couteau, et je connais la main qui le lance."

#. [&"dacian", "You want the truth told on my sand, Ice-king? Then by the old rule. First blood, and no further."
#: scripts/campaign/mission_e7_02.gd:108 data/voice/lines/e7m2.json:L17
msgid "You want the truth told on my sand, Ice-king? Then by the old rule. First blood, and no further."
msgstr "Tu veux la vérité sur mon sable, roi de glace ? Alors, la vieille règle : premier sang, et rien de plus."

#. [&"dacian", "Well struck. Twice now an Adamarch guest has cut me. I am starting to take it personally."],
#: scripts/campaign/mission_e7_02.gd:109 data/voice/lines/e7m2.json:L18a
msgid "Well struck. Twice now an Adamarch guest has cut me. I am starting to take it personally."
msgstr "Bien frappé. Deux fois qu'un invité d'Adamarch me coupe. Je commence à le prendre personnel."

#. [&"dacian", "First blood to the Sun. Now say your truth, Ice-king, and I will listen."],
#: scripts/campaign/mission_e7_02.gd:110 data/voice/lines/e7m2.json:L18b
msgid "First blood to the Sun. Now say your truth, Ice-king, and I will listen."
msgstr "Premier sang au Soleil. Maintenant, dis ta vérité, roi de glace, et je t'écouterai."

#. [&"herald", "Neither bleeds! By the law, it is a draw, and the sand is quiet!"],
#: scripts/campaign/mission_e7_02.gd:111 data/voice/lines/e7m2.json:L18c
msgid "Neither bleeds! By the law, it is a draw, and the sand is quiet!"
msgstr "Aucun ne saigne ! Selon la loi, c'est match nul, et le sable est en paix !"

#. [&"hush", "Hush now, Sunblade. The war only needs one more death."],
#: scripts/campaign/mission_e7_02.gd:112 data/voice/lines/e7m2.json:L19
msgid "Hush now, Sunblade. The war only needs one more death."
msgstr "Chut, Sunblade. La guerre n'a besoin que d'une mort de plus."

#. [&"seraphine", "Behind you, Dacian! The knives again!"],
#: scripts/campaign/mission_e7_02.gd:113 data/voice/lines/e7m2.json:L20
msgid "Behind you, Dacian! The knives again!"
msgstr "Derrière toi, Dacian ! Encore les couteaux !"

#. [&"vessa", "I know those knives. I've had them at my throat. Hush! I owe you a night!"],
#: scripts/campaign/mission_e7_02.gd:114 data/voice/lines/e7m2.json:L21
msgid "I know those knives. I've had them at my throat. Hush! I owe you a night!"
msgstr "Je connais ces couteaux. Je les ai eus sur la gorge. Hush ! Je te dois une nuit !"

#. [&"hush", "There is always another night, Ice-king. Ask your friend how he spends his."],
#: scripts/campaign/mission_e7_02.gd:115 data/voice/lines/e7m2.json:L22
msgid "There is always another night, Ice-king. Ask your friend how he spends his."
msgstr "Il y a toujours une autre nuit, roi de glace. Demande à ton ami comment il passe les siennes."

#. [&"dacian", "Those were never ours. You knew before you came to the sand."],
#: scripts/campaign/mission_e7_02.gd:116 data/voice/lines/e7m2.json:L23
msgid "Those were never ours. You knew before you came to the sand."
msgstr "Ce n'était jamais les nôtres. Tu le savais avant de venir sur le sable."

#. [&"torvald", "Mother Hush. I have stood beside this mask in Malrik's camp. They were my ally's knives."],
#: scripts/campaign/mission_e7_02.gd:117 data/voice/lines/e7m2.json:L24
msgid "Mother Hush. I have stood beside this mask in Malrik's camp. They were my ally's knives."
msgstr "Mère Hush. J'ai côtoyé ce masque dans le camp de Malrik. C'étaient les couteaux de mon allié."

#. [&"seraphine", "Then your ally broke a truce that held for a hundred and thirty years. For what?"],
#: scripts/campaign/mission_e7_02.gd:118 data/voice/lines/e7m2.json:L25
msgid "Then your ally broke a truce that held for a hundred and thirty years. For what?"
msgstr "Alors ton allié a brisé une trêve qui tenait depuis cent trente ans. Pour quoi ?"

#. [&"torvald", "For a war that does not end. Wars are good for business, and better for that stone."],
#: scripts/campaign/mission_e7_02.gd:119 data/voice/lines/e7m2.json:L26
msgid "For a war that does not end. Wars are good for business, and better for that stone."
msgstr "Pour une guerre sans fin. La guerre est bonne pour les affaires, et meilleure encore pour cette pierre."

#. [&"ossavar", "First blood, and no further. The cities forgot. Let us see if you remember."],
#: scripts/campaign/mission_e7_02.gd:120 data/voice/lines/e7m2.json:L27
msgid "First blood, and no further. The cities forgot. Let us see if you remember."
msgstr "Premier sang, et rien de plus. Les villes ont oublié. Voyons si toi, tu t'en souviens."

#. [&"aldra", "Bettors' gold. It spends the same as honest gold, which is the whole trouble with gold."],
#: scripts/campaign/mission_e7_02.gd:121 data/voice/lines/e7m2.json:L28
msgid "Bettors' gold. It spends the same as honest gold, which is the whole trouble with gold."
msgstr "L'or des parieurs. Il se dépense comme l'or honnête, et c'est tout le problème avec l'or."

#. [&"seraphine", "The Sunblade is down. Every bell in both cities will ring for war now."],
#: scripts/campaign/mission_e7_02.gd:122 data/voice/lines/e7m2.json:L29
msgid "The Sunblade is down. Every bell in both cities will ring for war now."
msgstr "Le Sunblade est tombé. Toutes les cloches des deux villes vont sonner la guerre, maintenant."

#. [&"torvald", "Too late. I always arrive... too late."],
#: scripts/campaign/mission_e7_02.gd:123 data/voice/lines/e7m2.json:L30
msgid "Too late. I always arrive... too late."
msgstr "Trop tard. J'arrive toujours... trop tard."

#. "The morning after the Laurel, the Coinwater woke to two lies. Aurivane says Adamarch faked an attack to steal
#: scripts/campaign/mission_e7_02.gd:126
msgid "The morning after the Laurel, the Coinwater woke to two lies. Aurivane says Adamarch faked an attack to steal the duel. Adamarch says Aurivane hid knives in gold cloaks. Aurivane's spears now hold the Tollrock, and a barricade shuts the North Causeway."
msgstr "Le matin après le Laurel, le Coinwater s'est réveillé avec deux mensonges. Aurivane dit qu'Adamarch a simulé une attaque pour voler le duel. Adamarch dit qu'Aurivane a caché des couteaux sous des manteaux dorés. Les lances d'Aurivane tiennent maintenant le Tollrock, et une barricade ferme la Chaussée nord."

#. "Malrik sailed home to the Admiralty \"to mourn\". Seraphine did not: she stands at Torvald's camp with a band
#: scripts/campaign/mission_e7_02.gd:127
msgid "Malrik sailed home to the Admiralty \"to mourn\". Seraphine did not: she stands at Torvald's camp with a bandaged hand and one question. Ossavar, on the Master's chair, gave his own advice: ask the herald where the knives came from."
msgstr "Malrik est rentré à l'Amirauté « pour faire son deuil ». Pas Seraphine : elle se tient au camp de Torvald, la main bandée, avec une seule question. Ossavar, sur le siège du Maître, a donné son propre conseil : demander au héraut d'où venaient les couteaux."

#. "Take the rock. Find what the knives left behind. Then settle it the only way both cities still respect: first
#: scripts/campaign/mission_e7_02.gd:128
msgid "Take the rock. Find what the knives left behind. Then settle it the only way both cities still respect: first blood, and no further."
msgstr "Prends le rocher. Trouve ce que les couteaux ont laissé derrière eux. Puis règle ça de la seule façon que les deux cités respectent encore : premier sang, et rien de plus."

#. const BRIEFING_LINE := "The herald saw the knives arrive. He fled to the far shore."
#: scripts/campaign/mission_e7_02.gd:130
msgid "The herald saw the knives arrive. He fled to the far shore."
msgstr "Le héraut a vu arriver les couteaux. Il s'est enfui sur l'autre rive."

#. const HINT_START := "Break the Sun Barricade on the North Causeway. Frost Mortars hit walls hard; a Rimecarver
#: scripts/campaign/mission_e7_02.gd:131
msgid "Break the Sun Barricade on the North Causeway. Frost Mortars hit walls hard; a Rimecarver's Scrying Rune shows what is behind it."
msgstr "Brise la Barricade du soleil sur la Chaussée nord. Les Frost Mortars frappent fort sur les murs; la Scrying Rune d'un Rimecarver montre ce qu'il y a derrière."

#. const HINT_CITADEL := "Your Stronghold can become a Citadel: select the Keep and press X (300 crystals, 90 s).
#: scripts/campaign/mission_e7_02.gd:132
msgid "Your Stronghold can become a Citadel: select the Keep and press X (300 crystals, 90 s). It opens the Shardguard (C) and lets you call Aldra (V)."
msgstr "Ta Forteresse peut devenir une Citadelle : sélectionne le donjon et appuie sur X (300 cristaux, 90 s). Elle débloque le Shardguard (C) et permet d'appeler Aldra (V)."

#. const HINT_CALL := "Call Aldra: select the Keep and press V. She fights on her own; her card sets where (Escor
#: scripts/campaign/mission_e7_02.gd:133
msgid "Call Aldra: select the Keep and press V. She fights on her own; her card sets where (Escort / Vanguard / Hold home)."
msgstr "Appelle Aldra : sélectionne le donjon et appuie sur V. Elle combat seule; sa carte choisit où (Escorte / Avant-garde / Garde la base)."

#. const HINT_CLUE := "Hold Torvald beside a clue (4 s) with no enemy near to read it."
#: scripts/campaign/mission_e7_02.gd:134
msgid "Hold Torvald beside a clue (4 s) with no enemy near to read it."
msgstr "Garde Torvald près d'un indice (4 s), sans ennemi proche, pour le lire."

#. const HINT_SHARDGUARD := "A Shardguard beside Dacian stops her blink and freezes her."
#: scripts/campaign/mission_e7_02.gd:135
msgid "A Shardguard beside Dacian stops her blink and freezes her."
msgstr "Un Shardguard près de Dacian bloque son saut et la gèle."

#. const MSG_ISLE_SHUT := "The Sun Barricade still stands: the isle is closed."
#: scripts/campaign/mission_e7_02.gd:136
msgid "The Sun Barricade still stands: the isle is closed."
msgstr "La Barricade du soleil tient encore : l'île est fermée."

#. const MSG_DACIAN := "Dacian comes to the sand."
#: scripts/campaign/mission_e7_02.gd:137
msgid "Dacian comes to the sand."
msgstr "Dacian descend sur le sable."

#. const MSG_DACIAN_SOON := "Dacian comes to the sand. Meet him at the Tollrock."
#: scripts/campaign/mission_e7_02.gd:138
msgid "Dacian comes to the sand. Meet him at the Tollrock."
msgstr "Dacian descend sur le sable. Va l'affronter au Tollrock."

#. const MSG_BOXES_WINDOW := "The bettors will be back for their strongboxes in %s."
#: scripts/campaign/mission_e7_02.gd:139
msgid "The bettors will be back for their strongboxes in %s."
msgstr "Les parieurs reviendront chercher leurs coffres dans %s."

#. const MSG_BOXES_GONE := "The bettors carried off the last strongboxes."
#: scripts/campaign/mission_e7_02.gd:140
msgid "The bettors carried off the last strongboxes."
msgstr "Les parieurs ont emporté les derniers coffres."

#. const MSG_CAUSEWAY_WARN := "Break the Sun Barricade before %s, or the causeway holds and the truth stays burie
#: scripts/campaign/mission_e7_02.gd:141
msgid "Break the Sun Barricade before %s, or the causeway holds and the truth stays buried."
msgstr "Brise la Barricade du soleil avant %s, sinon la chaussée tient et la vérité reste enterrée."

#. const MSG_CAUSEWAY_HOLDS := "The causeway holds: you have not broken it."
#: scripts/campaign/mission_e7_02.gd:142
msgid "The causeway holds: you have not broken it."
msgstr "La chaussée tient : tu ne l'as pas brisée."

#. const HINT_SWING := "Dacian winds up a Sun Cleave: step out of the marked ground before it lands."
#: scripts/campaign/mission_e7_02.gd:143
msgid "Dacian winds up a Sun Cleave: step out of the marked ground before it lands."
msgstr "Dacian arme un Sun Cleave : sors de la zone marquée avant qu'il tombe."

#. const MSG_RING := "The Laurel ring is for the duellists alone."
#: scripts/campaign/mission_e7_02.gd:144
msgid "The Laurel ring is for the duellists alone."
msgstr "Le cercle du Laurel est réservé aux duellistes."

#. const MSG_CLUE_REFUSED := "Not with the enemy this close."
#: scripts/campaign/mission_e7_02.gd:145
msgid "Not with the enemy this close."
msgstr "Pas avec l'ennemi si proche."

#. const MSG_VESSA_FELL := "Vessa falls back to the Sun Gate"
#: scripts/campaign/mission_e7_02.gd:146
msgid "Vessa falls back to the Sun Gate"
msgstr "Vessa se replie vers la Porte du soleil"

#. const MSG_STAND_DOWN := "Aurivane lowers its spears for the Laurel."
#: scripts/campaign/mission_e7_02.gd:147
msgid "Aurivane lowers its spears for the Laurel."
msgstr "Aurivane abaisse ses lances pour le Laurel."

#. local_building_into("fire_barracks", "sun_barricade", "Sun Barricade")
#: scripts/campaign/mission_e7_02.gd:197
msgid "Sun Barricade"
msgstr "Barricade du soleil"

#. c.victory_banner = "VICTORY\nFirst blood, and no further"
#: scripts/campaign/mission_e7_02.gd:227
msgid "VICTORY\nFirst blood, and no further"
msgstr "VICTOIRE\nPremier sang, et rien de plus"

#. c.spotlight = {"id": &"helper_aldra", "trigger": &"manual", "key_hint": "Rime Keep: V",
#: scripts/campaign/mission_e7_02.gd:230
msgid "Rime Keep: V"
msgstr "Rime Keep : V"

#. "card": "Aldra. The Glass Warden: she shields the army's walk and shatters the line at the end of it."}
#: scripts/campaign/mission_e7_02.gd:231
msgid "Aldra. The Glass Warden: she shields the army's walk and shatters the line at the end of it."
msgstr "Aldra. La Gardienne de verre : elle protège la marche de l'armée et brise la ligne au bout du chemin."

