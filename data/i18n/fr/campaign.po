#. [&"narrator", "Nature had no kingdom left, only seed. Fire had a border, and a frost fort sitting on it."],
#: scripts/campaign/mission_e2_02.gd:173
msgid "Nature had no kingdom left, only seed. Fire had a border, and a frost fort sitting on it."
msgstr "La Nature n'avait plus de royaume, seulement des graines. Le Feu avait une frontière, et un fort de givre assis dessus."

#. [&"ysolde", "Three groves along your line, Vessa. Give me those, and I can give you a kingdom back."],
#: scripts/campaign/mission_e2_02.gd:174
msgid "Three groves along your line, Vessa. Give me those, and I can give you a kingdom back."
msgstr "Trois bosquets le long de ta ligne, Vessa. Donne-moi ça, et je peux te redonner un royaume."

#. [&"vessa", "Three trees? I can do three trees. Torvald brought a whole fort. That one's mine."],
#: scripts/campaign/mission_e2_02.gd:175
msgid "Three trees? I can do three trees. Torvald brought a whole fort. That one's mine."
msgstr "Trois arbres? Je peux faire trois arbres. Torvald a amené un fort au complet. Celui-là est à moi."

#. [&"ysolde", "This one I can do alone. Keep them off me, and do not set it on fire."],
#: scripts/campaign/mission_e2_02.gd:176
msgid "This one I can do alone. Keep them off me, and do not set it on fire."
msgstr "Celui-ci, je peux le faire seule. Tiens-les loin de moi, et ne mets pas le feu dedans."

#. [&"vessa", "One time. I set ONE tree on fire, one time."],
#: scripts/campaign/mission_e2_02.gd:177
msgid "One time. I set ONE tree on fire, one time."
msgstr "Une fois. J'ai mis le feu à UN arbre, une fois."

#. [&"maelis", "Stumpwood breathes again. The forest remembers who froze it."],
#: scripts/campaign/mission_e2_02.gd:178
msgid "Stumpwood breathes again. The forest remembers who froze it."
msgstr "Stumpwood respire encore. La forêt se souvient de qui l'a gelée."

#. [&"ysolde", "Point, and I will go. I am done waiting for wars to pass my wood by."],
#: scripts/campaign/mission_e2_02.gd:179
msgid "Point, and I will go. I am done waiting for wars to pass my wood by."
msgstr "Montre-moi l'endroit, et j'y vais. J'ai fini d'attendre que les guerres passent à côté de mon bois."

#. [&"ashby", "Watchtower's ours, my queen. We can see clear across the Hollowmere."],
#: scripts/campaign/mission_e2_02.gd:180
msgid "Watchtower's ours, my queen. We can see clear across the Hollowmere."
msgstr "La tour de guet est à nous, ma reine. On voit clair de l'autre bord du Hollowmere."

#. [&"malrik", "A gardener and a matchstick. Torvald, they are planting trees at us."],
#: scripts/campaign/mission_e2_02.gd:181
msgid "A gardener and a matchstick. Torvald, they are planting trees at us."
msgstr "Une jardinière et une allumette. Torvald, elles nous plantent des arbres dessus."

#. [&"vessa", "The Citadel's up. Vey, the storm can come any time now. Now would be good."],
#: scripts/campaign/mission_e2_02.gd:182
msgid "The Citadel's up. Vey, the storm can come any time now. Now would be good."
msgstr "La Citadelle est debout. Vey, la tempête peut venir n'importe quand. Là, ce serait bien."

#. [&"vey", "You called twice in two days. I'll start to think you missed me."],
#: scripts/campaign/mission_e2_02.gd:183
msgid "You called twice in two days. I'll start to think you missed me."
msgstr "Tu m'appelles deux fois en deux jours. Je vais finir par croire que je t'ai manqué."

#. [&"torvald", "This bank is mine until the thaw, child. The thaw is a long way off."],
#: scripts/campaign/mission_e2_02.gd:184
msgid "This bank is mine until the thaw, child. The thaw is a long way off."
msgstr "Cette rive est à moi jusqu'au dégel, petite. Le dégel est encore loin."

#. [&"vessa", "I AM the thaw, Torvald. I've been told I'm very warm."],
#: scripts/campaign/mission_e2_02.gd:185
msgid "I AM the thaw, Torvald. I've been told I'm very warm."
msgstr "Le dégel, C'EST moi, Torvald. On m'a dit que je suis très chaleureuse."

#. [&"malrik", "The shrine glade. How fitting. Do pray, Ysolde. Nobody answered last time."],
#: scripts/campaign/mission_e2_02.gd:186
msgid "The shrine glade. How fitting. Do pray, Ysolde. Nobody answered last time."
msgstr "La clairière du sanctuaire. Comme c'est approprié. Prie donc, Ysolde. Personne n'a répondu la dernière fois."

#. [&"torvald", "I gave the wood one winter. I can give it another."],
#: scripts/campaign/mission_e2_02.gd:187
msgid "I gave the wood one winter. I can give it another."
msgstr "J'ai donné un hiver au bois. Je peux lui en donner un autre."

#. [&"ysolde", "Malrik. You burned my people. You will not have their seed."],
#: scripts/campaign/mission_e2_02.gd:188
msgid "Malrik. You burned my people. You will not have their seed."
msgstr "Malrik. Tu as brûlé mon peuple. Tu n'auras pas ses graines."

#. [&"messenger", "Frost on the road! They're going for the Heartseed!"],
#: scripts/campaign/mission_e2_02.gd:189
msgid "Frost on the road! They're going for the Heartseed!"
msgstr "Du givre sur la route! Ils s'en vont vers Heartseed!"

#. [&"ysolde", "Three groves. Enough roots to stand on. Rise."],
#: scripts/campaign/mission_e2_02.gd:190
msgid "Three groves. Enough roots to stand on. Rise."
msgstr "Trois bosquets. Assez de racines pour tenir debout. Lève-toi."

#. [&"vessa", "Huh. You grow a castle out of a seed. I have to build mine out of rocks."],
#: scripts/campaign/mission_e2_02.gd:191
msgid "Huh. You grow a castle out of a seed. I have to build mine out of rocks."
msgstr "Ben voyons. Toi, tu fais pousser un château avec une graine. Moi, je dois bâtir le mien avec des roches."

#. [&"ysolde", "Then we each keep the other's. Fire and Nature, one front."],
#: scripts/campaign/mission_e2_02.gd:192
msgid "Then we each keep the other's. Fire and Nature, one front."
msgstr "Alors chacune garde celui de l'autre. Le Feu et la Nature, un seul front."

#. [&"vessa", "Rimehold's down. Torvald, you left your fort on my bank. I put it back."],
#: scripts/campaign/mission_e2_02.gd:193
msgid "Rimehold's down. Torvald, you left your fort on my bank. I put it back."
msgstr "Rimehold est tombé. Torvald, t'as oublié ton fort sur ma rive. Je te l'ai rangé."

#. [&"narrator", "Two kingdoms on one bank, two across the water. Now it is a real war."],
#: scripts/campaign/mission_e2_02.gd:194
msgid "Two kingdoms on one bank, two across the water. Now it is a real war."
msgstr "Deux royaumes sur une rive, deux de l'autre côté de l'eau. Maintenant, c'est une vraie guerre."

#. [&"torvald", "Now, Bishop. Before her roots take hold."],
#: scripts/campaign/mission_e2_02.gd:195
msgid "Now, Bishop. Before her roots take hold."
msgstr "Maintenant, l'Évêque. Avant que ses racines prennent."

#. [&"malrik", "Knights, to the shrine glade. Burn whatever grew there twice."],
#: scripts/campaign/mission_e2_02.gd:196
msgid "Knights, to the shrine glade. Burn whatever grew there twice."
msgstr "Chevaliers, à la clairière du sanctuaire. Brûlez ce qui a repoussé là, deux fois."

#. [&"ysolde", "Three stones in our hands. The land listens to whoever stands on it."],
#: scripts/campaign/mission_e2_02.gd:197
msgid "Three stones in our hands. The land listens to whoever stands on it."
msgstr "Trois pierres entre nos mains. La terre écoute ceux qui se tiennent dessus."

#. [&"ysolde", "They cut it. Then we plant it again. That is the whole of my strength."],
#: scripts/campaign/mission_e2_02.gd:198
msgid "They cut it. Then we plant it again. That is the whole of my strength."
msgstr "Ils l'ont coupé. Alors on le replante. C'est toute ma force."

#. [&"messenger", "We've lost too many carriers. The seed's running out."],
#: scripts/campaign/mission_e2_02.gd:199
msgid "We've lost too many carriers. The seed's running out."
msgstr "On a perdu trop de porteurs. Les graines s'épuisent."

#. [&"torvald", "Two banners on one bank. Malrik, I begin to see why you feared her."],
#: scripts/campaign/mission_e2_02.gd:200
msgid "Two banners on one bank. Malrik, I begin to see why you feared her."
msgstr "Deux bannières sur une rive. Malrik, je commence à comprendre pourquoi tu la craignais."

#. [&"ysolde", "You came when I called, Vessa. Next time, I come when you do."],
#: scripts/campaign/mission_e2_02.gd:201
msgid "You came when I called, Vessa. Next time, I come when you do."
msgstr "Tu es venue quand j'ai appelé, Vessa. La prochaine fois, c'est moi qui viens quand tu appelles."

#. [&"vessa", "Deal. And next time, I'll leave your trees alone."],
#: scripts/campaign/mission_e2_02.gd:202
msgid "Deal. And next time, I'll leave your trees alone."
msgstr "Marché conclu. Et la prochaine fois, je laisse tes arbres tranquilles."

#. [&"vessa", "Ysolde... keep... planting..."],
#: scripts/campaign/mission_e2_02.gd:203
msgid "Ysolde... keep... planting..."
msgstr "Ysolde... continue... de planter..."

#. [&"ashby", "The Emberwatch is burning! Fall back, fall back!"],
#: scripts/campaign/mission_e2_02.gd:204
msgid "The Emberwatch is burning! Fall back, fall back!"
msgstr "L'Emberwatch brûle! Repliez-vous, repliez-vous!"

#. [&"ysolde", "The roots are cut. All of them. I am sorry, Vessa."],
#: scripts/campaign/mission_e2_02.gd:205
msgid "The roots are cut. All of them. I am sorry, Vessa."
msgstr "Les racines sont coupées. Toutes. Je suis désolée, Vessa."

#. [&"vey", "First time you've called me in twelve years, girl. I came running."],
#: scripts/campaign/mission_e2_02.gd:206
msgid "First time you've called me in twelve years, girl. I came running."
msgstr "La première fois que tu m'appelles en douze ans, ma fille. Je suis arrivé en courant."

#. "Ysolde walked out of her last Heartwood with a pouch of seed, one warden and a girl who never stops running.
#: scripts/campaign/mission_e2_02.gd:209
msgid "Ysolde walked out of her last Heartwood with a pouch of seed, one warden and a girl who never stops running. Her army is ash. Her kingdom is whatever she can plant before winter notices."
msgstr "Ysolde est sortie de son dernier Heartwood avec une bourse de graines, une gardienne et une fille qui n'arrête jamais de courir. Son armée n'est que cendres. Son royaume, c'est tout ce qu'elle peut planter avant que l'hiver s'en aperçoive."

#. "Fire's border runs along the Hollowmere now, and Torvald has already crossed it: a frost fort on Vessa's own
#: scripts/campaign/mission_e2_02.gd:210
msgid "Fire's border runs along the Hollowmere now, and Torvald has already crossed it: a frost fort on Vessa's own bank, squatting on the richest crystal seam she owns, and Malrik's knives in the reeds behind it."
msgstr "La frontière du Feu longe maintenant le Hollowmere, et Torvald l'a déjà franchie : un fort de givre sur la rive même de Vessa, planté sur son plus riche filon de cristal, et les couteaux de Malrik dans les roseaux derrière."

#. "Plant three groves along Fire's line and Nature grows back beside it. Then break the frost fort. Two against
#: scripts/campaign/mission_e2_02.gd:211
msgid "Plant three groves along Fire's line and Nature grows back beside it. Then break the frost fort. Two against two, at last. Ysolde says it will be slow. Vessa says that is what the fire is for."
msgstr "Plantez trois bosquets le long de la ligne du Feu et la Nature repoussera à ses côtés. Puis brisez le fort de givre. Deux contre deux, enfin. Ysolde dit que ce sera lent. Vessa dit que c'est à ça que sert le feu."

#. const BRIEFING_PING_LINE := "Ping a grove site to send Ysolde's column there (Alt+click the site, or the \"Sen
#: scripts/campaign/mission_e2_02.gd:213
msgid "Ping a grove site to send Ysolde's column there (Alt+click the site, or the \"Send Ysolde\" buttons)."
msgstr "Signalez un site de bosquet pour y envoyer la colonne d'Ysolde (Alt+clic sur le site, ou les boutons « Envoyer Ysolde »)."

#. const HINT_GROVE_A := "Ysolde plants, you guard. Keep the enemy out of the grove ring."
#: scripts/campaign/mission_e2_02.gd:214
msgid "Ysolde plants, you guard. Keep the enemy out of the grove ring."
msgstr "Ysolde plante, vous gardez. Tenez l'ennemi hors de l'anneau du bosquet."

#. const HINT_NEXT_GROVE := "Send Ysolde to the next grove: Alt+click its site, or press \"Send Ysolde\" for it (
#: scripts/campaign/mission_e2_02.gd:215
msgid "Send Ysolde to the next grove: Alt+click its site, or press \"Send Ysolde\" for it (top right)."
msgstr "Envoyez Ysolde au prochain bosquet : Alt+clic sur son site, ou « Envoyer Ysolde » pour ce bosquet (en haut à droite)."

#. const HINT_POINTS := "Capture points: stand in the ring with no enemy inside. Watchtowers see far, wells pay e
#: scripts/campaign/mission_e2_02.gd:216
msgid "Capture points: stand in the ring with no enemy inside. Watchtowers see far, wells pay essence, the shrine blesses your army."
msgstr "Points de capture : tenez-vous dans l'anneau sans ennemi dedans. Les tours de guet voient loin, les puits paient de l'essence, le sanctuaire bénit votre armée."

#. const HINT_SABOTEUR := "A Saboteur looks like a Rime Hauler. Walk it past the spires and charge the Frost Hall
#: scripts/campaign/mission_e2_02.gd:219
msgid "A Saboteur looks like a Rime Hauler. Walk it past the spires and charge the Frost Hall."
msgstr "Un Saboteur ressemble à un Rime Hauler. Faites-le passer devant les flèches et minez la Frost Hall."

#. const MSG_PLANTING := "Ysolde is planting {grove}. Keep the enemy out of the grove."
#: scripts/campaign/mission_e2_02.gd:220
msgid "Ysolde is planting {grove}. Keep the enemy out of the grove."
msgstr "Ysolde plante {grove}. Tenez l'ennemi hors du bosquet."

#. const MSG_PAUSED := "The planting stops while the enemy stands in the grove"
#: scripts/campaign/mission_e2_02.gd:221
msgid "The planting stops while the enemy stands in the grove"
msgstr "La plantation arrête tant que l'ennemi est dans le bosquet"

#. const MSG_GROWING := "{grove} is growing again ({n} / 3)"
#: scripts/campaign/mission_e2_02.gd:222
msgid "{grove} is growing again ({n} / 3)"
msgstr "{grove} repousse ({n} / 3)"

#. const MSG_TWO_V_TWO := "The war is two against two."
#: scripts/campaign/mission_e2_02.gd:223
msgid "The war is two against two."
msgstr "La guerre est maintenant à deux contre deux."

#. const MSG_YSOLDE_FELL := "Ysolde has fallen, the forest will regrow her"
#: scripts/campaign/mission_e2_02.gd:226 scripts/world/skirmish.gd:301
msgid "Ysolde has fallen, the forest will regrow her"
msgstr "Ysolde est tombée, la forêt la fera repousser"

