#: scripts/campaign/mission_e4_03.gd:654
msgid "Shatter Aldra's Glass Spire"
msgstr "Fracasser la Glass Spire d'Aldra"

#. return "Lose no grove once it is green"
#: scripts/campaign/mission_e4_03.gd:656
msgid "Lose no grove once it is green"
msgstr "Ne perdre aucun bosquet une fois vert"

