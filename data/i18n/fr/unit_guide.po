msgstr "Smoke Pouch le fait perdre de vue aux ennemis"

#. cons
#: data/ui/unit_guide.json:coin_cutter
msgid "Fragile once surrounded"
msgstr "Fragile une fois encerclé"

#. cons
#: data/ui/unit_guide.json:coin_cutter
msgid "Autonomous and greedy for bounties"
msgstr "Autonome et avide de primes"

#. strong_against
#: data/ui/unit_guide.json:coin_cutter data/ui/unit_guide.json:greywater_tracker
msgid "Caravans"
msgstr "Caravanes"

#. strong_against
#: data/ui/unit_guide.json:coin_cutter
msgid "Lone units"
msgstr "Unités isolées"

#. good_with
#: data/ui/unit_guide.json:coin_cutter
msgid "Raids"
msgstr "Raids"

#. summary
#: data/ui/unit_guide.json:mender
msgid "Hired healer champion. Heals your soldiers; acts on bounties."
msgstr "Champion soigneur engagé. Soigne vos soldats; agit selon les primes."

#. pros
#: data/ui/unit_guide.json:mender
msgid "Mending Draught heals the most hurt ally"
msgstr "Mending Draught soigne l'allié le plus blessé"

#. pros
#: data/ui/unit_guide.json:mender
msgid "Soothing Circle heals a whole area"
msgstr "Soothing Circle soigne toute une zone"

#. pros
#: data/ui/unit_guide.json:mender
msgid "Lifeline saves an ally (level 4)"
msgstr "Lifeline sauve un allié (niveau 4)"

#. cons
#: data/ui/unit_guide.json:mender
msgid "Lowest damage of the four champions"
msgstr "Moins de dégâts des quatre champions"

#. cons
#: data/ui/unit_guide.json:mender
msgid "Autonomous; needs an army to heal"
msgstr "Autonome; a besoin d'une armée à soigner"

#. good_with
#: data/ui/unit_guide.json:mender
msgid "Your army"
msgstr "Votre armée"

#. class
#: data/ui/unit_guide.json:stormbottle_genie
