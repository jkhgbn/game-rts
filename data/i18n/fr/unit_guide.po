#: data/ui/unit_guide.json:stormbottle_genie
msgid "A huge bolt every few seconds that also chains; extra damage on titans."
msgstr "Un énorme éclair régulier qui rebondit aussi; dégâts bonus contre les titans."

#. pros
#: data/ui/unit_guide.json:stormbottle_genie
msgid "Lightning chains to 2 more enemies"
msgstr "La foudre rebondit sur 2 autres ennemis"

#. pros
#: data/ui/unit_guide.json:stormbottle_genie
msgid "Tempest Bolt: a huge strike on a cooldown"
msgstr "Tempest Bolt : une frappe énorme avec recharge"

#. pros
#: data/ui/unit_guide.json:stormbottle_genie
msgid "Long range with lots of HP"
msgstr "Longue portée, beaucoup de PV"

#. cons
#: data/ui/unit_guide.json:stormbottle_genie
msgid "One per team, hired at a tavern"
msgstr "Un par équipe, engagé à une taverne"

#. cons
#: data/ui/unit_guide.json:stormbottle_genie
msgid "Slow and big: a focus-fire target"
msgstr "Lent et gros : une cible de tir concentré"

#. strong_against
#: data/ui/unit_guide.json:stormbottle_genie
msgid "Big targets"
msgstr "Grosses cibles"

#. strong_against
#: data/ui/unit_guide.json:stormbottle_genie
msgid "Titans"
msgstr "Titans"

#. good_with
#: data/ui/unit_guide.json:stormbottle_genie
msgid "Any army"
msgstr "Toute armée"

#. summary
#: data/ui/unit_guide.json:greywater_tracker
