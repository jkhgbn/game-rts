msgstr "Primes d'exploration"

#. good_with
#: data/ui/unit_guide.json:wayfinder data/ui/unit_guide.json:coin_cutter
msgid "Hunt bounties"
msgstr "Primes de chasse"

#. summary
#: data/ui/unit_guide.json:oathwall
msgid "Hired guardian champion. Armoured wall that protects allies; acts on bounties."
msgstr "Champion gardien engagé. Mur blindé qui protège les alliés; agit selon les primes."

#. pros
#: data/ui/unit_guide.json:oathwall
msgid "Toughest champion: most HP and armour"
msgstr "Champion le plus coriace : plus de PV et d'armure"

#. pros
#: data/ui/unit_guide.json:oathwall
msgid "Oath of Iron armours itself and allies"
msgstr "Oath of Iron renforce l'armure du champion et des alliés"

#. pros
#: data/ui/unit_guide.json:oathwall
msgid "Shield Bash stuns a foe for a moment"
msgstr "Shield Bash étourdit un ennemi un moment"

#. cons
#: data/ui/unit_guide.json:oathwall
msgid "Slow, with low damage"
msgstr "Lent, peu de dégâts"

#. good_with
#: data/ui/unit_guide.json:oathwall
msgid "Guard bounties"
msgstr "Primes de garde"

#. good_with
#: data/ui/unit_guide.json:oathwall data/ui/unit_guide.json:mender
msgid "Escort bounties"
msgstr "Primes d'escorte"

#. summary
#: data/ui/unit_guide.json:coin_cutter
msgid "Hired raider champion. Fast damage and loot; acts on bounties."
msgstr "Champion pillard engagé. Dégâts rapides et butin; agit selon les primes."

#. pros
#: data/ui/unit_guide.json:coin_cutter
msgid "Highest DPS of the four champions"
msgstr "Plus haut DPS des quatre champions"

#. pros
#: data/ui/unit_guide.json:coin_cutter
msgid "Cutpurse loots coin from what it hits"
msgstr "Cutpurse vole de l'or à ce qu'il frappe"

#. pros
#: data/ui/unit_guide.json:coin_cutter
