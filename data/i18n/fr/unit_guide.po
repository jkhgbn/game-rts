msgstr "Engagés par deux ou trois à une Greywater Lodge; ils traquent seuls les Magpies."

#. pros
#: data/ui/unit_guide.json:greywater_tracker
msgid "Hunts Magpie thieves and earns gold"
msgstr "Traque les voleurs Magpie et gagne de l'or"

#. pros
#: data/ui/unit_guide.json:greywater_tracker
msgid "Its hits root the target briefly"
msgstr "Ses coups enracinent brièvement la cible"

#. pros
#: data/ui/unit_guide.json:greywater_tracker
msgid "Costs no crystals and no pop"
msgstr "Ne coûte ni cristaux ni pop."

#. cons
#: data/ui/unit_guide.json:greywater_tracker
