msgid "Spins for 2 s: 12 damage every 0.5 s to every enemy within 3 m."
msgstr "Tournoie 2 s : 12 dégâts toutes les 0,5 s à chaque ennemi à moins de 3 m."

#. "text": "A bolt at a foe within 12 m: 40 damage."},
#: scripts/units/champion_abilities.gd:142
