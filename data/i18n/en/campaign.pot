#. [&"narrator", "Three days later. Malrik came back from Duskbarrow to a ridge that smelled of thunder."],
#: scripts/campaign/mission_e3_04.gd:122
msgid "Three days later. Malrik came back from Duskbarrow to a ridge that smelled of thunder."
msgstr ""

#. [&"torvald", "Every dusk the old man walks down to the river and looks at us. Then he walks away."],
#: scripts/campaign/mission_e3_04.gd:123
msgid "Every dusk the old man walks down to the river and looks at us. Then he walks away."
msgstr ""

#. [&"malrik", "Looks. Not crosses?"],
#: scripts/campaign/mission_e3_04.gd:124
msgid "Looks. Not crosses?"
msgstr ""

#. [&"torvald", "Not yet. I think he was waiting for you. He is polite like that."],
#: scripts/campaign/mission_e3_04.gd:125
msgid "Not yet. I think he was waiting for you. He is polite like that."
msgstr ""

#. [&"hush", "Riders at the reeds. Quick little sparks."],
#: scripts/campaign/mission_e3_04.gd:126
msgid "Riders at the reeds. Quick little sparks."
msgstr ""

#. [&"vey", "Bishop! You sent your knife into my girl's camp twice now. I've come to return the favour."],
#: scripts/campaign/mission_e3_04.gd:127
msgid "Bishop! You sent your knife into my girl's camp twice now. I've come to return the favour."
msgstr ""

#. [&"malrik", "Old man. They told me you were dead. I was almost sad."],
#: scripts/campaign/mission_e3_04.gd:128
msgid "Old man. They told me you were dead. I was almost sad."
msgstr ""

#. [&"vessa", "He's not dead, he's LATE. There's a difference!"],
#: scripts/campaign/mission_e3_04.gd:129
msgid "He's not dead, he's LATE. There's a difference!"
msgstr ""

#. [&"hush", "Old man. You still owe me a night."],
#: scripts/campaign/mission_e3_04.gd:130
msgid "Old man. You still owe me a night."
msgstr ""

#. [&"vey", "And you still miss, knife-woman. Every single time."],
#: scripts/campaign/mission_e3_04.gd:131
msgid "And you still miss, knife-woman. Every single time."
msgstr ""

#. [&"vey", "Hah! Good. Again!"],
#: scripts/campaign/mission_e3_04.gd:132
msgid "Hah! Good. Again!"
msgstr ""

#. [&"malrik", "He is laughing. Why is he laughing?"],
#: scripts/campaign/mission_e3_04.gd:133
msgid "He is laughing. Why is he laughing?"
msgstr ""

#. [&"vey", "Off my hill. Well. Your hill. For now."],
#: scripts/campaign/mission_e3_04.gd:134
msgid "Off my hill. Well. Your hill. For now."
msgstr ""

#. [&"vessa", "Both fords, Vey! We pinch him!"],
#: scripts/campaign/mission_e3_04.gd:135
msgid "Both fords, Vey! We pinch him!"
msgstr ""

#. [&"torvald", "Malrik. That light in your hand. It moved before you did."],
#: scripts/campaign/mission_e3_04.gd:137
msgid "Malrik. That light in your hand. It moved before you did."
msgstr ""

#. [&"obren", "Torvald. Old frost. You feel it too. Join us, and nothing will ever melt."],
#: scripts/campaign/mission_e3_04.gd:138
msgid "Torvald. Old frost. You feel it too. Join us, and nothing will ever melt."
msgstr ""

#. [&"torvald", "...It knows my name."],
#: scripts/campaign/mission_e3_04.gd:139
msgid "...It knows my name."
msgstr ""

#. [&"malrik", "It knows everyone's name. It is a stone with nothing else to do."],
#: scripts/campaign/mission_e3_04.gd:140
msgid "It knows everyone's name. It is a stone with nothing else to do."
msgstr ""

#. [&"vey", "Last storm I've got, Bishop. Let's see what you've got."],
#: scripts/campaign/mission_e3_04.gd:141
msgid "Last storm I've got, Bishop. Let's see what you've got."
msgstr ""

#. [&"malrik", "Everything, old man. I took it all. That is the whole secret."],
#: scripts/campaign/mission_e3_04.gd:142
msgid "Everything, old man. I took it all. That is the whole secret."
msgstr ""

#. [&"torvald", "They have a watch. Take it back, or the ridge goes with it."],
#: scripts/campaign/mission_e3_04.gd:143
msgid "They have a watch. Take it back, or the ridge goes with it."
msgstr ""

#. [&"vey", "That's enough. My storm is borrowed, and I've spent the loan."],
#: scripts/campaign/mission_e3_04.gd:144
msgid "That's enough. My storm is borrowed, and I've spent the loan."
msgstr ""

#. [&"vessa", "Vey! Get up! We're not done!"],
#: scripts/campaign/mission_e3_04.gd:145
msgid "Vey! Get up! We're not done!"
msgstr ""

#. [&"vey", "We are today, girl. Today the ridge is his."],
#: scripts/campaign/mission_e3_04.gd:146
msgid "We are today, girl. Today the ridge is his."
msgstr ""

#. [&"malrik", "The ridge is mine. The valley next. I will not stop."],
#: scripts/campaign/mission_e3_04.gd:147
msgid "The ridge is mine. The valley next. I will not stop."
msgstr ""

#. [&"torvald", "No. I don't think you can."],
#: scripts/campaign/mission_e3_04.gd:148
msgid "No. I don't think you can."
msgstr ""

#. [&"narrator", "The ridge fell to Shadow. Torvald had heard the stone say his name. He did not forget it."],
#: scripts/campaign/mission_e3_04.gd:149
msgid "The ridge fell to Shadow. Torvald had heard the stone say his name. He did not forget it."
msgstr ""

#. [&"malrik", "Struck down... by an old man's weather."],
#: scripts/campaign/mission_e3_04.gd:150
msgid "Struck down... by an old man's weather."
msgstr ""

#. [&"narrator", "Fire and thunder took the ridge, and the Bishop's winter melted away."],
#: scripts/campaign/mission_e3_04.gd:151
msgid "Fire and thunder took the ridge, and the Bishop's winter melted away."
msgstr ""

#. [&"vessa", "Ow! Fine! Back in a minute!"],
#: scripts/campaign/mission_e3_04.gd:152
msgid "Ow! Fine! Back in a minute!"
msgstr ""

#. [&"malrik", "Even thunder falls off a horse, old man."],
#: scripts/campaign/mission_e3_04.gd:153
msgid "Even thunder falls off a horse, old man."
msgstr ""

#. [&"vey", "Bishop! Not one alarm, that night. Your knife is getting better. So am I."],
#: scripts/campaign/mission_e3_04.gd:154
msgid "Bishop! Not one alarm, that night. Your knife is getting better. So am I."
msgstr ""

#. "Three days Malrik spent laying his dead back down in Duskbarrow. Three evenings an old man with a burning swo
#: scripts/campaign/mission_e3_04.gd:157
msgid "Three days Malrik spent laying his dead back down in Duskbarrow. Three evenings an old man with a burning sword walked down to the river and looked at Torvald's winter on the ridge, and walked away again."
msgstr ""

#. "Ysolde has taken her people south, out of the war. Vessa has stayed, with every soldier she has left and the 
#: scripts/campaign/mission_e3_04.gd:158
msgid "Ysolde has taken her people south, out of the war. Vessa has stayed, with every soldier she has left and the one ally who has never lost a duel: Old Vey, the Master's storm-sword. Today they cross."
msgstr ""

#. "Hold the ridge. You cannot kill a storm, but you can wear one out. And Torvald is watching the stone in your 
#: scripts/campaign/mission_e3_04.gd:159
msgid "Hold the ridge. You cannot kill a storm, but you can wear one out. And Torvald is watching the stone in your pocket more closely than he watches the river."
msgstr ""

#. const BRIEFING_LINE := "Old Vey cannot die. Break his storm three times and he will leave the field."
#: scripts/campaign/mission_e3_04.gd:161
msgid "Old Vey cannot die. Break his storm three times and he will leave the field."
msgstr ""

#. const HINT_START := "Hold the three watch points. Old Vey cannot die: break his storm three times and he will 
#: scripts/campaign/mission_e3_04.gd:162
msgid "Hold the three watch points. Old Vey cannot die: break his storm three times and he will leave."
msgstr ""

#. const HINT_PADDOCK := "A Dread Paddock can now be raised (the \"Raise the Dread Paddock\" button): it trains t
#: scripts/campaign/mission_e3_04.gd:163
msgid "A Dread Paddock can now be raised (the \"Raise the Dread Paddock\" button): it trains the Nightmare Knight, a titan whose charge can break a storm."
