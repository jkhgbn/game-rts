#. [&"narrator", "The same afternoon, from the other hill. Here nobody counts fords. They count people."],
#: scripts/campaign/mission_e4_01.gd:152 data/voice/lines/e4m1.json:L1
msgid "The same afternoon, from the other hill. Here nobody counts fords. They count people."
msgstr ""

#. [&"ysolde", "Maelis, the horns. Every farm in the valley comes up this hill before dark."],
#: scripts/campaign/mission_e4_01.gd:153 data/voice/lines/e4m1.json:L2
msgid "Maelis, the horns. Every farm in the valley comes up this hill before dark."
msgstr ""

#. [&"maelis", "And the ford? Malrik will want his ford."],
#: scripts/campaign/mission_e4_01.gd:154 data/voice/lines/e4m1.json:L3
msgid "And the ford? Malrik will want his ford."
msgstr ""

#. [&"ysolde", "Let him want it. A ford is water and stones. Those farms are families."],
#: scripts/campaign/mission_e4_01.gd:155 data/voice/lines/e4m1.json:L4
msgid "Let him want it. A ford is water and stones. Those farms are families."
msgstr ""

#. [&"vessa", "I'll take the east slope. If Torvald crosses, he can explain himself to a fire."],
#: scripts/campaign/mission_e4_01.gd:156 data/voice/lines/e4m1.json:L5
msgid "I'll take the east slope. If Torvald crosses, he can explain himself to a fire."
msgstr ""

#. [&"messenger", "Up the hill! Leave the... leave the goats! Up to the golden tree!"],
#: scripts/campaign/mission_e4_01.gd:157 data/voice/lines/e4m1.json:L6
msgid "Up the hill! Leave the... leave the goats! Up to the golden tree!"
msgstr ""

#. [&"malrik", "Ysolde. You are herding sheep while I take your river. That is very you."],
#: scripts/campaign/mission_e4_01.gd:158 data/voice/lines/e4m1.json:L7
msgid "Ysolde. You are herding sheep while I take your river. That is very you."
msgstr ""

#. [&"ysolde", "Sheep come back in spring, Malrik. So do I."],
#: scripts/campaign/mission_e4_01.gd:159 data/voice/lines/e4m1.json:L8
msgid "Sheep come back in spring, Malrik. So do I."
msgstr ""

#. [&"maelis", "Through the ford, little ones. Slow is fine. Slow is alive."],
#: scripts/campaign/mission_e4_01.gd:160 data/voice/lines/e4m1.json:L9
msgid "Through the ford, little ones. Slow is fine. Slow is alive."
msgstr ""

#. [&"torvald", "Ysolde. Go home. I have no quarrel with your farms."],
#: scripts/campaign/mission_e4_01.gd:161 data/voice/lines/e4m1.json:L10
msgid "Ysolde. Go home. I have no quarrel with your farms."
msgstr ""

#. [&"ysolde", "Then why is your winter standing in them, Torvald?"],
#: scripts/campaign/mission_e4_01.gd:162 data/voice/lines/e4m1.json:L11
msgid "Then why is your winter standing in them, Torvald?"
msgstr ""

#. [&"obren", "The green one keeps a tree, Bishop. A golden tree. HIS tree. Take it."],
#: scripts/campaign/mission_e4_01.gd:163 data/voice/lines/e4m1.json:L12
msgid "The green one keeps a tree, Bishop. A golden tree. HIS tree. Take it."
msgstr ""

#. [&"malrik", "One thing at a time. The ford first. Then we will talk about trees."],
#: scripts/campaign/mission_e4_01.gd:164 data/voice/lines/e4m1.json:L13
msgid "One thing at a time. The ford first. Then we will talk about trees."
msgstr ""

#. [&"narrator", "Smoke over the farms. Whoever was still there is not coming up the hill."],
#: scripts/campaign/mission_e4_01.gd:165 data/voice/lines/e4m1.json:L14
msgid "Smoke over the farms. Whoever was still there is not coming up the hill."
msgstr ""

#. [&"narrator", "The evening horn. Malrik's whole host comes down to the water."],
#: scripts/campaign/mission_e4_01.gd:166 data/voice/lines/e4m1.json:L15
msgid "The evening horn. Malrik's whole host comes down to the water."
msgstr ""

#. [&"ysolde", "The ford's gone. Fall back to the stones and the standards. Nobody runs."],
#: scripts/campaign/mission_e4_01.gd:167 data/voice/lines/e4m1.json:L15b
msgid "The ford's gone. Fall back to the stones and the standards. Nobody runs."
msgstr ""

#. [&"ysolde", "Let them have the water. Everyone to the foot of the hill. Nobody passes the tree."],
#: scripts/campaign/mission_e4_01.gd:168 data/voice/lines/e4m1.json:L16
msgid "Let them have the water. Everyone to the foot of the hill. Nobody passes the tree."
msgstr ""

#. [&"vessa", "The ford held till the horn! Ysolde, that was almost reckless. I'm proud of you."],
#: scripts/campaign/mission_e4_01.gd:169 data/voice/lines/e4m1.json:L17
msgid "The ford held till the horn! Ysolde, that was almost reckless. I'm proud of you."
msgstr ""

#. [&"ysolde", "They have a standard. Let them carry it. Banners are light. Hills are not."],
#: scripts/campaign/mission_e4_01.gd:170 data/voice/lines/e4m1.json:L18
msgid "They have a standard. Let them carry it. Banners are light. Hills are not."
msgstr ""

#. [&"vessa", "Ysolde! Torvald brought mortars to my well. I could use some thorns over here!"],
#: scripts/campaign/mission_e4_01.gd:171 data/voice/lines/e4m1.json:L19
msgid "Ysolde! Torvald brought mortars to my well. I could use some thorns over here!"
msgstr ""

#. [&"hush", "The Bishop wanted a look at the tree. I came to look first."],
#: scripts/campaign/mission_e4_01.gd:172 data/voice/lines/e4m1.json:L20
msgid "The Bishop wanted a look at the tree. I came to look first."
msgstr ""

#. [&"maelis", "Behind us! The wood has a knife in it!"],
#: scripts/campaign/mission_e4_01.gd:173 data/voice/lines/e4m1.json:L21
msgid "Behind us! The wood has a knife in it!"
msgstr ""

#. [&"obren", "There it is. His tree. Burn it, and he feels it in the deep."],
#: scripts/campaign/mission_e4_01.gd:174 data/voice/lines/e4m1.json:L22
msgid "There it is. His tree. Burn it, and he feels it in the deep."
msgstr ""

#. [&"malrik", "Ysolde! Step aside. I only want the tree."],
#: scripts/campaign/mission_e4_01.gd:175 data/voice/lines/e4m1.json:L23
msgid "Ysolde! Step aside. I only want the tree."
msgstr ""

#. [&"ysolde", "Everyone who ever wanted this tree said \"only\"."],
#: scripts/campaign/mission_e4_01.gd:176 data/voice/lines/e4m1.json:L24
msgid "Everyone who ever wanted this tree said \"only\"."
msgstr ""

#. [&"torvald", "I came for a ford, Bishop. Not for his tree. My host stops here."],
#: scripts/campaign/mission_e4_01.gd:177 data/voice/lines/e4m1.json:L25
msgid "I came for a ford, Bishop. Not for his tree. My host stops here."
msgstr ""

#. [&"vey", "Lightning, Bishop. Since before you were born. Off the hill."],
#: scripts/campaign/mission_e4_01.gd:178 data/voice/lines/e4m1.json:L26
msgid "Lightning, Bishop. Since before you were born. Off the hill."
msgstr ""

#. [&"ysolde", "A horn's down. The other one will have to sing for both."],
#: scripts/campaign/mission_e4_01.gd:179 data/voice/lines/e4m1.json:L27
msgid "A horn's down. The other one will have to sing for both."
msgstr ""

#. [&"narrator", "Ten families under the tree. The goats, mostly, made it too."],
#: scripts/campaign/mission_e4_01.gd:180 data/voice/lines/e4m1.json:L28
msgid "Ten families under the tree. The goats, mostly, made it too."
msgstr ""

#. [&"messenger", "That's... twenty, my lady. Twenty! The tree's getting... crowded."],
#: scripts/campaign/mission_e4_01.gd:181 data/voice/lines/e4m1.json:L29
msgid "That's... twenty, my lady. Twenty! The tree's getting... crowded."
msgstr ""

#. [&"ysolde", "Everyone. Every last one. Now we only have to keep them."],
#: scripts/campaign/mission_e4_01.gd:182 data/voice/lines/e4m1.json:L30
msgid "Everyone. Every last one. Now we only have to keep them."
msgstr ""

#. [&"ysolde", "The ford is his. The hill is ours, and every family on it, and the tree."],
#: scripts/campaign/mission_e4_01.gd:183 data/voice/lines/e4m1.json:L31
msgid "The ford is his. The hill is ours, and every family on it, and the tree."
msgstr ""

#. [&"vessa", "He'll call it a victory, you know."],
#: scripts/campaign/mission_e4_01.gd:184 data/voice/lines/e4m1.json:L32
msgid "He'll call it a victory, you know."
msgstr ""

#. [&"ysolde", "Let him. Something always grows back. It will not stop."],
#: scripts/campaign/mission_e4_01.gd:185 data/voice/lines/e4m1.json:L33
msgid "Let him. Something always grows back. It will not stop."
msgstr ""

#. [&"narrator", "Night fell. The golden tree still stood, and everyone who made it up the hill slept under it."]
#: scripts/campaign/mission_e4_01.gd:186 data/voice/lines/e4m1.json:L34
msgid "Night fell. The golden tree still stood, and everyone who made it up the hill slept under it."
msgstr ""

#. [&"ysolde", "Keep them... under the tree... Maelis..."],
#: scripts/campaign/mission_e4_01.gd:187 data/voice/lines/e4m1.json:L35
msgid "Keep them... under the tree... Maelis..."
msgstr ""

#. [&"maelis", "The Master's tree... It's gone dark."],
#: scripts/campaign/mission_e4_01.gd:188 data/voice/lines/e4m1.json:L36
msgid "The Master's tree... It's gone dark."
msgstr ""

#. [&"ysolde", "Too many. We were too slow, and the valley is empty."],
#: scripts/campaign/mission_e4_01.gd:189 data/voice/lines/e4m1.json:L37
msgid "Too many. We were too slow, and the valley is empty."
msgstr ""

#. [&"maelis", "The forest is not done with me. Neither am I."],
#: scripts/campaign/mission_e4_01.gd:190 data/voice/lines/e4m1.json:L38
msgid "The forest is not done with me. Neither am I."
msgstr ""

#. "The horns have sounded on both hills. Malrik and Torvald are coming down to the river, and between them and L
#: scripts/campaign/mission_e4_01.gd:193
msgid "The horns have sounded on both hills. Malrik and Torvald are coming down to the river, and between them and Lark Hill lie three hamlets, two farms, and the Master's golden tree."
msgstr ""

#. "Ysolde cannot win the valley today. She can keep it: bring every family up the hill to the tree, and hold the
#: scripts/campaign/mission_e4_01.gd:194
msgid "Ysolde cannot win the valley today. She can keep it: bring every family up the hill to the tree, and hold the hill until the sun goes down. Vessa holds the east slope, and has promised to be patient. Nobody believes her."
msgstr ""

#. "Hold Lark Hill until nightfall. Let them have the water if they must. Nothing that lives on this hill is thei
#: scripts/campaign/mission_e4_01.gd:195
msgid "Hold Lark Hill until nightfall. Let them have the water if they must. Nothing that lives on this hill is theirs."
msgstr ""

#. const BRIEFING_EP3 := "You have seen this afternoon from the other hill. This time, stand under the tree."
#: scripts/campaign/mission_e4_01.gd:197
msgid "You have seen this afternoon from the other hill. This time, stand under the tree."
msgstr ""

#. const HINT_START := "Ring the hamlet bells with Ysolde (or Maelis): the villagers walk to the golden tree by t
#: scripts/campaign/mission_e4_01.gd:198
msgid "Ring the hamlet bells with Ysolde (or Maelis): the villagers walk to the golden tree by themselves. Two farms wait across the river."
msgstr ""

#. const HINT_STRONGHOLD := "Your Heartwood can become a Stronghold: select it and press X (200 crystals). It ope
#: scripts/campaign/mission_e4_01.gd:199
msgid "Your Heartwood can become a Stronghold: select it and press X (200 crystals). It opens Vinelasher, Greenheart Oathkeeper (Grove Hall) · Bramblesage (Keep)."
msgstr ""

#. const HINT_SAGE := "Bramblesage: Z Snagroot drags an enemy to the Sage. V Pollen Haze makes archers inside it 
#: scripts/campaign/mission_e4_01.gd:200
