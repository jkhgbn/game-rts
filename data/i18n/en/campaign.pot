#. [&"ossavar", "The Outwall. Where the coin is earned, and never spent."],
#: scripts/campaign/mission_e7_03.gd:88 data/voice/lines/e7m3.json:L1
msgid "The Outwall. Where the coin is earned, and never spent."
msgstr ""

#. [&"brannet", "You're the ice-king? We've had kings before. They stand on the wall and watch."],
#: scripts/campaign/mission_e7_03.gd:89 data/voice/lines/e7m3.json:L2
msgid "You're the ice-king? We've had kings before. They stand on the wall and watch."
msgstr ""

#. [&"torvald", "Then I will stand down here. Ring your bells when I tell you, and bring your people to me."],
#: scripts/campaign/mission_e7_03.gd:90 data/voice/lines/e7m3.json:L3
msgid "Then I will stand down here. Ring your bells when I tell you, and bring your people to me."
msgstr ""

#. [&"aldra", "The Glass Hall is open, my lord. It holds more than you think. Winter is roomy."],
#: scripts/campaign/mission_e7_03.gd:91 data/voice/lines/e7m3.json:L4
msgid "The Glass Hall is open, my lord. It holds more than you think. Winter is roomy."
msgstr ""

#. [&"brannet", "Rope Row's coming. Mind the old ones, they walk slow. Like you, no offence."],
#: scripts/campaign/mission_e7_03.gd:92 data/voice/lines/e7m3.json:L5
msgid "Rope Row's coming. Mind the old ones, they walk slow. Like you, no offence."
msgstr ""

#. [&"aldra", "Crimson lanterns on the water. Aurivane burns what it cannot buy."],
#: scripts/campaign/mission_e7_03.gd:93 data/voice/lines/e7m3.json:L6
msgid "Crimson lanterns on the water. Aurivane burns what it cannot buy."
msgstr ""

#. [&"brannet", "Facetguards, turned back by an ice-king. I'll be telling that one in the tavern for years."],
#: scripts/campaign/mission_e7_03.gd:94 data/voice/lines/e7m3.json:L7
msgid "Facetguards, turned back by an ice-king. I'll be telling that one in the tavern for years."
msgstr ""

#. [&"brannet", "The Archon's press took a whole lane. They'll dig till they drop, and nobody'll count them."],
#: scripts/campaign/mission_e7_03.gd:95 data/voice/lines/e7m3.json:L7b
msgid "The Archon's press took a whole lane. They'll dig till they drop, and nobody'll count them."
msgstr ""

#. [&"aldra", "Men in grey masks, out of the old adit. They do not take coin. They take people."],
#: scripts/campaign/mission_e7_03.gd:96 data/voice/lines/e7m3.json:L8
msgid "Men in grey masks, out of the old adit. They do not take coin. They take people."
msgstr ""

#. [&"diamond_archon", "Ice-king. Adamarch did not open its harbour to you so you could herd fishermen."],
#: scripts/campaign/mission_e7_03.gd:97 data/voice/lines/e7m3.json:L9
msgid "Ice-king. Adamarch did not open its harbour to you so you could herd fishermen."
msgstr ""

#. [&"diamond_archon", "Guard my pits. The diamonds pay for your dragons. The Outwall can look after itself."],
#: scripts/campaign/mission_e7_03.gd:98 data/voice/lines/e7m3.json:L10
msgid "Guard my pits. The diamonds pay for your dragons. The Outwall can look after itself."
msgstr ""

#. [&"torvald", "It has been looking after itself for a thousand years, Your Radiance. Look where it got them."],
#: scripts/campaign/mission_e7_03.gd:99 data/voice/lines/e7m3.json:L11
msgid "It has been looking after itself for a thousand years, Your Radiance. Look where it got them."
msgstr ""

#. [&"aldra", "Diamond tithe. Every minute you stand there, my lord, the Archon pays. Every minute."],
#: scripts/campaign/mission_e7_03.gd:100 data/voice/lines/e7m3.json:L12
msgid "Diamond tithe. Every minute you stand there, my lord, the Archon pays. Every minute."
msgstr ""

#. [&"diamond_archon", "Those beasts are the property of the Diamond Hall. You will answer for them."],
#: scripts/campaign/mission_e7_03.gd:101 data/voice/lines/e7m3.json:L13
msgid "Those beasts are the property of the Diamond Hall. You will answer for them."
msgstr ""

#. [&"torvald", "Then I will answer for them. They will answer to nobody."],
#: scripts/campaign/mission_e7_03.gd:102 data/voice/lines/e7m3.json:L14
msgid "Then I will answer for them. They will answer to nobody."
msgstr ""

#. [&"brannet", "Net Lane, out! Follow the cold, it's the only thing tonight that isn't lying to us."],
#: scripts/campaign/mission_e7_03.gd:103 data/voice/lines/e7m3.json:L15
msgid "Net Lane, out! Follow the cold, it's the only thing tonight that isn't lying to us."
msgstr ""

#. [&"brannet", "The boats are in. Two crews, sixteen souls, and the whole night coming for them."],
#: scripts/campaign/mission_e7_03.gd:104 data/voice/lines/e7m3.json:L16
msgid "The boats are in. Two crews, sixteen souls, and the whole night coming for them."
msgstr ""

#. [&"seraphine", "The Archon forbade this. The Hall of Silence can fine me. These are Adamarch's people too."],
#: scripts/campaign/mission_e7_03.gd:105 data/voice/lines/e7m3.json:L17
msgid "The Archon forbade this. The Hall of Silence can fine me. These are Adamarch's people too."
msgstr ""

#. [&"torvald", "Pits to the east, fishers to the south. Aldra, I cannot stand in two places."],
#: scripts/campaign/mission_e7_03.gd:106 data/voice/lines/e7m3.json:L18
msgid "Pits to the east, fishers to the south. Aldra, I cannot stand in two places."
msgstr ""

#. [&"aldra", "Their captain comes himself. Break his mask, my lord. I want to see what is under it."],
#: scripts/campaign/mission_e7_03.gd:107 data/voice/lines/e7m3.json:L19
msgid "Their captain comes himself. Break his mask, my lord. I want to see what is under it."
msgstr ""

#. [&"torvald", "Violet. And a candle sigil. Malrik, you are taking rowers from the gutter now."],
#: scripts/campaign/mission_e7_03.gd:108 data/voice/lines/e7m3.json:L20
msgid "Violet. And a candle sigil. Malrik, you are taking rowers from the gutter now."
msgstr ""

#. [&"aldra", "His gift at the auction was their wages. Tonight he came back for the men."],
#: scripts/campaign/mission_e7_03.gd:109 data/voice/lines/e7m3.json:L21
msgid "His gift at the auction was their wages. Tonight he came back for the men."
msgstr ""

#. [&"ossavar", "The last tide, Ice-king. The cities always send the biggest boats just before morning."],
#: scripts/campaign/mission_e7_03.gd:110 data/voice/lines/e7m3.json:L22
msgid "The last tide, Ice-king. The cities always send the biggest boats just before morning."
msgstr ""

#. [&"brannet", "Half the Outwall gone! Ice-king, whatever you're guarding, it isn't us!"],
#: scripts/campaign/mission_e7_03.gd:111 data/voice/lines/e7m3.json:L23
msgid "Half the Outwall gone! Ice-king, whatever you're guarding, it isn't us!"
msgstr ""

#. [&"brannet", "Every bell's rung. I never heard all five at once. Sounds like a festival."],
#: scripts/campaign/mission_e7_03.gd:112 data/voice/lines/e7m3.json:L24
msgid "Every bell's rung. I never heard all five at once. Sounds like a festival."
msgstr ""

#. [&"brannet", "Dawn, and the Outwall's still here. Nobody on the wall will ever thank you. So: thank you."],
#: scripts/campaign/mission_e7_03.gd:113 data/voice/lines/e7m3.json:L25
msgid "Dawn, and the Outwall's still here. Nobody on the wall will ever thank you. So: thank you."
msgstr ""

#. [&"diamond_archon", "The pits held. Adamarch pays its debts, Ice-king. It never forgets them, either."],
#: scripts/campaign/mission_e7_03.gd:114 data/voice/lines/e7m3.json:L26
msgid "The pits held. Adamarch pays its debts, Ice-king. It never forgets them, either."
msgstr ""

#. [&"diamond_archon", "My pits stood empty all night. Remember that I asked you, and that you chose."],
#: scripts/campaign/mission_e7_03.gd:115 data/voice/lines/e7m3.json:L27
msgid "My pits stood empty all night. Remember that I asked you, and that you chose."
msgstr ""

#. [&"ossavar", "You did not pay for that, Ice-king. Nobody paid for that. I will remember."],
#: scripts/campaign/mission_e7_03.gd:116 data/voice/lines/e7m3.json:L28
msgid "You did not pay for that, Ice-king. Nobody paid for that. I will remember."
msgstr ""

#. [&"torvald", "I waited too long again. The lanes are quiet. Too quiet, for a morning."],
#: scripts/campaign/mission_e7_03.gd:117 data/voice/lines/e7m3.json:L29
msgid "I waited too long again. The lanes are quiet. Too quiet, for a morning."
msgstr ""

#. [&"torvald", "Not here... not in front of them..."],
#: scripts/campaign/mission_e7_03.gd:118 data/voice/lines/e7m3.json:L30
msgid "Not here... not in front of them..."
msgstr ""

#. [&"aldra", "The lanes are empty, my lord. There is nobody left to shelter."],
#: scripts/campaign/mission_e7_03.gd:119 data/voice/lines/e7m3.json:L31
msgid "The lanes are empty, my lord. There is nobody left to shelter."
msgstr ""

#. "Adamarch admits nobody who has not paid in gold and proved it in blood. Everyone else lives outside the white
#: scripts/campaign/mission_e7_03.gd:122
msgid "Adamarch admits nobody who has not paid in gold and proved it in blood. Everyone else lives outside the white wall, in the Outwall: dockers, net-menders, rowers, the hands that make the Diamond City rich. Tonight nobody is guarding them."
msgstr ""

#. "Aurivane's boats are landing raiders on the quays. Adamarch's own press-gangs are emptying the lanes to dig t
#: scripts/campaign/mission_e7_03.gd:123
msgid "Aurivane's boats are landing raiders on the quays. Adamarch's own press-gangs are emptying the lanes to dig the pits deeper. And masked men come out of the old diamond adit and take people into the dark."
msgstr ""

#. "Torvald camps against the wall with Aldra and what is left of his army. The Diamond Archon will send her orde
#: scripts/campaign/mission_e7_03.gd:124
msgid "Torvald camps against the wall with Aldra and what is left of his army. The Diamond Archon will send her orders soon. He already knows what she will ask. He does not yet know what he will answer."
msgstr ""

