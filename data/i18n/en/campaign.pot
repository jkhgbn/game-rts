msgstr ""

#. [&"aldra", "Crimson sails on the water. They will shell the shore road. Sink them, or stay off it."],
#: scripts/campaign/mission_e7_04.gd:87 data/voice/lines/e7m4.json:L5
msgid "Crimson sails on the water. They will shell the shore road. Sink them, or stay off it."
msgstr ""

#. [&"vessa", "Last chance to pick the right side, Torvald! I'm told I'm very forgiving!"],
#: scripts/campaign/mission_e7_04.gd:88 data/voice/lines/e7m4.json:L6
msgid "Last chance to pick the right side, Torvald! I'm told I'm very forgiving!"
msgstr ""

#. [&"torvald", "You are told many things, Vessa. Most of them by people standing behind you."],
#: scripts/campaign/mission_e7_04.gd:89 data/voice/lines/e7m4.json:L7
msgid "You are told many things, Vessa. Most of them by people standing behind you."
msgstr ""

#. [&"ossavar", "One small sale before the great one. Sunwake, Aurivane's pride. Who pays?"],
#: scripts/campaign/mission_e7_04.gd:90 data/voice/lines/e7m4.json:L8
msgid "One small sale before the great one. Sunwake, Aurivane's pride. Who pays?"
msgstr ""

#. [&"torvald", "Sunwake flies with us. For the morning, at least."],
#: scripts/campaign/mission_e7_04.gd:91 data/voice/lines/e7m4.json:L9
msgid "Sunwake flies with us. For the morning, at least."
msgstr ""

#. [&"ossavar", "Sunwake keeps her old masters. For now."],
#: scripts/campaign/mission_e7_04.gd:92 data/voice/lines/e7m4.json:L10
msgid "Sunwake keeps her old masters. For now."
msgstr ""

#. [&"ysolde", "Malrik! Every grave you dig, I will plant over. Every single one!"],
#: scripts/campaign/mission_e7_04.gd:93 data/voice/lines/e7m4.json:L11
msgid "Malrik! Every grave you dig, I will plant over. Every single one!"
msgstr ""

#. [&"malrik", "Then you will be a very busy gardener, Ysolde."],
#: scripts/campaign/mission_e7_04.gd:94 data/voice/lines/e7m4.json:L12
msgid "Then you will be a very busy gardener, Ysolde."
msgstr ""

#. [&"aldra", "One red sail under. The sea keeps the coin, as usual."],
#: scripts/campaign/mission_e7_04.gd:95 data/voice/lines/e7m4.json:L13
msgid "One red sail under. The sea keeps the coin, as usual."
msgstr ""

#. [&"seraphine", "The rock is Adamarch's! The Archon is watching from the spire, Ice-king. So is everyone."],
#: scripts/campaign/mission_e7_04.gd:96 data/voice/lines/e7m4.json:L14
msgid "The rock is Adamarch's! The Archon is watching from the spire, Ice-king. So is everyone."
msgstr ""

#. [&"diamond_archon", "Empty the pits. All of them. Let the sky be white and silver by noon."],
#: scripts/campaign/mission_e7_04.gd:97 data/voice/lines/e7m4.json:L15
msgid "Empty the pits. All of them. Let the sky be white and silver by noon."
msgstr ""

#. [&"ossavar", "Every dragon on the Coinwater changes sides in one morning. I have seen this before."],
#: scripts/campaign/mission_e7_04.gd:98 data/voice/lines/e7m4.json:L16
msgid "Every dragon on the Coinwater changes sides in one morning. I have seen this before."
msgstr ""

#. [&"vessa", "He bought the whole SKY? Ysolde, pull back! Everyone, back to the ships!"],
#: scripts/campaign/mission_e7_04.gd:99 data/voice/lines/e7m4.json:L17
msgid "He bought the whole SKY? Ysolde, pull back! Everyone, back to the ships!"
msgstr ""

#. [&"dacian", "Enough. Seraphine, the cloth. We end this on the sand, the old way."],
#: scripts/campaign/mission_e7_04.gd:100 data/voice/lines/e7m4.json:L18
msgid "Enough. Seraphine, the cloth. We end this on the sand, the old way."
msgstr ""

#. [&"seraphine", "A truce, Sunblade. No bets. No knives. Just us."],
#: scripts/campaign/mission_e7_04.gd:101 data/voice/lines/e7m4.json:L19
msgid "A truce, Sunblade. No bets. No knives. Just us."
msgstr ""

#. [&"malrik", "Burn them. Both fleets, the sand, the cloth. A strait of dead feeds the stone for years."],
#: scripts/campaign/mission_e7_04.gd:102 data/voice/lines/e7m4.json:L20
msgid "Burn them. Both fleets, the sand, the cloth. A strait of dead feeds the stone for years."
msgstr ""

#. [&"obren", "Yes, Bishop. A whole sea of them. Feed me, and I will crown you king of the deep."],
#: scripts/campaign/mission_e7_04.gd:103 data/voice/lines/e7m4.json:L21
msgid "Yes, Bishop. A whole sea of them. Feed me, and I will crown you king of the deep."
msgstr ""

#. [&"torvald", "No."],
#: scripts/campaign/mission_e7_04.gd:104 data/voice/lines/c_e4_frontier.json:L4
#: data/voice/lines/e7m4.json:L22
msgid "No."
msgstr ""

#. [&"malrik", "You said that once before, in your hall. \"For now,\" you said."],
#: scripts/campaign/mission_e7_04.gd:105 data/voice/lines/e7m4.json:L23
msgid "You said that once before, in your hall. \"For now,\" you said."
msgstr ""

#. [&"torvald", "I am done waiting, Malrik. Aldra. Everyone. To the rock."],
#: scripts/campaign/mission_e7_04.gd:106 data/voice/lines/e7m4.json:L24
msgid "I am done waiting, Malrik. Aldra. Everyone. To the rock."
msgstr ""

#. [&"ossavar", "You paid me once, Ice-king, in clean coin. That bond still holds. I fly with you."],
#: scripts/campaign/mission_e7_04.gd:107 data/voice/lines/e7m4.json:L25
msgid "You paid me once, Ice-king, in clean coin. That bond still holds. I fly with you."
msgstr ""

#. [&"ossavar", "You never bought me, Ice-king. That is why I will fly with you."],
#: scripts/campaign/mission_e7_04.gd:108 data/voice/lines/e7m4.json:L25a
msgid "You never bought me, Ice-king. That is why I will fly with you."
msgstr ""

#. [&"ossavar", "And you sheltered the Outwall when nobody paid. I remember debts."],
#: scripts/campaign/mission_e7_04.gd:109 data/voice/lines/e7m4.json:L25b
msgid "And you sheltered the Outwall when nobody paid. I remember debts."
msgstr ""

#. [&"vessa", "Torvald? You're fighting HIM? ...Fine. Aurivane stands down. Don't make me regret it."],
#: scripts/campaign/mission_e7_04.gd:110 data/voice/lines/e7m4.json:L26
msgid "Torvald? You're fighting HIM? ...Fine. Aurivane stands down. Don't make me regret it."
msgstr ""

#. [&"malrik", "Kesh. Morrow. Sunwake. I filled your hoards to the brim. Earn them."],
#: scripts/campaign/mission_e7_04.gd:111 data/voice/lines/e7m4.json:L27
msgid "Kesh. Morrow. Sunwake. I filled your hoards to the brim. Earn them."
msgstr ""

#. [&"aldra", "My lord, the Bazaar. A dragon serves whoever filled the hoard last. Pay them to fly away."],
#: scripts/campaign/mission_e7_04.gd:112 data/voice/lines/e7m4.json:L28
msgid "My lord, the Bazaar. A dragon serves whoever filled the hoard last. Pay them to fly away."
msgstr ""

#. [&"ossavar", "Paid to go home. The one price he never tried."],
#: scripts/campaign/mission_e7_04.gd:113 data/voice/lines/e7m4.json:L29
msgid "Paid to go home. The one price he never tried."
msgstr ""

#. [&"hush", "There is always another night, Ice-king. Tonight it is yours."],
#: scripts/campaign/mission_e7_04.gd:114 data/voice/lines/e7m4.json:L30
msgid "There is always another night, Ice-king. Tonight it is yours."
msgstr ""

#. [&"torvald", "Then I will spend it awake."],
#: scripts/campaign/mission_e7_04.gd:115 data/voice/lines/e7m4.json:L31
msgid "Then I will spend it awake."
msgstr ""

#. [&"brannet", "Those oars were ours! Nobody from the Outwall rows for the candle-man!"],
#: scripts/campaign/mission_e7_04.gd:116 data/voice/lines/e7m4.json:L32
msgid "Those oars were ours! Nobody from the Outwall rows for the candle-man!"
msgstr ""

#. [&"aldra", "Silver sinks the same as crimson, my lord. Slower, perhaps. Heavier pride."],
#: scripts/campaign/mission_e7_04.gd:117 data/voice/lines/e7m4.json:L32b
msgid "Silver sinks the same as crimson, my lord. Slower, perhaps. Heavier pride."
msgstr ""

#. [&"obren", "More, Bishop. The sea is generous tonight."],
#: scripts/campaign/mission_e7_04.gd:118 data/voice/lines/e7m4.json:L33
msgid "More, Bishop. The sea is generous tonight."
msgstr ""

#. [&"malrik", "Do you hear it, Torvald? Every one of them is mine now. Every single one."],
#: scripts/campaign/mission_e7_04.gd:119 data/voice/lines/e7m4.json:L33b
msgid "Do you hear it, Torvald? Every one of them is mine now. Every single one."
msgstr ""

#. [&"ossavar", "He walked out once, and the sea went still. Your turn, Ice-king. Go to the light."],
#: scripts/campaign/mission_e7_04.gd:120 data/voice/lines/e7m4.json:L34
msgid "He walked out once, and the sea went still. Your turn, Ice-king. Go to the light."
msgstr ""

#. [&"aldra", "The west water is glass. Their galleys are stuck fast."],
#: scripts/campaign/mission_e7_04.gd:121 data/voice/lines/e7m4.json:L35
msgid "The west water is glass. Their galleys are stuck fast."
msgstr ""

#. [&"seraphine", "The east is frozen! Dacian, back to back!"],
#: scripts/campaign/mission_e7_04.gd:122 data/voice/lines/e7m4.json:L36
msgid "The east is frozen! Dacian, back to back!"
msgstr ""

#. [&"malrik", "Torvald! You never said no to anyone in your life. Why start with me?"],
#: scripts/campaign/mission_e7_04.gd:123 data/voice/lines/e7m4.json:L37
msgid "Torvald! You never said no to anyone in your life. Why start with me?"
msgstr ""

#. [&"torvald", "Because I finally saw what you were buying."],
#: scripts/campaign/mission_e7_04.gd:124 data/voice/lines/e7m4.json:L38
msgid "Because I finally saw what you were buying."
msgstr ""

#. [&"torvald", "Enough."],
#: scripts/campaign/mission_e7_04.gd:125 data/voice/lines/e7m4.json:L39
#: data/voice/lines/ep7_opening.json:L22
msgid "Enough."
msgstr ""

#. [&"ossavar", "I have heard that word once before. It sounded better from you."],
#: scripts/campaign/mission_e7_04.gd:126 data/voice/lines/e7m4.json:L40
msgid "I have heard that word once before. It sounded better from you."
msgstr ""

#. [&"torvald", "The sea... was never mine to hold."],
#: scripts/campaign/mission_e7_04.gd:127 data/voice/lines/e7m4.json:L41
msgid "The sea... was never mine to hold."
msgstr ""

#. [&"aldra", "The rock is his. The stone will drink the whole strait now."],
#: scripts/campaign/mission_e7_04.gd:128 data/voice/lines/e7m4.json:L42
msgid "The rock is his. The stone will drink the whole strait now."
msgstr ""

#. [&"hush", "The Bishop sends his regrets. I will deliver them in person, later."],
#: scripts/campaign/mission_e7_04.gd:129 data/voice/lines/e7m4.json:L43
msgid "The Bishop sends his regrets. I will deliver them in person, later."
msgstr ""

#. "Nearly four hundred years ago, in the Year of Two Skies, Adamarch emptied its diamond pits in one night, and 
#: scripts/campaign/mission_e7_04.gd:132
msgid "Nearly four hundred years ago, in the Year of Two Skies, Adamarch emptied its diamond pits in one night, and every dragon on the Coinwater changed sides by morning. Tonight the Diamond Archon signs the same order, with Malrik's hand on her pen."
msgstr ""

#. "At dawn both cities sail everything they own into the strait. Aurivane holds the Tollrock with Vessa and Ysol
#: scripts/campaign/mission_e7_04.gd:133
msgid "At dawn both cities sail everything they own into the strait. Aurivane holds the Tollrock with Vessa and Ysolde. Adamarch attacks it with Torvald and Malrik. The truce of the Stilled Sea is a hundred and thirty years old, and it ends today."
msgstr ""

#. "Torvald knows whose knives broke the Laurel. He knows whose masks walked out of the old adit. He has waited f
#: scripts/campaign/mission_e7_04.gd:134
msgid "Torvald knows whose knives broke the Laurel. He knows whose masks walked out of the old adit. He has waited for Malrik to become someone else. Today he will find out how long a patient man can wait."
msgstr ""

