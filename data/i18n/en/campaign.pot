#. const MISSION_TITLE := "The Green Road"
#: scripts/campaign/mission_e4_02.gd:22
msgid "The Green Road"
msgstr ""

#. [&"narrator", "The morning after Lark Hill. The wagons burned in the night. The people will have to walk."],
#: scripts/campaign/mission_e4_02.gd:117 data/voice/lines/e4m2.json:L1
msgid "The morning after Lark Hill. The wagons burned in the night. The people will have to walk."
msgstr ""

#. [&"ysolde", "One road, the Fire border at the end of it, and everyone we kept alive. We walk them there."],
#: scripts/campaign/mission_e4_02.gd:118 data/voice/lines/e4m2.json:L2
msgid "One road, the Fire border at the end of it, and everyone we kept alive. We walk them there."
msgstr ""

#. [&"maelis", "The western woods are old and full of ears. Some of those ears are Malrik's."],
#: scripts/campaign/mission_e4_02.gd:119 data/voice/lines/e4m2.json:L3
msgid "The western woods are old and full of ears. Some of those ears are Malrik's."
msgstr ""

#. [&"messenger", "The first ones are... they're ready, my lady. Ring the lantern and... they'll go."],
#: scripts/campaign/mission_e4_02.gd:120 data/voice/lines/e4m2.json:L4
msgid "The first ones are... they're ready, my lady. Ring the lantern and... they'll go."
msgstr ""

#. [&"maelis", "I'll run ahead and smell the road. Call me when your tree grows tall enough to shout."],
#: scripts/campaign/mission_e4_02.gd:121 data/voice/lines/e4m2.json:L5
msgid "I'll run ahead and smell the road. Call me when your tree grows tall enough to shout."
msgstr ""

#. [&"ysolde", "Don't fight them all on your own. Leave me a few."],
#: scripts/campaign/mission_e4_02.gd:122 data/voice/lines/e4m2.json:L6
msgid "Don't fight them all on your own. Leave me a few."
msgstr ""

#. [&"ysolde", "Torvald froze the brook. The old folk will slip, and his archers know it."],
#: scripts/campaign/mission_e4_02.gd:123 data/voice/lines/e4m2.json:L7
msgid "Torvald froze the brook. The old folk will slip, and his archers know it."
msgstr ""

#. [&"ysolde", "Stay on the road. If anything moves in the trees, stop, and let the thorns go first."],
#: scripts/campaign/mission_e4_02.gd:124 data/voice/lines/e4m2.json:L8
msgid "Stay on the road. If anything moves in the trees, stop, and let the thorns go first."
msgstr ""

#. [&"ysolde", "Knives in the oak! Down, everyone down! Thornlings, into the ferns!"],
#: scripts/campaign/mission_e4_02.gd:125 data/voice/lines/e4m2.json:L10
msgid "Knives in the oak! Down, everyone down! Thornlings, into the ferns!"
msgstr ""

#. [&"hush", "Little lambs on a little road. The Bishop sends his regards."],
#: scripts/campaign/mission_e4_02.gd:126 data/voice/lines/e4m2.json:L11
msgid "Little lambs on a little road. The Bishop sends his regards."
msgstr ""

#. [&"ysolde", "You burned their wagons. You don't get their children."],
#: scripts/campaign/mission_e4_02.gd:127 data/voice/lines/e4m2.json:L12
msgid "You burned their wagons. You don't get their children."
msgstr ""

#. [&"ysolde", "Maelis! The Heartwood stands tall enough. Come home."],
#: scripts/campaign/mission_e4_02.gd:128 data/voice/lines/e4m2.json:L13
msgid "Maelis! The Heartwood stands tall enough. Come home."
msgstr ""

#. [&"maelis", "I went to see the brook. It is cold, it is guarded, and it is very rude."],
#: scripts/campaign/mission_e4_02.gd:129 data/voice/lines/e4m2.json:L14
msgid "I went to see the brook. It is cold, it is guarded, and it is very rude."
msgstr ""

#. [&"ashby", "Nature folk at the gate! Open up, lads. Blankets, bread, and no questions."],
#: scripts/campaign/mission_e4_02.gd:130 data/voice/lines/e4m2.json:L15
msgid "Nature folk at the gate! Open up, lads. Blankets, bread, and no questions."
msgstr ""

#. [&"hush", "Another night, then. There is always another night."],
#: scripts/campaign/mission_e4_02.gd:131 data/voice/lines/e4m2.json:L16
msgid "Another night, then. There is always another night."
msgstr ""

#. [&"ysolde", "They're through. Ring it again, Wren."],
#: scripts/campaign/mission_e4_02.gd:132 data/voice/lines/e4m2.json:L17
msgid "They're through. Ring it again, Wren."
msgstr ""

#. [&"ysolde", "No... Keep moving. We grieve at the border. Not here."],
#: scripts/campaign/mission_e4_02.gd:133 data/voice/lines/e4m2.json:L18
msgid "No... Keep moving. We grieve at the border. Not here."
msgstr ""

#. [&"maelis", "Listen. The brook's talking again. It says thank you, roughly."],
#: scripts/campaign/mission_e4_02.gd:134 data/voice/lines/e4m2.json:L19
msgid "Listen. The brook's talking again. It says thank you, roughly."
msgstr ""

#. [&"maelis", "Their nest is ash. Malrik will need new hunters, and new excuses."],
#: scripts/campaign/mission_e4_02.gd:135 data/voice/lines/e4m2.json:L20
msgid "Their nest is ash. Malrik will need new hunters, and new excuses."
msgstr ""

#. [&"hush", "The knife never misses, Ysolde. It only waits for the right neck."],
#: scripts/campaign/mission_e4_02.gd:136 data/voice/lines/e4m2.json:L21
msgid "The knife never misses, Ysolde. It only waits for the right neck."
msgstr ""

#. [&"ysolde", "Then it can wait forever. Maelis, stay with the people."],
#: scripts/campaign/mission_e4_02.gd:137 data/voice/lines/e4m2.json:L22
msgid "Then it can wait forever. Maelis, stay with the people."
msgstr ""

#. [&"maelis", "Make way for the old herd!"],
#: scripts/campaign/mission_e4_02.gd:138 data/voice/lines/e4m2.json:L23
msgid "Make way for the old herd!"
msgstr ""

#. [&"narrator", "The last of them leave Larkrest. Behind them, the green road goes quiet."],
#: scripts/campaign/mission_e4_02.gd:139 data/voice/lines/e4m2.json:L24
msgid "The last of them leave Larkrest. Behind them, the green road goes quiet."
msgstr ""

#. [&"maelis", "Everything they have left is coming. Good. It means we're nearly there."],
