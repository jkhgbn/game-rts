#. const MISSION_TITLE := "The Salt Road"
#: scripts/campaign/mission_e2_03.gd:18
msgid "The Salt Road"
msgstr ""

#. const SPEAKER_NAMES := {&"vessa": "Vessa", &"vey": "Old Vey", &"pell": "Pell", &"bettany": "Bettany",
#: scripts/campaign/mission_e2_03.gd:94
msgid "Bettany"
msgstr ""

#. [&"narrator", "The Salt Road runs from Emberfall to the sea. Everything on it has a price, even the road."],
#: scripts/campaign/mission_e2_03.gd:98
msgid "The Salt Road runs from Emberfall to the sea. Everything on it has a price, even the road."
msgstr ""

#. [&"vessa", "Six wagons of gold. I don't own one wagon of gold. I own a lot of rocks. Shiny ones."],
#: scripts/campaign/mission_e2_03.gd:99
msgid "Six wagons of gold. I don't own one wagon of gold. I own a lot of rocks. Shiny ones."
msgstr ""

#. [&"pell", "Rocks become gold at a post, my queen. Gold becomes everything else. Trust a professional."],
#: scripts/campaign/mission_e2_03.gd:100
msgid "Rocks become gold at a post, my queen. Gold becomes everything else. Trust a professional."
msgstr ""

#. [&"vey", "I'll ride to Emberfall and find the old stair. Pay the hunters, then call me."],
#: scripts/campaign/mission_e2_03.gd:101
msgid "I'll ride to Emberfall and find the old stair. Pay the hunters, then call me."
msgstr ""

#. [&"pell", "You again! The fire one. Last time you let me out of a cage. Today I let you into a market."],
#: scripts/campaign/mission_e2_03.gd:102
msgid "You again! The fire one. Last time you let me out of a cage. Today I let you into a market."
msgstr ""

#. [&"pell", "A Bazaar! Look at it. Smell it. Now put wheels on something and send it somewhere far."],
#: scripts/campaign/mission_e2_03.gd:103
msgid "A Bazaar! Look at it. Smell it. Now put wheels on something and send it somewhere far."
msgstr ""

#. [&"bettany", "Heads up, Firelady. The Magpies are out. They like their caravans full and their guards absent."
#: scripts/campaign/mission_e2_03.gd:104
msgid "Heads up, Firelady. The Magpies are out. They like their caravans full and their guards absent."
msgstr ""

#. [&"vessa", "Bettany? I thought your tavern burned down."],
#: scripts/campaign/mission_e2_03.gd:105
msgid "Bettany? I thought your tavern burned down."
msgstr ""

#. [&"pell", "Gold! Your first gold. I'm not crying. It's the salt."],
#: scripts/campaign/mission_e2_03.gd:106
msgid "Gold! Your first gold. I'm not crying. It's the salt."
msgstr ""

#. [&"malrik", "Every road charges a toll, Vessa. This one charges you."],
#: scripts/campaign/mission_e2_03.gd:107
msgid "Every road charges a toll, Vessa. This one charges you."
msgstr ""

#. [&"vessa", "A tollbooth. You built a tollbooth. That is the most Malrik thing you've ever done."],
#: scripts/campaign/mission_e2_03.gd:108
msgid "A tollbooth. You built a tollbooth. That is the most Malrik thing you've ever done."
msgstr ""

#. [&"vessa", "Stables! Javelins on horseback. Sir Crackle will have to wait for a saddle."],
#: scripts/campaign/mission_e2_03.gd:109
msgid "Stables! Javelins on horseback. Sir Crackle will have to wait for a saddle."
msgstr ""

#. [&"bettany", "One wagon. Five to go. The hunters count slow and they count twice."],
#: scripts/campaign/mission_e2_03.gd:110
msgid "One wagon. Five to go. The hunters count slow and they count twice."
msgstr ""

#. [&"vessa", "What do they even want all this gold for?"],
#: scripts/campaign/mission_e2_03.gd:111
msgid "What do they even want all this gold for?"
msgstr ""

#. [&"pell", "They took the tribute! Get it back! That gold has my fingerprints on it!"],
#: scripts/campaign/mission_e2_03.gd:112
msgid "They took the tribute! Get it back! That gold has my fingerprints on it!"
msgstr ""

#. [&"vessa", "Got it! Finders keepers, Magpies."],
#: scripts/campaign/mission_e2_03.gd:113
msgid "Got it! Finders keepers, Magpies."
msgstr ""

#. [&"vessa", "Vey, the Citadel's lit. The stair can wait. I've got thieves."],
#: scripts/campaign/mission_e2_03.gd:114
msgid "Vey, the Citadel's lit. The stair can wait. I've got thieves."
msgstr ""

#. [&"vey", "Thieves AND a toll? Girl, you do know how to throw a party."],
#: scripts/campaign/mission_e2_03.gd:115
msgid "Thieves AND a toll? Girl, you do know how to throw a party."
msgstr ""

#. [&"ashby", "Shades sitting on Millstone Cross, my queen. No caravan's getting through there."],
#: scripts/campaign/mission_e2_03.gd:116
msgid "Shades sitting on Millstone Cross, my queen. No caravan's getting through there."
msgstr ""

#. [&"malrik", "If I can't have the deep road, nobody walks it. Burn the market."],
#: scripts/campaign/mission_e2_03.gd:117
msgid "If I can't have the deep road, nobody walks it. Burn the market."
msgstr ""

#. [&"vessa", "Toll's paid. In fire. Keep the change."],
#: scripts/campaign/mission_e2_03.gd:118
msgid "Toll's paid. In fire. Keep the change."
msgstr ""

#. [&"vessa", "You rebuilt it?! You rebuilt the tollbooth?"],
#: scripts/campaign/mission_e2_03.gd:119
msgid "You rebuilt it?! You rebuilt the tollbooth?"
msgstr ""

#. [&"bettany", "Halfway. The old hunters are starting to like you. Don't let it go to your head."],
#: scripts/campaign/mission_e2_03.gd:120
msgid "Halfway. The old hunters are starting to like you. Don't let it go to your head."
msgstr ""

#. [&"bettany", "Eight Magpies. The Lodge remembers who clears its road."],
#: scripts/campaign/mission_e2_03.gd:121
msgid "Eight Magpies. The Lodge remembers who clears its road."
msgstr ""

#. [&"pell", "Robbing Malrik's wagons! You're a natural. I've never been prouder."],
#: scripts/campaign/mission_e2_03.gd:122
msgid "Robbing Malrik's wagons! You're a natural. I've never been prouder."
msgstr ""

#. [&"bettany", "Six. Paid in full. Here's your road down: a stair under Emberfall, the Sunrise Road."],
#: scripts/campaign/mission_e2_03.gd:123
msgid "Six. Paid in full. Here's your road down: a stair under Emberfall, the Sunrise Road."
msgstr ""

#. [&"bettany", "Two of ours will guide you. Nobody else has walked it since the Master."],
#: scripts/campaign/mission_e2_03.gd:124
msgid "Two of ours will guide you. Nobody else has walked it since the Master."
msgstr ""

#. [&"malrik", "A map to the deep. How generous. I'll take it off your body."],
#: scripts/campaign/mission_e2_03.gd:125
msgid "A map to the deep. How generous. I'll take it off your body."
msgstr ""

#. [&"bettany", "Guides are with you. Go before the Bishop buys the next one."],
#: scripts/campaign/mission_e2_03.gd:126
msgid "Guides are with you. Go before the Bishop buys the next one."
msgstr ""

#. [&"vessa", "Pell, keep the Bazaar running. Fire just learned what gold is for."],
#: scripts/campaign/mission_e2_03.gd:127
msgid "Pell, keep the Bazaar running. Fire just learned what gold is for."
msgstr ""

#. [&"vessa", "Should have... ridden faster..."],
#: scripts/campaign/mission_e2_03.gd:128
msgid "Should have... ridden faster..."
msgstr ""

#. [&"ashby", "The Saltwatch is lost! Get the queen out!"],
#: scripts/campaign/mission_e2_03.gd:129
msgid "The Saltwatch is lost! Get the queen out!"
msgstr ""

#. [&"ashby", "Built you a tower on the west road, my queen. Learned that at the Millwatch."],
#: scripts/campaign/mission_e2_03.gd:130
msgid "Built you a tower on the west road, my queen. Learned that at the Millwatch."
msgstr ""

#. [&"pell", "You again! You left me in that cage, you know. I escaped. On my own. Thank you for asking."],
#: scripts/campaign/mission_e2_03.gd:131
msgid "You again! You left me in that cage, you know. I escaped. On my own. Thank you for asking."
msgstr ""

#. [&"bettany", "It did. The Lodge pays better, and nobody here throws fire at the furniture."],
#: scripts/campaign/mission_e2_03.gd:132
msgid "It did. The Lodge pays better, and nobody here throws fire at the furniture."
msgstr ""

#. [&"bettany", "Arrows, mostly. And never having to go down there again."],
#: scripts/campaign/mission_e2_03.gd:133
msgid "Arrows, mostly. And never having to go down there again."
msgstr ""

#. "The three relics point down, under Emberfall, along roads nobody living has walked. Nobody but the Greywater 
#: scripts/campaign/mission_e2_03.gd:136
msgid "The three relics point down, under Emberfall, along roads nobody living has walked. Nobody but the Greywater hunters, who mapped the deep for a hundred years and have never sold the map."
msgstr ""

#. "They will sell it now, for gold: six wagons of it, delivered to their Lodge's door at the far end of the Salt
#: scripts/campaign/mission_e2_03.gd:137
msgid "They will sell it now, for gold: six wagons of it, delivered to their Lodge's door at the far end of the Salt Road. Their neighbours across the road are the Magpies, who steal for a living. Malrik's men have started charging tolls."
msgstr ""

#. "Fire has never needed gold. Fire has crystals, and a short temper. Pell says that is a fine start for a merch
#: scripts/campaign/mission_e2_03.gd:138
msgid "Fire has never needed gold. Fire has crystals, and a short temper. Pell says that is a fine start for a merchant."
msgstr ""

#. const BRIEFING_LINE := "Build a Bazaar, send caravans to the trading posts, then send tribute to the Greywater
#: scripts/campaign/mission_e2_03.gd:140
msgid "Build a Bazaar, send caravans to the trading posts, then send tribute to the Greywater Lodge."
msgstr ""

#. const HINT_BUILD_BAZAAR := "Build an Ember Bazaar: select a Cinder Hand, press B then B. It must stand within 
#: scripts/campaign/mission_e2_03.gd:141
msgid "Build an Ember Bazaar: select a Cinder Hand, press B then B. It must stand within 20 m of the keep."
msgstr ""

#. const HINT_CARAVANS := "Train caravans (Z). They walk to a trading post and bring back gold. Far posts pay mor
#: scripts/campaign/mission_e2_03.gd:142
msgid "Train caravans (Z). They walk to a trading post and bring back gold. Far posts pay more, but the road is longer."
msgstr ""

#. const HINT_MAGPIES := "Magpies rob loaded caravans. Escort them, hire Outriders at the Lodge (U), or chase the
#: scripts/campaign/mission_e2_03.gd:143
msgid "Magpies rob loaded caravans. Escort them, hire Outriders at the Lodge (U), or chase the loot sack before it fades."
