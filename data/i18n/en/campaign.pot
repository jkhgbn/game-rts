#. const MISSION_TITLE := "The Light Below"
#: scripts/campaign/mission_e2_05.gd:24
msgid "The Light Below"
msgstr ""

#. [&"narrator", "Under the roots of the world, a door. And on the other side of it, the one who made it."],
#: scripts/campaign/mission_e2_05.gd:162
msgid "Under the roots of the world, a door. And on the other side of it, the one who made it."
msgstr ""

#. [&"vessa", "That's it. That's the door. Vey, he's right there. Under my feet."],
#: scripts/campaign/mission_e2_05.gd:163
msgid "That's it. That's the door. Vey, he's right there. Under my feet."
msgstr ""

#. [&"vey", "Four seals. Wake them with the relics and the door stands. Let Malrik break them and it falls."],
#: scripts/campaign/mission_e2_05.gd:164
msgid "Four seals. Wake them with the relics and the door stands. Let Malrik break them and it falls."
msgstr ""

#. [&"malrik", "Good evening, Vessa. Mind the statue. It's been waiting a hundred years to stretch its legs."],
#: scripts/campaign/mission_e2_05.gd:165
msgid "Good evening, Vessa. Mind the statue. It's been waiting a hundred years to stretch its legs."
msgstr ""

#. [&"vessa", "One seal! See, Vey? I can be patient. For four seconds at a time."],
#: scripts/campaign/mission_e2_05.gd:166
msgid "One seal! See, Vey? I can be patient. For four seconds at a time."
msgstr ""

#. [&"malrik", "Crack. Do you hear it, Vessa? That is the sound of a lock giving up."],
#: scripts/campaign/mission_e2_05.gd:167
msgid "Crack. Do you hear it, Vessa? That is the sound of a lock giving up."
msgstr ""

#. [&"vey", "Kindle it again, girl. The relics are stronger than his pebble. If you hold them."],
#: scripts/campaign/mission_e2_05.gd:168
msgid "Kindle it again, girl. The relics are stronger than his pebble. If you hold them."
msgstr ""

#. [&"ysolde", "The east seal is mine. Hold the west, Vessa. We have done this before."],
#: scripts/campaign/mission_e2_05.gd:169
msgid "The east seal is mine. Hold the west, Vessa. We have done this before."
msgstr ""

#. [&"ysolde", "Torvald is on my bridge with half of winter. I could use some fire."],
#: scripts/campaign/mission_e2_05.gd:170
msgid "Torvald is on my bridge with half of winter. I could use some fire."
msgstr ""

#. [&"torvald", "I will hold the north stair, Bishop. Do what you came to do, and quickly."],
#: scripts/campaign/mission_e2_05.gd:171
msgid "I will hold the north stair, Bishop. Do what you came to do, and quickly."
msgstr ""

#. [&"aldra", "Rime on the ramp, Torvald. They will not climb it twice."],
#: scripts/campaign/mission_e2_05.gd:172
msgid "Rime on the ramp, Torvald. They will not climb it twice."
msgstr ""

#. [&"hush", "Did you miss me, little ember? I missed you. Twice now."],
#: scripts/campaign/mission_e2_05.gd:173
msgid "Did you miss me, little ember? I missed you. Twice now."
msgstr ""

#. [&"vessa", "A dragon! An actual dragon! Vey, I have a DRAGON."],
#: scripts/campaign/mission_e2_05.gd:174
msgid "A dragon! An actual dragon! Vey, I have a DRAGON."
msgstr ""

#. [&"obren", "Wake, my jailer. The door was always mine to open."],
#: scripts/campaign/mission_e2_05.gd:175
msgid "Wake, my jailer. The door was always mine to open."
msgstr ""

#. [&"malrik", "Torvald, now. Both bridges. Let them choose which kingdom to lose."],
#: scripts/campaign/mission_e2_05.gd:176
msgid "Torvald, now. Both bridges. Let them choose which kingdom to lose."
msgstr ""

#. [&"vey", "Obren's Wardens. They guarded this door before he turned. Now they guard nothing."],
#: scripts/campaign/mission_e2_05.gd:177
msgid "Obren's Wardens. They guarded this door before he turned. Now they guard nothing."
msgstr ""

#. [&"master", "...Vessa?"],
#: scripts/campaign/mission_e2_05.gd:178
msgid "...Vessa?"
msgstr ""

#. [&"malrik", "Dying in the dark. Twice in one war. I am starting to keep count."],
#: scripts/campaign/mission_e2_05.gd:179
msgid "Dying in the dark. Twice in one war. I am starting to keep count."
msgstr ""

#. [&"narrator", "A hundred years the jailer stood over the door. Tonight Malrik's stone told it to open it."],
#: scripts/campaign/mission_e2_05.gd:180
msgid "A hundred years the jailer stood over the door. Tonight Malrik's stone told it to open it."
msgstr ""

#. [&"malrik", "Open it, Mason. Let me see what the Master was so busy guarding."],
#: scripts/campaign/mission_e2_05.gd:181
msgid "Open it, Mason. Let me see what the Master was so busy guarding."
msgstr ""

#. [&"vessa", "Everyone on the door! Nobody touches it but us!"],
#: scripts/campaign/mission_e2_05.gd:182
msgid "Everyone on the door! Nobody touches it but us!"
msgstr ""

#. [&"malrik", "Feed, old stone. Take what you need from me. I have plenty."],
#: scripts/campaign/mission_e2_05.gd:183
msgid "Feed, old stone. Take what you need from me. I have plenty."
msgstr ""

#. [&"vey", "He's holding it up with the shard! Cut the line, girl! Get to Malrik!"],
#: scripts/campaign/mission_e2_05.gd:184
msgid "He's holding it up with the shard! Cut the line, girl! Get to Malrik!"
msgstr ""

#. [&"master", "Hold."],
#: scripts/campaign/mission_e2_05.gd:185
msgid "Hold."
msgstr ""

#. [&"ysolde", "The line is cut! Now, before he crawls back!"],
#: scripts/campaign/mission_e2_05.gd:186
msgid "The line is cut! Now, before he crawls back!"
msgstr ""

#. [&"vey", "Feel that? He's pushing back from below. The spark first, Vessa. Then the storm."],
#: scripts/campaign/mission_e2_05.gd:187
msgid "Feel that? He's pushing back from below. The spark first, Vessa. Then the storm."
msgstr ""

#. [&"vessa", "Then let's give him something to push with. Door! Light! NOW!"],
#: scripts/campaign/mission_e2_05.gd:188
msgid "Then let's give him something to push with. Door! Light! NOW!"
msgstr ""

#. [&"torvald", "This is not what you promised, Bishop. You said a door. Not a jailer."],
#: scripts/campaign/mission_e2_05.gd:189
msgid "This is not what you promised, Bishop. You said a door. Not a jailer."
msgstr ""

#. [&"aldra", "Winter goes home, Torvald. Let the Bishop dig his own grave."],
#: scripts/campaign/mission_e2_05.gd:190
msgid "Winter goes home, Torvald. Let the Bishop dig his own grave."
msgstr ""

#. [&"vessa", "It answered! The Door hit it! He's helping us!"],
#: scripts/campaign/mission_e2_05.gd:191
msgid "It answered! The Door hit it! He's helping us!"
msgstr ""

#. [&"messenger", "The Heartwood's down! But we're still with you!"],
#: scripts/campaign/mission_e2_05.gd:192
msgid "The Heartwood's down! But we're still with you!"
msgstr ""

#. [&"malrik", "Keep your door, Vessa. I have the key, and all the time in the world."],
#: scripts/campaign/mission_e2_05.gd:193
msgid "Keep your door, Vessa. I have the key, and all the time in the world."
msgstr ""

#. [&"ysolde", "It held. Vessa. It held."],
#: scripts/campaign/mission_e2_05.gd:194
msgid "It held. Vessa. It held."
msgstr ""

#. [&"vessa", "Master... I was... so close..."],
#: scripts/campaign/mission_e2_05.gd:195
msgid "Master... I was... so close..."
msgstr ""

#. [&"vey", "Sunfoot's burning! Back to the stair, girl, now!"],
#: scripts/campaign/mission_e2_05.gd:196
msgid "Sunfoot's burning! Back to the stair, girl, now!"
msgstr ""

#. [&"vey", "No knives at our backs tonight. Hush is still licking her wounds. Good."],
#: scripts/campaign/mission_e2_05.gd:197
msgid "No knives at our backs tonight. Hush is still licking her wounds. Good."
msgstr ""

#. [&"vey", "So you do. Point it at the big statue, and try not to name it."],
#: scripts/campaign/mission_e2_05.gd:198
msgid "So you do. Point it at the big statue, and try not to name it."
msgstr ""

#. [&"vessa", "Master?! Master, I'm here! I'm right here!"],
#: scripts/campaign/mission_e2_05.gd:199
msgid "Master?! Master, I'm here! I'm right here!"
msgstr ""

#. "At the bottom of the Sunrise Road the world opens into a cavern so big it has its own weather: warm wind risi
#: scripts/campaign/mission_e2_05.gd:202
msgid "At the bottom of the Sunrise Road the world opens into a cavern so big it has its own weather: warm wind rising from a chasm, and in the middle, set in the floor, a round white door that glows like a sunrise."
msgstr ""

#. "The Master is on the other side, holding it shut. Four old seals ring the door; the relics can wake them. Mal
#: scripts/campaign/mission_e2_05.gd:203
msgid "The Master is on the other side, holding it shut. Four old seals ring the door; the relics can wake them. Malrik came down his own stair with Torvald, and the stone in his hand wants that door open."
msgstr ""

#. "Ysolde's army came down behind Vessa. Two kingdoms on each side of the chasm, and between them, standing over
#: scripts/campaign/mission_e2_05.gd:204
msgid "Ysolde's army came down behind Vessa. Two kingdoms on each side of the chasm, and between them, standing over the door like a jailer, a statue as tall as a tower. Its eyes are closed. For now."
msgstr ""

#. const BRIEFING_LINE := "Kindle the seals around the Door with Vessa. Each seal Malrik cracks brings the jailer
#: scripts/campaign/mission_e2_05.gd:206
msgid "Kindle the seals around the Door with Vessa. Each seal Malrik cracks brings the jailer closer to waking."
msgstr ""

#. const HINT_SEALS := "Kindle a seal: Vessa beside it for 4 s. Malrik can crack them back. Ping Ysolde to help h
#: scripts/campaign/mission_e2_05.gd:207
msgid "Kindle a seal: Vessa beside it for 4 s. Malrik can crack them back. Ping Ysolde to help hold them."
msgstr ""

