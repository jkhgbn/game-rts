#. const MISSION_TITLE := "A Hundred Winters"
#: scripts/campaign/mission_e6_01.gd:23
msgid "A Hundred Winters"
msgstr ""

#. [&"narrator", "A hundred winters ago, the lake had no name, and the north had one keeper."],
#: scripts/campaign/mission_e6_01.gd:94 data/voice/lines/e6m1.json:L1
msgid "A hundred winters ago, the lake had no name, and the north had one keeper."
msgstr ""

#. [&"master", "Keep this cold, Torvald. Keep it until I come back for it."],
#: scripts/campaign/mission_e6_01.gd:95 data/voice/lines/e6m1.json:L2
msgid "Keep this cold, Torvald. Keep it until I come back for it."
msgstr ""

#. [&"torvald", "What is it?"],
#: scripts/campaign/mission_e6_01.gd:96 data/voice/lines/e6m1.json:L3
msgid "What is it?"
msgstr ""

#. [&"master", "A promise I made to a stone. Something will come for it. Every winter."],
#: scripts/campaign/mission_e6_01.gd:97 data/voice/lines/e6m1.json:L4
msgid "A promise I made to a stone. Something will come for it. Every winter."
msgstr ""

#. [&"aldra", "My lord? The ice is singing. Can you hear it?"],
#: scripts/campaign/mission_e6_01.gd:98 data/voice/lines/e6m1.json:L5
msgid "My lord? The ice is singing. Can you hear it?"
msgstr ""

#. [&"torvald", "Go home, girl. Winter is coming, and it is bringing guests."],
#: scripts/campaign/mission_e6_01.gd:99 data/voice/lines/e6m1.json:L6
msgid "Go home, girl. Winter is coming, and it is bringing guests."
msgstr ""

#. [&"aldra", "This is my home. I'll stay, if it's all the same to you."],
#: scripts/campaign/mission_e6_01.gd:100 data/voice/lines/e6m1.json:L7
msgid "This is my home. I'll stay, if it's all the same to you."
msgstr ""

#. [&"narrator", "The first winter came down from the north, and it did not come alone."],
#: scripts/campaign/mission_e6_01.gd:101 data/voice/lines/e6m1.json:L8
msgid "The first winter came down from the north, and it did not come alone."
msgstr ""

#. [&"obren", "That is my key, frost-man. I made the lock. Give it back."],
#: scripts/campaign/mission_e6_01.gd:102 data/voice/lines/e6m1.json:L9
msgid "That is my key, frost-man. I made the lock. Give it back."
msgstr ""

#. [&"torvald", "A talking stone. Wonderful. I was hoping for a quiet century."],
#: scripts/campaign/mission_e6_01.gd:103 data/voice/lines/e6m1.json:L10
msgid "A talking stone. Wonderful. I was hoping for a quiet century."
msgstr ""

#. [&"torvald", "The ice holds for us, and not for them. Remember that, girl."],
#: scripts/campaign/mission_e6_01.gd:104 data/voice/lines/e6m1.json:L11
msgid "The ice holds for us, and not for them. Remember that, girl."
msgstr ""

#. [&"aldra", "Aldra. My name is Aldra. And I will remember."],
#: scripts/campaign/mission_e6_01.gd:105 data/voice/lines/e6m1.json:L12
msgid "Aldra. My name is Aldra. And I will remember."
msgstr ""

#. [&"narrator", "Spring came late to the lake, and stayed only a little while."],
#: scripts/campaign/mission_e6_01.gd:106 data/voice/lines/e6m1.json:L13
msgid "Spring came late to the lake, and stayed only a little while."
msgstr ""

#. [&"torvald", "You carved a giant out of my lake."],
#: scripts/campaign/mission_e6_01.gd:108 data/voice/lines/e6m1.json:L15
msgid "You carved a giant out of my lake."
msgstr ""

#. [&"aldra", "You weren't using it."],
#: scripts/campaign/mission_e6_01.gd:109 data/voice/lines/e6m1.json:L16
msgid "You weren't using it."
msgstr ""

#. [&"obren", "Every winter, frost-man. I have nothing left but winters."],
#: scripts/campaign/mission_e6_01.gd:110 data/voice/lines/e6m1.json:L17
msgid "Every winter, frost-man. I have nothing left but winters."
msgstr ""

#. [&"torvald", "Bigger ones. Of course there are bigger ones."],
#: scripts/campaign/mission_e6_01.gd:111 data/voice/lines/e6m1.json:L18
msgid "Bigger ones. Of course there are bigger ones."
msgstr ""

#. [&"narrator", "The third winter was the longest. The Hollow sent everything it had left."],
#: scripts/campaign/mission_e6_01.gd:112 data/voice/lines/e6m1.json:L19
msgid "The third winter was the longest. The Hollow sent everything it had left."
msgstr ""

#. [&"obren", "Step aside, little king of snow. I built stairs before your mountains had names."],
#: scripts/campaign/mission_e6_01.gd:113 data/voice/lines/e6m1.json:L20
msgid "Step aside, little king of snow. I built stairs before your mountains had names."
msgstr ""

#. [&"torvald", "Stone is patient. Ice is older."],
#: scripts/campaign/mission_e6_01.gd:114 data/voice/lines/e6m1.json:L21
msgid "Stone is patient. Ice is older."
msgstr ""

#. [&"master", "Three winters, and not one stone stood on your ice."],
#: scripts/campaign/mission_e6_01.gd:115 data/voice/lines/e6m1.json:L22
msgid "Three winters, and not one stone stood on your ice."
msgstr ""

#. [&"torvald", "They will come back."],
#: scripts/campaign/mission_e6_01.gd:116 data/voice/lines/e6m1.json:L23
msgid "They will come back."
