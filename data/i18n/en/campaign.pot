#: scripts/campaign/e8_story_screen.gd:111 scripts/campaign/e8_story_screen.gd:212
msgid "Back to the menu"
msgstr ""

#. _title(Loc.t("Choose, all four of you."))
#: scripts/campaign/e8_story_screen.gd:154
msgid "Choose, all four of you."
