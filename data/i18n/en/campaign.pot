#. [&"vessa", "Come and take them, Bishop. You owe me for Emberfall. And for Vey."],
#: scripts/campaign/mission_04.gd:93 data/voice/lines/m04.json:L3
msgid "Come and take them, Bishop. You owe me for Emberfall. And for Vey."
