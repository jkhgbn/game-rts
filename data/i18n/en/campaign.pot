#. [&"narrator", "Forty winters ago. The gate had stood for sixty years, and never once opened."],
#: scripts/campaign/mission_e6_02.gd:90 data/voice/lines/e6m2.json:L1
msgid "Forty winters ago. The gate had stood for sixty years, and never once opened."
msgstr ""

#. [&"torvald", "Sixty winters I have kept this gate. I can keep it one more."],
#: scripts/campaign/mission_e6_02.gd:91 data/voice/lines/e6m2.json:L2
msgid "Sixty winters I have kept this gate. I can keep it one more."
msgstr ""

#. [&"aldra", "Torvald. The Heartfrost hums when the stone-men are near. It is humming now."],
#: scripts/campaign/mission_e6_02.gd:92 data/voice/lines/e6m2.json:L3
msgid "Torvald. The Heartfrost hums when the stone-men are near. It is humming now."
msgstr ""

#. [&"torvald", "Then the gate stays shut, and the lake stays quiet."],
#: scripts/campaign/mission_e6_02.gd:93 data/voice/lines/e6m2.json:L4
msgid "Then the gate stays shut, and the lake stays quiet."
msgstr ""

#. [&"narrator", "South of the wall, the lamps of Hearthwick went out one by one."],
#: scripts/campaign/mission_e6_02.gd:94 data/voice/lines/e6m2.json:L5
msgid "South of the wall, the lamps of Hearthwick went out one by one."
msgstr ""

#. [&"aldra", "They are not coming for the lake. Why are they not coming for the lake?"],
#: scripts/campaign/mission_e6_02.gd:95 data/voice/lines/e6m2.json:L5b
msgid "They are not coming for the lake. Why are they not coming for the lake?"
msgstr ""

#. [&"rider", "Lord Torvald! Open the gate! The stone-men are in Hearthwick!"],
#: scripts/campaign/mission_e6_02.gd:96 data/voice/lines/e6m2.json:L6
msgid "Lord Torvald! Open the gate! The stone-men are in Hearthwick!"
msgstr ""

#. [&"rider", "They're burning the houses. Two hundred people, my lord. Children."],
#: scripts/campaign/mission_e6_02.gd:97 data/voice/lines/e6m2.json:L7
msgid "They're burning the houses. Two hundred people, my lord. Children."
msgstr ""

#. [&"aldra", "It is bait. They want the gate open. They want the mere."],
#: scripts/campaign/mission_e6_02.gd:98 data/voice/lines/e6m2.json:L8
msgid "It is bait. They want the gate open. They want the mere."
msgstr ""

#. [&"torvald", "I know what they want."],
#: scripts/campaign/mission_e6_02.gd:99 data/voice/lines/e6m2.json:L9
msgid "I know what they want."
msgstr ""

#. [&"torvald", "Open the gate. All of it."],
#: scripts/campaign/mission_e6_02.gd:100 data/voice/lines/e6m2.json:L10
msgid "Open the gate. All of it."
msgstr ""

#. [&"rider", "Thank you, my lord! I'll bring them home!"],
#: scripts/campaign/mission_e6_02.gd:101 data/voice/lines/e6m2.json:L11
msgid "Thank you, my lord! I'll bring them home!"
msgstr ""

#. [&"aldra", "Then I hold the mere alone. Do not be long."],
#: scripts/campaign/mission_e6_02.gd:102 data/voice/lines/e6m2.json:L12
msgid "Then I hold the mere alone. Do not be long."
msgstr ""

#. [&"torvald", "...No. The gate stays shut."],
#: scripts/campaign/mission_e6_02.gd:103 data/voice/lines/e6m2.json:L13
msgid "...No. The gate stays shut."
msgstr ""

#. [&"rider", "You can see the smoke from up there! You can SEE it!"],
#: scripts/campaign/mission_e6_02.gd:104 data/voice/lines/e6m2.json:L14
msgid "You can see the smoke from up there! You can SEE it!"
msgstr ""

#. [&"narrator", "The snow buried his signal fire. Torvald watched it go out."],
#: scripts/campaign/mission_e6_02.gd:105 data/voice/lines/e6m2.json:L15
msgid "The snow buried his signal fire. Torvald watched it go out."
msgstr ""

#. [&"obren", "Thank you for opening the door, frost-man."],
#: scripts/campaign/mission_e6_02.gd:106 data/voice/lines/e6m2.json:L16
msgid "Thank you for opening the door, frost-man."
msgstr ""

#. [&"obren", "Keep your gate, then. I will come up through your floor."],
#: scripts/campaign/mission_e6_02.gd:107 data/voice/lines/e6m2.json:L17
msgid "Keep your gate, then. I will come up through your floor."
msgstr ""

#. [&"rider", "They're through! Keep it open, the last ones are coming!"],
#: scripts/campaign/mission_e6_02.gd:108 data/voice/lines/e6m2.json:L18
msgid "They're through! Keep it open, the last ones are coming!"
msgstr ""

#. [&"torvald", "Their door is broken. Go home, stones."],
#: scripts/campaign/mission_e6_02.gd:109 data/voice/lines/e6m2.json:L19
msgid "Their door is broken. Go home, stones."
msgstr ""

#. [&"aldra", "Torvald! The big one is at your gate!"],
#: scripts/campaign/mission_e6_02.gd:110 data/voice/lines/e6m2.json:L20
msgid "Torvald! The big one is at your gate!"
msgstr ""

#. [&"torvald", "Close it now. Gently. Everyone is home."],
#: scripts/campaign/mission_e6_02.gd:111 data/voice/lines/e6m2.json:L21
msgid "Close it now. Gently. Everyone is home."
msgstr ""

#. [&"rider", "Hearthwick will remember this gate, my lord."],
#: scripts/campaign/mission_e6_02.gd:112 data/voice/lines/e6m2.json:L22
msgid "Hearthwick will remember this gate, my lord."
msgstr ""

#. [&"torvald", "The lake is safe. The lake is always safe."],
#: scripts/campaign/mission_e6_02.gd:113 data/voice/lines/e6m2.json:L23
msgid "The lake is safe. The lake is always safe."
msgstr ""

#. [&"aldra", "And the town?"],
#: scripts/campaign/mission_e6_02.gd:114 data/voice/lines/e6m2.json:L24
msgid "And the town?"
msgstr ""

#. [&"torvald", "...Ask me in a hundred winters."],
#: scripts/campaign/mission_e6_02.gd:115 data/voice/lines/e6m2.json:L25
msgid "...Ask me in a hundred winters."
msgstr ""

#. [&"torvald", "The ice... gives..."],
#: scripts/campaign/mission_e6_02.gd:116 data/voice/lines/e6m2.json:L26
msgid "The ice... gives..."
msgstr ""

#. [&"obren", "Mine."],
#: scripts/campaign/mission_e6_02.gd:117 data/voice/lines/e6m2.json:L27
msgid "Mine."
msgstr ""

#. [&"torvald", "Hearthwick still sends me bread every midwinter. Burnt, usually."],
#: scripts/campaign/mission_e6_02.gd:119 data/voice/lines/c_e6_gate.json:L1_open
#: data/voice/lines/e6m2.json:L29
msgid "Hearthwick still sends me bread every midwinter. Burnt, usually."
msgstr ""

#. [&"torvald", "Some nights I still see the smoke."],
#: scripts/campaign/mission_e6_02.gd:120 data/voice/lines/c_e6_gate.json:L1_shut
#: data/voice/lines/e6m2.json:L30
msgid "Some nights I still see the smoke."
msgstr ""

#. "Forty winters ago. For sixty years Torvald's ice gate has stood across the south road, and in sixty years it 
#: scripts/campaign/mission_e6_02.gd:123
msgid "Forty winters ago. For sixty years Torvald's ice gate has stood across the south road, and in sixty years it has never once opened. Behind it lie his keep, his lake, and the Heartfrost he promised to keep cold."
msgstr ""

#. "South of the wall lies Hearthwick: two hundred people, a mill, and a signal fire they light when they need th
#: scripts/campaign/mission_e6_02.gd:124
msgid "South of the wall lies Hearthwick: two hundred people, a mill, and a signal fire they light when they need their lord. Tonight the stone-men have come back up out of the ground, and they are not walking toward the lake."
msgstr ""

#. "Aldra watches the mere. Torvald watches the gate. Somewhere in the snow, a rider is coming. Decide what the g
#: scripts/campaign/mission_e6_02.gd:125
msgid "Aldra watches the mere. Torvald watches the gate. Somewhere in the snow, a rider is coming. Decide what the gate is for."
