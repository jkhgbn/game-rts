msgstr ""

#. [&"vessa", "Crown, orb, signet. Let's see what you do together."],
#: scripts/campaign/mission_04.gd:106 data/voice/lines/m04.json:L16
msgid "Crown, orb, signet. Let's see what you do together."
msgstr ""

#. [&"obren", "His storm? Impossible! That light should have faded a hundred years ago!"],
#: scripts/campaign/mission_04.gd:107 data/voice/lines/m04.json:L17
msgid "His storm? Impossible! That light should have faded a hundred years ago!"
