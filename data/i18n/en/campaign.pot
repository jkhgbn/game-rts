msgstr ""

#. const HINT_VEY := "Old Vey cannot be hurt tonight. Slip past him veiled, or raise an alarm far away to draw hi
#: scripts/campaign/mission_e3_02.gd:151
msgid "Old Vey cannot be hurt tonight. Slip past him veiled, or raise an alarm far away to draw him off."
msgstr ""

