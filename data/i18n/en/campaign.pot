#. const MISSION_TITLE := "Sunrise Road"
#: scripts/campaign/mission_e2_04.gd:24
msgid "Sunrise Road"
msgstr ""

#. [&"narrator", "The Sunrise Road. The Master cut it before the kingdoms had names. No one has walked it since."
#: scripts/campaign/mission_e2_04.gd:152
msgid "The Sunrise Road. The Master cut it before the kingdoms had names. No one has walked it since."
msgstr ""

#. [&"vessa", "It's so dark. Good thing I'm the brightest person I know."],
#: scripts/campaign/mission_e2_04.gd:153
msgid "It's so dark. Good thing I'm the brightest person I know."
msgstr ""

#. [&"vey", "Stay close to the light, girl. Down here the dark has teeth."],
#: scripts/campaign/mission_e2_04.gd:154
msgid "Stay close to the light, girl. Down here the dark has teeth."
msgstr ""

#. [&"vey", "Sunstones. He set them for the Wardens, so they'd always see him coming home."],
#: scripts/campaign/mission_e2_04.gd:155
msgid "Sunstones. He set them for the Wardens, so they'd always see him coming home."
msgstr ""

#. [&"vessa", "There's a Warden in the wall. Asleep. Vey, the last ones I met tried to crush me."],
#: scripts/campaign/mission_e2_04.gd:156
msgid "There's a Warden in the wall. Asleep. Vey, the last ones I met tried to crush me."
msgstr ""

#. [&"vey", "Those were Obren's, woken by Obren. These are the Master's. They know whose storm I carry."],
#: scripts/campaign/mission_e2_04.gd:157
msgid "Those were Obren's, woken by Obren. These are the Master's. They know whose storm I carry."
msgstr ""

#. [&"vey", "Up, old friend. Your master's walking again. Well. His sword is."],
#: scripts/campaign/mission_e2_04.gd:158
msgid "Up, old friend. Your master's walking again. Well. His sword is."
msgstr ""

#. [&"vessa", "Shades, in the dark. Of course. They never pick a nice, sunny cave."],
#: scripts/campaign/mission_e2_04.gd:159
msgid "Shades, in the dark. Of course. They never pick a nice, sunny cave."
msgstr ""

#. [&"ashby", "My queen! Work crew's on the stair. Find us a hearth to build around!"],
#: scripts/campaign/mission_e2_04.gd:160
msgid "My queen! Work crew's on the stair. Find us a hearth to build around!"
msgstr ""

#. [&"vessa", "A forge. He built forges down here? What was he making?"],
#: scripts/campaign/mission_e2_04.gd:161
msgid "A forge. He built forges down here? What was he making?"
msgstr ""

#. [&"vey", "Wardens. Doors. Things that hold. He was always better at holding than letting go."],
#: scripts/campaign/mission_e2_04.gd:162
msgid "Wardens. Doors. Things that hold. He was always better at holding than letting go."
msgstr ""

#. [&"malrik", "Hush. The old man is with her. Wake the stones before he does."],
#: scripts/campaign/mission_e2_04.gd:163
msgid "Hush. The old man is with her. Wake the stones before he does."
msgstr ""

#. [&"vessa", "The hearth's lit. Ashby, it's yours. Make me things that hit harder."],
#: scripts/campaign/mission_e2_04.gd:164
msgid "The hearth's lit. Ashby, it's yours. Make me things that hit harder."
msgstr ""

#. [&"ashby", "A Master's forge! My grandad would weep. Then he'd charge you for it."],
#: scripts/campaign/mission_e2_04.gd:165
msgid "A Master's forge! My grandad would weep. Then he'd charge you for it."
msgstr ""

#. [&"ashby", "First batch out of the old forge, my queen! Blades that remember the fire."],
#: scripts/campaign/mission_e2_04.gd:166
msgid "First batch out of the old forge, my queen! Blades that remember the fire."
msgstr ""

#. [&"obren", "Wake, my masons. The Bishop's hand carries my heart. Obey it."],
#: scripts/campaign/mission_e2_04.gd:167
msgid "Wake, my masons. The Bishop's hand carries my heart. Obey it."
msgstr ""

#. [&"vessa", "That voice again. I'd hoped we buried you."],
#: scripts/campaign/mission_e2_04.gd:168
msgid "That voice again. I'd hoped we buried you."
msgstr ""

#. [&"vey", "They're throwing everything at the forge. Hold the light, and they break on it."],
#: scripts/campaign/mission_e2_04.gd:169
msgid "They're throwing everything at the forge. Hold the light, and they break on it."
msgstr ""

#. [&"vey", "Two crafts mastered. Good. The gate won't open for a fool. Or so he told me."],
#: scripts/campaign/mission_e2_04.gd:170
msgid "Two crafts mastered. Good. The gate won't open for a fool. Or so he told me."
msgstr ""

#. [&"hush", "The little ember, in the dark. You're a long way from your braziers."],
#: scripts/campaign/mission_e2_04.gd:171
msgid "The little ember, in the dark. You're a long way from your braziers."
msgstr ""

#. [&"vessa", "Mother Hush. You missed me once. I'd hate for you to get out of practice."],
#: scripts/campaign/mission_e2_04.gd:172
msgid "Mother Hush. You missed me once. I'd hate for you to get out of practice."
msgstr ""

#. [&"hush", "Hush now. The dark only wants to be listened to."],
#: scripts/campaign/mission_e2_04.gd:173 scripts/campaign/mission_e3_02.gd:115
msgid "Hush now. The dark only wants to be listened to."
msgstr ""

#. [&"hush", "There is always another night, little ember. Another night."],
#: scripts/campaign/mission_e2_04.gd:174
msgid "There is always another night, little ember. Another night."
msgstr ""

#. [&"vey", "Here. Hand on the sun, girl. I'll give it the storm. Hold it with me."],
#: scripts/campaign/mission_e2_04.gd:175
msgid "Here. Hand on the sun, girl. I'll give it the storm. Hold it with me."
msgstr ""

#. [&"vessa", "It's warm. Vey, the door is WARM. Something's on the other side."],
#: scripts/campaign/mission_e2_04.gd:176
msgid "It's warm. Vey, the door is WARM. Something's on the other side."
msgstr ""

#. [&"narrator", "And for the first time in twelve years, the Sunrise Road saw its sunrise."],
#: scripts/campaign/mission_e2_04.gd:177
msgid "And for the first time in twelve years, the Sunrise Road saw its sunrise."
msgstr ""

#. [&"vey", "He's down there. I can feel him. And he's tired, girl. So very tired."],
#: scripts/campaign/mission_e2_04.gd:178
msgid "He's down there. I can feel him. And he's tired, girl. So very tired."
msgstr ""

#. [&"vessa", "Then we go faster. Wardens, with me. We're going to fetch the Master."],
#: scripts/campaign/mission_e2_04.gd:179
msgid "Then we go faster. Wardens, with me. We're going to fetch the Master."
msgstr ""

#. [&"malrik", "Go on, then. Run ahead. I'll be right behind you, with the key you lack."],
#: scripts/campaign/mission_e2_04.gd:180
msgid "Go on, then. Run ahead. I'll be right behind you, with the key you lack."
msgstr ""

#. [&"vey", "Eight of his Wardens, awake for you. He'd have liked that."],
#: scripts/campaign/mission_e2_04.gd:181
msgid "Eight of his Wardens, awake for you. He'd have liked that."
msgstr ""

#. [&"vessa", "Every stone lit. Okay, the Master had good taste in caves."],
#: scripts/campaign/mission_e2_04.gd:182
msgid "Every stone lit. Okay, the Master had good taste in caves."
msgstr ""

#. [&"vessa", "Vey... the light... it's going out..."],
#: scripts/campaign/mission_e2_04.gd:183
msgid "Vey... the light... it's going out..."
msgstr ""

#. [&"ashby", "The forge is lost! The hearth's gone cold!"],
#: scripts/campaign/mission_e2_04.gd:184
msgid "The forge is lost! The hearth's gone cold!"
msgstr ""

#. [&"vessa", "Shades in the dark. I know that smoke. She ran from me once."],
#: scripts/campaign/mission_e2_04.gd:185
msgid "Shades in the dark. I know that smoke. She ran from me once."
msgstr ""

#. [&"vessa", "Mother Hush. Last time you ran. Want to try running a second time?"],
#: scripts/campaign/mission_e2_04.gd:186
msgid "Mother Hush. Last time you ran. Want to try running a second time?"
msgstr ""

#. "Under the Emberfall observatory a stair goes down, and down, past the last root and the last bat, into halls 
#: scripts/campaign/mission_e2_04.gd:189
msgid "Under the Emberfall observatory a stair goes down, and down, past the last root and the last bat, into halls the Master cut before there were kingdoms. The Greywater guides call it the Sunrise Road. They do not say why."
msgstr ""

#. "The Master's old Wardens sleep in the walls. Old Vey says they will know his storm. Mother Hush went down fir
#: scripts/campaign/mission_e2_04.gd:190
msgid "The Master's old Wardens sleep in the walls. Old Vey says they will know his storm. Mother Hush went down first, with a splinter of Malrik's stone, and the Wardens she wakes have amber eyes."
msgstr ""

#. "Somewhere below there is a forge, and past it a gate. Vessa brought a small army, a big temper and the only l
#: scripts/campaign/mission_e2_04.gd:191
msgid "Somewhere below there is a forge, and past it a gate. Vessa brought a small army, a big temper and the only light for a mile. Down here, that is the same thing."
msgstr ""

#. const BRIEFING_LINE := "The dark hides the enemy: light the sunstones, and keep Vessa close to the fight."
#: scripts/campaign/mission_e2_04.gd:193
msgid "The dark hides the enemy: light the sunstones, and keep Vessa close to the fight."
msgstr ""

#. const HINT_DARK := "It's dark down here: the enemy hides beyond your light. Light the sunstones (stand Vessa b
#: scripts/campaign/mission_e2_04.gd:194
msgid "It's dark down here: the enemy hides beyond your light. Light the sunstones (stand Vessa beside one)."
msgstr ""

