msgstr ""

#. [&"malrik", "More diggers, more knives. You should have burned my hall when you had the chance."],
#: scripts/campaign/mission_02.gd:150 data/voice/lines/m02.json:L6a
msgid "More diggers, more knives. You should have burned my hall when you had the chance."
msgstr ""

#. [&"malrik", "Someone burned my barracks, so I brought fewer friends. Petty, little ember. I approve."],
#: scripts/campaign/mission_02.gd:151 data/voice/lines/m02.json:L6b
