#. const SPEAKER_NAMES := {&"malrik": "Malrik", &"hush": "Mother Hush", &"obren": "Obren", &"shade": "Shade Capta
#: scripts/campaign/mission_e3_03.gd:85
msgid "Shade Captain"
msgstr ""

#. [&"narrator", "Duskbarrow. The city of the dead, where Malrik learned to read by tombstone light."],
#: scripts/campaign/mission_e3_03.gd:88
msgid "Duskbarrow. The city of the dead, where Malrik learned to read by tombstone light."
msgstr ""

#. [&"malrik", "Every vigil out at once. Someone has been very rude to my dead."],
#: scripts/campaign/mission_e3_03.gd:89
msgid "Every vigil out at once. Someone has been very rude to my dead."
msgstr ""

#. [&"shade", "Bishop. The barrows are stirring. The living are in the Great Crypt. All of them."],
#: scripts/campaign/mission_e3_03.gd:90
msgid "Bishop. The barrows are stirring. The living are in the Great Crypt. All of them."
msgstr ""

#. [&"malrik", "Then the living stay in the crypt, and the dead go back to bed."],
#: scripts/campaign/mission_e3_03.gd:91
msgid "Then the living stay in the crypt, and the dead go back to bed."
msgstr ""

#. [&"obren", "They are mine now, Bishop. Ask me nicely, and they kneel."],
#: scripts/campaign/mission_e3_03.gd:92
msgid "They are mine now, Bishop. Ask me nicely, and they kneel."
msgstr ""

#. [&"malrik", "You raised my dead, and now you sell me the shovel."],
#: scripts/campaign/mission_e3_03.gd:93
msgid "You raised my dead, and now you sell me the shovel."
msgstr ""

#. [&"obren", "Not sell. Lend. You will hardly notice the price."],
#: scripts/campaign/mission_e3_03.gd:94
msgid "Not sell. Lend. You will hardly notice the price."
msgstr ""

#. [&"malrik", "Sleep. You did your share of standing."],
#: scripts/campaign/mission_e3_03.gd:95
msgid "Sleep. You did your share of standing."
msgstr ""

#. [&"obren", "There. Was that so hard? Again, whenever you like."],
#: scripts/campaign/mission_e3_03.gd:96
msgid "There. Was that so hard? Again, whenever you like."
msgstr ""

#. [&"malrik", "Useful. Do not get comfortable in there."],
#: scripts/campaign/mission_e3_03.gd:97
msgid "Useful. Do not get comfortable in there."
msgstr ""

#. [&"obren", "Half yours, half mine. We share so nicely, you and I."],
#: scripts/campaign/mission_e3_03.gd:98
msgid "Half yours, half mine. We share so nicely, you and I."
msgstr ""

#. [&"obren", "MINE. Hold still. Let me look out of your eyes."],
#: scripts/campaign/mission_e3_03.gd:99
msgid "MINE. Hold still. Let me look out of your eyes."
msgstr ""

#. [&"malrik", "Out. OUT. I decide. I have always decided."],
#: scripts/campaign/mission_e3_03.gd:100
msgid "Out. OUT. I decide. I have always decided."
msgstr ""

#. [&"shade", "The Pauper's Field and the Bishops' Rest are open! Everything is walking!"],
#: scripts/campaign/mission_e3_03.gd:101
msgid "The Pauper's Field and the Bishops' Rest are open! Everything is walking!"
msgstr ""

#. [&"malrik", "Even the bishops. Of course even the bishops."],
#: scripts/campaign/mission_e3_03.gd:102
msgid "Even the bishops. Of course even the bishops."
msgstr ""

#. [&"malrik", "The dead are up, Hush. My dead."],
#: scripts/campaign/mission_e3_03.gd:103
msgid "The dead are up, Hush. My dead."
msgstr ""

#. [&"hush", "Then they can lie down again. I'll help them."],
#: scripts/campaign/mission_e3_03.gd:104
msgid "Then they can lie down again. I'll help them."
msgstr ""

#. [&"shade", "The crypt doors are cracking! The families are inside!"],
#: scripts/campaign/mission_e3_03.gd:105
msgid "The crypt doors are cracking! The families are inside!"
msgstr ""

#. [&"narrator", "Two barrows sleep. The stone does not like the quiet."],
#: scripts/campaign/mission_e3_03.gd:106
msgid "Two barrows sleep. The stone does not like the quiet."
msgstr ""

#. [&"obren", "Your father dug these graves, Bishop. Shall I show you what I built from his work?"],
#: scripts/campaign/mission_e3_03.gd:107
msgid "Your father dug these graves, Bishop. Shall I show you what I built from his work?"
msgstr ""

#. [&"obren", "Forty years he dug here. Let me give him a body."],
#: scripts/campaign/mission_e3_03.gd:108
msgid "Forty years he dug here. Let me give him a body."
msgstr ""

#. [&"malrik", "He had one. He wore it out honestly."],
#: scripts/campaign/mission_e3_03.gd:109
msgid "He had one. He wore it out honestly."
msgstr ""

#. [&"malrik", "That bell. He rang it every dusk. Stop wearing my father's bell."],
#: scripts/campaign/mission_e3_03.gd:110
msgid "That bell. He rang it every dusk. Stop wearing my father's bell."
msgstr ""

#. [&"hush", "Light it, Bishop. Just this once."],
#: scripts/campaign/mission_e3_03.gd:111
msgid "Light it, Bishop. Just this once."
msgstr ""

#. [&"malrik", "Not yet. Not while it is listening."],
#: scripts/campaign/mission_e3_03.gd:112
msgid "Not yet. Not while it is listening."
msgstr ""

#. [&"narrator", "The vigils burned again in Duskbarrow. In the Bishop's pocket, the stone kept count."],
#: scripts/campaign/mission_e3_03.gd:113
msgid "The vigils burned again in Duskbarrow. In the Bishop's pocket, the stone kept count."
msgstr ""

#. [&"malrik", "Bury me... somewhere quiet."],
#: scripts/campaign/mission_e3_03.gd:114
msgid "Bury me... somewhere quiet."
msgstr ""

#. [&"shade", "The crypt is open... the dead are among the living!"],
#: scripts/campaign/mission_e3_03.gd:115
msgid "The crypt is open... the dead are among the living!"
msgstr ""

#. "Duskbarrow keeps its dead the old way: a candle at every barrow door, lit at dusk by the gravediggers. Two ni
#: scripts/campaign/mission_e3_03.gd:118
msgid "Duskbarrow keeps its dead the old way: a candle at every barrow door, lit at dusk by the gravediggers. Two nights ago the candles went out, all four at once, and the dead stood up."
msgstr ""

#. "The living of the city have shut themselves inside the Great Crypt. The Bishop's Seat still stands above the 
#: scripts/campaign/mission_e3_03.gd:119
msgid "The living of the city have shut themselves inside the Great Crypt. The Bishop's Seat still stands above the Lantern Road. Malrik rode home through two nights to find his own dead walking toward his own people."
msgstr ""

#. "Light the vigils again and the dead will lie down. The stone in his pocket says there is a faster way. It is 
#: scripts/campaign/mission_e3_03.gd:120
msgid "Light the vigils again and the dead will lie down. The stone in his pocket says there is a faster way. It is very eager to show him."
msgstr ""

#. const BRIEFING_LINE := "Only Malrik can relight a vigil candle. Clear the barrow first."
