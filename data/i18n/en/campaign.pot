#. const MSG_HEART_BOUND := "The Winterheart is still frost-bound. Its frost breaks after the glass host comes (1
#: scripts/campaign/mission_e4_04.gd:177
msgid "The Winterheart is still frost-bound. Its frost breaks after the glass host comes (19:00)."
