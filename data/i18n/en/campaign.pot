#. [&"ysolde", "They say I was born the year nothing grew. I won't let there be two."],
#: scripts/campaign/mission_e6_03.gd:92 data/voice/lines/e6m3.json:L2
msgid "They say I was born the year nothing grew. I won't let there be two."
msgstr ""

#. [&"maelis", "Seed in the snow, little one? The whole village is laughing at you."],
#: scripts/campaign/mission_e6_03.gd:93 data/voice/lines/e6m3.json:L3
msgid "Seed in the snow, little one? The whole village is laughing at you."
msgstr ""

#. [&"ysolde", "My mother did it. In spring it came up green. Help me keep the wolves off."],
#: scripts/campaign/mission_e6_03.gd:94 data/voice/lines/e6m3.json:L4
msgid "My mother did it. In spring it came up green. Help me keep the wolves off."
msgstr ""

#. [&"maelis", "Fine. I'll take the well. The wolves always come to the well."],
#: scripts/campaign/mission_e6_03.gd:95 data/voice/lines/e6m3.json:L5
msgid "Fine. I'll take the well. The wolves always come to the well."
msgstr ""

#. [&"narrator", "When the sun went down, the frost bit through everything that was not covered."],
#: scripts/campaign/mission_e6_03.gd:96 data/voice/lines/e6m3.json:L6
msgid "When the sun went down, the frost bit through everything that was not covered."
msgstr ""

#. [&"ysolde", "Cover the gardens! Sit on them if you have to!"],
#: scripts/campaign/mission_e6_03.gd:97 data/voice/lines/e6m3.json:L7
msgid "Cover the gardens! Sit on them if you have to!"
msgstr ""

#. [&"maelis", "Wolves off the north ridge. Thin ones. Hungry ones."],
#: scripts/campaign/mission_e6_03.gd:98 data/voice/lines/e6m3.json:L8
msgid "Wolves off the north ridge. Thin ones. Hungry ones."
msgstr ""

#. [&"ysolde", "See? It fights back. Things that grow always fight back."],
#: scripts/campaign/mission_e6_03.gd:99 data/voice/lines/e6m3.json:L9
msgid "See? It fights back. Things that grow always fight back."
msgstr ""

#. [&"ysolde", "No. No, no. I'll plant it again. Next year. I will."],
#: scripts/campaign/mission_e6_03.gd:100 data/voice/lines/e6m3.json:L10
msgid "No. No, no. I'll plant it again. Next year. I will."
msgstr ""

#. [&"maelis", "Colder than last night. The river froze to the bottom."],
#: scripts/campaign/mission_e6_03.gd:101 data/voice/lines/e6m3.json:L11
msgid "Colder than last night. The river froze to the bottom."
msgstr ""

#. [&"ysolde", "Then we'll be warmer than the river."],
#: scripts/campaign/mission_e6_03.gd:102 data/voice/lines/e6m3.json:L12
msgid "Then we'll be warmer than the river."
msgstr ""

#. [&"narrator", "On the longest night, the pack's old leader came down from the ridge."],
#: scripts/campaign/mission_e6_03.gd:103 data/voice/lines/e6m3.json:L13
msgid "On the longest night, the pack's old leader came down from the ridge."
msgstr ""

#. [&"maelis", "Old Whitepelt. I've hunted him nine winters. He's never been this hungry."],
#: scripts/campaign/mission_e6_03.gd:104 data/voice/lines/e6m3.json:L14
msgid "Old Whitepelt. I've hunted him nine winters. He's never been this hungry."
msgstr ""

#. [&"maelis", "Nine winters. And a girl with a seed sack beats me to him."],
#: scripts/campaign/mission_e6_03.gd:105 data/voice/lines/e6m3.json:L15
msgid "Nine winters. And a girl with a seed sack beats me to him."
msgstr ""

#. [&"narrator", "And then, one grey morning, the snow began to turn to water."],
#: scripts/campaign/mission_e6_03.gd:106 data/voice/lines/e6m3.json:L16
msgid "And then, one grey morning, the snow began to turn to water."
msgstr ""

#. [&"master", "A sapling, coaxed through the frost. In this cold?"],
#: scripts/campaign/mission_e6_03.gd:107 data/voice/lines/e6m3.json:L17
msgid "A sapling, coaxed through the frost. In this cold?"
msgstr ""

#. [&"ysolde", "It wants to grow. It only needs someone to wait with it."],
#: scripts/campaign/mission_e6_03.gd:108 data/voice/lines/e6m3.json:L18
msgid "It wants to grow. It only needs someone to wait with it."
msgstr ""

#. [&"master", "Show me."],
#: scripts/campaign/mission_e6_03.gd:109 data/voice/lines/e6m3.json:L19
msgid "Show me."
msgstr ""

#. [&"master", "...Show me again."],
#: scripts/campaign/mission_e6_03.gd:110 data/voice/lines/e6m3.json:L20
msgid "...Show me again."
msgstr ""

#. [&"narrator", "She did. For twenty years, until he was gone."],
#: scripts/campaign/mission_e6_03.gd:111 data/voice/lines/e6m3.json:L21
msgid "She did. For twenty years, until he was gone."
msgstr ""

#. [&"ysolde", "I'm sorry... I couldn't keep them warm."],
#: scripts/campaign/mission_e6_03.gd:112 data/voice/lines/e6m3.json:L22
msgid "I'm sorry... I couldn't keep them warm."
msgstr ""

#. [&"ysolde", "Nothing grew. Nothing at all."],
#: scripts/campaign/mission_e6_03.gd:113 data/voice/lines/e6m3.json:L23
msgid "Nothing grew. Nothing at all."
msgstr ""

#. [&"maelis", "I'm fine! Bitten. Fine. Keep planting."],
#: scripts/campaign/mission_e6_03.gd:114 data/voice/lines/e6m3.json:L24
msgid "I'm fine! Bitten. Fine. Keep planting."
msgstr ""

#. [&"ysolde", "Twelve years ago he sent for me one last time. Torvald too. Only us."],
#: scripts/campaign/mission_e6_03.gd:115 data/voice/lines/c_e6_seed.json:L5
#: data/voice/lines/e6m3.json:L25
msgid "Twelve years ago he sent for me one last time. Torvald too. Only us."
msgstr ""

#. "Thirty-two winters ago. Evenmead remembers the year nothing grew: the year the frost never lifted, the year a
#: scripts/campaign/mission_e6_03.gd:118
msgid "Thirty-two winters ago. Evenmead remembers the year nothing grew: the year the frost never lifted, the year a girl was born on Lark Hill. Fifteen winters later, the frost has come back."
msgstr ""

#. "The village sleeps inside the Hollow Oak and eats its last seed corn. Ysolde does not. She has buried the see
#: scripts/campaign/mission_e6_03.gd:119
msgid "The village sleeps inside the Hollow Oak and eats its last seed corn. Ysolde does not. She has buried the seed in the snow, in four gardens across the hill, the way her mother did. The village laughs."
msgstr ""

#. "The wolves are not laughing. They have come down from the north ridge, thin and hungry, and they can smell se
#: scripts/campaign/mission_e6_03.gd:120
msgid "The wolves are not laughing. They have come down from the north ridge, thin and hungry, and they can smell seed under snow. Keep the gardens alive until spring."
msgstr ""

#. const HINT_START := "Move Spriglings onto a garden to tend it: a tended garden does not freeze at night and gr
#: scripts/campaign/mission_e6_03.gd:122
msgid "Move Spriglings onto a garden to tend it: a tended garden does not freeze at night and grows back. Tending Spriglings carry no seed home."
msgstr ""

#. const HINT_NIGHT := "Night is coming. Cover the gardens."
#: scripts/campaign/mission_e6_03.gd:123
msgid "Night is coming. Cover the gardens."
msgstr ""

#. const HINT_THICKET := "Call the Thicket (E) is ready: three Saplings at a point. Save it for the long night."
