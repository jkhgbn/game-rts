#. @export var artifact_name := "Ember Crown"
#: scripts/campaign/artifact.gd:9 scripts/campaign/ember_crown.gd:51 data/items/ember_crown.tres:8
msgid "Ember Crown"
msgstr ""

#. &"e8m2": ["L1", "L2", "L3", "L4", "L5", "L5b", "L6", "L7", "L8", "L10", "L11", "L12", "L13", "L14", "L15", "L1
