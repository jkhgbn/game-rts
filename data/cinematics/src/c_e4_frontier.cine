# Between-scene "The Wall", ~70 s (docs/design/script-episodes-4-8/e4m3.md, shot list F1-F9; beats from
# docs/design/mission-e4-03.md Cinematic hooks `c_e4_frontier`). Night in the Ice camp at the Heartglade's edge:
# Torvald kneels by the green shoot of e4m3_shoot ("Tell them I was looking at a weed."); Aldra: Malrik wants the Wall
# raised before the snow, "Then it will be raised. I gave my word."; the shoot alone in the snow. Emberwatch: Vessa and
# Ysolde over the map, the Wall of a Hundred Winters, "I'll bring the fire. You bring the patience." / "I'll bring a tree."
# Text source for i18n / voices: data/voice/lines/c_e4_frontier.json (the same text as the lines below).
# e4m3 / e4m4 are not built: not in CampaignState.STORY_FILMS yet (play it with run_cine.ps1 play c_e4_frontier).
# Sets: forge_intro_torvald stands in for the Ice camp at the Heartglade's edge (e4m3's map is not a stage set: its
# snow, its signal brazier and fx_snow; its prologue host / fx hidden; night = a blue full-screen grade);
# forge_watch_keep stands in for Emberwatch's war room (the c2_two_fronts war table, scale 1.4). Props: the green shoot
# (forge_ep4_memories/props/shoot_v2.tscn), Torvald's lantern (the ep2_ending rime lantern), the Heartwood Seed (the
# ep2 seed-pod prop).
# Axis: camp: Torvald (east, by the shoot) - Aldra (west); every camp camera stays on the lake side (+Z) of them,
# the keep behind them. War room: the c2_two_fronts rule, every camera north of the table.
cine c_e4_frontier  title="The Wall"  letterbox=2.39  seed=403  length=66..76
use set forge_intro_torvald
use music res://assets/audio/forge/music/ep4_opening.wav  vol=-24
env night  moon_yaw=200  moon_pitch=-30  energy=0.45  color=#9fb4ff
cast  aldra     res://art/units/helpers/helper_aldra/helper_aldra.tscn  at=(3.0, 0, 1.2)  yaw=70  hidden=1
cast  shoot     res://art/cinematics/stage_sets/forge_ep4_memories/props/shoot_v2.tscn  at=(7.6, 0.02, 6.6)  scale=1.8
cast  lantern   res://art/cinematics/props/ep2_ending/rime_lantern.tscn  at=(6.5, 0, 5.0)  yaw=0  scale=0.6
cast  ysolde    res://art/units/wizards/ysolde.tscn  at=(-8.6, 0, -0.7)  yaw=100  hidden=1
cast  seed      res://art/cinematics/props/ep2_between/seed_pod.tscn  at=(-7.2, 1.2, -1.1)  scale=1.4  hidden=1
prop  table     res://art/cinematics/props/ep3_between/war_map.tscn  at=(-7, 0, -1)  yaw=0  scale=1.4  set=forge_watch_keep

# ---------------------------------------------------------------- the Ice camp, night
# Wide, low, snow falling: Torvald alone, kneeling with a lantern by the green shoot
shot F1 8.0  cam=dolly  from=(1.0, 1.0, 10.5)  to=(2.0, 1.0, 9.8)  look=(7.4, 0.9, 5.6)  fov=42  in=fade_black:1.0
  at 0.0  fade color=#0d1430 alpha=0.6 time=0.05
  at 0.0  hide colossus
  at 0.0  hide frostbow
  at 0.0  hide messenger
  at 0.0  hide foe
  at 0.0  hide army_line
  at 0.0  hide army_charge
  at 0.0  hide fx_icewall
  at 0.0  hide fx_burst
  at 0.0  hide fx_cracks
  at 0.0  hide fx_heart
  at 0.0  teleport torvald  to=(7.4, 0, 5.4)  yaw=10
  at 0.0  anim torvald set_expression  arg=neutral
  at 0.0  sfx res://assets/audio/forge/sfx/snow_step.wav  vol=-20
# Aldra steps into the lantern light, chisel-staff on her shoulder
shot F2 9.0  cam=static  from=(9.6, 1.7, 9.4)  look=(6.6, 1.5, 4.8)  fov=40  faces=aldra,torvald
  at 0.0  show aldra
  at 0.0  move aldra  to=(6.0, 0, 4.4)  speed=1.2
  at 0.8  line aldra "Your captains are asking why we pulled back."  dur=3.6
  at 5.0  line torvald "Tell them I was looking at a weed."  dur=2.8
# CU Aldra: she looks at the shoot
shot F3 3.2  cam=static  from=(4.8, 1.75, 7.0)  look=aldra  fov=30
  at 0.0  teleport aldra  to=(6.0, 0, 4.4)  yaw=36
  at 0.4  line aldra "We could burn it again."  dur=2.2
# CU Torvald: he does not look up
shot F3B 2.8  cam=static  from=(6.9, 1.7, 8.0)  look=torvald  fov=30
  at 0.5  line torvald "No."  dur=1.2
# Two-shot: Torvald stands, lantern in hand; he lets the shoot be and walks back to the tents with her
shot F4 11.0  cam=dolly  from=(8.4, 1.8, 10.6)  to=(6.4, 1.8, 10.2)  look=(5.6, 1.5, 4.8)>(3.6, 1.5, 3.6)  fov=42  faces=aldra,torvald
  at 0.0  face torvald  to=aldra  time=0.6
  at 0.6  line aldra "Malrik's riders came at dusk. He wants the Wall raised before the snow."  dur=4.6
  at 0.6  anim torvald set_expression  arg=worried
  at 5.8  line torvald "Then it will be raised. I gave my word."  dur=3.0
  at 7.0  move torvald  to=(2.0, 0, 2.6)  speed=1.0
  at 7.2  move aldra  to=(1.4, 0, 3.4)  speed=1.0
  at 7.0  hide lantern
# Wide, static: the shoot alone in the snow; the lantern light leaves it
shot F5 4.0  cam=static  from=(9.4, 0.9, 9.6)  look=(7.6, 0.4, 6.6)  fov=34
  at 3.0  fade alpha=1 time=1.0

# ---------------------------------------------------------------- Emberwatch, the war room
# Over the map table, high: Vessa's finger traces the Wall across Torvald's frontier
shot F6 7.0  set=forge_watch_keep  cam=static  from=(-7.1, 3.3, -3.1)  look=(-7.5, 1.15, -0.8)  fov=46  in=fade_black:0.6
  at 0.0  fade color=#000000 alpha=0 time=0.3
  at 0.0  hide guard_w
  at 0.0  hide aldra
  at 0.0  hide shoot
  at 0.0  show ysolde
  at 0.0  teleport vessa  to=(-7, 0, 0.05)  yaw=180
  at 0.0  anim vessa play_cast
  at 0.6  line vessa "He's raising the Wall of a Hundred Winters. Every pass on his frontier."  dur=4.4
# Two-shot: Ysolde sets the seed on the map, on the Wall's line
shot F7 12.0  set=forge_watch_keep  cam=dolly  from=(-5.0, 2.3, -3.3)  to=(-5.8, 2.3, -3.5)  look=(-7.6, 1.3, -0.5)  fov=42  faces=vessa,ysolde
  at 0.0  anim ysolde set_expression  arg=neutral
  at 0.4  line ysolde "When the snow closes them, the north feeds Malrik's war all winter. Out of reach."  dur=5.0
  at 0.4  anim ysolde play_cast
  at 1.2  show seed
  at 1.2  sfx res://assets/audio/forge/sfx/sapling_creak.wav  vol=-16
  at 6.2  line vessa "So we break it before the first blizzard. A week, Ashby says. Maybe less."  dur=4.4
# CU Vessa, grinning
shot F8 6.0  set=forge_watch_keep  cam=static  from=(-6.55, 1.8, -2.5)  look=vessa  fov=30
  at 0.0  anim vessa set_expression  arg=smile
  at 0.4  line vessa "I'll bring the fire. You bring the patience."  dur=3.0
# CU Ysolde, dead serious
shot F9 7.0  set=forge_watch_keep  cam=static  from=(-7.7, 1.85, -2.7)  look=ysolde  fov=30
  at 0.0  anim ysolde set_expression  arg=neutral
  at 0.5  line ysolde "I'll bring a tree."  dur=1.8
  at 5.8  fade alpha=1 time=1.2
