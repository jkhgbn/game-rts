# e8m3 E1: the King rises out of the pit, chains snap taut (mission-e8-03.md 8.1).
# Lines from data/voice/lines/e8m3.json; the mission's end state says them again (shown once). Fallback: the end state.
cine e8m3_king  title="The Hollow King"  mode=pause  letterbox=2.39  seed=861  length=31..38
env dusk  moon_yaw=120  moon_pitch=-30  energy=0.9
cast  narrator  capsule  at=(0, 0, -300)  hidden=1
cast  obren  capsule  at=(10, 0, -300)  hidden=1
cast  vey  capsule  at=(20, 0, -300)  hidden=1
cast  vessa  capsule  at=(30, 0, -300)  hidden=1
cast  torvald  capsule  at=(40, 0, -300)  hidden=1
cast  malrik  capsule  at=(50, 0, -300)  hidden=1

shot S1 11.4  cam=static  from=(0, 26, 10)  look=(0, 2, 0)  fov=52  in=fade_black:0.3
  at 0.2  line narrator "The last thing Obren ever built climbed out of the dark, and it was wearing his throne."
  at 5.6  line obren "A thousand years he held it. A hundred I lay under it. Now I hold everything."
shot S2 6.0  cam=static  from=(-12, 3, 26)  look=(0, 6, 0)  fov=40
  at 0.2  line vey "Chains on every limb. The keys are holding him. Keep the keys standing, and he stays bound."
shot S3 11.4  cam=static  from=(4, 4, 8)  look=(0, 6, 0)  fov=34
  at 0.2  line vessa "So we hit him when the chains pull. And we don't let go. I can do that. Probably."
  at 5.6  line torvald "Hold the line. Ice knows how. The rest of you, copy me."
shot S4 6.0  cam=static  from=(-14, 1.9, 22)  look=(-17.5, 1.5, 17.5)  fov=32
  at 0.2  line malrik "Four people who hate each other, holding one rope. What could possibly go wrong."
