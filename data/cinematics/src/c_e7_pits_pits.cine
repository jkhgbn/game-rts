# Between-scene "The Year Comes Round" (PITS take: the second take of c_e7_pits), ~70 s (docs/design/script-episodes-4-8/e7m3.md, shot list
# P1-P10; beats from docs/design/mission-e7-03.md Cinematic hooks `c_e7_pits`, two Ossavar takes). Night in the Hall of
# Silence: Malrik asks the Diamond Archon to empty the dragon pits ("By morning every dragon on the Coinwater is ours." /
# "An Archon before me did that once. The Year of Two Skies."); she seals the order; pre-dawn on the Outwall roofs,
# Torvald and Aldra watch the Hall's lamps; Ossavar lowers his head to Torvald. This is the PITS take (e7m3_pits and
# not e7m3_people: "You guarded stones. Everyone guards stones." and he lifts off at once; Torvald opens his mouth and
# says nothing); the PEOPLE take is c_e7_pits.
# Text source for i18n / voices: data/voice/lines/c_e7_pits.json (L1-L7, L8b, L10-L11).
# e7m3 / e7m4 are not built: not in CampaignState.STORY_FILMS yet; picking the take needs a StoryFlow film-by-flag
# pick (not built). Play it with run_cine.ps1 play c_e7_pits_pits.
# Sets (stand-ins; forge_adamarch / adamarch_outwall are not built): forge_citadel's orrery dome under a night grade =
# the Hall of Silence (its Master / swordsman puppets hidden; the c_e3 camp table + art/cinematics/props/ep7_between/
# diamond_heap.tscn); forge_watch_keep's front curtain wall = the Outwall roof ridge, its keep = the lit Hall above the
# white wall. Stand-ins: the Diamond Archon = the Mage-Archer champion, the Facetguards = two Oathwall champions,
# Ossavar = the cinder dragon titan (static cameras only).
# Axis: the Hall: the Archon (north of the table) - Malrik (south-east); cameras east of them. The roof: every camera
# north of the wall, facing Torvald and Aldra.
cine c_e7_pits_pits  title="The Year Comes Round"  letterbox=2.39  seed=705  length=67..73
use set forge_citadel
use music res://assets/audio/music/music_menu.wav  vol=-24
cast  narrator   capsule  at=(0, 0, -300)  hidden=1  speaker=ossavar
cast  diamond_archon  res://art/units/champions/mage_archer/mage_archer.tscn  at=(-12.0, 48, -0.2)  yaw=0  set=forge_citadel
cast  malrik     res://art/units/wizards/malrik.tscn  at=(-10.6, 48, 1.6)  yaw=-120  set=forge_citadel
cast  fguard1    res://art/units/champions/oathwall/oathwall.tscn  at=(-15.6, 48, 0.4)  yaw=90  set=forge_citadel
cast  fguard2    res://art/units/champions/oathwall/oathwall.tscn  at=(-9.0, 48, -2.4)  yaw=-90  set=forge_citadel
prop  table      res://art/cinematics/props/ep3_between/war_map.tscn  at=(-12.0, 48, 0.8)  yaw=0  set=forge_citadel
prop  diamonds   res://art/cinematics/props/ep7_between/diamond_heap.tscn  at=(-11.9, 48.85, 0.75)  set=forge_citadel
cast  torvald    res://art/units/wizards/torvald.tscn  at=(5.0, 4.5, 2.0)  yaw=180  set=forge_watch_keep
cast  aldra      res://art/units/helpers/helper_aldra/helper_aldra.tscn  at=(6.3, 4.5, 2.0)  yaw=190  set=forge_watch_keep
cast  ossavar    res://art/units/titans/cinder_dragon/cinder_dragon.tscn  at=(1.4, 4.5, 2.4)  yaw=150  set=forge_watch_keep

# ---------------------------------------------------------------- the Hall of Silence
# Wide, slow dolly down the hall: white marble, crown windows, Facetguards motionless along the walls
shot P1 8.0  cam=dolly  from=(-13.4, 50.6, 4.4)  to=(-13.2, 50.0, 3.4)  look=(-12, 48.8, 0)  fov=50  in=fade_black:1.0  faces=diamond_archon
  at 0.0  fade color=#0b0c26  alpha=0.4  time=0.05
  at 0.0  hide master
  at 0.0  hide swordsman
  at 1.5  line ossavar "The Hall of Silence, where they teach one word a day. Malrik brought more."  dur=6.0
# MS, 3/4, the table between them: the Archon in white, still; Malrik lets diamonds run through his fingers
shot P2 8.0  cam=static  from=(-12.8, 49.6, 3.4)  look=(-11.4, 49.2, 0.6)  fov=44  faces=diamond_archon,malrik
  at 0.0  anim malrik set_expression  arg=smile
  at 0.6  anim malrik play_cast
  at 1.0  line malrik "Empty the pits, Your Radiance. All of them."  dur=3.2
  at 4.4  line malrik "By morning every dragon on the Coinwater is ours."  dur=3.4
# CU the Archon, front: she does not move for two seconds, then answers
shot P3 8.0  cam=static  from=(-11.8, 49.3, 2.2)  look=diamond_archon  fov=30
  at 2.0  line diamond_archon "An Archon before me did that once. The Year of Two Skies."  dur=4.8
# CU Malrik: he holds a diamond up to the lamp; an amber pulse answers from his other hand
shot P4 6.0  cam=static  from=(-11.2, 49.75, 0.4)  look=malrik  fov=30
  at 0.4  vfx gem  scene=res://art/cinematics/fx/ice_burst.tscn  at=(-10.9, 49.6, 1.2)  life=1.6  scale=0.06
  at 0.8  line malrik "Then let us call it a tradition."  dur=2.6
  at 2.6  vfx pulse  scene=res://art/cinematics/stage_sets/forge_ep3_memories/props/heart_pulse.tscn  at=(-10.5, 49.0, 1.3)  life=2.4  scale=0.3
# ECU the table: the Archon's white-gloved hand presses her seal into white wax on the order
shot P5 5.0  cam=static  from=(-11.6, 49.35, 1.5)  look=(-12.0, 48.86, 0.8)  fov=26
  at 2.0  sfx res://assets/audio/forge/sfx/stone_thump.wav  vol=-18
  at 2.4  line diamond_archon "Yes."  dur=1.4

# ---------------------------------------------------------------- the Outwall roofs, pre-dawn
# Wide: Torvald and Aldra on a roof ridge; above the white wall the Hall's windows are still lit
shot P6 7.0  set=forge_watch_keep  cam=static  from=(9.0, 6.4, -4.0)  look=(5.4, 5.4, 2.0)  fov=46  in=fade_black:0.6  faces=torvald,aldra
  at 0.0  fade color=#1a2440  alpha=0.35  time=0.05
  at 0.0  hide vessa
  at 0.0  hide guard_w
  at 0.0  hide guard_e
  at 0.0  hide ossavar
  at 2.0  line aldra "The Hall's lamps are still lit, my lord. Someone is signing something."  dur=4.6
# MS three-shot: Ossavar on the ridge beside them lowers his head to Torvald's height
shot P7 8.0  set=forge_watch_keep  cam=static  from=(8.0, 5.8, -5.2)  look=(4.0, 5.6, 2.0)  fov=50  faces=torvald,aldra
  at 0.0  show ossavar
  at 1.2  line ossavar "You guarded stones. Everyone guards stones."  dur=4.0
  at 5.4  move ossavar  to=(-30, 30, 40)  speed=12
# CU Torvald, 3/4: Ossavar is already gone; Torvald opens his mouth and says nothing
shot P8 7.0  set=forge_watch_keep  cam=static  from=(6.0, 6.3, 0.2)  look=torvald  fov=30
  at 0.0  anim torvald set_expression  arg=neutral
  at 0.0  hide ossavar
  at 2.0  anim torvald set_expression  arg=worried
# Wide, the roofs: the ridge is empty beside them; Aldra turns to Torvald
shot P9 7.0  set=forge_watch_keep  cam=static  from=(10.0, 7.0, -7.0)  look=(4.0, 6.0, 2.0)  fov=52  faces=torvald,aldra
  at 1.0  line aldra "Will you ask him, my lord?"  dur=2.2
  at 1.4  face aldra  to=torvald  time=0.6
  at 4.2  line torvald "Tomorrow."  dur=1.6
# Wide crane up: a grey dawn line over the strait; every lamp on the Admiralty lit
shot P10 6.0  set=forge_watch_keep  cam=crane  from=(10, 8, -6)  to=(22, 30, 24)  look=(4, 5, 2)>(-10, 2, 40)  fov=46>52
  at 0.0  hide ossavar
  at 0.0  fade color=#8a9ab8  alpha=0.25  time=1.0
  at 5.0  fade color=#000000  alpha=1  time=1.0
