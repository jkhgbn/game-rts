# e5m3 E16 "e5m3_found" (docs/design/mission-e5-03.md, Cinematic hooks; script-episodes-4-8/e5m3.md 1): 45 s, then the
# victory. mode=pause over the live mission. 1) MS the Reeve on his knees on the porch (orbits the live `reeve`), the
# lantern rolling away (townsfolk and the freed father are not actors yet); 2) WIDE over the square from the east; 3) WS
# among the graves: the boy, and behind him the very tall shadow with the burning hem (the Master is not in the
# mission: his voice over the boy, a warm flare at the frame edge): L20-L22; 4) CU the boy looking up: L23; 5) STATIC CU:
# he pinches out his candle, calm in the dark: L24; FADE_BLACK. The boy's shots orbit the live hero (tag `malrik`); the
# cast stands on the porch for cine's checks. Axis: the boy - Master line north-south; every camera on its EAST side.
# Fallback: the end state says L20-L24, then the victory.
cine e5m3_found  title="This One, Too"  mode=pause  letterbox=2.39  seed=532  length=43..47
env night  moon_yaw=200  moon_pitch=-30  energy=0.35
cast  malrik    res://art/units/wizards/malrik.tscn  at=(1, 0, 9)  yaw=180
cast  reeve     res://art/units/fire/flame_guard.tscn  at=(0, 0, 4)  yaw=0
cast  narrator  capsule  at=(0, 0, -300)  hidden=1
cast  master    capsule  at=(0, 0, -310)  hidden=1

# MS the Reeve on his knees on the porch, his lantern rolling away
shot F1 6.0  cam=orbit  pivot=reeve  r=4.5  h=1.2  deg=20>32  in=fade_black:0.6
  at 0.3  sfx res://assets/audio/sfx/building_hit.wav  vol=-14
# WIDE over the square from the east: the windows lit, the boy turning away
shot F2 6.0  cam=crane  from=(22, 10, 14)  to=(18, 8, 12)  look=(0, 2, 6)>(0, 1.5, 8)  fov=46>42
  at 0.2  sfx res://assets/audio/forge/sfx/evenmead_amb.wav  vol=-14
# WS the boy among the graves; the tall shadow behind him (a warm flare at the edge of frame)
shot F3 16.0  cam=orbit  pivot=malrik  r=6.0  h=1.6  deg=10>20
  at 0.4  line malrik "You're not one of the Reeve's. Who are you? ...You're very tall."
  at 0.6  fade color=#ffd48a alpha=0.18 time=2.0
  at 5.6  line master "Reading tombstones by one candle, at midnight. And they told you everything."
  at 11.2  line malrik "The dead don't lie. They've got nothing left to want."
# CU the boy looking up
shot F4 6.0  cam=orbit  pivot=malrik  r=2.0  h=1.3  deg=-10>-4  fov=32
  at 0.6  line master "This one, too."
  at 0.6  fade color=#000000 alpha=0.0 time=0.8
# STATIC CU: he pinches out his candle; in the dark he is calm, almost smiling; FADE_BLACK
shot F5 11.0  cam=orbit  pivot=malrik  r=2.2  h=1.5  deg=15>17  fov=34
  at 0.4  line narrator "He pinched out his candle. In the dark, he was not afraid. He never had been."
  at 6.5  fade alpha=1 time=2.0