# e7m2 E11 "e7m2_herald" (docs/design/mission-e7-02.md, Cinematic hooks): mode=pause when the herald's clue is read.
# 1) MS behind a beached bettors' boat: the herald cowering, ledger pages blowing (L13); 2) CU the herald; 3) OTS herald
# on Torvald, 3/4 (L14-L15). Axis: the herald - Torvald line; every camera on its WEST side.
# Fallback: the end state says L13-L15; the herald stays put.
cine e7m2_herald  title="The Herald"  mode=pause  letterbox=2.39  seed=722  length=13..19
env day  moon_yaw=210  moon_pitch=-34  energy=0.9
cast  herald   capsule  at=(0, 0, -300)  hidden=1
cast  torvald  capsule  at=(0, 0, -310)  hidden=1

# MS behind a beached boat: the herald cowering
shot H1 5.4  cam=static  from=(21, 2.0, 38)  look=(26, 0.8, 35.5)  fov=38  in=fade_black:0.3
  at 0.2  line herald "Don't hurt me! I only read the names! I saw the boat, a black boat, from the north side!"
# OTS herald on Torvald
shot H2 3.0  cam=static  from=(23, 1.7, 37)  look=(26, 1.5, 33)  fov=32
  at 0.2  line torvald "Easy. Who stepped out of it?"
# CU the herald
shot H3 5.6  cam=static  from=(23.5, 1.4, 36.5)  look=(26, 1.0, 35.5)  fov=28
  at 0.2  line herald "A woman in a white mask. She never said a word. The knives followed her like ducklings."
