# m02 E10 "m2_heartfrost" "A Hundred Winters" (docs/design/mission-02.md, Cinematic hooks; ep1 7.2: 3 shots): ~11 s,
# mode=pause over the live mission. 1) CU the Heartfrost at the centre (0, 0) cracking, light through the ice; 2) the
# burst: a white-blue flash and a freeze wave (the mission's own burst + orb float run in the end state, after the film);
# 3) MS Vessa (orbit on the live hero `vessa`, L9). The end state says L9 once: the film's subtitle is not repeated.
cine m2_heartfrost  title="A Hundred Winters"  mode=pause  letterbox=2.39  seed=62  length=9..13
env day  moon_yaw=200  moon_pitch=-30  energy=0.9
cast  vessa  res://art/units/wizards/vessa.tscn  at=(-4, 0, 6)  yaw=150

# CU the Heartfrost cracking, light through the ice
shot H1 3.5  cam=dolly  from=(3.2, 1.8, 4.2)  to=(2.6, 1.6, 3.4)  look=(0, 1.2, 0)>(0, 1.0, 0)  fov=36>32  in=fade_black:0.4
  at 0.3  sfx res://assets/audio/forge/sfx/ice_creak.wav  vol=-4
  at 1.6  sfx res://assets/audio/forge/sfx/ice_creak.wav  vol=-2
# The burst: a white-blue flash, the freeze wave rolling out
shot H2 3.0  cam=dolly  from=(9, 5, 10)  to=(10, 6, 11.5)  look=(0, 1, 0)>(0, 1.2, 0)  fov=46>50
  at 0.2  vfx burst  scene=res://art/cinematics/fx/ice_burst.tscn  at=(0, 1, 0)  life=2.6  scale=1.6
  at 0.2  vfx wave  scene=res://art/cinematics/fx/freeze_wave.tscn  at=(0, 0.1, 0)  life=2.6  scale=2.0
  at 0.2  sfx res://assets/audio/sfx/building_collapse.wav  vol=-4
  at 0.2  fade color=#bfeaff alpha=0.55 time=0.15
  at 0.6  fade color=#bfeaff alpha=0 time=1.2
  at 0.2  shake 0.5
# MS Vessa
shot H3 5.0  cam=orbit  pivot=vessa  r=3.8  h=1.6  deg=40>55
  at 0.2  line vessa "A hundred winters of ice, and it took me one afternoon. Somebody write that down."
  at 4.4  fade alpha=1 time=0.6
