# e3m1 E10 "e3m1_standard" (docs/design/mission-e3-01.md, Cinematic hooks): ~13 s (spec 0:10, stretched so L15-L17
# fit at <= 17 chars/s), mode=pause over the live mission. Ysolde's Standard (1.5, 21.5) tips into the flowers (the
# mission's own topple tween), then the N12 mark reversed: a long lens from the standard's base up Lark Hill to the
# golden tree (-16, 48.5), the heart-stone pulsing soft in the foreground. Axis: cameras east of the Malrik - Ysolde line.
# Map points only (no actor-tracked camera: the standard is a zone prop). Lines: L15-L17 (mission DIALOGUE).
cine e3m1_standard  title="Ysolde's Standard"  mode=pause  letterbox=2.39  seed=32  length=11..15
env day  moon_yaw=210  moon_pitch=-30  energy=0.9
# speakers (off camera stand-ins; Obren is the voice in the stone, named on the subtitles like in the mission)
cast  obren    capsule  at=(0, 0, -300)
cast  torvald  res://art/units/wizards/torvald.tscn  at=(30, 0, -36)  yaw=180
cast  malrik   res://art/units/wizards/malrik.tscn   at=(4, 0, 15)  yaw=200

# MS the standard: it tips, the green banner falls into the flowers
shot T1 4.5  cam=dolly  from=(7.5, 1.9, 18.0)  to=(6.8, 1.7, 18.6)  look=(1.5, 1.8, 21.5)>(1.2, 0.7, 22.3)  fov=38>36  in=fade_black:0.5
  at 0.2  sfx res://assets/audio/sfx/building_collapse.wav  vol=-10
  at 0.4  line obren "The flag falls. The tree is right there. Take it. TAKE it."
  at 0.4  sfx res://assets/audio/forge/sfx/obren_whisper.wav  vol=-10
# Long lens from the standard's base up Lark Hill to the golden tree; the stone beats in Malrik's hand, soft, close
shot T2 8.5  cam=dolly  from=(4.6, 1.3, 17.2)  to=(4.4, 1.35, 17.5)  look=(-14.0, 3.0, 47.0)>(-16.0, 3.4, 48.5)  fov=22>20
  at 0.3  line torvald "Malrik. Your hand is shaking. Is that you, or the stone?"
  at 0.3  vfx heart  scene=res://art/cinematics/stage_sets/forge_ep3_memories/props/heart_pulse.tscn  at=(3.9, 1.05, 18.2)  life=8.0  scale=0.45
  at 0.6  sfx res://assets/audio/forge/sfx/stone_thump.wav  vol=-9
  at 4.8  line malrik "It is me, Torvald. It has always been me."
  at 5.0  sfx res://assets/audio/forge/sfx/stone_thump.wav  vol=-8
  at 7.9  fade alpha=1 time=0.6
