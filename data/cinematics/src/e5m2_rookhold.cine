# e5m2 E1 "e5m2_rookhold" (docs/design/mission-e5-02.md, Cinematic hooks; script-episodes-4-8/e5m2.md 1): 15 s at 0:00,
# mode=pause over the live mission (the spec's HOLD runs as PAUSE). Rookhold (120 x 120, seed 5102): the field camp
# (-40, -40), Vessa's start (-32, -32), Ashby 2 m east; the Causeway (-26, -26) -> (22, 22) through the reed fields Near
# Reeds (-14, -12), Heron Pools (2, 2), Gatereeds (12, 13); the palisade ring around (34, 34), the Rook Gate (22, 22),
# the towers (21, 31) / (31, 21).
# 1) LOW over the reeds at Heron Pools (no heron actor yet: a reed rustle), the camera rising toward Rookhold's black
# palisade and its two towers: L1; 2) MS Vessa (15) and Ashby at the camp edge, 3/4 from the west (orbits the live
# hero, tag `vessa`; the cast stands at the start for cine's checks). Axis: the Vessa - Ashby line north-south; every
# camera on its WEST side. Fallback: the end state says L1-L4 and shows the first hint.
cine e5m2_rookhold  title="Rookhold"  mode=pause  letterbox=2.39  seed=511  length=13..17
env day  moon_yaw=200  moon_pitch=-55  energy=0.85
cast  vessa     res://art/units/wizards/vessa.tscn       at=(-32, 0, -32)  yaw=135
cast  ashby     res://art/units/fire/flame_guard.tscn    at=(-30, 0, -32)  yaw=135
cast  narrator  capsule  at=(0, 0, -300)  hidden=1

# LOW over the Heron Pools reeds, rising toward the black palisade
shot K1 8.0  cam=crane  from=(-6, 1.4, -4)  to=(0, 6, 0)  look=(8, 1, 8)>(30, 3, 30)  fov=44>38  in=fade_black:0.6
  at 0.0  sfx res://assets/audio/forge/sfx/evenmead_amb.wav  vol=-10
  at 0.5  line narrator "Three summers on, the reivers built a fort in the fens. Vessa was sent to knock."
# MS Vessa and Ashby at the camp edge, 3/4 from the west
shot K2 7.0  cam=orbit  pivot=vessa  r=5.0  h=1.4  deg=200>190
  at 0.4  sfx res://assets/audio/forge/sfx/army_armour.wav  vol=-16
  at 6.4  fade alpha=1 time=0.6