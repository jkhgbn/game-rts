# Episode 7 ending "No. Not for Now.", ~70 s, the title inside the last shot (docs/design/script-episodes-4-8/e7m4.md,
# shot list N1-N10; beats from docs/design/mission-e7-04.md Cinematic hooks `ep7_ending` + Reward `ossavar_ring`,
# campaign-outline.md 3.7). Dawn on a Coinwater turned to glass: galleys frozen at angles, dragons on the ice with heads
# bowed; Torvald walks out to Malrik's frozen galley ("So. No." / "No. Not for now. Not ever." / "We will see who waits
# longer, Torvald."), Malrik steps back into the shadow of his hull and is gone; Dacian and Seraphine share one flask on
# the arena rim beside the empty chair; Ossavar slips the gold ring off his broken horn and drops it at Torvald's feet
# ("The one price I ever gave back."), then flies north; the title card.
# Text source for i18n / voices: data/voice/lines/ep7_ending.json (the same text as the lines below).
# e7m4 is not built: not in CampaignState.STORY_FILMS yet (play it with run_cine.ps1 play ep7_ending).
# Sets (stand-ins; forge_tollrock and its frozen-sea variant are not built): forge_intro_torvald's frozen lake = the
# glass Coinwater (its signal brazier = the Tollrock light; landmark barges = the frozen galleys; the frost / cinder
# dragon titans on the ice); forge_intro_vessa = the Tollrock arena (the ep7_opening convention: the stone chair).
# Props: art/cinematics/props/ep7_between/gold_ring.tscn, stone_chair.tscn. Stand-ins: Dacian = the Coin-Cutter,
# Seraphine = the Oathwall champion, Ossavar = the cinder dragon titan (static cameras only: it bobs in real time).
# Axis: Torvald (south-west, on the ice) - Malrik (north-east, on the galley's bow); every camera stays east of them.
cine ep7_ending  title="Episode 7: Gold for Fire"  letterbox=2.39  seed=706  length=67..73
use set forge_intro_torvald
use music res://assets/audio/music/music_menu.wav  vol=-20
cast  narrator   capsule  at=(0, 0, -300)  hidden=1  speaker=ossavar
cast  aldra      res://art/units/helpers/helper_aldra/helper_aldra.tscn  at=(-7.2, 0, 4.8)  yaw=70  set=forge_intro_torvald
cast  malrik     res://art/units/wizards/malrik.tscn  at=(6.6, 1.2, 10.2)  yaw=-125  set=forge_intro_torvald
cast  hstone     res://art/cinematics/stage_sets/forge_ep3_memories/props/heart_stone_hand.tscn  at=(6.2, 2.25, 9.8)  set=forge_intro_torvald
cast  galley     res://art/environment/landmarks/barge.tscn  at=(7.0, 0, 10.6)  yaw=35  set=forge_intro_torvald
cast  galley2    res://art/environment/landmarks/barge.tscn  at=(-12.0, 0, 11.0)  yaw=-20  set=forge_intro_torvald
cast  frostd     res://art/units/titans/frost_dragon/frost_dragon.tscn  at=(-6.0, 0, 13.4)  yaw=170  set=forge_intro_torvald
cast  cinderd    res://art/units/titans/cinder_dragon/cinder_dragon.tscn  at=(17.0, 0, 12.0)  yaw=-150  set=forge_intro_torvald
cast  ring       res://art/cinematics/props/ep7_between/gold_ring.tscn  at=(4.6, 2.2, 7.4)  set=forge_intro_torvald  hidden=1
prop  chair      res://art/cinematics/props/ep7_between/stone_chair.tscn  at=(-9.5, 0, 7)  yaw=90  set=forge_intro_vessa
cast  dacian     res://art/units/champions/coin_cutter/coin_cutter.tscn  at=(-8.2, 0, 5.4)  yaw=100  set=forge_intro_vessa
cast  seraphine  res://art/units/champions/oathwall/oathwall.tscn  at=(-8.2, 0, 8.6)  yaw=80  set=forge_intro_vessa
cast  ossavar    res://art/units/titans/cinder_dragon/cinder_dragon.tscn  at=(-12.0, 0, 7.0)  yaw=90  hidden=1

# ---------------------------------------------------------------- the glass sea at dawn
# Wide crane down: the strait turned to glass; galleys frozen at angles; dragons on the ice, heads bowed; the light burns
shot N1 9.0  cam=crane  from=(22, 18, 30)  to=(14, 8, 22)  look=(2, 0.6, 8)>(3, 0.8, 8)  fov=50>42  in=fade_white:1.0
  at 0.0  fade color=#ffe9c0  alpha=0.12  time=0.05
  at 0.0  hide colossus
  at 0.0  hide frostbow
  at 0.0  hide messenger
  at 0.0  hide foe
  at 0.0  hide army_line
  at 0.0  hide army_charge
  at 0.0  hide fx_icewall
  at 0.0  hide fx_burst
  at 0.0  hide fx_heart
  at 0.0  hide fx_snow
  at 0.0  show fx_cracks
  at 0.0  teleport torvald  to=(-6.2, 0, 5.4)  yaw=70
  at 0.0  vfx light  scene=res://art/cinematics/fx/fire_burst.tscn  at=(-3.8, 1.4, -1.6)  life=60  scale=0.25
  at 1.5  line ossavar "Dawn came up on a sea that did not move. The second time in my long life."  dur=6.2
# MLS tracking beside them: Torvald walks out across the glass toward the silver galley; Aldra a step behind
shot N2 7.0  cam=dolly  from=(-3.6, 1.4, 10.6)  to=(2.0, 1.4, 12.2)  look=(-4.4, 1.2, 5.6)>(3.2, 1.2, 8.0)  fov=42  faces=torvald
  at 0.0  move torvald  to=(3.6, 0, 8.0)  speed=1.5
  at 0.3  move aldra  to=(2.4, 0, 7.2)  speed=1.5
  at 0.0  sfx res://assets/audio/forge/sfx/snow_step.wav  vol=-18
# MS, low, up at the bow: Malrik at the rail, the heart-stone dim in his hand; he looks down at Torvald
shot N3 6.0  cam=static  from=(4.6, 0.5, 7.6)  look=(6.6, 2.8, 10.2)  fov=44  faces=malrik
  at 0.0  teleport torvald  to=(3.6, 0, 8.0)  yaw=50
  at 0.0  teleport aldra  to=(2.4, 0, 7.2)  yaw=50
  at 0.0  anim malrik set_expression  arg=neutral
  at 2.0  line malrik "So. No."  dur=1.8
# CU Torvald, 3/4, from below: his breath frosts; he does not look away
shot N4 6.0  cam=static  from=(5.8, 1.3, 9.0)  look=(3.6, 2.0, 8.0)  fov=34  faces=torvald
  at 0.0  anim torvald set_expression  arg=fierce
  at 0.4  vfx breath  scene=res://art/cinematics/fx/ice_burst.tscn  at=(3.9, 1.95, 8.3)  life=1.2  scale=0.05
  at 1.0  line torvald "No. Not for now. Not ever."  dur=3.0
# CU Malrik, then: a thin smile; he steps back into the shadow of his hull, and the shadow is empty
shot N5 8.0  cam=static  from=(5.0, 2.4, 8.2)  look=malrik  fov=34
  at 0.2  anim malrik set_expression  arg=smile
  at 0.8  line malrik "We will see who waits longer, Torvald."  dur=3.2
  at 4.4  move malrik  to=(7.6, 1.2, 11.6)  speed=0.8
  at 5.4  vfx shroud  scene=res://art/cinematics/fx/umbral_shroud.tscn  at=(7.6, 2.0, 11.6)  life=2.2
  at 5.6  sfx res://assets/audio/sfx/spell_umbral_shroud.wav  vol=-10
  at 6.0  hide malrik
  at 6.0  hide hstone

# ---------------------------------------------------------------- the arena rim
# Wide: Dacian and Seraphine on the rim beside the empty chair, sharing water from one flask; neither speaks
shot N6 7.0  set=forge_intro_vessa  cam=static  from=(2.4, 2.0, 7.0)  look=(-8.8, 1.3, 7.0)  fov=44  in=blend:0.5  faces=dacian,seraphine
  at 0.0  hide vessa
  at 0.0  hide vessa_young
  at 0.0  hide guard
  at 0.0  hide scorchbow
  at 0.0  hide adept
  at 0.0  hide army_host
  at 0.0  hide army_fallen
  at 0.0  hide fx_pillar
  at 0.0  hide fx_columns
  at 0.0  hide fx_embers
  at 0.0  hide fx_volley
  at 2.0  anim dacian play_cast
  at 4.4  anim seraphine play_cast
# MS Ossavar on the chair: he rises; with one claw he slips the gold ring off his broken horn
shot N7 6.0  set=forge_intro_vessa  cam=static  from=(-2.0, 2.4, 11.0)  look=(-11.0, 3.4, 7.0)  fov=46
  at 0.0  show ossavar
  at 2.4  vfx glint  scene=res://art/cinematics/fx/sun_pillar.tscn  at=(-10.6, 4.6, 7.0)  life=0.6  scale=0.08

# ---------------------------------------------------------------- the ring
# CU on the ice: the gold ring drops on the glass at Torvald's feet and rings; Torvald picks it up
shot N8 6.0  cam=static  from=(6.0, 0.8, 6.4)  look=(4.4, 0.3, 7.6)  fov=36  in=blend:0.4
  at 0.0  hide ossavar
  at 0.0  show ring
  at 0.2  move ring  to=(4.6, 0.02, 7.4)  speed=5
  at 0.6  sfx res://assets/audio/forge/sfx/knife_ring.wav  vol=-10
  at 1.5  line ossavar "The one price I ever gave back."  dur=3.0
  at 4.0  anim torvald play_cast
# Wide: Ossavar flies north over the ice; his shadow crosses Torvald and Aldra
shot N9 8.0  cam=static  from=(9.0, 2.2, 17.0)  look=(2.0, 5.0, 2.0)  fov=54  faces=torvald,aldra
  at 0.0  show ossavar
  at 0.0  teleport ossavar  to=(26, 14, 24)  yaw=-140
  at 0.2  move ossavar  to=(-14, 30, -40)  speed=12
  at 1.0  line ossavar "Gold for fire, they say. He paid in neither."  dur=4.4
  at 1.6  fade color=#000000  alpha=0.25  time=0.4
  at 2.4  fade color=#ffe9c0  alpha=0.12  time=0.6
# EWS high and wide, the sun coming up: Torvald and Aldra small on the glass, side by side; the title
shot N10 7.0  cam=crane  from=(12, 14, 30)  to=(18, 40, 50)  look=(3, 0, 8)>(3, 0, 8)  fov=46>54
  at 0.0  hide ossavar
  at 1.0  title "Episode 7" sub="Gold for Fire · End" time=4.5
  at 6.0  fade color=#000000  alpha=1  time=1.0
