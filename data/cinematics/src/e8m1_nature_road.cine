# e8m1_nature E1: the reverse of S28, the three walls in a row (D.9).
# Lines from data/voice/lines/e8m1_nature.json; the mission's end state says them again (shown once). Fallback: the end state.
cine e8m1_nature_road  title="The Closed Road"  mode=pause  letterbox=2.39  seed=841  length=20..27
env dusk  moon_yaw=120  moon_pitch=-30  energy=0.9
cast  narrator  capsule  at=(0, 0, -300)  hidden=1
cast  ysolde  capsule  at=(10, 0, -300)  hidden=1
cast  maelis  capsule  at=(20, 0, -300)  hidden=1

shot S1 6.0  cam=static  from=(-14, 2, 14)  look=(-24, 1.5, 14)  fov=40  in=fade_black:0.3
  at 0.2  line narrator "The Closed Road. For a hundred years nobody came in. For a hundred years she never went out."
shot S2 11.4  cam=static  from=(-28, 1.9, 18)  look=(-24, 1.6, 14)  fov=32
  at 0.2  line ysolde "I grew these walls to keep the war out. They did. They kept everything out."
  at 5.6  line maelis "They'll fight you, child. They only know the one word you taught them."
shot S3 6.0  cam=static  from=(-40, 6, 20)  look=(20, 0, 0)  fov=46
  at 0.2  line ysolde "Then I'll teach them a second word. It's a short one. Open."
