# e3m3 E3 "e3m3_offer" (docs/design/mission-e3-03.md, Cinematic hooks): ~12 s (spec 0:10, stretched so L5-L7 read at
# <= 17 chars/s), mode=pause over the live mission (violet dusk in Duskbarrow). 1) ECU the stone in Malrik's hand, amber
# light through his fingers; 2) MS around him: the nearest Wardens turn toward the stone. Both shots orbit the live hero
# (tag `malrik`); the cast position is a stand-in for cine's checks. Cameras on the east side (the Ep3 rule).
# Lines: L5-L7 (mission DIALOGUE, French in campaign.po).
cine e3m3_offer  title="The Offer"  mode=pause  letterbox=2.39  seed=51  length=10..14
env dusk  moon_yaw=200  moon_pitch=-14  energy=0.7
cast  malrik  res://art/units/wizards/malrik.tscn  at=(0, 0, -24)  yaw=180
cast  obren   capsule  at=(0, 0, -300)

# ECU the stone in his hand
shot O1 5.0  cam=orbit  pivot=malrik  r=1.3  h=1.15  deg=20>30  fov=26  in=fade_black:0.4
  at 0.2  vfx heart  scene=res://art/cinematics/stage_sets/forge_ep3_memories/props/heart_pulse.tscn  at=(0.3, 1.1, -23.5)  life=4.8  scale=0.6
  at 0.3  sfx res://assets/audio/forge/sfx/stone_thump.wav  vol=-6
  at 0.4  line obren "They are mine now, Bishop. Ask me nicely, and they kneel."
  at 0.4  sfx res://assets/audio/forge/sfx/obren_whisper.wav  vol=-9
  at 2.6  sfx res://assets/audio/forge/sfx/stone_thump.wav  vol=-7
# MS around him: the Wardens turn their heads toward the stone at once
shot O2 7.0  cam=orbit  pivot=malrik  r=7.5  h=3.2  deg=-15>5  fov=44
  at 0.2  line malrik "You raised my dead, and now you sell me the shovel."
  at 3.9  line obren "Not sell. Lend. You will hardly notice the price."
  at 6.4  fade alpha=1 time=0.6
