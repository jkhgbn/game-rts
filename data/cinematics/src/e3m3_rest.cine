# e3m3 E15 "e3m3_rest" (docs/design/mission-e3-03.md, Cinematic hooks): 30 s, then the victory. mode=pause over the live
# mission. 1) the Sexton kneels and comes apart (orbit on the live `sexton` while it exists, else its baked mark);
# 2) MS Malrik by the spade; 3) two-shot Malrik and Hush, 3/4-left: the taper, the candle put away (L24-L25); 4) WIDE:
# the four vigils burn violet at the barrow doors, the stone pulses once; FADE_BLACK. Malrik's shots orbit the live hero.
# Cameras on the east side (the Ep3 rule). Lines: L24-L26 (L26 narrator, voice-over).
cine e3m3_rest  title="Rest"  mode=pause  letterbox=2.39  seed=53  length=28..32
env dusk  moon_yaw=200  moon_pitch=-14  energy=0.7
cast  sexton    capsule  at=(0, 0, 24)  yaw=0
cast  malrik    res://art/units/wizards/malrik.tscn  at=(2, 0, 18)  yaw=200
cast  hush      res://art/units/helpers/helper_hush/helper_hush.tscn  at=(3.2, 0, 17.4)  yaw=250
cast  narrator  capsule  at=(0, 0, -300)  hidden=1

# The Sexton kneels in the Lodge road and comes apart into gravestones
shot R1 7.0  cam=orbit  pivot=sexton  r=10  h=4  deg=-25>-10  fov=46  in=fade_black:0.5
  at 1.0  sfx res://assets/audio/sfx/building_collapse.wav  vol=-4
  at 1.2  vfx apart  scene=res://art/cinematics/fx/shadow_wave.tscn  at=(0, 0.1, 24)  life=3.0  scale=2.2
  at 3.0  sfx res://assets/audio/forge/sfx/knife_ring.wav  vol=-10
# MS the spade upright in the earth; Malrik walks up to it
shot R2 6.0  cam=orbit  pivot=malrik  r=4.5  h=1.6  deg=-10>5
  at 0.5  sfx res://assets/audio/forge/sfx/snow_step.wav  vol=-12
# Two-shot Malrik and Hush, 3/4-left: the taper, the candle put away
shot R3 9.0  cam=orbit  pivot=malrik  r=3.4  h=1.6  deg=30>40
  at 0.4  line hush "Light it, Bishop. Just this once."
  at 3.8  line malrik "Not yet. Not while it is listening."
  at 6.6  sfx res://assets/audio/forge/sfx/candle_pinch.wav  vol=-8
# WIDE: the four vigils burn violet at the barrow doors; the stone pulses once
shot R4 8.0  cam=crane  from=(30, 26, -20)  to=(24, 22, -14)  look=(0, 0, 18)>(0, 0, 16)  fov=62>58
  at 0.2  vfx v1  scene=res://art/cinematics/fx/umbral_shroud.tscn  at=(-39, 0.1, 0)  life=7.5
  at 0.5  vfx v2  scene=res://art/cinematics/fx/umbral_shroud.tscn  at=(39, 0.1, 0)  life=7.2
  at 0.8  vfx v3  scene=res://art/cinematics/fx/umbral_shroud.tscn  at=(-30.7, 0.1, 34.3)  life=6.9
  at 1.1  vfx v4  scene=res://art/cinematics/fx/umbral_shroud.tscn  at=(30.7, 0.1, 34.3)  life=6.6
  at 0.4  line narrator "The vigils burned again in Duskbarrow. In the Bishop's pocket, the stone kept count."
  at 5.2  sfx res://assets/audio/forge/sfx/stone_thump.wav  vol=-6
  at 6.8  fade alpha=1 time=1.2
