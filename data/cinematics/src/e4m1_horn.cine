# e4m1 E11 "e4m1_horn" (docs/design/mission-e4-01.md, Cinematic hooks; script-episodes-4-8/e4m1.md 1): 12 s at 12:00,
# mode=pause over the live mission (the spec's HOLD runs as PAUSE: MissionBase.play_cutscene freezes the world).
# Evenmead from the south (e3m1's map row for row): river at z ~0, Stone Ford (4, 0), ford stones (12, 9), the crest
# (-5, 34), Horn Spires West / East (-40, 10) / (48, 10), Malrik's ridge north (z -36..-48).
# 1) WIDE crane from the B14R mark (-70, 40, 0) -> (-60, 42, 8): Malrik's host comes down to the Stone Ford, the Ice column
# to Birch Ford; the evening horns sound and each Horn Spire puffs its ring (a bloom ring at both spire marks; the mission
# skips the dead one's sound); 2) MS Ysolde on the crest, 3/4-left, staff raised (orbits the live hero: tag `ysolde` =
# her model, MissionBase.cinematic_actor; the cast position is the crest pad, a stand-in for cine's checks).
# Axis (the ep4_opening rule): every camera stays WEST of the north-south Malrik - Ysolde line.
# Lines: L15 (narrator, voice-over), L16 (mission DIALOGUE, French in dialogue.po).
# Fallback (no .tres / cinematics off): the end state says L15-L16 as dialogue cards.
cine e4m1_horn  title="The Evening Horn"  mode=pause  letterbox=2.39  seed=71  length=10..14
env day  moon_yaw=230  moon_pitch=-18  energy=0.9
cast  ysolde    res://art/units/wizards/ysolde.tscn  at=(-5, 0, 34)  yaw=180
cast  narrator  capsule  at=(0, 0, -300)  hidden=1

# WIDE crane from B14R: both hosts come down to the water, the horns call from the hill
shot H1 6.0  cam=crane  from=(-70, 40, 0)  to=(-60, 42, 8)  look=(0, 2, 0)>(4, 1, 2)  fov=50>46  in=fade_black:0.6
  at 0.0  sfx res://assets/audio/forge/sfx/evenmead_horns.wav  vol=-6
  at 0.5  line narrator "The evening horn. Malrik's whole host comes down to the water."
  at 1.0  sfx res://assets/audio/forge/sfx/army_armour.wav  vol=-9
  at 1.4  vfx ring_w  scene=res://art/cinematics/fx/bloom_wave.tscn  at=(-40, 0.5, 10)  life=2.6  scale=1.4
  at 1.8  vfx ring_e  scene=res://art/cinematics/fx/bloom_wave.tscn  at=(48, 0.5, 10)  life=2.6  scale=1.4
# MS Ysolde on the crest, 3/4-left (north-west of her), staff raised
shot H2 6.0  cam=orbit  pivot=ysolde  r=4.2  h=1.5  deg=-140>-128
  at 0.2  sfx res://assets/audio/sfx/ab_grove_oath.wav  vol=-10
  at 0.3  line ysolde "Let them have the water. Everyone to the foot of the hill. Nobody passes the tree."
  at 5.4  fade alpha=1 time=0.6
