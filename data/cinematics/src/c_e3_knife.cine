# Between-scene "The Bishop's Knife", ~68 s (docs/design/mission-e3-02.md, Cinematic hooks `c_e3_knife`; beats for its
# writer E3M2.D1, campaign-outline.md 3.3 "Hush and Malrik after Evenmead"). Dusk on the ridge after the ford: Malrik
# scrapes the ford mud off his boots; Hush is already behind him; he does not turn ("You missed her, at Emberfall." /
# "Once."); he lays four wooden tokens on a map of the south camp; Torvald watches from his pavilion; Hush takes the
# tokens and is gone. Plays after e3m1's victory (StoryFlow: CampaignState.STORY_FILMS c_e3_knife -> e3m2).
# Text source for i18n / voices: data/voice/lines/c_e3_knife.json (the same text as the lines below).
# Set: forge_evenmead (marks B14 N12, puppets malrik / hush / torvald on the ridge at y ~7.4). The set only has its
# golden-hour preset: dusk is a violet full-screen grade (the ep3_ending trick, lighter). Props: art/cinematics/props/
# ep3_between/ (the camp table and its map; the tokens apart so Hush can take them).
# Axis: the Ep3 rule (every camera east of the Malrik - Ysolde line; Malrik / Hush shots from their east side).
cine c_e3_knife  title="The Bishop's Knife"  letterbox=2.39  seed=36  length=62..74
use set forge_evenmead
use music res://assets/audio/forge/music/ep3_opening.wav  vol=-22
env dusk  moon_yaw=210  moon_pitch=-18  energy=0.7
cast  war_map  res://art/cinematics/props/ep3_between/war_map.tscn     at=(1.5, 7.434, -35.0)  yaw=0
cast  tokens   res://art/cinematics/props/ep3_between/war_tokens.tscn  at=(1.5, 7.434, -35.0)  yaw=0

# ---------------------------------------------------------------- dusk on the ridge
# Wide over the valley at dusk: the black ford, the armies pulled back to their hills
shot B14 9.0  in=fade_black:1.2
  at 0.0  fade color=#2a1c3a alpha=0.32 time=0.05
  at 0.0  hide hush
  at 0.0  teleport torvald  to=(-9.0, 7.4, -39.0)  yaw=70
  at 0.0  sfx res://assets/audio/forge/sfx/evenmead_amb.wav  vol=-10
# Malrik scrapes the ford mud off his boots
shot K2 7.0  cam=frame "ms on malrik, 3/4 left, low"  push=0.2
  at 0.0  anim malrik set_expression  arg=neutral
  at 0.4  sfx res://assets/audio/forge/sfx/shovel_earth.wav  vol=-12
  at 0.8  line malrik "Ford mud. My father said the same of grave clay: it never comes off."
  at 3.2  sfx res://assets/audio/forge/sfx/shovel_earth.wav  vol=-13
# Hush is already behind him; he does not turn
shot K3 7.0  cam=frame "ms on malrik and hush, 3/4 left, eye"
  at 0.0  teleport hush  to=(0.8, 7.43, -37.4)  yaw=10
  at 0.0  show hush
  at 0.6  line malrik "You missed her, at Emberfall."
  at 4.0  line hush "Once."
  at 4.0  anim hush set_expression  arg=neutral
shot K4 6.0  cam=frame "mcu on hush, 3/4 left, eye"
  at 0.4  line hush "Once is enough to remember, Bishop. Who is it tonight?"
# The map of the south camp; four wooden tokens, one per wagon
shot K5 8.0  cam=frame "cu on tokens, high"
  at 0.3  sfx res://assets/audio/forge/sfx/stone_thump.wav  vol=-20
  at 0.5  line malrik "Not who. What. Four wagons on the south hill, one token each."
  at 4.6  line malrik "Bring me back their axle pins."
  at 4.6  sfx res://assets/audio/forge/sfx/knife_ring.wav  vol=-16
# Torvald watches from his pavilion
shot K6 7.0  cam=dolly  from=(-5.9, 9.5, -38.7)  to=(-6.2, 9.45, -38.75)  look=(-9.0, 9.35, -39.0)  fov=34  faces=torvald
  at 0.0  anim torvald set_expression  arg=worried
  at 0.6  line torvald "You send a knife at farmers' carts, Malrik."
  at 0.6  sfx res://assets/audio/forge/sfx/ice_creak.wav  vol=-16
shot K7 6.0  cam=frame "mcu on malrik, 3/4 left, eye"
  at 0.0  anim malrik set_expression  arg=smile
  at 0.4  line malrik "At an army's supper, Torvald. Hungry soldiers go home."
# Hush takes the tokens and is gone
shot K8 6.0  cam=frame "ms on hush and malrik, 3/4 left, eye"
  at 0.4  line hush "Sleep well, Bishop. Someone won't."
  at 2.6  hide tokens
  at 2.6  sfx res://assets/audio/forge/sfx/knife_ring.wav  vol=-12
  at 3.2  vfx smoke  scene=res://art/cinematics/fx/umbral_shroud.tscn  at=(0.8, 7.6, -37.4)  life=2.6
  at 3.2  sfx res://assets/audio/sfx/spell_umbral_shroud.wav  vol=-8
  at 3.6  hide hush
# Long lens across the valley: the fires coming alight on Lark Hill
shot N12 12.0
  at 0.0  fade color=#2a1c3a alpha=0.4 time=2.0
  at 2.0  vfx f1  scene=res://art/cinematics/fx/fire_pillar.tscn  at=(-14, 7.0, 36)  life=10  scale=0.1
  at 3.4  vfx f2  scene=res://art/cinematics/fx/fire_pillar.tscn  at=(-4, 7.4, 37)  life=9  scale=0.1
  at 4.6  vfx f3  scene=res://art/cinematics/fx/fire_pillar.tscn  at=(6, 7.0, 36)  life=8  scale=0.1
  at 10.8  fade alpha=1 time=1.2
