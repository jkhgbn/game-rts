# e8m2 E1: the isle crack at dusk, the four seats, the player's wizard (mission-e8-02.md 9).
# Lines from data/voice/lines/e8m2.json; the mission's end state says them again (shown once). Fallback: the end state.
cine e8m2_seats  title="Four Seats"  mode=pause  letterbox=2.39  seed=851  length=30..37
env dusk  moon_yaw=120  moon_pitch=-30  energy=0.9
cast  narrator  capsule  at=(0, 0, -300)  hidden=1
cast  vey  capsule  at=(10, 0, -300)  hidden=1
cast  vessa  capsule  at=(20, 0, -300)  hidden=1
cast  torvald  capsule  at=(30, 0, -300)  hidden=1
cast  malrik  capsule  at=(40, 0, -300)  hidden=1
cast  ysolde  capsule  at=(50, 0, -300)  hidden=1

shot S1 6.0  cam=static  from=(0, 22, 14)  look=(0, 0, 0)  fov=50  in=fade_black:0.3
  at 0.2  line narrator "Four kingdoms on one field, and every banner pointed the same way. It had never happened."
shot S2 6.0  cam=static  from=(-20, 6, 40)  look=(-30, 0, 30)  fov=44
  at 0.2  line vey "Well. Look at the four of you. Thirty years I waited to see this, and it's ugly. I love it."
shot S3 6.0  cam=static  from=(-40, 6, -20)  look=(-30, 0, -30)  fov=44
  at 0.2  line vessa "Fire takes its bank. Or wherever I'm standing. I'm flexible."
shot S4 6.0  cam=static  from=(40, 6, -20)  look=(30, 0, -30)  fov=44
  at 0.2  line torvald "Ice holds its bank. Malrik, if that stone so much as hums, I'm freezing your pocket."
shot S5 9.4  cam=static  from=(20, 6, 40)  look=(30, 0, 30)  fov=44
  at 0.2  line malrik "Noted. Ysolde, try not to plant anything on my keyhole."
  at 5.6  line ysolde "No promises. Spring is busy."
