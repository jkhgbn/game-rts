# PLANTED-BUG copy of watch_keep.cine (cine acceptance): exactly 4 bugs, cine check must report exactly 4 FAILs:
#  1. S4 crosses the axis (ots shade on the wrong shoulder)  2. S2 line is overlong  3. S8 names a missing marker
#  4. S6 plays an unknown clip.
# The Watch-Keep: Vessa keeps watch below the Fire keep at nightfall; a Shade comes out of the dark; a knife glints;
# cut to black. Tools-wave acceptance demo of `cine` (docs/plan/tools-wave.md section 3). Self-staged: no set needed.
# The Vessa -> Shade line runs north-south (z); every camera stays on its east (+x) side (180-degree rule).
cine watch_keep_bugs  title="The Watch-Keep (planted bugs)"  letterbox=2.39  seed=11  length=45..60
use music res://assets/audio/music/music_menu.wav
env night  moon_yaw=200  moon_pitch=-32  energy=0.7  color=#9fb4ff

prop  keep   res://art/buildings/fire_keep.tscn  at=(0, 0, 0)
cast  vessa  res://art/units/wizards/vessa.tscn  at=(0, 0, -7)    yaw=180
cast  shade  res://art/units/shadow/shade.tscn   at=(1.5, 0, -14)  yaw=0  hidden=1

marks S1  from=(18, 12, -24)  to=(11, 4.5, -17)  look=(0, 9, 0)>(0, 2.2, -7)  fov=50>42
mark  mid (0.7, 0.2, -9.3)
marks S8  from=(14, 6.5, -20)  look=(0.6, 1.2, -9)  fov=46

shot S1 7.0  cam=crane  from=@S1_from  to=@S1_to  look=@S1_look_from>@S1_look_to  in=fade_black:1.2
  at 0.6  title "The Watch-Keep"  sub="Fire kingdom, the last hour of dusk"  time=4
shot S2 6.0  cam=frame "ms on vessa, 3/4 right"  push=0.5
  at 0.8  line vessa "The watch fires are out, all of them, every brazier from the north gate to the river tower, and nobody sounded the horn."
  at 3.6  anim vessa play_level_up
shot S3 6.0  cam=frame "ws on shade, ots vessa"  fov=38
  at 1.0  show shade
  at 1.0  sfx  res://assets/audio/sfx/spell_umbral_shroud.wav
  at 1.2  move shade  to=(1.2, 0, -11.5)  speed=1.1
shot S4 5.0  cam=frame "mcu on vessa, ots shade"  fov=36
  at 0.6  line vessa "You are a long way from the dark, shade."
shot S5 6.0  cam=orbit  pivot=@mid  r=6.5  h=1.0  deg=-30>12  faces=vessa,shade  fov=40
  at 0.8  line shade "The keep sleeps. So should you."
shot S6 5.0  cam=frame "cu on shade, profile left"  fov=34  push=0.25
  at 1.0  clip shade draw_knfe
  at 1.25 fade color=#ffffff  alpha=0.55  time=0.06
  at 1.3  fade alpha=0  time=0.3
  at 1.25 sfx  res://assets/audio/sfx/spell_shadow_lance.wav
shot S7 5.0  cam=frame "mcu on vessa, 3/4 right, low"  push=0.3
  at 0.4  anim vessa play_cast  arg=fireball
  at 1.2  line vessa "Not tonight."
shot S8 6.0  cam=static  from=@S8_frm  look=@S8_look_from
  at 0.5  move shade  to=(0.6, 0, -8.2)  speed=4
  at 0.6  sfx  res://assets/audio/sfx/fireball_cast.wav
  at 1.1  fade alpha=1  time=0.12
