# e8m2 E17: four pillars of colour, the Throne rises out of the dust (9).
# Lines from data/voice/lines/e8m2.json; the mission's end state says them again (shown once). Fallback: the end state.
cine e8m2_turn  title="The Turn"  mode=pause  letterbox=2.39  seed=853  length=35..42
env dusk  moon_yaw=120  moon_pitch=-30  energy=0.9
cast  narrator  capsule  at=(0, 0, -300)  hidden=1
cast  master  capsule  at=(10, 0, -300)  hidden=1
cast  vessa  capsule  at=(20, 0, -300)  hidden=1
cast  malrik  capsule  at=(30, 0, -300)  hidden=1
cast  obren  capsule  at=(40, 0, -300)  hidden=1
cast  torvald  capsule  at=(50, 0, -300)  hidden=1
cast  ysolde  capsule  at=(60, 0, -300)  hidden=1

shot S1 6.0  cam=static  from=(0, 30, 6)  look=(0, 0, 0)  fov=56  in=fade_black:0.3
  at 0.2  line narrator "Four keyholes, four colours, one ring of light around the isle."
shot S2 6.0  cam=static  from=(4, 1.0, 4)  look=(0, -2, 0)  fov=30
  at 0.2  line master "Now. All four of you. Turn them, and do not let go."
shot S3 6.0  cam=static  from=(-14, 1.9, 22)  look=(-17.5, 1.5, 17.5)  fov=32
  at 0.2  line vessa "Master?! That's... that's him! Turn them!"
shot S4 6.0  cam=static  from=(-14, 1.9, -22)  look=(-17.5, 1.5, -17.5)  fov=32
  at 0.2  line malrik "Of course he waits until the last minute to speak. Family trait."
shot S5 6.0  cam=static  from=(12, 4, 12)  look=(0, 3, 0)  fov=44
  at 0.2  line obren "You opened my door with your own hands. Thank you. Now I come up."
shot S6 8.4  cam=static  from=(14, 1.9, -22)  look=(17.5, 1.5, -17.5)  fov=32
  at 0.2  line torvald "Then let him come. We are four. We hold."
  at 5.6  line ysolde "Together."
