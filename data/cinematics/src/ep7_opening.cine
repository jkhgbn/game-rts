# Episode 7 opening "Gold for Fire", 3:26 (docs/design/episode7-opening.md sections 3-4: written as `ep5_opening`,
# "Episode 5", 3:23; renamed ep7_opening / Episode 7 here, with JS's 2026-09-28 H17b line "He left in anger", +3 s).
# Cold open: the thousandth Laurel Duel on the Tollrock (Dacian Orrow, the Sunblade of Aurivane, against Seraphine
# Vael, the Diamond Wall of Adamarch: first blood, and no further; "Well struck."); Ossavar lands on the rim above the
# Master's empty chair and tells the thousand-year war of the two harbour cities (the gold, the Coinwater, the dragons
# bought back, the Year of Two Skies, the Master walking out on the sea: "Enough."; the duel he gave them and the bets
# they laid on it; he left in anger, raised four apprentices, gave the two cities to Vessa and Malrik: "No problem at
# all!"); the present: the old price stands, "And look who has come to bid."; the title card.
# Text source for i18n / voices: data/voice/lines/ep7_opening.json (34 lines, written 2026-10-08 from the script;
# French in data/i18n/fr/dialogue.po; voiced by Voice Forge; H19's three lines are ep5_ending N2's own WAVs).
# e7m1 is not built: not in CampaignState.STORY_FILMS yet (play it with run_cine.ps1 play ep7_opening).
# Sets (stand-ins; forge_tollrock, forge_coinwater_battle, forge_aurivane, forge_adamarch are not built):
#  - the Tollrock arena = forge_intro_vessa's open ground (its prologue host / fx hidden), the Master's stone chair and
#    its white cloth = art/cinematics/props/ep7_between/; no crowd, no strait, no royal boxes (the Archons stand on the
#    sand at the arena's ends);
#  - the Coinwater = forge_evenmead's river, the Tollrock = its ford stones, the galleys = landmark barges; the dragon
#    sky = the prologue flock (data/cinematics/prologue/sky_near.tscn);
#  - Aurivane / Adamarch = forge_citadel's wides under a gold / a white-blue grade; the orrery dome (H18-H20) = its S06
#    mark and Master puppet, Vessa and Malrik at 0.9 scale (as ep5_ending).
# Stand-ins: Dacian = the Coin-Cutter champion, Seraphine = the Oathwall champion, the herald = the Mender, the Gold
# Archon = the Wayfinder, the Diamond Archon = the Mage-Archer, Ossavar = the cinder dragon titan; the Master on the
# sea / in the chair = the forge_ep3_memories light figure. No white warhorse (H17b: he walks out of the south gate).
# Duel axis: Dacian (south) - Seraphine (north) on x = 0; every duel camera stays east of it (x > 0), looking west to
# the chair; D12 (top-down) is the neutral shot. H19-H20: the ep5_ending rule (cameras east of the Master's line).
cine ep7_opening  title="Episode 7: Gold for Fire"  letterbox=2.39  seed=701  length=200..212  skip_lock=20
use set forge_intro_vessa
use music res://assets/audio/music/music_menu.wav  vol=-21
cast  narrator   capsule  at=(0, 0, -300)  hidden=1  speaker=ossavar
prop  chair      res://art/cinematics/props/ep7_between/stone_chair.tscn  at=(-9.5, 0, 7)  yaw=90  set=forge_intro_vessa
cast  cloth      res://art/cinematics/props/ep7_between/chair_cloth.tscn  at=(-9.5, 0, 7)  yaw=90  set=forge_intro_vessa
cast  herald     res://art/units/champions/mender/mender.tscn  at=(-7.6, 0, 9.2)  yaw=100  set=forge_intro_vessa
cast  dacian     res://art/units/champions/coin_cutter/coin_cutter.tscn  at=(0.3, 0, 13.6)  yaw=180  set=forge_intro_vessa
cast  seraphine  res://art/units/champions/oathwall/oathwall.tscn  at=(-0.3, 0, 0.8)  yaw=0  set=forge_intro_vessa
cast  archon_g   res://art/units/champions/wayfinder/wayfinder.tscn  at=(-5.0, 0, 15.0)  yaw=150  set=forge_intro_vessa  hidden=1
cast  archon_d   res://art/units/champions/mage_archer/mage_archer.tscn  at=(-5.0, 0, -1.0)  yaw=30  set=forge_intro_vessa  hidden=1
cast  old_a      res://art/units/fire/flame_guard.tscn  at=(0, 0, 9.0)  yaw=180  set=forge_intro_vessa  hidden=1
cast  old_b      res://art/units/shadow/shadow_knight.tscn  at=(0, 0, 5.0)  yaw=0  set=forge_intro_vessa  hidden=1
cast  ossavar    res://art/units/titans/cinder_dragon/cinder_dragon.tscn  at=(-14, 16, 7)  yaw=90  set=forge_intro_vessa  hidden=1
cast  hooded     res://art/cinematics/stage_sets/forge_ep3_memories/props/master.tscn  at=(0, -50, 0)  yaw=90  hidden=1
cast  y_vessa    res://art/units/wizards/vessa.tscn   at=(-13.7, 48, -4.0)  yaw=0  scale=0.9  set=forge_citadel
cast  y_malrik   res://art/units/wizards/malrik.tscn  at=(-12.3, 48, -4.0)  yaw=0  scale=0.9  set=forge_citadel
cast  barge1     res://art/environment/landmarks/barge.tscn  at=(22, -1.2, -5.0)  yaw=70  set=forge_evenmead
cast  barge2     res://art/environment/landmarks/barge.tscn  at=(30, -1.2, -6.5)  yaw=110  set=forge_evenmead
cast  barge3     res://art/environment/landmarks/barge.tscn  at=(-12, -1.2, 3.0)  yaw=95  set=forge_evenmead
cast  barge4     res://art/environment/landmarks/barge.tscn  at=(-22, -1.2, 3.5)  yaw=80  set=forge_evenmead
cast  young_oss  res://art/units/titans/cinder_dragon/cinder_dragon.tscn  at=(70, 26, -40)  yaw=-60  set=forge_evenmead  hidden=1
cast  frostd     res://art/units/titans/frost_dragon/frost_dragon.tscn  at=(16, -0.8, 6.0)  yaw=-120  set=forge_evenmead  hidden=1
cast  cinderd    res://art/units/titans/cinder_dragon/cinder_dragon.tscn  at=(4, -0.8, -8.0)  yaw=-30  set=forge_evenmead  hidden=1
prop  flock      res://data/cinematics/prologue/sky_near.tscn  at=(0, 30, 0)  set=forge_evenmead

# ---------------------------------------------------------------- the thousandth duel (cold open, noon)
# Crane in low over the ground, up over the rim: the arena at noon
shot D01 7.0  cam=crane  from=(30, 4, 30)  to=(14, 8, 16)  look=(-2, 1, 7)>(-3, 1.2, 7)  fov=48>40  in=fade_black:1.2
  at 0.0  hide vessa
  at 0.0  hide vessa_young
  at 0.0  hide guard
  at 0.0  hide scorchbow
  at 0.0  hide adept
  at 0.0  hide army_host
  at 0.0  hide army_fallen
  at 0.0  hide fx_pillar
  at 0.0  hide fx_columns
  at 0.0  hide fx_embers
  at 0.0  hide fx_volley
  at 0.0  sfx res://assets/audio/forge/sfx/army_armour.wav  vol=-14
# MS on the herald, low, the chair behind: white cloth on it
shot D02 5.0  cam=static  from=(-4.2, 1.0, 11.4)  look=(-7.8, 1.7, 8.8)  fov=40  faces=herald
  at 0.3  line herald "By the Truce of the Stilled Sea: first blood, and no further!"  dur=4.4
  at 0.6  anim herald play_cast
# MLS, 3/4, low, the south gate: Dacian strides out dragging the Sunblade, raises it
shot D03 4.0  cam=static  from=(5.0, 0.8, 13.6)  look=(0.2, 1.3, 12.0)  fov=40  faces=dacian
  at 0.0  move dacian  to=(0.2, 0, 10.0)  speed=1.6
  at 0.2  line herald "For Aurivane, the Sunblade: Dacian Orrow!"  dur=3.4
  at 2.6  anim dacian play_attack
  at 2.8  sfx res://assets/audio/forge/sfx/army_armour.wav  vol=-10
# MLS, 3/4, low, the north gate: Seraphine walks out; light off her shield crosses the sand
shot D04 4.0  cam=static  from=(5.0, 0.8, 0.6)  look=(-0.2, 1.3, 2.6)  fov=40  faces=seraphine
  at 0.0  move seraphine  to=(-0.2, 0, 4.0)  speed=1.4
  at 0.2  line herald "For Adamarch, the Diamond Wall: Seraphine Vael!"  dur=3.6
  at 1.2  vfx glint  scene=res://art/cinematics/fx/sun_pillar.tscn  at=(-0.2, 1.3, 4.0)  life=0.8  scale=0.15
# MS two-shot: both bow to the empty chair, then face each other
shot D05 6.0  cam=static  from=(6.4, 1.6, 7.0)  look=(0, 1.4, 7.0)  fov=42  faces=dacian,seraphine
  at 0.0  teleport dacian  to=(0.2, 0, 9.4)  yaw=-90
  at 0.0  teleport seraphine  to=(-0.2, 0, 4.6)  yaw=-90
  at 1.4  face dacian  to=seraphine  time=0.4
  at 1.4  face seraphine  to=dacian  time=0.4
  at 1.8  line dacian "Nine years I trained for this sand."  dur=2.6
  at 4.6  line seraphine "Then don't waste it."  dur=1.4
# WS, low, the length of the arena: first clash, the cleave, the angled shield, sparks, sand
shot D06 5.0  cam=static  from=(4.2, 0.5, 15.0)  look=(0, 1.3, 6.4)  fov=40  faces=dacian,seraphine
  at 0.4  move dacian  to=(0.2, 0, 7.8)  speed=2.4
  at 0.6  anim dacian play_attack
  at 0.9  anim seraphine play_attack
  at 1.1  vfx sparks  scene=res://art/cinematics/fx/fire_burst.tscn  at=(0, 1.6, 6.6)  life=0.8  scale=0.25
  at 2.6  anim dacian play_attack
  at 2.8  vfx sparks2  scene=res://art/cinematics/fx/fire_burst.tscn  at=(0, 1.5, 6.4)  life=0.8  scale=0.2
# OTS Seraphine, eye, shake: the flurry drives her back
shot D07 4.0  cam=static  from=(1.0, 1.7, 3.4)  look=(0.1, 1.5, 7.8)  fov=40  faces=dacian
  at 0.0  teleport seraphine  to=(-0.2, 0, 5.6)  yaw=0
  at 0.2  anim dacian play_attack
  at 0.4  move seraphine  to=(-0.2, 0, 4.4)  speed=0.8
  at 1.4  anim dacian play_attack
  at 2.6  anim dacian play_attack
# MS: the shield bash; he spins with the fall and cuts her shield strap
shot D08 2.6  cam=static  from=(4.8, 1.5, 6.8)  look=(0, 1.3, 6.4)  fov=40  faces=dacian,seraphine
  at 0.2  anim seraphine play_attack
  at 1.2  anim dacian play_attack
  at 1.4  vfx sparks3  scene=res://art/cinematics/fx/fire_burst.tscn  at=(-0.1, 1.2, 5.6)  life=0.8  scale=0.2
# ECU insert, the sand: the strap gives, a last glint
shot D08B 1.4  cam=static  from=(1.4, 0.45, 5.8)  look=(0, 0.15, 6.0)  fov=34
  at 0.2  vfx glint2  scene=res://art/cinematics/fx/ember.tscn  at=(0, 0.1, 6.0)  life=1.2  scale=0.2
# Orbit around them: sword on sword; the plume flies; Dacian laughs
shot D09 5.0  cam=orbit  pivot=(0, 1.3, 6.8)  r=6  h=1.6  deg=-30>30  faces=dacian,seraphine
  at 0.3  anim dacian play_attack
  at 0.5  anim seraphine play_attack
  at 1.8  anim dacian play_attack
  at 2.0  anim seraphine play_attack
  at 3.1  vfx plume  scene=res://art/cinematics/fx/ember.tscn  at=(0.2, 2.3, 7.8)  life=1.6  scale=0.3
  at 3.4  anim dacian set_expression  arg=smile
# CU two-shot, profile, eye: the bind, faces close
shot D10 6.0  cam=static  from=(2.4, 1.75, 7.0)  look=(0, 1.75, 7.0)  fov=34  faces=dacian,seraphine
  at 0.0  teleport dacian  to=(0.1, 0, 7.6)  yaw=180
  at 0.0  teleport seraphine  to=(-0.1, 0, 6.4)  yaw=0
  at 1.0  line dacian "Yield, Diamond Wall."  dur=1.8
  at 3.2  line seraphine "Walls don't yield."  dur=1.6
# EWS, low, from the east rim: they back off to opposite ends; silence; they charge
shot D11 5.0  cam=static  from=(17, 2.4, 7.0)  look=(0, 1.0, 7.0)  fov=50  faces=dacian,seraphine
  at 0.4  move dacian  to=(0.1, 0, 15.0)  speed=2.6
  at 0.4  move seraphine  to=(-0.1, 0, -1.0)  speed=2.6
  at 3.4  move dacian  to=(0.1, 0, 5.0)  speed=7
  at 3.4  move seraphine  to=(-0.1, 0, 9.0)  speed=7
# Top-down, static: the pass, one flash; they stop back to back
shot D12 4.0  cam=static  from=(0, 24, 7.01)  look=(0, 0, 7)  fov=30
  at 0.0  teleport dacian  to=(0.1, 0, 9.4)  yaw=180
  at 0.0  teleport seraphine  to=(-0.1, 0, 4.6)  yaw=0
  at 0.0  move dacian  to=(0.1, 0, 4.6)  speed=7
  at 0.0  move seraphine  to=(-0.1, 0, 9.4)  speed=7
  at 0.4  vfx flash  scene=res://art/cinematics/fx/sun_pillar.tscn  at=(0, 1.2, 7.0)  life=0.3  scale=0.2
# CU on Dacian, 3/4, eye: the red line opens on his cheek; the crowd reacts
shot D13 5.0  cam=static  from=(2.0, 1.85, 3.2)  look=dacian  fov=30
  at 0.0  teleport dacian  to=(0.1, 0, 4.6)  yaw=150
  at 0.0  teleport seraphine  to=(-0.1, 0, 9.4)  yaw=0
  at 0.6  anim dacian play_hit
  at 1.5  line herald "First blood! Adamarch!"  dur=2.0
# MS two-shot: he grins, offers his hand; she takes it
shot D14 5.0  cam=static  from=(5.6, 1.6, 7.0)  look=(0, 1.4, 7.0)  fov=40  faces=dacian,seraphine
  at 0.0  teleport dacian  to=(0.1, 0, 7.8)  yaw=180
  at 0.0  teleport seraphine  to=(-0.1, 0, 6.2)  yaw=0
  at 0.4  anim dacian set_expression  arg=smile
  at 1.6  line dacian "Well struck."  dur=1.4
# WS, low, looking up west past the chair: the shadow, the silence; Ossavar lands; the cloth tears; back to back
shot D15 6.0  cam=static  from=(6.4, 0.5, 7.0)  look=(-9, 4.6, 7.0)  fov=52  faces=dacian,seraphine
  at 0.0  show ossavar
  at 0.3  sfx res://assets/audio/sfx/atk_storm.wav  vol=-10
  at 0.4  move ossavar  to=(-14, 0, 7)  speed=6
  at 2.6  hide cloth
  at 3.2  face dacian  to=ossavar  time=0.5
  at 3.2  face seraphine  to=ossavar  time=0.5
  at 3.2  anim dacian play_attack
  at 3.2  anim seraphine play_attack

# ---------------------------------------------------------------- the thousand-year war (Ossavar tells it)
# CU on Ossavar (static: the dragon model bobs in real time, so no framer / follow on it): his gold eye
shot H01 5.0  cam=static  from=(-4.0, 4.0, 9.0)  look=(-11.0, 3.0, 7.0)  fov=36
  at 0.0  teleport ossavar  to=(-14, 0, 7)  yaw=90
  at 0.3  line ossavar "They say he kept the peace for a thousand years. Not here."  dur=4.4
# Hero wide, dawn: the Gold City (forge_citadel under a gold grade)
shot H02 3.0  set=forge_citadel  cam=dolly  from=(52, 62, 150)  to=(44, 60, 134)  look=(0, 64, 0)  fov=40  in=fade_white:0.4
  at 0.0  fade color=#ffcf70  alpha=0.22  time=0.05
  at 0.0  hide y_vessa
  at 0.0  hide y_malrik
  at 0.0  hide swordsman
  at 0.3  line ossavar "Two cities on one strait. Aurivane, of gold. Adamarch, of diamond."  dur=5.4
# Hero wide, dawn: the Diamond City (forge_citadel under a white-blue grade)
shot H03 3.0  set=forge_citadel  cam=dolly  from=(-60, 70, -120)  to=(-52, 68, -110)  look=(0, 70, 0)  fov=40  in=blend:0.3
  at 0.0  fade color=#cfe6ff  alpha=0.25  time=0.05
# The Scale and the Anvil yard: the market terrace
shot H04 6.0  set=forge_citadel  cam=crane  from=(-22, 62, 79)  to=(-9, 34, 57)  look=(-12.5, 31, 47.2)  fov=44>40
  at 0.0  fade color=#ffcf70  alpha=0.12  time=0.3
  at 0.3  line ossavar "Only the rich may live inside their walls. Only the strong may stay."  dur=5.4
# WS from the water toward the Tollrock (the ford stones): a trader pays the toll
shot H05 4.5  set=forge_evenmead  cam=static  from=(42, 3.0, -9.0)  look=(14, 0.6, 4.0)  fov=42  in=fade_white:0.4
  at 0.0  fade color=#ffffff  alpha=0  time=0.2
  at 0.0  hide malrik
  at 0.0  hide torvald
  at 0.0  hide hush
  at 0.0  hide ysolde
  at 0.0  hide evenmead_vessa
  at 0.0  hide vey
  at 0.0  hide stone
  at 0.0  hide army_shadow
  at 0.0  hide army_ice
  at 0.0  hide army_nature
  at 0.0  hide army_fire
  at 0.3  line ossavar "Between them, one rock. Who holds it taxes every ship on the sea."  dur=4.2
# Low on the water, tracking two fleets: galleys ram, spear walls on the decks
shot H06 4.5  set=forge_evenmead  cam=dolly  from=(40, -0.5, -3.0)  to=(32, -0.5, -3.4)  look=(24, -0.4, -6.0)>(18, -0.4, -5.0)  fov=44
  at 0.3  line ossavar "They fought over it for a thousand years. For gold, and for glory."  dur=4.2
  at 1.0  move barge2  to=(24, -1.2, -5.6)  speed=3
  at 1.6  vfx ram  scene=res://art/cinematics/fx/fire_burst.tscn  at=(24, 0.2, -5.4)  life=2.0  scale=0.8
# High, night, slow push: a tall hooded stranger on the ridge opens his hand; gold rains into both harbours
shot H07 6.0  set=forge_evenmead  cam=dolly  from=(30, 22, 24)  to=(26, 20, 18)  look=(0, 6, -30)  fov=46  in=fade_black:0.4
  at 0.0  fade color=#0b0c26  alpha=0.5  time=0.05
  at 0.0  show hooded
  at 0.0  teleport hooded  to=(2.0, 7.4, -38.0)  yaw=180
  at 0.3  line ossavar "He tried everything. He sent them gold, so they would want nothing."  dur=5.4
  at 1.5  vfx gold1  scene=res://art/cinematics/fx/ember.tscn  at=(-20, 4, 2)  life=4.5  scale=2.0
  at 1.8  vfx gold2  scene=res://art/cinematics/fx/ember.tscn  at=(28, 4, -6)  life=4.2  scale=2.0
# Low, dusk, tilt down into the water: burning hulks sink; coins spill into the clear water
shot H08 6.0  set=forge_evenmead  cam=dolly  from=(14, 1.2, 4.0)  to=(14, 0.6, 3.0)  look=(22, 0.4, -5.0)>(20, -1.4, -3.0)  fov=42  in=fade_black:0.4
  at 0.0  fade color=#5a2a10  alpha=0.3  time=0.05
  at 0.0  hide hooded
  at 0.0  vfx burn1  scene=res://art/cinematics/fx/fire_pillar.tscn  at=(22, -1.0, -5.0)  life=6  scale=0.4
  at 0.0  vfx burn2  scene=res://art/cinematics/fx/fire_pillar.tscn  at=(30, -1.0, -6.5)  life=6  scale=0.4
  at 0.3  line ossavar "They bought more ships. So much gold sank, they named the strait the Coinwater."  dur=5.4
  at 2.4  vfx coins  scene=res://art/cinematics/fx/ember.tscn  at=(21, -0.6, -4.0)  life=3.4  scale=0.6
# EWS, the sky, north: the flock rises and flies north; at the harbour, chests open toward the sky; they turn back
shot H09 5.0  set=forge_evenmead  cam=static  from=(0, 11, 24)  look=(0, 36, -60)  fov=56  in=blend:0.3
  at 0.0  fade alpha=0  time=0.3
  at 0.3  line ossavar "He took us dragons away. They paid us more to come back."  dur=4.6
# Tracking young Ossavar (a dolly along his flight; no follow cam on a bobbing dragon): he burns a white tower; the Year of Two Skies: the whole flock turns on its old masters
shot H10 6.0  set=forge_evenmead  cam=dolly  from=(52, 30, -20)  to=(14, 26, 14)  look=(30, 24, -16)>(-6, 20, 16)  fov=50
  at 0.0  show young_oss
  at 0.0  move young_oss  to=(-10, 22, 20)  speed=16
  at 0.3  line ossavar "I burned Adamarch for Aurivane, then Aurivane for Adamarch. Twice each."  dur=5.4
  at 2.4  vfx breath  scene=res://art/cinematics/fx/fire_pillar.tscn  at=(12, 1, 9)  life=3.4  scale=0.8
# Epic wide, crane up: the Battle of the Full Strait, both shores burning; a tiny light on the water in the middle
shot H11 6.0  set=forge_evenmead  cam=crane  from=(50, 10, 30)  to=(60, 40, 50)  look=(8, 0, -2)>(8, 0, -2)  fov=50  in=blend:0.3
  at 0.0  hide young_oss
  at 0.0  fade color=#5a2a10  alpha=0.3  time=0.3
  at 0.0  vfx f1  scene=res://art/cinematics/fx/fire_pillar.tscn  at=(-30, 0, 20)  life=6  scale=1.2
  at 0.0  vfx f2  scene=res://art/cinematics/fx/fire_pillar.tscn  at=(30, 3, -30)  life=6  scale=1.2
  at 0.0  vfx f3  scene=res://art/cinematics/fx/fire_pillar.tscn  at=(-10, 4, -28)  life=6  scale=1.0
  at 0.0  vfx f4  scene=res://art/cinematics/fx/fire_pillar.tscn  at=(40, 1, 18)  life=6  scale=1.0
  at 0.3  line ossavar "The harder he held them, the more they slipped. So at last, he came himself."  dur=5.4
  at 4.0  vfx light  scene=res://art/cinematics/fx/sun_pillar.tscn  at=(8, -1.2, -2)  life=2.0  scale=0.3
# Low behind the Master, on the water: he stands on the sea between the fleets, back to camera
shot H12 5.0  set=forge_evenmead  cam=static  from=(13.0, -0.6, 0.6)  look=(4.0, 1.4, -4.0)  fov=42  faces=hooded
  at 0.0  show hooded
  at 0.0  teleport hooded  to=(8.0, -1.2, -2.0)  yaw=-120
  at 0.3  line ossavar "He had never stepped into a war in the open. Not once in a thousand years."  dur=4.6
# Top-down, crane up: he walks; where he steps the waves go flat: a ring of glass over the whole strait
shot H13 4.0  set=forge_evenmead  cam=crane  from=(8.2, 12, -1.9)  to=(8.4, 40, -1.6)  look=(8, -1.2, -2)  fov=44
  at 0.0  fade alpha=0  time=0.3
  at 0.3  vfx glass  scene=res://art/cinematics/fx/freeze_wave.tscn  at=(8, -1.1, -2)  life=3.7  scale=4.0
  at 0.3  line ossavar "He walked out, and the sea went still."  dur=3.4
# CU on the hood, low, static: the face in shadow, the beard of white-gold light
shot H14 3.0  set=forge_evenmead  cam=static  from=(5.6, -0.3, 0.4)  look=(8.0, 1.0, -2.0)  fov=30  faces=hooded
  at 0.6  line master "Enough."  dur=1.6
# WS, eye, slow push: every sword lowers; every dragon lands on the glassy sea around him, heads bowed; Ossavar last
shot H15 5.0  set=forge_evenmead  cam=dolly  from=(30, 1.6, 10)  to=(26, 1.5, 8)  look=(8, 0.6, -2)  fov=42  faces=hooded
  at 0.0  show frostd
  at 0.0  show cinderd
  at 0.3  line ossavar "Every blade stopped. Every dragon came to his hand. Even mine."  dur=4.6

# ---------------------------------------------------------------- the duel he gave them
# The arena's first day: the first Laurel Duel; the Master himself in the stone chair
shot H16 6.0  cam=static  from=(8.0, 2.4, 11.0)  look=(-3.0, 1.4, 7.0)  fov=46  in=fade_white:0.4  faces=old_a,old_b
  at 0.0  fade color=#ffe9c0  alpha=0.15  time=0.05
  at 0.0  hide frostd
  at 0.0  hide cinderd
  at 0.0  hide ossavar
  at 0.0  hide dacian
  at 0.0  hide seraphine
  at 0.0  hide herald
  at 0.0  show old_a
  at 0.0  show old_b
  at 0.0  show cloth
  at 0.0  teleport hooded  to=(-9.3, 0.4, 7.0)  yaw=90
  at 0.3  line ossavar "He gave them one duel a year instead of a war. First blood, and no further."  dur=5.4
  at 1.0  anim old_a play_attack
  at 1.4  anim old_b play_attack
# MS on the chair, slow pull back: the stands full of bettors; the Master alone in his chair
shot H17 3.0  cam=dolly  from=(-6.4, 2.0, 7.2)  to=(-4.8, 2.3, 7.6)  look=(-9.3, 2.0, 7.0)  fov=38  faces=hooded
  at 0.0  hide old_a
  at 0.0  hide old_b
  at 0.0  show archon_g
  at 0.0  show archon_d
  at 0.3  line ossavar "They bowed to him. Then they bet their cities on the duels. They saw only gold."  dur=5.4
# He rises, drops the laurel on the sand and walks out of the south gate without a word
shot H17B 6.0  cam=static  from=(7.0, 1.2, 4.0)  look=(-2.0, 1.4, 10.0)  fov=46  faces=hooded
  at 0.4  move hooded  to=(-6.0, 0, 9.0)  speed=1.4
  at 2.6  move hooded  to=(0.0, 0, 22.0)  speed=2.4
  at 2.8  vfx laurel  scene=res://art/cinematics/fx/blossom.tscn  at=(-7.0, 0.1, 8.0)  life=3.0  scale=0.2
  at 3.0  line ossavar "He left in anger, and never sat there again."  dur=3.0

# ---------------------------------------------------------------- the orrery dome
# Dolly in behind the Master at the orrery: four little flames light one by one over his open hand
shot H18 6.0  set=forge_citadel  cam=dolly  from=(-13, 50.5, 4.4)  to=(-13, 50.3, 2.6)  look=(-13, 50.2, -4)  fov=44  in=fade_white:0.4
  at 0.0  fade color=#ffe9c0  alpha=0  time=0.2
  at 0.0  hide hooded
  at 0.0  hide archon_g
  at 0.0  hide archon_d
  at 0.0  hide y_vessa
  at 0.0  hide y_malrik
  at 0.0  vfx flames scene=res://art/cinematics/fx/four_flames.tscn at=(-11.6, 51.2, -3.2) life=6.0 scale=0.8
  at 0.3  line ossavar "So he stopped holding the world alone, and raised four apprentices to keep it."  dur=5.4
# MS two-shot over the Master's shoulder: Vessa and Malrik before him; Vessa bounces up, Malrik rises slow, smiling
shot H19 9.0  set=forge_citadel  cam=static  from=(-9.4, 50.0, -0.8)  look=(-13.0, 49.3, -4.0)  fov=38  faces=y_vessa,y_malrik
  at 0.0  show y_vessa
  at 0.0  show y_malrik
  at 0.3  line master "Vessa. Malrik. The two harbour cities are yours now. Keep them in peace."  dur=5.2
  at 5.6  anim y_vessa play_cast
  at 5.8  anim y_vessa set_expression  arg=smile
  at 5.8  line vessa "Of course, Master! No problem at all!"  dur=2.2
  at 8.1  line malrik "None whatsoever."  dur=1.3
  at 8.1  anim y_malrik set_expression  arg=smile
# CU two-shot, front, as they walk out past the camera: gold glints in both pairs of eyes
shot H20 5.0  set=forge_citadel  cam=static  from=(-12.6, 49.7, 3.4)  look=(-13.0, 49.3, -1.0)  fov=40  faces=y_vessa,y_malrik
  at 0.0  teleport y_vessa  to=(-13.6, 48, -2.6)  yaw=0
  at 0.0  teleport y_malrik  to=(-12.4, 48, -2.6)  yaw=0
  at 0.3  move y_vessa  to=(-13.6, 48, 1.0)  speed=1.4
  at 0.3  move y_malrik  to=(-12.4, 48, 0.6)  speed=1.2
  at 0.6  line ossavar "They heard gold, and soldiers, for free."  dur=3.0
  at 1.2  vfx glint_v  scene=res://art/cinematics/fx/sun_pillar.tscn  at=(-13.6, 49.5, -1.0)  life=0.5  scale=0.05
  at 1.2  vfx glint_m  scene=res://art/cinematics/fx/sun_pillar.tscn  at=(-12.4, 49.6, -1.2)  life=0.5  scale=0.05

# ---------------------------------------------------------------- the old price (present)
# Slow push past Ossavar to the chair: the empty chair, the torn cloth gone
shot P01 6.0  cam=dolly  from=(8, 3.2, 10)  to=(5, 2.6, 9.2)  look=(-9.5, 0.4, 7.0)  fov=44  in=fade_black:0.4  faces=dacian,seraphine
  at 0.0  fade alpha=0  time=0.05
  at 0.0  hide cloth
  at 0.0  show ossavar
  at 0.0  show dacian
  at 0.0  show seraphine
  at 0.0  teleport ossavar  to=(-14, 0, 7)  yaw=90
  at 0.0  teleport dacian  to=(0.1, 0, 7.6)  yaw=-90
  at 0.0  teleport seraphine  to=(-0.1, 0, 6.4)  yaw=-90
  at 0.3  line ossavar "Now his chair is empty. And I am home."  dur=3.0
# The two Archons rise at the arena's ends; gold pours on one side, diamonds on the other
shot P02 6.0  cam=static  from=(6.0, 2.0, 7.0)  look=(-5.0, 1.6, 7.0)  fov=60  faces=archon_g,archon_d
  at 0.0  show archon_g
  at 0.0  show archon_d
  at 0.3  line ossavar "So the old price stands. Whoever pays the most, I burn for."  dur=4.4
  at 1.5  vfx gold  scene=res://art/cinematics/fx/fire_burst.tscn  at=(-5.0, 0.6, 15.0)  life=3.0  scale=0.5
  at 2.5  vfx dia  scene=res://art/cinematics/fx/ice_burst.tscn  at=(-5.0, 0.6, -1.0)  life=2.0  scale=0.5
# CU two-shot, back to back: they look at each other over their shoulders, then lower their swords
shot P03 5.0  cam=static  from=(2.6, 1.8, 7.0)  look=(0, 1.75, 7.0)  fov=36  faces=dacian,seraphine
  at 0.0  teleport dacian  to=(0.1, 0, 7.6)  yaw=0
  at 0.0  teleport seraphine  to=(-0.1, 0, 6.4)  yaw=180
  at 1.5  face dacian  yaw=-60  time=0.8
  at 2.2  face seraphine  yaw=-120  time=0.8
# Crane up and out: at the horizon, four-coloured sails; the title
shot P04 7.0  cam=crane  from=(10, 4, 14)  to=(40, 40, 50)  look=(0, 1, 7)>(-40, 0, -40)  fov=40>50
  at 0.0  vfx s1  scene=res://art/cinematics/fx/fire_pillar.tscn  at=(-60, 0, 40)  life=7  scale=1.5
  at 0.0  vfx s2  scene=res://art/cinematics/fx/green_pillar.tscn  at=(-70, 0, 20)  life=7  scale=1.5
  at 0.0  vfx s3  scene=res://art/cinematics/fx/umbral_shroud.tscn  at=(-60, 0, -50)  life=7  scale=0.8
  at 0.0  vfx s4  scene=res://art/cinematics/fx/ice_burst.tscn  at=(-70, 2, -30)  life=7  scale=2.0
  at 1.0  line ossavar "And look who has come to bid."  dur=2.4
  at 2.8  title "Episode 7" sub="Gold for Fire" time=3.5
  at 6.2  fade alpha=1 time=0.8
