# e7m1 E11 "e7m1_laurel" (docs/design/mission-e7-01.md, Cinematic hooks; script-episodes-4-8/e7m1.md 1): mode=pause at
# 12:20. 1) MS on the sand, 3/4: four gold-cloaked figures drop from the rim; 2) CU Seraphine, back to the chair, sword
# up (L16); 3) MS Dacian, two Gilded Spears dragging him by the arms (L17); 4) insert: a knife on the sand, a thread of
# violet smoke. The end state spawns the knives on the rim, sends Dacian east and opens obj_seraphine.
# Axis: the Seraphine - Dacian line (-2.5, 2.5) / (2.5, -2.5); every camera on its SOUTH-EAST side.
# Fallback: the end state says L16-L17.
cine e7m1_laurel  title="Gold Cloaks"  mode=pause  letterbox=2.39  seed=712  length=12..19
env day  moon_yaw=225  moon_pitch=-26  energy=0.95
cast  seraphine  capsule  at=(0, 0, -300)  hidden=1
cast  dacian     capsule  at=(0, 0, -310)  hidden=1

# MS on the sand: four gold-cloaked figures drop from the rim
shot K1 3.0  cam=static  from=(7, 3.0, 7)  look=(0, 1.2, 0)  fov=40  in=fade_black:0.3
# CU Seraphine, back to the chair, sword up
shot K2 5.4  cam=static  from=(0.5, 1.7, 5.5)  look=(-2.5, 1.5, 2.5)  fov=30
  at 0.2  line seraphine "Gold cloaks, behind me. So this is how Aurivane wins now."
# MS Dacian, two Gilded Spears dragging him by the arms
shot K3 5.4  cam=static  from=(5.5, 1.8, 0.5)  look=(2.5, 1.4, -2.5)  fov=34
  at 0.2  line dacian "Those aren't mine! Seraphine, those are NOT mine!"
# Insert: a knife on the sand, a thread of violet smoke
shot K4 1.6  cam=static  from=(4.0, 0.6, 4.6)  look=(3, 0.1, 3)  fov=28
  at 0.2  fade color=#8a50d0 alpha=0.25 time=0.6
