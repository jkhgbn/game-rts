# e7m4 E9 "e7m4_turn" (docs/design/mission-e7-04.md, Cinematic hooks): mode=pause when the truce ends. 1) MS Malrik on the
# Adamarch causeway, amber pulse up his arm (L20); 2) ECU the stone (L21); 3) CU Torvald, 3/4, long hold, then "No." (L22);
# 4) OTS Torvald on Malrik (L24; L23 quotes "For now", which the cine grammar cannot hold: the end state says it). Ossavar's answer (L25 / L25a / L25b by flag) and Vessa's L26 are said by the end
# state, which also switches Malrik's seat (the 10 s grace), puts Ossavar on side 0 and raises the silver galleys.
# Axis: the Torvald - Malrik line; every camera on its SOUTH side.
# Fallback: the end state says L20-L26 and applies the turn.
cine e7m4_turn  title="No"  mode=pause  letterbox=2.39  seed=743  length=18..30
env day  moon_yaw=120  moon_pitch=-26  energy=0.9
cast  malrik   capsule  at=(0, 0, -300)  hidden=1
cast  obren    capsule  at=(0, 0, -310)  hidden=1
cast  torvald  capsule  at=(0, 0, -320)  hidden=1

# MS Malrik on the causeway, amber pulse up his arm
shot N1 6.4  cam=static  from=(-12, 1.9, 16)  look=(-15, 1.5, 12)  fov=36  in=fade_black:0.3
  at 0.2  line malrik "Burn them. Both fleets, the sand, the cloth. A strait of dead feeds the stone for years."
  at 0.6  fade color=#ffa040 alpha=0.12 time=1.5
# ECU the stone
shot N2 6.4  cam=static  from=(-14, 1.4, 13)  look=(-15, 1.2, 12)  fov=22
  at 0.2  line obren "Yes, Bishop. A whole sea of them. Feed me, and I will crown you king of the deep."
# CU Torvald, long hold, then: No.
shot N3 4.2  cam=static  from=(-30, 1.8, 30)  look=(-34, 1.7, 34)  fov=28
  at 2.4  line torvald "No."
# OTS Torvald on Malrik
shot N4 5.6  cam=static  from=(-33, 2.2, 36)  look=(-15, 1.5, 12)  fov=32
  at 0.2  line torvald "I am done waiting, Malrik. Aldra. Everyone. To the rock."
