# e8m1_shadow E1: three amber shafts over Duskbarrow, Malrik at his gate (B.9).
# Lines from data/voice/lines/e8m1_shadow.json; the mission's end state says them again (shown once). Fallback: the end state.
cine e8m1_shadow_home  title="Home"  mode=pause  letterbox=2.39  seed=821  length=20..27
env dusk  moon_yaw=120  moon_pitch=-30  energy=0.9
cast  narrator  capsule  at=(0, 0, -300)  hidden=1
cast  malrik  capsule  at=(10, 0, -300)  hidden=1
cast  obren  capsule  at=(20, 0, -300)  hidden=1

shot S1 6.0  cam=static  from=(-20, 16, 20)  look=(0, 0, 8)  fov=50  in=fade_black:0.3
  at 0.2  line narrator "Duskbarrow, city of crypts. Its bishop came home with a stone, and the dead got up to meet it."
shot S2 11.4  cam=static  from=(-32, 1.9, 32)  look=(-36, 1.6, 36)  fov=32
  at 0.2  line malrik "Every grave here, I dug, or my father did. They know my shovel. They don't know this."
  at 5.6  line obren "They are yours, Bishop. Take them back. Use me. Just a little."
shot S3 6.0  cam=static  from=(-35, 1.6, 35)  look=(-36, 1.4, 36)  fov=24
  at 0.2  line malrik "A little. You always say a little."
