# e8m1_shadow E5: the grave without amber (B.9).
# Lines from data/voice/lines/e8m1_shadow.json; the mission's end state says them again (shown once). Fallback: the end state.
cine e8m1_shadow_father  title="Father"  mode=pause  letterbox=2.39  seed=822  length=8..15
env dusk  moon_yaw=120  moon_pitch=-30  energy=0.9
cast  malrik  capsule  at=(0, 0, -300)  hidden=1
cast  obren  capsule  at=(10, 0, -300)  hidden=1

shot S1 6.0  cam=static  from=(30, 1.8, 30)  look=(36, 0.8, 26)  fov=32  in=fade_black:0.3
  at 0.2  line malrik "Father. You taught me where to dig. You never taught me when to stop."
shot S2 5.0  cam=static  from=(34, 1.5, 30)  look=(36, 1.2, 27)  fov=22
  at 0.2  line obren "Use me, and he will stand up and answer you. One question. Any question."
