# e8m3 E8: the King tears his feet out of the pit floor and steps up the ramp (mission-e8-03.md 8.1).
# Lines from data/voice/lines/e8m3.json; the mission's end state says them again (shown once). Fallback: the end state.
cine e8m3_walk  title="The King Walks"  mode=pause  letterbox=2.39  seed=862  length=5..12
env dusk  moon_yaw=120  moon_pitch=-30  energy=0.9
cast  obren  capsule  at=(0, 0, -300)  hidden=1

shot S1 2.0  cam=static  from=(16, 2, 18)  look=(0, 3, 0)  fov=46  in=fade_black:0.3
shot S2 5.8  cam=static  from=(6, 1.2, 10)  look=(0, 4, 0)  fov=40
  at 0.2  line obren "Enough of your little ring. I will walk to the weakest of you and sit on it."
