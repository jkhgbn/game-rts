# e6m4 E1 "e6m4_crack" (docs/design/mission-e6-04.md, Cinematic hooks; script-episodes-4-8/e6m4.md 1): mode=pause at
# 0:00 (the spec's HOLD runs as PAUSE). The mission puts Ysolde at (-14, 14) and Torvald at (14, -14) (the ends of the
# two Crown Bridges) before it plays. 1) CRANE down at dusk over the isle: amber cracks race out from the stone (L1);
# 2) LOW behind the Master kneeling on the stone; 3) WS the moat: stone heads break the surface; 4) two-shot from the
# isle, Ysolde walking on (orbits the live hero, tag `ysolde`) and Torvald (tag `torvald`): L2-L5; 5) CU the Master: L6;
# FADE_BLACK. Lines run 32 s (spec 0:30). The cast stands at the bridge marks for cine's checks.
# Axis: the West Bridge - East Bridge line (north-west / south-east through the stone); every camera on its SOUTH-WEST side.
# Fallback: the end state moves Ysolde to (-30, 30) and Torvald to (30, -30), says L1-L6 and shows the first hint.
cine e6m4_crack  title="The First Crack"  mode=pause  letterbox=2.39  seed=641  length=34..42
env dusk  moon_yaw=225  moon_pitch=-12  energy=0.85
cast  ysolde    res://art/units/wizards/ysolde.tscn   at=(-14, 0, 14)  yaw=135
cast  torvald   res://art/units/wizards/torvald.tscn  at=(14, 0, -14)  yaw=-45
cast  master    capsule  at=(0, 0, -300)  hidden=1
cast  narrator  capsule  at=(0, 0, -310)  hidden=1

# CRANE down at dusk over the isle: amber cracks race out from the stone
shot K1 6.0  cam=crane  from=(-26, 26, 22)  to=(-18, 16, 16)  look=(0, 0, 0)>(0, 0, 0)  fov=50>44  in=fade_black:0.8
  at 0.4  line narrator "Twelve years ago. The Master sent for two of his four. Only two."
  at 2.0  fade color=#ffa040 alpha=0.15 time=3.0
# LOW behind the Master kneeling, hands on the stone
shot K2 6.6  cam=static  from=(-3, 0.9, 4)  look=(0, 1.2, 0)  fov=38
  at 0.3  line master "Ysolde. Torvald. Hold the isle. Whatever climbs out of the water must not touch this stone."
# WS the moat: stone heads break the surface
shot K3 3.0  cam=static  from=(-20, 4.0, 2)  look=(-9, 0.5, -9)  fov=40
# Ysolde walks onto the West Bridge
shot K4 10.4  cam=orbit  pivot=ysolde  r=4.2  h=1.5  deg=200>212
  at 0.2  line torvald "What is under it?"
  at 5.2  line master "My first mistake. His name was Obren."
# Torvald on the East Bridge
shot K5 5.4  cam=orbit  pivot=torvald  r=4.4  h=1.6  deg=200>210
  at 0.2  line ysolde "Should we send for Vessa and Malrik?"
# CU the Master: face in shadow, beard of light
shot K6 7.0  cam=static  from=(-2.2, 1.6, 2.4)  look=(0, 1.3, 0)  fov=30
  at 0.3  line master "Vessa would burn it open to see inside. Malrik would ask what it pays. No."
  at 6.0  fade alpha=1 time=1.0
