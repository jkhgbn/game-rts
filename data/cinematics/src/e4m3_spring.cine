# e4m3 E17 "e4m3_spring" (docs/design/mission-e4-03.md, Cinematic hooks; script-episodes-4-8/e4m3.md 1): 35 s, then the
# victory. mode=pause over the live mission. 1) WS the five glades from above, moss spreading from each, the rime
# retreating in rings (a bloom ring at each grove centre: Hollowfen (18, 44), Stagwatch (44, 14), Heartglade (0, 9),
# Fernhollow (-30, -4), Mossgate (-44, -18)); 2) MS Ysolde and Maelis at the Last Heartwood; 3) ECU Ysolde's hand: the grey
# seed-pod opens, a living green-gold seed inside, pulsing (`green_shoot` VFX missing: a small blossom burst + a green
# glow); 4) WS the Ice withdrawing through the trees, Torvald last, looking back. Ysolde's shots orbit the live hero (tag
# `ysolde`), shot 4 the live `torvald` (MissionE403.torvald); cast positions are stand-ins for cine's checks.
# Axis: the Ysolde - Torvald line (z = x); every camera stays on its SOUTH-WEST side (z > x).
# Lines: L25 (Ysolde), L26 (Maelis), L27 (Ysolde), L28 (narrator, voice-over) (mission DIALOGUE, French in dialogue.po).
# Fallback: the end state says L25-L28 as dialogue cards, then the victory.
cine e4m3_spring  title="Spring in the Sighing Wood"  mode=pause  letterbox=2.39  seed=94  length=32..38
env day  moon_yaw=160  moon_pitch=-24  energy=0.95
cast  ysolde    res://art/units/wizards/ysolde.tscn  at=(3, 0, 14)  yaw=225
cast  maelis    res://art/units/helpers/helper_maelis/helper_maelis.tscn  at=(4.6, 0, 16.2)  yaw=250
cast  torvald   res://art/units/wizards/torvald.tscn  at=(-16, 0, -12)  yaw=45
cast  narrator  capsule  at=(0, 0, -300)  hidden=1

# WS the five glades from above: moss spreading, the rime retreating in rings
shot P1 9.0  cam=crane  from=(-14, 46, 66)  to=(-10, 38, 56)  look=(0, 0, 10)>(2, 0, 12)  fov=60>56  in=fade_black:0.8
  at 0.0  sfx res://assets/audio/forge/sfx/evenmead_amb.wav  vol=-14
  at 0.6  vfx m1  scene=res://art/cinematics/fx/bloom_wave.tscn  at=(18, 0.3, 44)  life=7.0  scale=2.2
  at 1.2  vfx m2  scene=res://art/cinematics/fx/bloom_wave.tscn  at=(44, 0.3, 14)  life=6.6  scale=2.2
  at 1.8  vfx m3  scene=res://art/cinematics/fx/bloom_wave.tscn  at=(0, 0.3, 9)  life=6.2  scale=2.6
  at 2.4  vfx m4  scene=res://art/cinematics/fx/bloom_wave.tscn  at=(-30, 0.3, -4)  life=5.8  scale=2.2
  at 3.0  vfx m5  scene=res://art/cinematics/fx/bloom_wave.tscn  at=(-44, 0.3, -18)  life=5.4  scale=2.2
  at 1.0  sfx res://assets/audio/forge/sfx/sapling_creak.wav  vol=-10
# MS Ysolde and Maelis at the Last Heartwood
shot P2 9.0  cam=orbit  pivot=ysolde  r=4.6  h=1.5  deg=150>166
  at 0.4  line ysolde "You see, Maelis? It always comes back."
  at 4.0  line maelis "Mm. And it brought you a present."
# ECU Ysolde's hand: the grey pod opens, a green-gold seed pulsing inside
shot P3 6.0  cam=orbit  pivot=ysolde  r=2.6  h=1.9  deg=170>180  fov=28
  at 0.6  vfx seed  scene=res://art/cinematics/fx/blossom.tscn  at=(2.6, 1.2, 13.6)  life=4.5  scale=0.3
  at 0.8  vfx glow  scene=res://art/cinematics/fx/green_pillar.tscn  at=(2.6, 1.1, 13.6)  life=4.0  scale=0.06
  at 0.8  sfx res://assets/audio/sfx/spell_vigor_on.wav  vol=-10
  at 2.4  sfx res://assets/audio/forge/sfx/stone_thump.wav  vol=-16
# WS the Ice withdrawing through the trees, Torvald last, looking back
shot P4 11.0  cam=orbit  pivot=torvald  r=9.0  h=3.0  deg=100>118
  at 0.2  sfx res://assets/audio/forge/sfx/snow_step.wav  vol=-10
  at 0.6  line ysolde "The wood can, now. Thank you, Vessa."
  at 4.0  line narrator "Under the frost, very slowly, the Sighing Wood began to breathe again."
  at 9.6  fade alpha=1 time=1.2
