# e4m1 E19 "e4m1_nightfall" (docs/design/mission-e4-01.md, Cinematic hooks; script-episodes-4-8/e4m1.md 1): 30 s, then
# the victory. mode=pause over the live mission. 1) WIDE crane from the B14R mark as the light drops golden -> dusk (a
# violet full-screen tint ramps in over 6 s: the same placeholder ramp as e3m1_dusk); 2) MS Ysolde under the golden tree
# (-16, 48.5), 3/4, villagers sitting in the refuge, Wren asleep against the trunk; 3) CU Ysolde's hand on the bark:
# blossoms open (a blossom burst at the tree side; `bloom_open` clip skipped until Motion Lab); 4) long lens north (the
# S12 mark nudged west, fov 22): Malrik on the ford stones (12, 9), the amber pulse, and one white-gold flicker behind the
# camera on the crest (Vey: a white flash over the frame + a thunder crack); 5) CU Ysolde, front: L33; FADE_BLACK; L34
# over black. Ysolde's shots orbit the live hero (tag `ysolde`); the cast stands by the tree for cine's checks.
# Axis: every camera WEST of the Malrik - Ysolde line. Lines: L31-L33 (mission DIALOGUE), L34 (narrator, voice-over).
# Fallback: the end state says L31-L34 as dialogue cards, then the victory.
cine e4m1_nightfall  title="Nightfall on Lark Hill"  mode=pause  letterbox=2.39  seed=73  length=28..32
env dusk  moon_yaw=230  moon_pitch=-12  energy=0.8
cast  ysolde    res://art/units/wizards/ysolde.tscn  at=(-12, 0, 45)  yaw=225
cast  vessa     res://art/units/wizards/vessa.tscn   at=(6, 0, 31)  yaw=200
cast  narrator  capsule  at=(0, 0, -300)  hidden=1

# WIDE crane from B14R, the light dropping golden -> dusk
shot N1 6.5  cam=crane  from=(-70, 40, 0)  to=(-60, 42, 8)  look=(0, 2, 0)>(-6, 1, 16)  fov=50>46  in=fade_black:0.8
  at 0.0  sfx res://assets/audio/forge/sfx/evenmead_amb.wav  vol=-8
  at 0.4  line ysolde "The ford is his. The hill is ours, and every family on it, and the tree."
  at 0.5  fade color=#2a1838 alpha=0.28 time=6.0
# MS Ysolde under the golden tree, 3/4 from the west; the refuge around her
shot N2 4.5  cam=orbit  pivot=ysolde  r=4.2  h=1.4  deg=175>187
  at 0.4  line vessa "He'll call it a victory, you know."
# CU her hand on the bark: blossoms open
shot N3 3.5  cam=orbit  pivot=ysolde  r=2.6  h=1.9  deg=-160>-150  fov=30
  at 0.3  vfx bloom  scene=res://art/cinematics/fx/blossom.tscn  at=(-12.8, 1.3, 44.2)  life=3.0  scale=0.5
  at 0.4  sfx res://assets/audio/forge/sfx/sapling_creak.wav  vol=-9
# Long lens north from the crest: Malrik on the ford stones, the amber pulse; Vey's flicker behind the camera
shot N4 5.5  cam=dolly  from=(-9.5, 6.4, 36.0)  to=(-9.7, 6.5, 36.6)  look=(12, 1.5, 9)>(12, 1.7, 9)  fov=22>20
  at 0.4  vfx heart  scene=res://art/cinematics/stage_sets/forge_ep3_memories/props/heart_pulse.tscn  at=(12.3, 1.1, 9.4)  life=4.6  scale=0.5
  at 0.5  sfx res://assets/audio/forge/sfx/stone_thump.wav  vol=-8
  at 2.0  sfx res://assets/audio/forge/sfx/stone_thump.wav  vol=-9
  at 3.2  fade color=#fff6dc alpha=0.45 time=0.1
  at 3.2  sfx res://assets/audio/sfx/atk_storm.wav  vol=-10
  at 3.35  fade color=#2a1838 alpha=0.28 time=0.5
# CU Ysolde, front: L33; black; L34 over black
shot N5 10.0  cam=orbit  pivot=ysolde  r=2.2  h=1.55  deg=-140>-132  fov=34
  at 0.3  line ysolde "Let him. Something always grows back. It will not stop."
  at 3.6  fade alpha=1 time=0.8
  at 4.3  line narrator "Night fell. The golden tree still stood, and everyone who made it up the hill slept under it." dur=5.6
