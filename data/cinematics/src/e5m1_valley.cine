# e5m1 E1 "e5m1_valley" (docs/design/mission-e5-01.md, Cinematic hooks; script-episodes-4-8/e5m1.md 1): 15 s at 0:00,
# mode=pause over the live mission (the spec's HOLD runs as PAUSE: MissionBase.play_cutscene freezes the world).
# The Vale of Bells (120 x 120, seed 5101): Valewatch (-38, -42), Vessa's start (-30, -34), Vey 2 m east; the five cold
# beacons Hearthstone (-18, -24), Millrace (-42, 14), Old Bridge (2, 0), the Knoll (36, -18), Bellmouth (26, 34); the
# citadel's cliff on the north edge (z < -54).
# 1) CRANE down from the citadel's cloud-line to the vale (the forge_citadel far card is not in the mission: open sky);
# L1 over it; 2) MS young Vessa (12) and Vey in his prime on the path, the beacon pillars in a row behind them (both
# orbit / frame the live actors: tag `vessa` = the hero's model, `vey` = MissionE5_01.vey; the cast stands at the
# start for cine's checks). Axis: the Vessa - Vey line runs east-west; every camera stays on its SOUTH side.
# Line: L1 (narrator, voice-over). Fallback: the end state says L1-L3 and shows the first hint.
cine e5m1_valley  title="The Vale of Bells"  mode=pause  letterbox=2.39  seed=501  length=13..17
env day  moon_yaw=200  moon_pitch=-38  energy=1.0
cast  vessa     res://art/units/wizards/vessa.tscn                   at=(-30, 0, -34)  yaw=20
cast  vey       res://art/units/helpers/helper_vey/helper_vey.tscn  at=(-28, 0, -34)  yaw=20
cast  narrator  capsule  at=(0, 0, -300)  hidden=1

# CRANE down from the cloud-line over the citadel's cliff to the vale
shot V1 7.5  cam=crane  from=(-6, 46, -74)  to=(-22, 15, -54)  look=(-12, 28, -60)>(-24, 1, -30)  fov=52>46  in=fade_black:0.6
  at 0.0  sfx res://assets/audio/forge/sfx/evenmead_amb.wav  vol=-10
  at 0.4  line narrator "Long before the war, a girl with soot on her hands came down into the Vale of Bells."
# MS young Vessa and Vey on the path, 3/4 from the south; the cold beacons behind them
shot V2 7.5  cam=orbit  pivot=vessa  r=5.2  h=1.4  deg=70>82
  at 0.4  sfx res://assets/audio/forge/sfx/snow_step.wav  vol=-18
  at 6.9  fade alpha=1 time=0.6
