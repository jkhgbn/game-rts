# e8m1_ice E1: the rider at the gate, Torvald at the lever (C.9).
# Lines from data/voice/lines/e8m1_ice.json; the mission's end state says them again (shown once). Fallback: the end state.
cine e8m1_ice_gate  title="The Knock"  mode=pause  letterbox=2.39  seed=831  length=20..27
env dusk  moon_yaw=120  moon_pitch=-30  energy=0.9
cast  narrator  capsule  at=(0, 0, -300)  hidden=1
cast  aldra  capsule  at=(10, 0, -300)  hidden=1
cast  torvald  capsule  at=(20, 0, -300)  hidden=1

shot S1 6.0  cam=static  from=(0, 2.2, -26)  look=(0, 2.0, -18)  fov=40  in=fade_black:0.3
  at 0.2  line narrator "The Hundredwinter Gate. Someone is knocking on it. Someone always was."
shot S2 11.4  cam=static  from=(4, 1.9, -8)  look=(0, 1.6, -12)  fov=32
  at 0.2  line aldra "We don't know what follows them. We could wait. Just until we see."
  at 5.6  line torvald "I always waited until I saw. Then there was nothing left to see."
shot S3 6.0  cam=static  from=(2, 1.4, -10)  look=(0, 1.0, -12)  fov=24
  at 0.2  line torvald "Not this year. Open the gate, Aldra. Or no. I will. My hands, this time."
