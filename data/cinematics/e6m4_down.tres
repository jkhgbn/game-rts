[sub_resource type="Resource" id="Resource_cm34u"]
script = ExtResource("1_74q74")
at = 0.2
speaker = &"master"
text = "Listen, both of you. Tell no one what sleeps here. If the world knows, the world will dig."
voice = "res://assets/audio/voice/master/listen_both_of_you_b938da9c.wav"

[sub_resource type="Resource" id="Resource_s4hao"]
script = ExtResource("1_74q74")
at = 6.6
speaker = &"master"
text = "My regalia are its keys. When I go, they will scatter. Never let them sit in one hand."
voice = "res://assets/audio/voice/master/my_regalia_are_its_7580d6b2.wav"

