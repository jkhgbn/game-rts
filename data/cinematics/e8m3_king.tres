[sub_resource type="Resource" id="Resource_ie5qb"]
script = ExtResource("1_i8xch")
at = 0.2
speaker = &"narrator"
text = "The last thing Obren ever built climbed out of the dark, and it was wearing his throne."
voice = "res://assets/audio/voice/narrator/the_last_thing_obren_c3bdfaca.wav"

[sub_resource type="Resource" id="Resource_rvows"]
script = ExtResource("1_i8xch")
at = 5.6
speaker = &"obren"
text = "A thousand years he held it. A hundred I lay under it. Now I hold everything."
voice = "res://assets/audio/voice/whisper/a_thousand_years_he_a7feb6e7.wav"

[sub_resource type="Resource" id="Resource_mm6mv"]
