[sub_resource type="Resource" id="Resource_4ryds"]
script = ExtResource("1_i8xch")
at = 0.2
speaker = &"vessa"
text = "So we hit him when the chains pull. And we don't let go. I can do that. Probably."
voice = "res://assets/audio/voice/vessa/so_we_hit_him_36e5db58.wav"

[sub_resource type="Resource" id="Resource_qqd60"]
script = ExtResource("1_i8xch")
at = 5.6
speaker = &"torvald"
text = "Hold the line. Ice knows how. The rest of you, copy me."
voice = "res://assets/audio/voice/torvald/hold_the_line_ice_d0fbd6bf.wav"

