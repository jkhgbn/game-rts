[sub_resource type="Resource" id="Resource_l6qeh"]
script = ExtResource("1_i8xch")
at = 0.2
speaker = &"vey"
text = "Chains on every limb. The keys are holding him. Keep the keys standing, and he stays bound."
voice = "res://assets/audio/voice/vey/chains_on_every_limb_6a960cec.wav"

