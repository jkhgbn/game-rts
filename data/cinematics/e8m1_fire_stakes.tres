[sub_resource type="Resource" id="Resource_hqaws"]
script = ExtResource("1_ilagu")
at = 0.2
speaker = &"vessa"
text = "So I just... stand here. For fourteen minutes."
voice = "res://assets/audio/voice/vessa/so_i_just_stand_ae4ac09b.wav"

[sub_resource type="Resource" id="Resource_hopkb"]
script = ExtResource("1_ilagu")
at = 5.6
speaker = &"vey"
text = "The spark first, then the storm. Today the spark waits. I'll be below, talking to the sky."
