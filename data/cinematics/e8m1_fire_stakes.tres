[sub_resource type="Resource" id="Resource_b84ol"]
script = ExtResource("1_ilagu")
at = 0.2
speaker = &"vessa"
text = "Two days early. I'm always early. That's the problem, isn't it?"
voice = "res://assets/audio/voice/vessa/two_days_early_im_df85b485.wav"

[sub_resource type="Resource" id="Resource_hp52d"]
