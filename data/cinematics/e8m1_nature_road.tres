[sub_resource type="Resource" id="Resource_ew7u3"]
script = ExtResource("1_djbsn")
at = 0.2
speaker = &"ysolde"
text = "I grew these walls to keep the war out. They did. They kept everything out."
voice = "res://assets/audio/voice/ysolde/i_grew_these_walls_3eff56ad.wav"

[sub_resource type="Resource" id="Resource_wvka6"]
script = ExtResource("1_djbsn")
at = 5.6
speaker = &"maelis"
text = "They'll fight you, child. They only know the one word you taught them."
voice = "res://assets/audio/voice/maelis/theyll_fight_you_child_513b461f.wav"

