[sub_resource type="Resource" id="Resource_t3uxc"]
script = ExtResource("1_onma5")
at = 0.2
speaker = &"aldra"
text = "We don't know what follows them. We could wait. Just until we see."
voice = "res://assets/audio/voice/aldra/we_dont_know_what_d0f0e649.wav"

[sub_resource type="Resource" id="Resource_i14jq"]
script = ExtResource("1_onma5")
at = 5.6
speaker = &"torvald"
text = "I always waited until I saw. Then there was nothing left to see."
voice = "res://assets/audio/voice/torvald/i_always_waited_until_b5388a57.wav"

[sub_resource type="Resource" id="Resource_287is"]
