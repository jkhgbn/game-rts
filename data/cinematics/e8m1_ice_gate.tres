[sub_resource type="Resource" id="Resource_je76s"]
script = ExtResource("1_onma5")
at = 0.2
speaker = &"torvald"
text = "Not this year. Open the gate, Aldra. Or no. I will. My hands, this time."
voice = "res://assets/audio/voice/torvald/not_this_year_open_e536b1ad.wav"

