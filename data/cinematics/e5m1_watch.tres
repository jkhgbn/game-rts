[sub_resource type="Resource" id="Resource_mthlh"]
script = ExtResource("1_vcxub")
at = 0.3
speaker = &"vey"
text = "Not bad, girl. Remember it: the spark first. Then the storm."
voice = "res://assets/audio/voice/vey/not_bad_girl_remember_074526d1.wav"

[sub_resource type="Resource" id="Resource_fn31q"]
script = ExtResource("1_vcxub")
at = 4.8
speaker = &"vessa"
text = "What storm? I don't have a storm. Do YOU have a storm?"
voice = "res://assets/audio/voice/vessa/what_storm_i_dont_bfa7fb9a.wav"

[sub_resource type="Resource" id="Resource_jce2h"]
script = ExtResource("1_vcxub")
at = 9.0
speaker = &"vey"
text = "Ha. Go and wash your face. You look like a chimney."
