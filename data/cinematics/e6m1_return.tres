[sub_resource type="Resource" id="Resource_lkm6d"]
script = ExtResource("1_i38sv")
at = 0.2
speaker = &"master"
text = "Three winters, and not one stone stood on your ice."
voice = "res://assets/audio/voice/master/three_winters_and_not_885c5243.wav"

[sub_resource type="Resource" id="Resource_3ppx3"]
script = ExtResource("1_i38sv")
at = 4.8
speaker = &"torvald"
text = "They will come back."
voice = "res://assets/audio/voice/torvald/they_will_come_back_e76bab96.wav"

[sub_resource type="Resource" id="Resource_70es6"]
script = ExtResource("1_i38sv")
at = 9.4
speaker = &"master"
text = "Then so will you. Every winter. You are my patience, Torvald."
voice = "res://assets/audio/voice/master/then_so_will_you_67e66592.wav"

