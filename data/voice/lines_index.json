  },
  {
   "id": "master/he_raised_four_apprentices_1eed795c",
   "speaker": "master",
   "text": "He raised four apprentices, and gave each of them a kingdom.",
   "text_hash": "1eed795cce0d2e70",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:30",
     "ref": "prologue_3min/S06@0.3",
