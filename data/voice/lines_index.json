    }
   ]
  },
  {
   "id": "master/four_heirs_one_empty_8bd4c10b",
   "speaker": "master",
   "text": "Four heirs. One empty throne.",
   "text_hash": "8bd4c10b54f8192f",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:49",
