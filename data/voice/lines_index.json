     "kind": "cine",
     "source": "data/voice/lines/prologue_3min.json",
     "ref": "prologue_3min/L28",
     "slot": 5.7,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "master/dragons_great_and_small_d6939132",
   "speaker": "master",
   "text": "Dragons great and small filled its sky, and not one breathed in anger.",
   "text_hash": "d6939132db627219",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:24",
     "ref": "prologue_3min/S04@0.4",
     "slot": 6.5,
