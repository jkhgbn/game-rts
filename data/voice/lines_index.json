     "slot": 5.7,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "master/he_thinks_i_gave_10970b83",
   "speaker": "master",
   "text": "He thinks I gave him leftovers. I gave the dark to the one it could not frighten.",
   "text_hash": "10970b8344a66eb8",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:76",
     "ref": "prologue_3min/S21@0.3",
     "slot": 7.6,
     "slot_kind": "cine shot",
