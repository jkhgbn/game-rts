    },
    {
     "kind": "cine",
     "source": "data/voice/lines/prologue_3min.json",
     "ref": "prologue_3min/L03",
     "slot": 6.6,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "master/i_know_this_tale_705bd7cd",
   "speaker": "master",
   "text": "I know this tale well, child. I was that wizard.",
   "text_hash": "705bd7cd5f116992",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:52",
     "ref": "prologue_3min/S13@0.8",
     "slot": 5.1,
     "slot_kind": "cine shot",
     "speaker_id": "master"
    },
    {
     "kind": "cine",
     "source": "data/voice/lines/prologue_3min.json",
     "ref": "prologue_3min/L13",
     "slot": 5.2,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "master/i_left_him_my_5d4b36a7",
   "speaker": "master",
   "text": "I left him my coldest secret. Torvald was my patience.",
   "text_hash": "5d4b36a7e29481e5",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:88",
     "ref": "prologue_3min/S25@0.3",
     "slot": 5.6,
     "slot_kind": "cine shot",
