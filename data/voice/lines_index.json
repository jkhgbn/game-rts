 "lines": [
  {
   "id": "malrik/and_me_he_gave_ad0ff01f",
   "speaker": "malrik",
   "text": "And me? He gave me what was left over. The dark. As if it were a kindness.",
   "text_hash": "ad0ff01fbd4b21d5",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep3_opening.json",
     "ref": "ep3_opening/L5",
     "slot": 5.0,
     "slot_kind": "cine slot",
     "speaker_id": "malrik"
    }
   ]
  },
  {
   "id": "malrik/everyone_tells_my_story_b15bf545",
   "speaker": "malrik",
   "text": "Everyone tells my story wrong. Let me try.",
   "text_hash": "b15bf5452aa0193a",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep3_opening.json",
     "ref": "ep3_opening/L1",
     "slot": 3.4,
     "slot_kind": "cine slot",
     "speaker_id": "malrik"
    }
   ]
  },
  {
   "id": "malrik/i_have_heard_stop_6b5d1395",
   "speaker": "malrik",
   "text": "I have heard \"stop\" all my life.",
   "text_hash": "6b5d13958af57d5b",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep3_opening.json",
     "ref": "ep3_opening/L14",
     "slot": 2.6,
     "slot_kind": "cine slot",
     "speaker_id": "malrik"
    }
   ]
  },
  {
   "id": "malrik/i_kept_something_a_95e665a5",
   "speaker": "malrik",
   "text": "I kept something. A candle. A knife. A stone that still beats in my hand.",
   "text_hash": "95e665a59374e8a4",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep3_opening.json",
     "ref": "ep3_opening/L9",
     "slot": 5.0,
     "slot_kind": "cine slot",
     "speaker_id": "malrik"
    }
   ]
  },
  {
   "id": "malrik/i_took_the_dark_7ada4fa9",
   "speaker": "malrik",
   "text": "I took the dark and taught it to kneel. I took knives, and a woman who never misses.",
   "text_hash": "7ada4fa9d73373e0",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep3_opening.json",
     "ref": "ep3_opening/L7",
     "slot": 5.6,
     "slot_kind": "cine slot",
     "speaker_id": "malrik"
    }
   ]
  },
  {
   "id": "malrik/i_was_a_gravediggers_c1b95674",
   "speaker": "malrik",
   "text": "I was a gravedigger's son. I grew up among the dead. They were better company.",
   "text_hash": "c1b95674a3a46b9e",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep3_opening.json",
     "ref": "ep3_opening/L2",
     "slot": 5.2,
     "slot_kind": "cine slot",
     "speaker_id": "malrik"
    }
   ]
  },
  {
   "id": "malrik/i_will_not_stop_0b262bfa",
   "speaker": "malrik",
   "text": "I will not stop.",
   "text_hash": "0b262bfa4db2909c",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep3_opening.json",
     "ref": "ep3_opening/L15",
     "slot": 2.0,
     "slot_kind": "cine slot",
     "speaker_id": "malrik"
    }
   ]
  },
  {
   "id": "malrik/it_whispers_let_it_f35c4d4b",
   "speaker": "malrik",
   "text": "It whispers. Let it. I am the one who listens, and I am the one who decides.",
   "text_hash": "f35c4d4bf0ad4088",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep3_opening.json",
     "ref": "ep3_opening/L10",
     "slot": 5.2,
     "slot_kind": "cine slot",
     "speaker_id": "malrik"
    }
   ]
  },
  {
   "id": "malrik/keep_it_warm_for_3523ab04",
   "speaker": "malrik",
   "text": "Keep it warm for me. The other three will come for it now.",
   "text_hash": "3523ab04fca3d563",
   "sources": [
    {
     "kind": "mission",
     "source": "scripts/campaign/mission_01.gd:DIALOGUE[12]",
     "ref": "L13",
     "slot": 5.0,
     "slot_kind": "subtitle",
     "speaker_id": "malrik"
    }
   ]
  },
  {
   "id": "malrik/light_all_the_candles_d4719180",
   "speaker": "malrik",
   "text": "Light all the candles you like. The dark just gets a better view.",
   "text_hash": "d471918032d40738",
   "sources": [
    {
     "kind": "mission",
     "source": "scripts/campaign/mission_01.gd:DIALOGUE[7]",
     "ref": "L8",
     "slot": 5.0,
     "slot_kind": "subtitle",
     "speaker_id": "malrik"
    }
   ]
  },
  {
   "id": "malrik/little_vessa_you_came_e419427c",
   "speaker": "malrik",
   "text": "Little Vessa. You came a long way to lose something you never had.",
   "text_hash": "e419427c87be0ed0",
   "sources": [
    {
     "kind": "mission",
     "source": "scripts/campaign/mission_01.gd:DIALOGUE[3]",
     "ref": "L4",
     "slot": 5.0,
     "slot_kind": "subtitle",
     "speaker_id": "malrik"
    }
   ]
  },
  {
   "id": "malrik/look_at_it_the_489223a3",
   "speaker": "malrik",
   "text": "Look at it. The last green country. Flowers to the knee. The Master's garden.",
   "text_hash": "489223a3e77c8619",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep3_opening.json",
     "ref": "ep3_opening/L12",
     "slot": 4.8,
     "slot_kind": "cine slot",
     "speaker_id": "malrik"
    }
   ]
  },
  {
   "id": "malrik/put_it_down_that_da2e3fa9",
   "speaker": "malrik",
   "text": "Put it down. That crown was never meant for someone who throws fire at her problems.",
   "text_hash": "da2e3fa9f83f9ffa",
   "sources": [
    {
     "kind": "mission",
     "source": "scripts/campaign/mission_01.gd:DIALOGUE[10]",
     "ref": "L11",
     "slot": 5.0,
     "slot_kind": "subtitle",
     "speaker_id": "malrik"
    }
   ]
  },
  {
   "id": "malrik/she_missed_emberfall_then_fbb05401",
   "speaker": "malrik",
   "text": "She missed. Emberfall. Then the Hollow. I lost, and lost, and every time I lost,",
   "text_hash": "fbb05401ec27cf46",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep3_opening.json",
     "ref": "ep3_opening/L8",
     "slot": 5.3,
     "slot_kind": "cine slot",
     "speaker_id": "malrik"
    }
   ]
  },
  {
   "id": "malrik/that_is_how_a_dfbf8c00",
   "speaker": "malrik",
   "text": "That is how a gravedigger's son grows strong: he never puts the shovel down.",
   "text_hash": "dfbf8c0015892647",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep3_opening.json",
     "ref": "ep3_opening/L11",
     "slot": 5.2,
     "slot_kind": "cine slot",
     "speaker_id": "malrik"
    }
   ]
  },
  {
   "id": "malrik/the_master_found_me_68a72082",
   "speaker": "malrik",
   "text": "The Master found me reading tombstones by one candle. He said: this one, too.",
   "text_hash": "68a72082c951e7f2",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep3_opening.json",
     "ref": "ep3_opening/L3",
     "slot": 5.2,
     "slot_kind": "cine slot",
     "speaker_id": "malrik"
    }
   ]
  },
  {
   "id": "malrik/then_he_vanished_and_877f4086",
   "speaker": "malrik",
   "text": "Then he vanished and left us nothing. So I took. That is the whole secret.",
   "text_hash": "877f408619161872",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep3_opening.json",
     "ref": "ep3_opening/L6",
     "slot": 5.0,
     "slot_kind": "cine slot",
     "speaker_id": "malrik"
    }
   ]
  },
  {
   "id": "malrik/they_will_stand_there_52f7eb60",
   "speaker": "malrik",
   "text": "They will stand there and tell me to stop. Fire. Roots. An old man's storm.",
   "text_hash": "52f7eb605616027e",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep3_opening.json",
     "ref": "ep3_opening/L13",
     "slot": 4.5,
     "slot_kind": "cine slot",
     "speaker_id": "malrik"
    }
   ]
  },
  {
   "id": "malrik/too_fourth_of_four_de85a128",
   "speaker": "malrik",
   "text": "Too. Fourth of four. Fire was his joy, ice his patience, the wood his heart.",
   "text_hash": "de85a128714aa26b",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep3_opening.json",
     "ref": "ep3_opening/L4",
     "slot": 5.2,
     "slot_kind": "cine slot",
     "speaker_id": "malrik"
    }
   ]
  },
  {
   "id": "master/burn_her_forest_down_16f3dda5",
   "speaker": "master",
   "text": "Burn her forest down, and it grows back. Every spring. Every time.",
   "text_hash": "16f3dda5b181e03d",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:94",
     "ref": "prologue_3min/S27@0.3",
     "slot": 6.6,
     "slot_kind": "cine shot",
     "speaker_id": "master"
    },
    {
     "kind": "cine",
     "source": "data/voice/lines/prologue_3min.json",
     "ref": "prologue_3min/L27",
     "slot": 6.7,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "master/but_he_is_never_adfcea4c",
   "speaker": "master",
   "text": "But he is never full. Whatever he holds, he wants more.",
   "text_hash": "adfcea4cc1c720b7",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:73",
     "ref": "prologue_3min/S20@0.3",
     "slot": 5.6,
     "slot_kind": "cine shot",
     "speaker_id": "master"
    },
    {
     "kind": "cine",
     "source": "data/voice/lines/prologue_3min.json",
     "ref": "prologue_3min/L20",
     "slot": 5.7,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "master/but_he_waits_too_7019f3d6",
   "speaker": "master",
   "text": "But he waits too long, and trusts slow ice more than quick friends.",
   "text_hash": "7019f3d63fa79bfb",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:85",
     "ref": "prologue_3min/S24@0.3",
     "slot": 6.6,
     "slot_kind": "cine shot",
     "speaker_id": "master"
    },
    {
     "kind": "cine",
     "source": "data/voice/lines/prologue_3min.json",
     "ref": "prologue_3min/L24",
     "slot": 6.7,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "master/but_she_never_waits_a66dd99c",
   "speaker": "master",
   "text": "But she never waits. And fire that will not wait burns its own house.",
   "text_hash": "a66dd99c60e94b27",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:61",
     "ref": "prologue_3min/S16@0.3",
     "slot": 6.6,
     "slot_kind": "cine shot",
     "speaker_id": "master"
    },
    {
     "kind": "cine",
     "source": "data/voice/lines/prologue_3min.json",
     "ref": "prologue_3min/L16",
     "slot": 6.7,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "master/but_she_will_not_f0c2364f",
   "speaker": "master",
   "text": "But she will not take a side, not even while the world burns.",
   "text_hash": "f0c2364fea6aa644",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:97",
     "ref": "prologue_3min/S28@0.3",
     "slot": 5.6,
     "slot_kind": "cine shot",
