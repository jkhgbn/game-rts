     "ref": "prologue_3min/L29",
     "slot": 6.7,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "master/kings_brought_him_their_38ebe69c",
   "speaker": "master",
   "text": "Kings brought him their quarrels, and went home as friends.",
   "text_hash": "38ebe69c86e2987a",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:27",
     "ref": "prologue_3min/S05@0.3",
     "slot": 5.6,
     "slot_kind": "cine shot",
     "speaker_id": "master"
    },
    {
     "kind": "cine",
     "source": "data/voice/lines/prologue_3min.json",
     "ref": "prologue_3min/L05",
     "slot": 5.7,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "master/malrik_i_found_him_915e2c7f",
   "speaker": "master",
   "text": "Malrik. I found him reading tombstones by the light of one candle.",
   "text_hash": "915e2c7fe62d85cc",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:67",
     "ref": "prologue_3min/S18@0.3",
     "slot": 5.6,
     "slot_kind": "cine shot",
     "speaker_id": "master"
    },
    {
     "kind": "cine",
     "source": "data/voice/lines/prologue_3min.json",
     "ref": "prologue_3min/L18",
     "slot": 5.7,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "master/malrik_of_shadow_b1f1cf04",
   "speaker": "master",
   "text": "Malrik, of Shadow.",
   "text_hash": "b1f1cf04857aa684",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:40",
     "ref": "prologue_3min/S09@0.2",
     "slot": 2.7,
     "slot_kind": "cine shot",
     "speaker_id": "master"
    },
    {
     "kind": "cine",
     "source": "data/voice/lines/prologue_3min.json",
     "ref": "prologue_3min/L09",
     "slot": 2.8,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "master/nothing_breaks_him_not_9a4ca6da",
   "speaker": "master",
   "text": "Nothing breaks him. Not armies, not winters. Not time.",
   "text_hash": "9a4ca6dacc803e22",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:82",
     "ref": "prologue_3min/S23@0.3",
     "slot": 6.6,
     "slot_kind": "cine shot",
     "speaker_id": "master"
    },
    {
     "kind": "cine",
     "source": "data/voice/lines/prologue_3min.json",
     "ref": "prologue_3min/L23",
     "slot": 6.7,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "master/nothing_is_hidden_from_3efbf049",
   "speaker": "master",
   "text": "Nothing is hidden from him. The dark itself comes when he calls.",
   "text_hash": "3efbf04925f7f5fa",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:70",
     "ref": "prologue_3min/S19@0.3",
     "slot": 6.6,
     "slot_kind": "cine shot",
     "speaker_id": "master"
    },
    {
     "kind": "cine",
     "source": "data/voice/lines/prologue_3min.json",
     "ref": "prologue_3min/L19",
     "slot": 6.7,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "master/once_upon_a_time_74703b43",
   "speaker": "master",
   "text": "Once upon a time, the strongest wizard of all time ruled the world.",
   "text_hash": "74703b43c785f0b5",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:15",
     "ref": "prologue_3min/S01@1.2",
     "slot": 5.7,
     "slot_kind": "cine shot",
     "speaker_id": "master"
    },
    {
     "kind": "cine",
     "source": "data/voice/lines/prologue_3min.json",
     "ref": "prologue_3min/L01",
     "slot": 5.8,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "master/still_she_laughed_like_57d11b3e",
   "speaker": "master",
   "text": "Still, she laughed like sunrise. Vessa was my joy.",
   "text_hash": "57d11b3eb25f5ecf",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:64",
     "ref": "prologue_3min/S17@0.3",
     "slot": 5.6,
     "slot_kind": "cine shot",
     "speaker_id": "master"
    },
    {
     "kind": "cine",
     "source": "data/voice/lines/prologue_3min.json",
     "ref": "prologue_3min/L17",
     "slot": 5.7,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "master/then_between_one_breath_72b919e2",
   "speaker": "master",
   "text": "Then, between one breath and the next, he was gone.",
   "text_hash": "72b919e2bdc1f864",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:33",
     "ref": "prologue_3min/S07@0.3",
     "slot": 4.6,
     "slot_kind": "cine shot",
     "speaker_id": "master"
    },
    {
     "kind": "cine",
     "source": "data/voice/lines/prologue_3min.json",
     "ref": "prologue_3min/L07",
     "slot": 4.7,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "master/they_called_him_only_31069c93",
   "speaker": "master",
   "text": "They called him only the Master. For a thousand years, he kept the peace.",
   "text_hash": "31069c93a08e49eb",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:18",
     "ref": "prologue_3min/S02@0.4",
     "slot": 6.5,
     "slot_kind": "cine shot",
     "speaker_id": "master"
    },
    {
     "kind": "cine",
     "source": "data/voice/lines/prologue_3min.json",
     "ref": "prologue_3min/L02",
     "slot": 6.6,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "master/torvald_of_ice_8995149a",
   "speaker": "master",
   "text": "Torvald, of Ice.",
   "text_hash": "8995149acd87f3f6",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:43",
     "ref": "prologue_3min/S10@0.2",
     "slot": 2.7,
     "slot_kind": "cine shot",
     "speaker_id": "master"
    },
    {
     "kind": "cine",
     "source": "data/voice/lines/prologue_3min.json",
     "ref": "prologue_3min/L10",
     "slot": 2.8,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "master/torvald_the_eldest_where_f5a25caa",
   "speaker": "master",
   "text": "Torvald, the eldest. Where he stands, the ice holds, and so does the line.",
   "text_hash": "f5a25caa1ad48cad",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:79",
     "ref": "prologue_3min/S22@0.3",
     "slot": 6.6,
     "slot_kind": "cine shot",
     "speaker_id": "master"
    },
    {
     "kind": "cine",
     "source": "data/voice/lines/prologue_3min.json",
     "ref": "prologue_3min/L22",
     "slot": 6.7,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "master/vessa_of_fire_629e6c64",
   "speaker": "master",
   "text": "Vessa, of Fire.",
   "text_hash": "629e6c6419893c4b",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:37",
     "ref": "prologue_3min/S08@0.2",
     "slot": 2.7,
     "slot_kind": "cine shot",
     "speaker_id": "master"
    },
    {
     "kind": "cine",
     "source": "data/voice/lines/prologue_3min.json",
     "ref": "prologue_3min/L08",
     "slot": 2.8,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "master/vessa_the_youngest_she_0f7ca4c7",
   "speaker": "master",
   "text": "Vessa, the youngest. She lit her first spark before she could spell her name.",
   "text_hash": "0f7ca4c7ce5a7bbb",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:55",
     "ref": "prologue_3min/S14@0.3",
     "slot": 6.6,
     "slot_kind": "cine shot",
     "speaker_id": "master"
    },
    {
     "kind": "cine",
     "source": "data/voice/lines/prologue_3min.json",
     "ref": "prologue_3min/L14",
     "slot": 6.7,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "master/ysolde_i_found_her_85d2e563",
   "speaker": "master",
   "text": "Ysolde. I found her coaxing a sapling through the frost.",
   "text_hash": "85d2e563e1b4c4e4",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:91",
     "ref": "prologue_3min/S26@0.3",
     "slot": 6.6,
     "slot_kind": "cine shot",
     "speaker_id": "master"
    },
    {
     "kind": "cine",
     "source": "data/voice/lines/prologue_3min.json",
     "ref": "prologue_3min/L26",
     "slot": 6.7,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "master/ysolde_of_nature_23123983",
   "speaker": "master",
   "text": "Ysolde, of Nature.",
   "text_hash": "231239830b7bd183",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:46",
     "ref": "prologue_3min/S11@0.2",
     "slot": 2.7,
     "slot_kind": "cine shot",
     "speaker_id": "master"
    },
    {
     "kind": "cine",
     "source": "data/voice/lines/prologue_3min.json",
     "ref": "prologue_3min/L11",
     "slot": 2.8,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "narrator/far_away_three_apprentices_c4c409b3",
   "speaker": "narrator",
   "text": "Far away, three apprentices feel the crown wake up, and begin to worry.",
   "text_hash": "c4c409b3f2522bd7",
   "sources": [
    {
     "kind": "mission",
     "source": "scripts/campaign/mission_01.gd:DIALOGUE[13]",
     "ref": "L14",
     "slot": 5.0,
     "slot_kind": "subtitle",
     "speaker_id": "narrator"
    }
   ]
  },
  {
   "id": "narrator/the_master_is_gone_e050d7b6",
   "speaker": "narrator",
   "text": "The Master is gone. His crown is not.",
   "text_hash": "e050d7b6908fd5fc",
   "sources": [
    {
     "kind": "mission",
     "source": "scripts/campaign/mission_01.gd:DIALOGUE[0]",
     "ref": "L1",
     "slot": 5.0,
     "slot_kind": "subtitle",
     "speaker_id": "narrator"
    }
   ]
  },
  {
   "id": "narrator/the_westwatch_fire_rises_d7e80c5e",
   "speaker": "narrator",
   "text": "The Westwatch fire rises. Riders who remember the old kingdom ride to meet it.",
   "text_hash": "d7e80c5e3bcec0d2",
   "sources": [
    {
     "kind": "mission",
     "source": "scripts/campaign/mission_01.gd:DIALOGUE[6]",
     "ref": "L7",
     "slot": 5.0,
     "slot_kind": "subtitle",
     "speaker_id": "narrator"
    }
   ]
  },
  {
   "id": "narrator/three_flames_answer_the_69a75470",
   "speaker": "narrator",
   "text": "Three flames answer. The seal cracks, and the old wardens wake up grumpy.",
   "text_hash": "69a754704167c6e6",
   "sources": [
    {
     "kind": "mission",
     "source": "scripts/campaign/mission_01.gd:DIALOGUE[8]",
     "ref": "L9",
     "slot": 5.0,
     "slot_kind": "subtitle",
     "speaker_id": "narrator"
    }
   ]
  },
  {
   "id": "pell/free_at_last_buy_f2b6c6c4",
   "speaker": "pell",
   "text": "Free at last! Buy something, would you? Shadow soldiers are terrible customers. They never pay, they just loom.",
   "text_hash": "f2b6c6c41860425e",
   "sources": [
    {
     "kind": "mission",
     "source": "scripts/campaign/mission_01.gd:DIALOGUE[5]",
     "ref": "L6",
     "slot": 5.0,
     "slot_kind": "subtitle",
     "speaker_id": "pell"
    }
   ]
  },
  {
   "id": "shade/the_keep_sleeps_so_dac3a4b3",
   "speaker": "shade",
   "text": "The keep sleeps. So should you.",
   "text_hash": "dac3a4b321ad2ac2",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/watch_keep.cine:28",
     "ref": "watch_keep/S5@0.8",
     "slot": 5.2,
     "slot_kind": "cine shot",
     "speaker_id": "shade"
    }
   ]
  },
  {
   "id": "vessa/an_ember_crown_in_21770f9f",
   "speaker": "vessa",
   "text": "An Ember Crown, in a place called Emberfall. I'm not saying it was left for me. I'm not NOT saying it.",
   "text_hash": "21770f9fac450741",
   "sources": [
    {
     "kind": "mission",
     "source": "scripts/campaign/mission_01.gd:DIALOGUE[1]",
     "ref": "L2",
     "slot": 5.0,
     "slot_kind": "subtitle",
     "speaker_id": "vessa"
    }
   ]
  },
  {
   "id": "vessa/im_here_for_the_10aceb62",
   "speaker": "vessa",
   "text": "I'm here for the crown, not a lecture. Fine. Both.",
   "text_hash": "10aceb623b16b943",
   "sources": [
    {
     "kind": "mission",
     "source": "scripts/campaign/mission_01.gd:DIALOGUE[9]",
     "ref": "L10",
     "slot": 5.0,
     "slot_kind": "subtitle",
     "speaker_id": "vessa"
    }
   ]
  },
  {
   "id": "vessa/not_tonight_0703ac9b",
   "speaker": "vessa",
   "text": "Not tonight.",
   "text_hash": "0703ac9b9f0d1c85",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/watch_keep.cine:36",
     "ref": "watch_keep/S7@1.2",
     "slot": 3.8,
     "slot_kind": "cine shot",
     "speaker_id": "vessa"
    }
   ]
  },
  {
   "id": "vessa/one_lit_malrik_you_c51368de",
   "speaker": "vessa",
   "text": "One lit. Malrik, you still dress like a funeral that got lost on the way.",
   "text_hash": "c51368dea356c1f5",
   "sources": [
    {
     "kind": "mission",
     "source": "scripts/campaign/mission_01.gd:DIALOGUE[4]",
     "ref": "L5",
     "slot": 5.0,
     "slot_kind": "subtitle",
     "speaker_id": "vessa"
    }
   ]
  },
  {
   "id": "vessa/tell_the_others_i_62fd53ca",
   "speaker": "vessa",
   "text": "Tell the others... I was winning.",
   "text_hash": "62fd53ca653f5647",
   "sources": [
    {
     "kind": "mission",
     "source": "scripts/campaign/mission_01.gd:DIALOGUE[14]",
     "ref": "L15",
     "slot": 5.0,
     "slot_kind": "subtitle",
     "speaker_id": "vessa"
    }
   ]
  },
  {
   "id": "vessa/the_watch_fires_are_67de4a2b",
   "speaker": "vessa",
   "text": "The watch fires are out. All of them.",
   "text_hash": "67de4a2b92ded3d4",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/watch_keep.cine:19",
     "ref": "watch_keep/S2@0.8",
     "slot": 5.2,
     "slot_kind": "cine shot",
     "speaker_id": "vessa"
    }
   ]
  },
  {
   "id": "vessa/then_its_in_the_02a82f6a",
   "speaker": "vessa",
   "text": "Then it's in the right hands. I throw fire at ALL my problems.",
   "text_hash": "02a82f6a4e7d6f22",
   "sources": [
    {
     "kind": "mission",
     "source": "scripts/campaign/mission_01.gd:DIALOGUE[11]",
     "ref": "L12",
     "slot": 5.0,
     "slot_kind": "subtitle",
     "speaker_id": "vessa"
    }
   ]
  },
  {
   "id": "vessa/three_braziers_one_seal_a933259b",
   "speaker": "vessa",
   "text": "Three braziers, one seal. How hard can it be to light things? It's my whole personality.",
   "text_hash": "a933259b39d98cf8",
   "sources": [
    {
     "kind": "mission",
     "source": "scripts/campaign/mission_01.gd:DIALOGUE[2]",
     "ref": "L3",
     "slot": 5.0,
     "slot_kind": "subtitle",
     "speaker_id": "vessa"
    }
   ]
  },
  {
   "id": "vessa/who_walks_the_wall_45dd4c19",
   "speaker": "vessa",
   "text": "Who walks the wall at this hour?",
   "text_hash": "45dd4c199b4131fe",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/two_wizards.cine:8",
     "ref": "two_wizards/S1@0.5",
     "slot": 3.5,
     "slot_kind": "cine shot",
     "speaker_id": "vessa"
    }
   ]
  },
  {
   "id": "vessa/you_are_a_long_e1ae8fe0",
   "speaker": "vessa",
   "text": "You are a long way from the dark, shade.",
   "text_hash": "e1ae8fe0fa50589c",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/watch_keep.cine:26",
     "ref": "watch_keep/S4@0.6",
     "slot": 4.4,
     "slot_kind": "cine shot",
     "speaker_id": "vessa"
    }
   ]
  },
  {
   "id": "vessa/ysolde_theyre_moving_a67643f3",
   "speaker": "vessa",
   "text": "Ysolde. They're moving.",
   "text_hash": "a67643f3643c8e79",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep4_opening.json",
     "ref": "ep4_opening/L14",
     "slot": 1.8,
     "slot_kind": "cine slot",
     "speaker_id": "vessa"
    }
   ]
  },
  {
   "id": "ysolde/a_tall_man_with_160c2abd",
   "speaker": "ysolde",
   "text": "A tall man with a burning hem found me coaxing a sapling through the frost.",
   "text_hash": "160c2abd7cad39ef",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep4_opening.json",
     "ref": "ep4_opening/L5",
     "slot": 5.1,
     "slot_kind": "cine slot",
     "speaker_id": "ysolde"
    }
   ]
  },
  {
   "id": "ysolde/he_said_show_me_79d79140",
   "speaker": "ysolde",
   "text": "He said: show me again. So I did, for twenty years, until he was gone.",
   "text_hash": "79d791406f654759",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep4_opening.json",
     "ref": "ep4_opening/L6",
     "slot": 5.0,
     "slot_kind": "cine slot",
     "speaker_id": "ysolde"
    }
   ]
  },
  {
   "id": "ysolde/i_knelt_in_the_143cbc56",
   "speaker": "ysolde",
   "text": "I knelt in the black, and I waited. Something green came up. It always does.",
   "text_hash": "143cbc56e179a416",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep4_opening.json",
     "ref": "ep4_opening/L9",
     "slot": 5.2,
     "slot_kind": "cine slot",
     "speaker_id": "ysolde"
    }
   ]
  },
  {
   "id": "ysolde/i_was_born_on_fbe13b97",
   "speaker": "ysolde",
   "text": "I was born on that hill, the year nothing grew. Not one blade of grass.",
   "text_hash": "fbe13b971d2a9e95",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep4_opening.json",
     "ref": "ep4_opening/L2",
     "slot": 5.0,
     "slot_kind": "cine slot",
     "speaker_id": "ysolde"
    }
   ]
  },
  {
   "id": "ysolde/in_spring_it_came_67120205",
   "speaker": "ysolde",
   "text": "In spring it came up green. I have never forgotten how that felt.",
   "text_hash": "67120205cac3f87e",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep4_opening.json",
     "ref": "ep4_opening/L4",
     "slot": 4.4,
     "slot_kind": "cine slot",
     "speaker_id": "ysolde"
    }
   ]
  },
  {
   "id": "ysolde/it_will_not_stop_46dfa508",
   "speaker": "ysolde",
   "text": "It will not stop.",
   "text_hash": "46dfa508ee291761",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep4_opening.json",
     "ref": "ep4_opening/L15",
     "slot": 2.0,
     "slot_kind": "cine slot",
     "speaker_id": "ysolde"
    }
   ]
  },
  {
   "id": "ysolde/last_winter_they_burned_e017cf01",
   "speaker": "ysolde",
   "text": "Last winter they burned my wood and froze the ashes. My army with it.",
   "text_hash": "e017cf01a68a078a",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep4_opening.json",
     "ref": "ep4_opening/L8",
     "slot": 5.0,
     "slot_kind": "cine slot",
     "speaker_id": "ysolde"
    }
   ]
  },
  {
   "id": "ysolde/let_them_come_cut_d956830a",
   "speaker": "ysolde",
   "text": "Let them come. Cut it. Burn it. Freeze it.",
   "text_hash": "d956830a45f84779",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep4_opening.json",
     "ref": "ep4_opening/L13",
     "slot": 3.2,
     "slot_kind": "cine slot",
     "speaker_id": "ysolde"
    }
   ]
  },
  {
   "id": "ysolde/malrik_stands_up_there_5121c046",
   "speaker": "ysolde",
   "text": "Malrik stands up there with his candle, his stone, and Torvald's winter.",
   "text_hash": "5121c04679366284",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep4_opening.json",
     "ref": "ep4_opening/L12",
     "slot": 4.6,
     "slot_kind": "cine slot",
     "speaker_id": "ysolde"
    }
   ]
  },
  {
   "id": "ysolde/malrik_tells_his_life_52243579",
   "speaker": "ysolde",
   "text": "Malrik tells his life as a list of wounds. Mine is a list of winters.",
   "text_hash": "52243579a9625344",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep4_opening.json",
     "ref": "ep4_opening/L1",
     "slot": 4.6,
     "slot_kind": "cine slot",
     "speaker_id": "ysolde"
    }
   ]
  },
  {
   "id": "ysolde/my_mother_buried_seed_b7d7b32b",
   "speaker": "ysolde",
   "text": "My mother buried seed in the snow. The village laughed. I watched it sleep.",
   "text_hash": "b7d7b32b77a03804",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep4_opening.json",
     "ref": "ep4_opening/L3",
     "slot": 5.1,
     "slot_kind": "cine slot",
     "speaker_id": "ysolde"
    }
   ]
  },
  {
   "id": "ysolde/that_is_my_strength_ae118cbe",
   "speaker": "ysolde",
   "text": "That is my strength. Not fire. Not knives. I come back. Every spring. Every time.",
   "text_hash": "ae118cbec0e9f153",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep4_opening.json",
     "ref": "ep4_opening/L10",
     "slot": 5.3,
     "slot_kind": "cine slot",
     "speaker_id": "ysolde"
    }
   ]
  },
  {
   "id": "ysolde/the_master_planted_this_049c4f15",
   "speaker": "ysolde",
   "text": "The Master planted this country with his own hands. He left it to me to keep.",
   "text_hash": "049c4f15dfc8fbbf",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep4_opening.json",
     "ref": "ep4_opening/L11",
     "slot": 5.1,
     "slot_kind": "cine slot",
     "speaker_id": "ysolde"
    }
   ]
  },
  {
   "id": "ysolde/they_call_me_soft_3535b2b2",
   "speaker": "ysolde",
   "text": "They call me soft. Neutral. Slow. Slow is how an oak outlives an army.",
   "text_hash": "3535b2b274279f89",
   "sources": [
    {
     "kind": "cine",
     "source": "data/voice/lines/ep4_opening.json",
     "ref": "ep4_opening/L7",
     "slot": 5.0,
     "slot_kind": "cine slot",
     "speaker_id": "ysolde"
    }
   ]
  }
 ]
}
