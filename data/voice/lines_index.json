    },
    {
     "kind": "cine",
     "source": "data/voice/lines/prologue_3min.json",
     "ref": "prologue_3min/L25",
     "slot": 5.7,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "master/i_loved_all_four_d534ea63",
   "speaker": "master",
   "text": "I loved all four of them. And still, they went to war.",
   "text_hash": "d534ea6313897cbb",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:103",
     "ref": "prologue_3min/S30@0.3",
     "slot": 5.6,
     "slot_kind": "cine shot",
     "speaker_id": "master"
    },
    {
     "kind": "cine",
     "source": "data/voice/lines/prologue_3min.json",
     "ref": "prologue_3min/L30",
     "slot": 5.7,
     "slot_kind": "cine slot",
     "speaker_id": "master"
    }
   ]
  },
  {
   "id": "master/i_would_say_show_1f5d14b4",
   "speaker": "master",
   "text": "I would say: show me again. And she always did. Ysolde was my heart.",
   "text_hash": "1f5d14b43a183667",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:100",
     "ref": "prologue_3min/S29@0.3",
     "slot": 6.6,
     "slot_kind": "cine shot",
