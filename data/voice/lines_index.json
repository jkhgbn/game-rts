    }
   ]
  },
  {
   "id": "master/his_citadel_rose_above_2e36d77d",
   "speaker": "master",
   "text": "His citadel rose above the clouds, a city of towers, bridges and bells.",
   "text_hash": "2e36d77d27246cd4",
   "sources": [
    {
     "kind": "cine",
     "source": "data/cinematics/src/prologue_3min.cine:21",
     "ref": "prologue_3min/S03@0.4",
     "slot": 6.5,
     "slot_kind": "cine shot",
