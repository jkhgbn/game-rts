+# H2: two enemies targeting a full-HP Hush make her autocast Smoke Cloak; one does not.
+func _setup_autocast() -> void:
+	T3Kit.force_enabled = true
+	if HelperAbilities.smoke_min_targeting() != 2:
+		_fail("skirmish smoke threshold %d, expected 2" % HelperAbilities.smoke_min_targeting())
+	hush_two = _make_hush(_base + Vector3(0.0, 0.0, 14.0))
+	hush_one = _make_hush(_base + Vector3(0.0, 0.0, -24.0))
+	for h in [hush_two, hush_one]:
+		(h as Helper).helper_abilities.reset_cooldowns()
+	for i in 2:
+		var u := _spawn("bal_two_%d" % i, Unit.Team.PLAYER, _base + Vector3(-2.0 + 4.0 * i, 0.0, 12.0))
+		u.set_auto_target(hush_two)
+	var lone := _spawn("bal_one", Unit.Team.PLAYER, _base + Vector3(0.0, 0.0, -22.0))
+	lone.set_auto_target(hush_one)
+
+
+func _check_autocast() -> void:
+	if int(hush_two.helper_abilities.casts.get(&"hush_smoke", 0)) < 1:
+		_fail("2 attackers: no Smoke Cloak autocast")
+	if int(hush_one.helper_abilities.casts.get(&"hush_smoke", 0)) != 0:
+		_fail("1 attacker on a full-HP Hush: Smoke Cloak autocast anyway")
+
