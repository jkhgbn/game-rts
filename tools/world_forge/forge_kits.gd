	"slab": "res://art/environment/rock_slab.tscn",
	"spire": "res://art/environment/rock_spire.tscn",
	"ruin_pillar": "res://art/environment/ruin_pillar.tscn",
	"standing_stones": "res://art/environment/landmarks/standing_stones.tscn",
	"giant_stump": "res://art/environment/landmarks/giant_stump.tscn",
	"aqueduct": "res://art/environment/landmarks/aqueduct.tscn",
