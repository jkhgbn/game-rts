}
## Built-in procedural pieces (generated by forge_mesh.gd, baked into the set).
const PROCEDURAL: Array[String] = ["brazier", "stake", "crate"]

const GROUNDS := {"ash": Color(0.24, 0.20, 0.18), "dirt": Color(0.36, 0.28, 0.20), "grass": Color(0.30, 0.40, 0.20),
	"snow": Color(0.82, 0.86, 0.92), "stone": Color(0.42, 0.40, 0.38), "sand": Color(0.72, 0.62, 0.44),
	"moss": Color(0.22, 0.30, 0.18), "crypt": Color(0.20, 0.19, 0.22)}
const PATH_KITS := {"road": Color(0.45, 0.36, 0.26), "ember": Color(0.95, 0.42, 0.10), "river": Color(0.10, 0.18, 0.26),
	"flagstone": Color(0.50, 0.48, 0.45), "snow": Color(0.90, 0.92, 0.96), "ash": Color(0.16, 0.14, 0.13)}


static func names() -> Array:
	var out: Array = KITS.keys()
	out.append_array(PROCEDURAL)
	out.sort()
	return out


## "kit:pine" / "pine" / "res://x.tscn" -> {ok, path, procedural, name}.
static func resolve(token: String) -> Dictionary:
	var t := token
	if t.begins_with("kit:"):
		t = t.substr(4)
	if t.begins_with("forge:"):
		t = t.substr(6)
	if t.begins_with("res://"):
		return {"ok": ResourceLoader.exists(t), "path": t, "procedural": false, "name": t.get_file().get_basename()}
	if PROCEDURAL.has(t):
		return {"ok": true, "path": "", "procedural": true, "name": t}
	if KITS.has(t):
		return {"ok": ResourceLoader.exists(KITS[t]), "path": KITS[t], "procedural": false, "name": t}
	return {"ok": false, "path": "", "procedural": false, "name": t}
