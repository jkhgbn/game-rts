extends SceneTree
## Sound plan (docs/design/sound-plan.md, JS 2026-09-27 "triple the sound, make a sound plan to use all new order").
## 1. Static: every GameAudio.SOUND_PLAN cue is in SOUNDS, has its .wav, is generated by order_sfx_generator.gd and is
##    played by game_audio.gd (a literal play_at / play_ui call or a value of NU_ABILITY_CUE / T3_ABILITY_CUE /
##    HIT_FX_CUE). The 27 unit family cues have 3 takes each (81 files), every TAKE_IDS cue loads 3 takes.
## 2. Takes never repeat back to back (pick_take).
## 3. Live in main.tscn: fake order nodes (UnitUpgrades-like, HelperRoster-like, StrIntPath on the hero, a
##    NewUnitAbility / T3Ability counter) emit / count, and GameAudio plays the planned cue.
## Run: godot --headless --path . -s tests/test_sound_plan.gd --fixed-fps 60 --quit-after 4000

const TASK_ID := "sound_plan"
const SFX := "res://assets/audio/sfx/"
const FAMILIES: Array[String] = ["blade", "heavy", "whip", "bow", "bolt", "siege", "magic", "storm", "beast"]

class FakeUpgrades extends Node:
	signal upgrade_started(unit_id: StringName)
	signal upgrade_completed(unit_id: StringName)
	signal upgrade_cancelled(unit_id: StringName, refund: int)
	var team := 0

class FakeRoster extends Node:
	signal helper_called(team: int, helper_id: StringName)
	signal helper_ready(helper: Node)
	signal helper_fallen(helper: Node)
	signal helper_revived(helper: Node)
	var team := 0

class FakePath extends Node:
	signal path_chosen(path: StringName)
	signal ability_started(path: StringName)
	signal ability_ended(path: StringName)

class FakeUnit extends Node3D:
	var team := 0
	var unit_type: Resource = null

class FakeNU extends Node:
	var casts := 0

class FakeT3 extends Node:
	var casts := {}
	var disguised := true
	var planting := false

var main: Node
var frame := 0
var _wait := 0
var _fails: Array[String] = []
var _ga: Node
var _up: FakeUpgrades
var _roster: FakeRoster
var _path: Node
var _nu: FakeNU
var _t3: FakeT3
var _helper: FakeUnit


func _process(_delta: float) -> bool:
	if main == null:
		_static_checks()
		main = load("res://scenes/main.tscn").instantiate()
		root.add_child(main)
		current_scene = main
		return false
	if main.get(&"hero") == null:
		_wait += 1
		if _wait > 5000:
			return _finish("navigation never finished baking")
		return false
	frame += 1
	if frame == 10:
		_ga = _find_audio(main)
		if _ga == null:
			return _finish("no GameAudio in main.tscn")
		_takes_check()
		_setup_fakes()
	elif frame == 110:   # a 1 s rescan has hooked the fakes
		_fire()
	elif frame == 140:
		_live_checks()
		return _finish("")
	return false


func _static_checks() -> void:
	var ga := load("res://scripts/audio/game_audio.gd") as GDScript
	var consts := ga.get_script_constant_map()
	var plan: Dictionary = consts["SOUND_PLAN"]
	var sounds: Array = consts["SOUNDS"]
	var tables: Array = []
	for k: String in ["NU_ABILITY_CUE", "T3_ABILITY_CUE", "HIT_FX_CUE"]:
		tables.append_array((consts[k] as Dictionary).values())
	var src := FileAccess.get_file_as_string("res://scripts/audio/game_audio.gd")
	var gen := load("res://assets/audio/order_sfx_generator.gd") as GDScript
	var gen_cues: Array = gen.get_script_constant_map()["CUES"]
	if plan.size() < 45:
		_fails.append("SOUND_PLAN has only %d cues" % plan.size())
	for id: StringName in plan:
		if not sounds.has(id):
			_fails.append("%s not in GameAudio.SOUNDS" % id)
		if not ResourceLoader.exists(SFX + String(id) + ".wav"):
			_fails.append("%s.wav missing" % id)
		if not gen_cues.has(String(id)):
			_fails.append("%s not made by order_sfx_generator.gd" % id)
		var lit := "&\"%s\"" % id
		var played := src.contains("play_at(" + lit) or src.contains("play_ui(" + lit) or tables.has(id)
		if not played:
			_fails.append("%s is never played by game_audio.gd" % id)
	for f in FAMILIES:
		for kind in ["atk_", "hit_", "death_"]:
			for sfx in ["", "_1", "_2"]:
				var p: String = SFX + kind + f + sfx + ".wav"
				if not ResourceLoader.exists(p):
					_fails.append("missing take %s" % p)
	print("  static: %d planned cues, %d fails so far" % [plan.size(), _fails.size()])


func _takes_check() -> void:
	for id: StringName in _ga.get(&"TAKE_IDS"):
		if int(_ga.call(&"take_count", id)) != 3:
			_fails.append("%s loads %d takes, not 3" % [id, int(_ga.call(&"take_count", id))])
	# No immediate repeat.
	var prev: Object = null
	for i in 60:
		var s: Object = _ga.call(&"pick_take", &"hit_blade", null)
		if s == null:
			_fails.append("pick_take returned null")
			break
		if s == prev:
			_fails.append("pick_take repeated a take back to back")
			break
		prev = s


func _setup_fakes() -> void:
	var hero: Node3D = main.get(&"hero")
	_up = FakeUpgrades.new()
	_up.add_to_group(&"unit_upgrades")
	main.add_child(_up)
	_roster = FakeRoster.new()
	_roster.add_to_group(&"helper_rosters")
	main.add_child(_roster)
	_path = hero.get_node_or_null(^"StrIntPath")   # a real one (skirmish) or the fake
	if _path == null:
		_path = FakePath.new()
		_path.name = "StrIntPath"
		hero.add_child(_path)
	# A Pyre Adept-like unit with a NewUnitAbility counter and a Saboteur-like T3Ability, in group "helpers" so the
	# rescan hooks them, next to the hero (audible).
	_helper = FakeUnit.new()
	var ut := UnitType.new()
	ut.id = &"pyre_adept"
	_helper.unit_type = ut
	_helper.add_to_group(&"helpers")
	main.add_child(_helper)
	_helper.global_position = hero.global_position + Vector3(1, 0, 1)
	_nu = FakeNU.new()
	_nu.name = "NewUnitAbility"
	_helper.add_child(_nu)
	_t3 = FakeT3.new()
	_t3.name = "T3Ability"
	_helper.add_child(_t3)


func _fire() -> void:
	_up.upgrade_started.emit(&"flame_guard")
	_up.upgrade_completed.emit(&"flame_guard")
	_roster.helper_called.emit(0, &"helper_vey")
	_roster.helper_ready.emit(_helper)
	_roster.helper_fallen.emit(_helper)
	_roster.helper_revived.emit(_helper)
	_path.emit_signal(&"path_chosen", &"str")
	_path.emit_signal(&"ability_started", &"int")
	_path.emit_signal(&"ability_ended", &"int")
	_nu.casts += 1
	_t3.casts = {&"powder_charge": 1, &"tempest_bolt": 1}
	_t3.disguised = false
	_t3.planting = true


func _live_checks() -> void:
	var counts: Dictionary = _ga.get(&"play_counts")
	for id: StringName in [&"ui_plus_start", &"alert_plus_done", &"ui_helper_call", &"alert_helper_arrive",
			&"alert_helper_fall", &"alert_helper_revive", &"alert_path_str", &"spell_snow_shield_on",
			&"spell_snow_shield_off", &"ab_flame_burst", &"ab_sab_armed", &"ab_tempest_bolt", &"ab_sab_reveal",
			&"ab_sab_plant"]:
		if int(counts.get(id, 0)) < 1:
			_fails.append("live: %s did not play" % id)


func _find_audio(n: Node) -> Node:
	if n.get_script() and (n.get_script() as Script).resource_path == "res://scripts/audio/game_audio.gd":
		return n
	for c in n.get_children():
		var f := _find_audio(c)
		if f:
			return f
	return null


func _finish(reason: String) -> bool:
	if reason != "":
		_fails.append(reason)
	if _fails.is_empty():
		print("PASS %s: every planned cue exists and is wired" % TASK_ID)
	else:
		for f in _fails:
			print("  - " + f)
		print("FAIL %s: %d problem(s)" % [TASK_ID, _fails.size()])
	return true
