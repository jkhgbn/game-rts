// env_painted.gdshader - shared painted shading for environment props (trees, rocks, pillars, pedestal,
// crystal-node discs, peddler cart, chest, decor, cliffs). Same look as art/shaders/painted.gdshader
// (art-keep.md 0.3) but the colour blocks come from VERTEX COLOURS so a whole prop is ONE mesh + ONE material
// (MultiMesh friendly).
// Meshes are generated by art/environment/build_env.gd, which bakes:
//   COLOR.rgb  sRGB colour block of the part
//   COLOR.a    0 at the mesh bottom -> 1 at its top (height gradient, fake sky light + AO)
//   UV.x       wind sway weight (0 trunk / stone, 1 foliage)
//   UV.y       local height in metres (dark contact band near y = 0)
// Per-instance variety (A.10): every instance gets a hash from its world position (MODEL_MATRIX origin, so it
// works in MultiMeshes with no per-instance data): foliage shifts hue (yellower / bluer), value and shape
// (taller / squatter, a slight lean); stone shifts value a little. Same map = same look every time.
shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back;

uniform sampler2D noise_tex : hint_default_white, filter_linear_mipmap, repeat_enable;
uniform float noise_scale_a = 0.5;
uniform float noise_scale_b = 0.12;
uniform float sway_strength = 0.09;
uniform float sway_speed = 1.1;
uniform float top_light = 0.12;
uniform vec3 rim_color : source_color = vec3(0.55, 0.65, 0.85);
uniform float rim_strength = 0.18;
uniform float instance_variation = 1.0;
// Map-edge cliffs only (MAP.P1, art/environment/cliff_mat.tres; 0 = off, the default for every other prop):
// vertical weathering streaks and wavy warm / cool strata painted over the rock faces, a cool dark foot where the
// wall meets the ground, and smoothed lighting on the grass caps / ledges so their triangles stop showing.
uniform float cliff_paint = 0.0;
uniform vec3 cliff_foot : source_color = vec3(0.17, 0.18, 0.23);
uniform float cliff_foot_height = 2.4;
uniform float cliff_top_smooth = 0.75;
uniform vec2 cliff_sun_xz = vec2(0.64, 0.77);   // direction TO the sun on the ground (preset_warm): walls turned away get darker
// G-F review 2 item 11 (FrozenLook.dress_level, mission 2's snow border; 0 = off, every other map): the same cliffs as
// cold blue-grey granite with snow on the caps and ledges (broken, deeper on flatter faces) and frost in the streaks.
uniform float cliff_snow = 0.0;
uniform vec3 snow_cap : source_color = vec3(0.74, 0.79, 0.86);
uniform vec3 snow_rock : source_color = vec3(0.40, 0.44, 0.52);

varying vec3 v_wp;
varying vec3 v_wn;
varying vec3 v_col;
varying float v_grad;
varying float v_y;

void vertex() {
	vec3 origin = MODEL_MATRIX[3].xyz;
	float ih = fract(sin(dot(origin.xz, vec2(12.9898, 78.233))) * 43758.5453);
	float ih2 = fract(ih * 17.13 + 0.31);
	float ih3 = fract(ih * 31.7 + 0.77);
	vec3 col = pow(COLOR.rgb, vec3(2.2));
	if (UV.x > 0.0) {
		float iv = instance_variation * UV.x;
		// Shape: taller / squatter crowns and a lean (trunks keep their base).
		float above = max(VERTEX.y - 1.2, 0.0);
		VERTEX.y += above * (ih - 0.5) * 0.22 * iv;
		VERTEX.xz += vec2(ih2 - 0.5, ih3 - 0.5) * above * 0.09 * iv;
		// Colour: from blue-green to yellow-green, lighter / darker.
		vec3 cool = col * vec3(0.88, 1.0, 1.10);
		vec3 warm = col * vec3(1.10, 1.04, 0.86);
		col = mix(col, mix(cool, warm, ih2), 0.8 * iv) * (0.88 + ih3 * 0.24 * iv + (1.0 - iv) * 0.12);
		// Wind.
		float ph = MODEL_MATRIX[3].x * 0.37 + MODEL_MATRIX[3].z * 0.23;
		float w = sway_strength * UV.x * max(VERTEX.y - 1.0, 0.0) * 0.35;
		VERTEX.x += sin(TIME * sway_speed + ph) * w;
		VERTEX.z += cos(TIME * sway_speed * 0.8 + ph * 1.3) * w * 0.7;
	} else {
		col *= 1.0 + (ih - 0.5) * 0.10 * instance_variation;
	}
	v_wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	v_wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
	v_col = col;
	v_grad = COLOR.a;
	v_y = UV.y;
}

float triplanar(vec3 p, vec3 n, float scale) {
	vec3 w = pow(abs(n), vec3(4.0));
	w /= (w.x + w.y + w.z + 0.0001);
	return texture(noise_tex, p.zy * scale).r * w.x
		+ texture(noise_tex, p.xz * scale).r * w.y
		+ texture(noise_tex, p.xy * scale).r * w.z;
}

void fragment() {
	vec3 n = normalize(v_wn);
	float na = triplanar(v_wp, n, noise_scale_a);
	float nb = triplanar(v_wp + vec3(17.3, 5.1, 9.7), n, noise_scale_b);
	vec3 albedo = v_col * (1.0 + (na - 0.5) * 0.22) * (1.0 + (nb - 0.5) * 0.14);
	albedo *= mix(0.70, 1.10, smoothstep(0.0, 1.0, v_grad));
	albedo *= mix(0.55, 1.0, smoothstep(0.0, 0.35, v_y + 0.05));
	albedo *= 1.0 + max(n.y, 0.0) * top_light;
	if (cliff_paint > 0.0) {
		float wall = (1.0 - smoothstep(0.35, 0.75, n.y)) * cliff_paint;
		// Streaks: noise stretched along y, running along the wall (x + z), posterised into painted strokes.
		float s = texture(noise_tex, vec2((v_wp.x + v_wp.z) * 0.42, v_wp.y * 0.05 + (v_wp.x - v_wp.z) * 0.013)).r;
		s = floor(s * 4.0 + 0.5) / 4.0 * 0.6 + s * 0.4;
		albedo *= mix(1.0, 0.76 + s * 0.48, wall);
		// Strata: bands ~2.4 m apart that rise and fall with the painted noise; alternate warm / cool.
		float band = fract(v_wp.y * 0.42 + nb * 0.9);
		float layer = smoothstep(0.08, 0.16, band) * (1.0 - smoothstep(0.52, 0.60, band));
		albedo *= mix(vec3(1.0), mix(vec3(0.88, 0.93, 1.05), vec3(1.10, 1.02, 0.88), layer), wall);
		// A thin dark seam under every layer (the ledge's shadow).
		albedo *= 1.0 - (1.0 - smoothstep(0.0, 0.07, band)) * 0.35 * wall;
		// Walls turned away from the sun (south / east banks, seen from the map) only get sky + the cool fill and
		// read pale; paint them a deeper, warmer shade so they frame the map instead of glowing.
		float away = smoothstep(0.1, -0.5, dot(normalize(n.xz + vec2(0.0001)), cliff_sun_xz));
		float slope = (1.0 - smoothstep(0.78, 0.95, n.y)) * cliff_paint;
		albedo *= mix(vec3(1.0), vec3(0.72, 0.68, 0.64), away * slope);
		// Grass caps (the crest and the wide low south bank): a darker, cooler, noise-broken forest-floor green
		// instead of a flat bright lawn, so the play space stays the brightest green on screen.
		float cap = smoothstep(0.6, 0.9, n.y) * step(v_col.r * 1.15, v_col.g) * cliff_paint;
		vec3 cap_col = mix(albedo, vec3(dot(albedo, vec3(0.30, 0.59, 0.11))), 0.3) * vec3(0.74, 0.78, 0.86);
		albedo = mix(albedo, cap_col * (0.82 + na * 0.36), cap);
		if (cliff_snow > 0.0) {
			// Granite: the painted value pattern kept, hue pulled to a cold grey-blue.
			float lum = dot(albedo, vec3(0.30, 0.59, 0.11));
			vec3 rock = snow_rock * (lum / max(dot(v_col, vec3(0.30, 0.59, 0.11)), 0.05)) * 0.9;
			albedo = mix(albedo, rock, cliff_snow);
			// Snow wherever the face looks up enough to hold it, broken by the noise; frost in the streaks.
			float hold = smoothstep(0.55, 0.8, n.y + (nb - 0.5) * 0.18);
			albedo = mix(albedo, snow_cap * (0.88 + na * 0.18), hold * cliff_snow);
		}
		// Cool dark foot where the wall meets the map floor.
		float foot = 1.0 - smoothstep(-0.3, cliff_foot_height, v_wp.y + (na - 0.5) * 0.8);
		albedo = mix(albedo, cliff_foot * (0.8 + na * 0.4), foot * 0.6 * cliff_paint);
		// Caps and ledges: light as one smooth surface (no triangle facets on the grass tops).
		vec3 up_v = normalize((VIEW_MATRIX * vec4(0.0, 1.0, 0.0, 0.0)).xyz);
		NORMAL = normalize(mix(NORMAL, up_v, smoothstep(0.45, 0.85, n.y) * cliff_top_smooth * cliff_paint));
	}
	float rim = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 3.0);
	ALBEDO = albedo;
	EMISSION = rim * rim_color * rim_strength;
	ROUGHNESS = 1.0;
}

void light() {
	float d = dot(NORMAL, LIGHT) * 0.5 + 0.5;
	float ramp = smoothstep(0.32, 0.42, d) * 0.55 + smoothstep(0.58, 0.68, d) * 0.45;
	DIFFUSE_LIGHT += ramp * ATTENUATION * LIGHT_COLOR / PI;
}
