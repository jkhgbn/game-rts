class_name CrystalClusterArt
extends Node3D
## Crystal node look (task A2.3; docs/design/economy.md): a cluster of 12 mana crystals and 3 old stumps
## bursting from a dark rock mound (r ~1.25, main crystal 2.2 m), a soft cyan light pool on the ground
## (additive, no real light) and star glints. Scene: art/environment/crystal_node.tscn, generated by
## art/environment/crystal/build_crystal.gd. Root = node centre on the ground.
## Cheap: 4 draw calls (rock, crystals, pool, glints), no _process. All crystals are ONE mesh; the shader
## shrinks each one toward its base as the node depletes (smallest first, the big one last) and dims the glow.
## Each node turns to a yaw hashed from its position, so neighbouring nodes do not look copy-pasted.
## Hook: CrystalNode calls `set_fill_ratio(crystals_left / max_crystals)` whenever crystals change.
## The rock keeps its size, so the caller should NOT also scale the model.

var _ratio: float = 1.0
var _crystals: GeometryInstance3D
var _pool: GeometryInstance3D
var _sparkles: GPUParticles3D


func _ready() -> void:
	_crystals = get_node_or_null(^"Crystals") as GeometryInstance3D
	_pool = get_node_or_null(^"GroundGlow") as GeometryInstance3D
	_sparkles = get_node_or_null(^"Sparkles") as GPUParticles3D
	var p := global_position
	rotation.y = fposmod(sin(p.x * 12.9898 + p.z * 78.233) * 43758.5453, 1.0) * TAU
	_apply()


## r = crystals left / crystals at start (0-1).
func set_fill_ratio(r: float) -> void:
	_ratio = clampf(r, 0.0, 1.0)
	if is_node_ready():
		_apply()


func get_fill_ratio() -> float:
	return _ratio


func _apply() -> void:
	if _crystals:
		_crystals.set_instance_shader_parameter(&"fill", _ratio)
	if _pool:
		_pool.visible = _ratio > 0.0
		_pool.set_instance_shader_parameter(&"intensity", lerpf(0.3, 1.0, _ratio))
		var s: float = lerpf(0.6, 1.0, _ratio)
		_pool.scale = Vector3(s, 1.0, s)
	if _sparkles:
		_sparkles.visible = _ratio > 0.0
		_sparkles.emitting = _ratio > 0.0
		_sparkles.amount_ratio = lerpf(0.3, 1.0, _ratio)
		var h: float = lerpf(0.45, 1.0, _ratio)
		_sparkles.scale = Vector3(lerpf(0.7, 1.0, _ratio), h, lerpf(0.7, 1.0, _ratio))
