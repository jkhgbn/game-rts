// nature_autumn.gdshader - task 20.V0: the GOLDEN AUTUMN variant of nature_props/nature_painted.gdshader (same
// meshes, same vertex bake, same cost). Only the foliage colour step differs (search "AUTUMN 20.V0"): every leaf crown
// (kind 2, also the lite border stand-ins) takes one of 4 crown tones by instance hash (russet / amber / gold / a rare
// late green), low leaf geometry (grass tufts, ferns, reeds: UV.y below ~1.6 m) takes the bracken / straw tones, and
// needles stay evergreen (the cool dark anchor of the value structure, docs/art/style-autumn.md 3). When
// nature_painted.gdshader changes, re-copy it and re-apply the marked block. Material: autumn/nature_autumn_mat.tres.
// --- original header ---
// nature_painted.gdshader - shared painted shading for the map's trees, rocks and ruin pillars (task A2.8).
// ONE material for every nature prop (MultiMesh friendly: no per-instance data, no scripts, no lights).
// Meshes are generated by art/environment/nature_props/build_nature.gd, which bakes per vertex:
//   COLOR.rgb  sRGB colour block (+ baked crown occlusion for foliage)
//   COLOR.a    0 at the mesh bottom -> 1 at its top (height gradient: fake sky light + AO)
//   UV.x       trees: wind weight (0 at the root -> 1 at the crown top, the same curve for trunk and leaves so
//              nothing tears); stone: moss amount (0 = bare)
//   UV.y       local height in metres (dark contact band near y = 0)
//   UV2.x      variant mask: 0 = always drawn, -1 = always drawn + "lite" shading (border-forest stand-ins),
//              else bit k = drawn in variant k (3 variants per mesh). The variant
//              comes from a hash of the instance's world position, so the same map always looks the same and a
//              MultiMesh shows 3 shapes with one mesh. Hidden parts collapse to a point (degenerate, never drawn).
//   UV2.y      kind: 0 bark, 1 needles, 2 leaves (can turn autumn), 3 stone, 4 birch bark, 5 ivy, 6 gold leaves
// Per instance (world-position hash): variant, crown height / lean, hue (cool <-> warm), value, rare autumn crown.
// Wind (vertex, cheap): a slow sway travelling across the map in gusts + a small leaf flutter.
shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back;

uniform sampler2D noise_tex : hint_default_white, filter_linear_mipmap, repeat_enable;
uniform float variant_count = 3.0;
// Wind.
uniform vec2 wind_dir = vec2(0.8, 0.6);
uniform float sway_strength = 0.16;
uniform float sway_speed = 1.15;
uniform float gust_scale = 0.045;      // gust wave frequency over the map (1 / metres)
uniform float gust_speed = 0.7;
uniform float flutter_strength = 0.035;
uniform float flutter_speed = 3.6;
// Per-instance variety.
uniform float instance_variation = 1.0;
uniform float autumn_chance = 0.12;
uniform vec3 autumn_color : source_color = vec3(0.78, 0.54, 0.17);
// AUTUMN 20.V0: crown tones (weights = share of crowns) and the undergrowth / evergreen tints.
uniform vec3 crown_russet : source_color = vec3(0.62, 0.22, 0.08);
uniform vec3 crown_amber : source_color = vec3(0.80, 0.44, 0.11);
uniform vec3 crown_gold : source_color = vec3(0.86, 0.64, 0.17);
uniform vec3 crown_late_green : source_color = vec3(0.44, 0.45, 0.16);
uniform vec4 crown_weights = vec4(0.30, 0.30, 0.30, 0.10);   // russet, amber, gold, late green
uniform vec3 under_bracken : source_color = vec3(0.58, 0.34, 0.13);
uniform vec3 under_straw : source_color = vec3(0.56, 0.46, 0.22);
uniform vec2 under_height = vec2(1.1, 2.1);                   // metres: below x = undergrowth, above y = crown
uniform float autumn_value = 0.10;                             // linear luminance that maps to the tone itself
uniform vec3 needle_tint : source_color = vec3(0.86, 0.94, 0.80);
uniform vec3 willow_tone : source_color = vec3(0.56, 0.47, 0.17);   // autumn willow / bright needles / ivy
uniform float willow_turn = 0.8;
uniform vec2 needle_bright = vec2(0.10, 0.20);                     // linear luminance: needles brighter turn
uniform vec2 grass_height = vec2(0.45, 0.95);                      // metres: needles / ivy below turn straw
// Painted look.
uniform vec3 sun_tint : source_color = vec3(1.0, 0.93, 0.62);   // sunlit tops of the crowns
uniform float sunlit_top = 0.24;
uniform float leaf_clumps = 0.20;                                 // painted leaf-clump value breakup
uniform float leaf_normal_noise = 0.45;                           // brushy light / shadow edge on crowns
uniform vec3 moss_color : source_color = vec3(0.33, 0.49, 0.10);
uniform vec3 moss_dark : source_color = vec3(0.15, 0.30, 0.06);
uniform float stone_top_light = 0.35;
uniform vec3 rim_color : source_color = vec3(0.55, 0.65, 0.85);
uniform float rim_strength = 0.12;                                // x albedo: stays subtle on dark stone
uniform float leaf_rim = 0.10;
// G-D map props (docs/art/gd_props.md): graphics tier, 0 Low (= the look and cost before G-D: the new code sits
// behind uniform branches that stay off), 1 Medium, 2 High, 3 Ultra. PropsLook writes it into nature_mat.tres.
//   Medium+  warm sunlit leaves / cool crown undersides, sun shining through the crown edges on the shadow side
//            (translucency), a softer light ramp on stone (no "crumpled paper" facets), rock strata, warm stone tops
//   High+    leaf dabs (a finer painted value layer on the crowns), lichen spots on stone, bark cracks
uniform float gd_detail = 0.0;
uniform vec3 leaf_light_tint : source_color = vec3(1.0, 0.96, 0.80);
uniform vec3 leaf_trans_color : source_color = vec3(1.0, 1.0, 0.42);   // x albedo: yellow-green light through leaves
uniform float leaf_trans = 0.55;
uniform vec3 crown_shade : source_color = vec3(0.80, 0.90, 1.0);       // crown undersides: cooler and darker
uniform vec3 leaf_highlight = vec3(1.45, 1.38, 0.78);                 // x albedo: sunlit leaf clusters (linear)
uniform float leaf_highlight_k = 0.45;
uniform float leaf_rim_gd = 2.2;                                       // leaf_rim x this at Medium+
uniform float stone_soft = 0.75;                                       // 0 = toon ramp, 1 = soft ramp (stone only)
uniform float strata = 0.20;
uniform float strata_freq = 3.0;                                       // bands per local metre
uniform vec3 lichen_color : source_color = vec3(0.74, 0.70, 0.50);
uniform float lichen = 0.45;

varying vec3 v_wp;
varying vec3 v_wn;
varying vec3 v_col;
varying float v_grad;
varying float v_y;
varying float v_moss;
varying flat float v_kind;
varying float v_ih;
varying vec3 v_lk;   // fragment -> light (G-D): x leaf translucency, y soft stone ramp, z warm sunlit leaves

// Sine-free hash (same result on every GPU; nature_preview.gd mirrors it to pick variants).
float hash1(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

void vertex() {
	vec3 origin = MODEL_MATRIX[3].xyz;
	float ih = hash1(origin.xz);
	float ih2 = hash1(origin.xz + vec2(17.3, 5.9));
	float ih3 = hash1(origin.xz + vec2(-7.1, 31.7));
	float ih4 = hash1(origin.zx + vec2(3.1, 7.7));
	float kind = UV2.y;
	// Variant: parts of the other variants collapse to one point (zero-area triangles are never rasterised).
	float mask = UV2.x;
	bool hidden = false;
	if (mask > 0.5) {
		float variant = min(floor(ih4 * variant_count), variant_count - 1.0);
		hidden = mod(floor(mask / exp2(variant)), 2.0) < 0.5;
	}
	vec3 col = pow(COLOR.rgb, vec3(2.2));
	bool foliage = kind > 0.5 && kind < 2.5 || kind > 4.5;
	bool stone = kind > 2.5 && kind < 3.5;
	float iv = instance_variation;
	v_moss = 0.0;
	if (stone) {
		v_moss = UV.x;
		col *= 1.0 + (ih - 0.5) * 0.12 * iv;
		col *= mix(vec3(0.97, 0.99, 1.04), vec3(1.04, 1.0, 0.95), ih2);   // cool / warm stone
	} else {
		float w = UV.x;
		// Shape: taller / squatter crowns and a lean (the root stays put: w is 0 there).
		VERTEX.y += VERTEX.y * w * (ih - 0.5) * 0.24 * iv;
		VERTEX.xz += vec2(ih2 - 0.5, ih3 - 0.5) * w * 0.55 * iv;
		if (foliage) {
			vec3 cool = col * vec3(0.90, 1.0, 1.07);
			vec3 warm = col * vec3(1.10, 1.05, 0.86);
			col = mix(col, mix(cool, warm, ih2), 0.75 * iv) * (0.90 + ih3 * 0.20 * iv);
			// A few deciduous crowns turn autumn (keeps the value: only the hue moves).
			// (Not on the lite border stand-ins: the border already has its own gold trees.)
			// AUTUMN 20.V0 (begin): every leaf crown turns (lite border stand-ins too), the value structure is kept.
			if (kind > 1.5 && kind < 2.5 && hash1(origin.xz + vec2(51.3, -13.7)) < autumn_chance) {
				float lum = dot(col, vec3(0.30, 0.59, 0.11));
				float pick = hash1(origin.xz + vec2(-23.9, 8.1)) * dot(crown_weights, vec4(1.0));
				vec3 tone = crown_late_green;
				if (pick < crown_weights.x) {
					tone = crown_russet;
				} else if (pick < crown_weights.x + crown_weights.y) {
					tone = crown_amber;
				} else if (pick < crown_weights.x + crown_weights.y + crown_weights.z) {
					tone = crown_gold;
				}
				vec3 under = mix(under_bracken, under_straw, ih2);
				tone = mix(under, tone, smoothstep(under_height.x, under_height.y, UV.y));
				col = tone * clamp(lum / autumn_value, 0.35, 1.7) * (0.92 + ih3 * 0.16 * iv);
			} else if (kind > 0.5 && kind < 1.5 || kind > 4.5 && kind < 5.5) {
				// Needles (pines, firs, some grass blades) and ivy (willow curtains, creepers, grass blades): dark
				// evergreens stay green (the cool anchor among the warm crowns); bright needles and every ivy turn
				// yellow-olive like an autumn willow; anything below grass_height turns straw.
				float lum = dot(col, vec3(0.30, 0.59, 0.11));
				float k = clamp(lum / autumn_value, 0.35, 1.7);
				float turn = kind > 4.5 ? 1.0 : smoothstep(needle_bright.x, needle_bright.y, lum);
				vec3 c2 = mix(col * needle_tint, willow_tone * k, turn * willow_turn);
				col = mix(c2, under_straw * k, 1.0 - smoothstep(grass_height.x, grass_height.y, UV.y));
			}
			// AUTUMN 20.V0 (end)
		} else {
			col *= 0.94 + ih3 * 0.12 * iv;
		}
		// Wind: a sway travelling across the map in gusts, in world space, + a leaf flutter.
		if (w > 0.0) {
			vec2 wd = normalize(wind_dir);
			float phase = dot(origin.xz, vec2(0.37, 0.23));
			float gust = 0.55 + 0.45 * sin(dot(origin.xz, wd) * gust_scale - TIME * gust_speed);
			float sway = (sin(TIME * sway_speed + phase) * 0.55 + sin(TIME * sway_speed * 2.3 + phase * 1.7) * 0.2
					+ 0.45) * gust;
			vec3 off_w = vec3(wd.x, 0.0, wd.y) * sway * sway_strength * w;
			mat3 b = mat3(MODEL_MATRIX);
			vec3 off_l = transpose(b) * off_w / max(dot(b[0], b[0]), 0.0001);
			VERTEX += off_l;
			VERTEX.y -= dot(off_l, off_l) * 0.8;
			if (foliage) {
				float fl = sin(TIME * flutter_speed + dot(VERTEX, vec3(4.1, 3.3, 5.7)) + phase * 3.0);
				VERTEX += NORMAL * fl * flutter_strength * w * (0.6 + 0.4 * gust);
			}
		}
	}
	if (hidden) {
		VERTEX = vec3(0.0, -3.0, 0.0);
	}
	v_wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	v_wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
	// No texture reads here: the props are drawn in 6 passes (depth, colour, 4 shadow splits), map-wide.
	v_col = col;
	v_grad = COLOR.a;
	v_y = UV.y;
	v_kind = kind + (mask < -0.5 ? 10.0 : 0.0);   // +10 = "lite" (border-forest stand-ins: no leaf-clump pass)
	v_ih = ih;
}

float triplanar(vec3 p, vec3 n, float scale) {
	vec3 w = pow(abs(n), vec3(4.0));
	w /= (w.x + w.y + w.z + 0.0001);
	return texture(noise_tex, p.zy * scale).r * w.x
		+ texture(noise_tex, p.xz * scale).r * w.y
		+ texture(noise_tex, p.xy * scale).r * w.z;
}

void fragment() {
	// Derivatives first (shader lint: only at the top level): the strata lines' anti-alias width.
	float fy = fwidth(v_y);
	vec3 n = normalize(v_wn);
	float na = triplanar(v_wp, n, 0.5);
	vec3 albedo = v_col * (1.0 + (na - 0.5) * 0.2);
	bool lite = v_kind > 9.5;
	float kind = lite ? v_kind - 10.0 : v_kind;
	bool foliage = kind > 0.5 && kind < 2.5 || kind > 4.5;
	float rim_k = 0.0;
	v_lk = vec3(0.0);
	bool gd = gd_detail > 0.5;
	bool gd_high = gd_detail > 1.5;
	if (foliage) {
		// Leaf clumps: a coarse, posterised brush pattern + a brushy light / shadow edge (strong on round
		// crowns, light on the needle tiers whose big planes would look blotchy). Lite: the fine noise stands in.
		bool needles = kind < 1.5;
		float clump = lite ? na : triplanar(v_wp + vec3(v_ih * 40.0), n, 0.62);
		float c2 = smoothstep(0.40, 0.60, clump);
		albedo *= mix(1.0 - leaf_clumps * 0.6, 1.0 + leaf_clumps * 0.4, c2);
		vec3 wn = normalize(n + (vec3(clump, na, 1.0 - clump) - 0.5) * leaf_normal_noise * (needles ? 0.35 : 1.0));
		NORMAL = normalize((VIEW_MATRIX * vec4(wn, 0.0)).xyz);
		// Sunlit top: warm, lighter where the crown faces the sky.
		float top = smoothstep(0.35, 0.95, wn.y) * smoothstep(0.40, 0.95, v_grad);
		albedo = mix(albedo, albedo * sun_tint * 1.25, top * sunlit_top * (0.5 + 0.5 * c2));
		albedo *= mix(0.72, 1.04, smoothstep(0.0, 1.0, v_grad));
		rim_k = leaf_rim;
		if (gd) {
			// Crown undersides cooler / darker (the crown reads as a volume, not a flat green blob).
			float under = smoothstep(0.15, -0.55, wn.y);
			float low = 1.0 - smoothstep(0.05, 0.45, v_grad);
			albedo *= mix(vec3(1.0), crown_shade * 0.82, clamp(under * 0.85 + low * 0.30, 0.0, 1.0));
			// Sunlit leaf clusters: warm yellow-green light on the faces turned to the sky, in soft broad patches
			// (a hard noise edge read as camouflage at zoom 10).
			float sky = smoothstep(0.35, 0.95, wn.y) * smoothstep(0.35, 0.95, v_grad);
			float hl = sky * smoothstep(0.30, 0.80, clump);
			albedo = mix(albedo, albedo * leaf_highlight, hl * leaf_highlight_k);
			if (gd_high && !lite) {
				// Leaf dabs: a faint finer value layer (its mip fades it out at long range by itself).
				float dab = triplanar(v_wp + vec3(v_ih * 23.0), n, 1.3);
				albedo *= mix(0.95, 1.04, smoothstep(0.35, 0.65, dab));
			}
			rim_k = leaf_rim * leaf_rim_gd;
			v_lk = vec3(leaf_trans * (needles ? 0.7 : 1.0), 0.0, 1.0);
		}
	} else if (kind > 2.5 && kind < 3.5) {
		// Stone: moss patches on the faces turned to the sky (noisy painted edge), lit warm tops, darker feet.
		// Moss: big soft caps (low-frequency edge), never a fine camouflage pattern.
		float nlow = texture(noise_tex, v_wp.xz * 0.3 + vec2(5.3, 2.1)).r;   // top-down: moss grows on tops
		float moss = smoothstep(0.60, 0.68, (n.y - 0.55) * 1.4 + (nlow - 0.5) * 1.0 + (na - 0.5) * 0.12) * v_moss;
		albedo *= 1.0 + max(n.y, 0.0) * stone_top_light;
		if (gd) {
			// Strata: soft wavy bands on the sides (bedding lines), never on the tops.
			float sy = v_y * strata_freq + (na - 0.5) * 1.4 + v_ih * 7.0 + v_wp.x * 0.11;
			float lw = 0.10 + fy * strata_freq * 1.5;
			float line = 1.0 - smoothstep(lw * 0.4, lw, abs(fract(sy) - 0.5));
			float sides = 1.0 - smoothstep(0.35, 0.8, abs(n.y));
			albedo *= 1.0 - line * strata * sides * mix(1.0, 0.5, step(1.0, fy * strata_freq));
			// Lighter bands between the lines and warm sun-bleached tops.
			albedo *= 1.0 + (fract(sy * 0.5 + 0.25) - 0.5) * 0.08 * sides;
			albedo *= mix(vec3(1.0), vec3(1.07, 1.03, 0.94), smoothstep(0.3, 0.9, n.y));
			if (gd_high) {
				// Lichen: small pale rosettes on the faces turned up (not under the moss).
				// Grey stone only: coloured stone (camp mud rocks, red clay) keeps its own paint.
				float sat = max(albedo.r, max(albedo.g, albedo.b)) - min(albedo.r, min(albedo.g, albedo.b));
				float grey = 1.0 - smoothstep(0.015, 0.05, sat);
				float lk = texture(noise_tex, v_wp.xz * 2.3 + v_wp.y * 0.9 + vec2(v_ih * 9.0)).r;
				float spots = smoothstep(0.68, 0.71, lk) * smoothstep(-0.2, 0.5, n.y) * (1.0 - moss) * grey;
				albedo = mix(albedo, lichen_color * (0.85 + na * 0.3), spots * lichen);
			}
			v_lk = vec3(0.0, stone_soft, 0.0);
		}
		albedo = mix(albedo, mix(moss_dark, moss_color, smoothstep(0.3, 0.7, na)), moss);
		albedo *= mix(0.62, 1.06, smoothstep(0.0, 1.0, v_grad));
	} else {
		// Bark: vertical streaks. Birch: pale with dark horizontal lenticel dashes.
		float ang = atan(n.z, n.x);
		float streak = texture(noise_tex, vec2(ang * 0.6 + v_wp.x * 0.3, v_wp.y * 0.15)).r;
		if (kind > 3.5) {
			float dash = texture(noise_tex, vec2(ang * 0.9 + v_wp.x * 0.5, v_wp.y * 2.2)).r;
			albedo = mix(albedo, vec3(0.035, 0.03, 0.028), smoothstep(0.60, 0.66, dash) * 0.9);
			albedo *= mix(0.94, 1.04, streak);
		} else {
			albedo *= mix(0.84, 1.1, streak);
			if (gd_high) {
				// Bark plates: dark vertical cracks between lighter ridges.
				float crack = texture(noise_tex, vec2(ang * 2.4 + v_wp.x * 0.7, v_wp.y * 0.35)).r;
				albedo *= mix(1.06, 0.62, smoothstep(0.58, 0.68, crack));
			}
		}
		albedo *= mix(0.72, 1.06, smoothstep(0.0, 1.0, v_grad));
	}
	// Contact band: dark where the prop meets the ground.
	albedo *= mix(0.50, 1.0, smoothstep(0.0, 0.40, v_y + 0.05));
	float rim = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 3.0);
	ALBEDO = albedo;
	// A faint cool rim on stone / bark, a warm leafy one on crowns (never a glassy halo).
	EMISSION = foliage ? albedo * rim * rim_k : rim * rim_color * rim_strength * albedo * 2.0;
	ROUGHNESS = 1.0;
	SPECULAR = 0.0;
}

void light() {
	float d = dot(NORMAL, LIGHT) * 0.5 + 0.5;
	float ramp = smoothstep(0.32, 0.44, d) * 0.55 + smoothstep(0.58, 0.70, d) * 0.45;
	vec3 lc = LIGHT_COLOR;
	if (gd_detail > 0.5) {
		// Stone: a softer ramp, so neighbouring facets differ by a step, not by lit / unlit.
		float soft = smoothstep(0.12, 0.62, d) * 0.6 + smoothstep(0.50, 0.86, d) * 0.4;
		ramp = mix(ramp, soft, v_lk.y);
		// Leaves: warm where the sun hits them.
		lc *= mix(vec3(1.0), leaf_light_tint, v_lk.z);
		// Leaves: sun shining through the crown on its shadow side, strongest at the silhouette (half the shadow
		// still counts: light passes through the crown that casts it).
		float edge = 1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0);
		float back = smoothstep(0.52, 0.12, d);
		DIFFUSE_LIGHT += leaf_trans_color * (v_lk.x * back * (0.3 + 0.7 * edge * edge))
				* (0.45 + 0.55 * ATTENUATION) * LIGHT_COLOR / PI;
	}
	DIFFUSE_LIGHT += ramp * ATTENUATION * lc / PI;
}
