class_name CrownPedestalArt
extends Node3D
## The Ember Crown's altar (task A2.3). Scene: art/environment/crown_pedestal.tscn, generated by
## art/environment/crown/build_crown.gd. Root = the crown's spot on the ground; the crown floats at y 1.8
## (it is the Artifact's own gem node; art/environment/crown/ember_crown_mesh.res is its model).
## Node contract: "Runes" (MeshInstance3D, crown_rune.gdshader) is tinted red by EmberCrown while sealed.
##
## Four looks, blended smoothly:
##   SEALED    red seal: 4 glowing chains from the rune stones and 3 spinning seal rings lock the crown,
##             red embers, red glow pool, no beacon.
##   STIRRING  the last 30 s before the seal breaks: the rings spin up and flicker, the glow turns gold.
##   AWAKE     claimable: the seal shatters once (flash + shard burst), a gold column of light rises above
##             the crown, gold embers and glow pool.
##   EMPTY     the crown is worn or lies elsewhere: no beacon, the runes and embers cool down.
## State source, in order:
##   1. Bound crown (automatic): the nearest ancestor with is_sealed() / is_available() (EmberCrown) or a
##      `claimed` signal (plain Artifact), polled every frame through its public API only. bind_crown()
##      binds another node by hand.
##   2. Manual (no crown found): set_sealed(bool), set_stirring(bool), set_crown_present(bool).

enum Look { SEALED, STIRRING, AWAKE, EMPTY }

const STIR_LEAD := 30.0        ## EmberCrown.STIR_LEAD: the seal starts to stir 30 s before it breaks.
const HOME_RADIUS := 0.75      ## The crown counts as "on the altar" within this distance (m, flat).
const BREAK_TIME := 0.85       ## Seal shatter animation (s).
const RING_SPIN: Array[float] = [0.9, -1.25, 0.7]
const SEAL_RED := Color(1.0, 0.16, 0.07)
const EMBER_GOLD := Color(1.0, 0.62, 0.22)
const EMBERS_RED := Color(2.6, 0.55, 0.3)
const EMBERS_GOLD := Color(2.6, 1.55, 0.7)

var _crown: Node3D
var _claimed := false            # plain Artifact: its `claimed` signal fired
var _manual_sealed := false
var _manual_stirring := false
var _manual_present := true
var _look: int = -1
var _break_t := -1.0             # >= 0 while the seal shatters
var _stir := 0.0                 # 0-1 while stirring
var _time := 0.0

# Smoothed values (lerped toward the look's targets every frame).
var _beacon_i := 0.0
var _pool_i := 0.0
var _pool_col := SEAL_RED
var _rune_i := 1.0
var _embers_i := 0.5
var _embers_col := EMBERS_RED

var _runes: GeometryInstance3D
var _rings_root: Node3D
var _rings: Array[Node3D] = []
var _chains: GeometryInstance3D
var _beacon: GeometryInstance3D
var _pool: GeometryInstance3D
var _embers: GPUParticles3D
var _embers_mat: StandardMaterial3D
var _burst: GPUParticles3D
var _manual_tint: ShaderMaterial   # red runes in manual mode (EmberCrown tints them itself)
# G-D (docs/art/gd_props.md), by GameSettings.effective_graphics_quality() at _ready:
#   High+  "BeaconCore": a narrow, hotter inner column inside the beacon (the same beacon mesh, no new material)
#   Ultra  "CrownLight": one warm OmniLight3D (no shadow) that follows the glow pool's colour and intensity, so the
#          altar, the wardens and the units around it are lit by the crown (the only prop light, Ultra only)
const CORE_SCALE := Vector3(0.38, 1.3, 0.38)
const CORE_TINT := Color(1.0, 0.86, 0.6)
const LIGHT_ENERGY := 1.4
const LIGHT_RANGE := 9.0
const STONE_MAT := "res://art/environment/crown/crown_stone_mat.tres"   ## High+: dressed stone lit by the crown
var _core: GeometryInstance3D
var _light: OmniLight3D
var _stone: GeometryInstance3D


func _ready() -> void:
	PropsLook.ensure()
	set_detail_tier(PropsLook.tier())
	add_to_group(&"lighting_rigs")
	_runes = get_node_or_null(^"Runes") as GeometryInstance3D
	_rings_root = get_node_or_null(^"SealRings") as Node3D
	if _rings_root:
		for n: Node in _rings_root.get_children():
			if n is Node3D:
				_rings.append(n as Node3D)
	_chains = get_node_or_null(^"SealChains") as GeometryInstance3D
	_beacon = get_node_or_null(^"Beacon") as GeometryInstance3D
	_pool = get_node_or_null(^"GroundGlow") as GeometryInstance3D
	_embers = get_node_or_null(^"Embers") as GPUParticles3D
	_burst = get_node_or_null(^"SealBurst") as GPUParticles3D
	if _embers and _embers.draw_pass_1:
		var m := _embers.draw_pass_1.surface_get_material(0) as StandardMaterial3D
		if m:
			_embers_mat = m.duplicate() as StandardMaterial3D
			_embers.material_override = _embers_mat
	_find_crown()
	_update_state(true)
	_snap()
	_apply(0.0)


## The G-D tier pieces for graphics tier q (0 Low .. 3 Ultra): High+ BeaconCore + the crown-lit stone, Ultra the
## CrownLight. Both ways, idempotent. _ready uses PropsLook.tier(); GameSettings.apply_graphics reaches it through the
## "lighting_rigs" group (set_quality); tests and labs call it directly.
func set_detail_tier(q: int) -> void:
	q = clampi(q, 0, 3)
	var beacon := get_node_or_null(^"Beacon") as MeshInstance3D
	if q >= 2 and beacon and _core == null:
		var core := MeshInstance3D.new()
		core.name = "BeaconCore"
		core.mesh = beacon.mesh
		core.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		core.gi_mode = GeometryInstance3D.GI_MODE_DISABLED
		core.transform = Transform3D(Basis.from_scale(CORE_SCALE), beacon.position)
		add_child(core)
		_core = core
		_core.set_instance_shader_parameter(&"tint", CORE_TINT)
	elif q < 2 and _core != null:
		_core.queue_free()
		_core = null
	var stone := get_node_or_null(^"Stone") as MeshInstance3D
	if stone and stone.mesh and ResourceLoader.exists(STONE_MAT):
		for i: int in stone.mesh.get_surface_count():   # the env_painted surface (the other one is the gold trim)
			var m := stone.mesh.surface_get_material(i) as ShaderMaterial
			if m and m.shader and m.shader.resource_path.ends_with("env_painted.gdshader"):
				stone.set_surface_override_material(i, load(STONE_MAT) as Material if q >= 2 else null)
		_stone = stone if q >= 2 else null
	if q >= 3 and _light == null:
		var l := OmniLight3D.new()
		l.name = "CrownLight"
		l.position = Vector3(0.0, 2.2, 0.0)
		l.omni_range = LIGHT_RANGE
		l.omni_attenuation = 1.6
		l.shadow_enabled = false
		l.light_energy = 0.0
		l.light_specular = 0.3
		add_child(l)
		_light = l
	elif q < 3 and _light != null:
		_light.queue_free()
		_light = null


## GameSettings.apply_graphics -> group "lighting_rigs" (G-D).
func set_quality(q: int) -> void:
	set_detail_tier(q)


## Binds the crown this altar shows (EmberCrown or Artifact). Called automatically in _ready.
func bind_crown(crown: Node3D) -> void:
	_crown = crown
	_claimed = false
	if crown and not crown.has_method(&"is_available") and crown.has_signal(&"claimed"):
		if not crown.is_connected(&"claimed", _on_claimed):
			crown.connect(&"claimed", _on_claimed)


## Manual state (only used when no crown is bound).
func set_sealed(sealed: bool) -> void:
	_manual_sealed = sealed


func set_stirring(stirring: bool) -> void:
	_manual_stirring = stirring


func set_crown_present(present: bool) -> void:
	_manual_present = present


## The current look (Look enum: 0 sealed, 1 stirring, 2 awake, 3 empty).
func get_look() -> int:
	return _look


func _find_crown() -> void:
	var p: Node = get_parent()
	var depth := 0
	while p != null and depth < 3:
		if p is Node3D and (p.has_method(&"is_sealed") or p.has_method(&"is_available") or p.has_signal(&"claimed")):
			bind_crown(p as Node3D)
			return
		p = p.get_parent()
		depth += 1


func _on_claimed(_artifact: Node, _by: Node) -> void:
	_claimed = true


func _process(delta: float) -> void:
	_time += delta
	_update_state(false)
	_apply(delta)


## Reads the crown (or the manual flags) and switches the look.
func _update_state(first: bool) -> void:
	var sealed := _manual_sealed
	var stirring := _manual_stirring
	var present := _manual_present
	_stir = 0.6 if stirring else 0.0
	if _crown != null and is_instance_valid(_crown):
		sealed = _crown.has_method(&"is_sealed") and bool(_crown.call(&"is_sealed"))
		var left := STIR_LEAD + 1.0
		if _crown.has_method(&"crown_unseal_time_left"):
			left = float(_crown.call(&"crown_unseal_time_left"))
		stirring = sealed and left <= STIR_LEAD
		_stir = clampf(1.0 - left / STIR_LEAD, 0.0, 1.0) if stirring else 0.0
		if _crown.has_method(&"is_available"):
			var d := Vector2(_crown.global_position.x - global_position.x,
					_crown.global_position.z - global_position.z).length()
			present = bool(_crown.call(&"is_available")) and d <= HOME_RADIUS
		else:
			present = not _claimed
	var look: int = Look.EMPTY
	if present:
		look = Look.AWAKE
		if sealed:
			look = Look.STIRRING if stirring else Look.SEALED
	if look == _look:
		return
	var was_sealed := _look == Look.SEALED or _look == Look.STIRRING
	_look = look
	if look == Look.AWAKE and was_sealed and not first:
		_break_t = 0.0
		if _burst:
			_burst.restart()
			_burst.emitting = true
	var seal_on := look == Look.SEALED or look == Look.STIRRING
	if _rings_root:
		_rings_root.visible = seal_on or _break_t >= 0.0
		_rings_root.scale = Vector3.ONE
	if _chains:
		_chains.visible = seal_on or _break_t >= 0.0
	# Manual mode tints the runes itself (a bound EmberCrown does it through its own hook).
	if _runes and (_crown == null or not _crown.has_method(&"is_sealed")):
		_runes.material_override = _red_runes() if seal_on else null


func _red_runes() -> ShaderMaterial:
	if _manual_tint == null:
		var base := _runes.get_active_material(0) as ShaderMaterial
		if base == null:
			return null
		_manual_tint = base.duplicate() as ShaderMaterial
		_manual_tint.set_shader_parameter(&"glow_color", SEAL_RED)
		_manual_tint.set_shader_parameter(&"core_color", SEAL_RED.lightened(0.4))
		_manual_tint.set_shader_parameter(&"energy", 3.5)
	return _manual_tint


## Jumps the smoothed values to the current look (no fade at spawn).
func _snap() -> void:
	var t := _targets()
	_beacon_i = t[0]
	_pool_i = t[1]
	_pool_col = t[2]
	_rune_i = t[3]
	_embers_i = t[4]
	_embers_col = t[5]


## [beacon, pool intensity, pool colour, rune intensity, embers amount, embers colour] for the look.
func _targets() -> Array:
	match _look:
		Look.SEALED:
			return [0.0, 0.55, SEAL_RED, 1.0, 0.45, EMBERS_RED]
		Look.STIRRING:
			var f := 0.5 + 0.5 * sin(_time * (9.0 + _stir * 14.0)) * sin(_time * 3.7)
			return [0.08 + 0.3 * _stir * f, 0.6 + 0.35 * _stir * f, SEAL_RED.lerp(EMBER_GOLD, _stir * f),
					1.0 + 0.4 * _stir * f, 0.5 + 0.5 * _stir, EMBERS_RED.lerp(EMBERS_GOLD, _stir)]
		Look.AWAKE:
			return [1.8, 1.05, EMBER_GOLD, 1.1, 1.0, EMBERS_GOLD]
	return [0.0, 0.22, EMBER_GOLD, 0.45, 0.2, EMBERS_GOLD]   # EMPTY


func _apply(delta: float) -> void:
	var t := _targets()
	var k := clampf(delta * 3.0, 0.0, 1.0)
	var kf := clampf(delta * 9.0, 0.0, 1.0) if _look == Look.STIRRING else k   # flicker follows fast
	_beacon_i = lerpf(_beacon_i, t[0], clampf(delta * 1.4, 0.0, 1.0) if t[0] > _beacon_i else kf)
	_pool_i = lerpf(_pool_i, t[1], kf)
	_pool_col = _pool_col.lerp(t[2], kf)
	_rune_i = lerpf(_rune_i, t[3], kf)
	_embers_i = lerpf(_embers_i, t[4], k)
	_embers_col = _embers_col.lerp(t[5], k)

	var seal_i := 1.0
	var spin := 1.0
	if _look == Look.STIRRING:
		var fl := 0.5 + 0.5 * sin(_time * (11.0 + _stir * 18.0))
		seal_i = 1.0 + _stir * 0.9 * fl
		spin = 1.0 + _stir * 4.0
	var pool_flash := 0.0
	if _break_t >= 0.0:
		_break_t += delta
		var b := clampf(_break_t / BREAK_TIME, 0.0, 1.0)
		seal_i = 1.0 + 3.5 * b
		spin = 6.0
		pool_flash = (1.0 - b) * 1.2
		if _rings_root:
			_rings_root.scale = Vector3.ONE * (1.0 + 0.9 * b * b)
		if b >= 1.0:
			_break_t = -1.0
			if _rings_root:
				_rings_root.visible = false
			if _chains:
				_chains.visible = false

	if _rings_root and _rings_root.visible:
		_rings_root.rotate_y(delta * 0.35 * spin)
		for i: int in _rings.size():
			_rings[i].rotate_object_local(Vector3.UP, delta * RING_SPIN[i % RING_SPIN.size()] * spin)
			(_rings[i] as GeometryInstance3D).set_instance_shader_parameter(&"intensity", seal_i)
	if _chains and _chains.visible:
		_chains.set_instance_shader_parameter(&"intensity", seal_i * (0.9 + 0.1 * sin(_time * 2.3)))
	if _runes:
		_runes.set_instance_shader_parameter(&"intensity", _rune_i)
	if _beacon:
		_beacon.visible = _beacon_i > 0.01
		_beacon.set_instance_shader_parameter(&"intensity", _beacon_i)
	if _core:
		_core.visible = _beacon_i > 0.01
		_core.set_instance_shader_parameter(&"intensity", _beacon_i * 0.9)
	if _stone:
		_stone.set_instance_shader_parameter(&"glow_tint", _pool_col)
		_stone.set_instance_shader_parameter(&"glow_i", clampf(_pool_i + pool_flash + _beacon_i * 0.2, 0.0, 3.0))
	if _light:
		_light.light_color = _pool_col
		_light.light_energy = LIGHT_ENERGY * clampf(_pool_i + pool_flash + _beacon_i * 0.3, 0.0, 3.0)
		_light.visible = _light.light_energy > 0.02
	if _pool:
		_pool.set_instance_shader_parameter(&"intensity", _pool_i + pool_flash)
		_pool.set_instance_shader_parameter(&"tint", _pool_col)
	if _embers:
		_embers.amount_ratio = clampf(_embers_i, 0.05, 1.0)
		if _embers_mat:
			_embers_mat.albedo_color = _embers_col
