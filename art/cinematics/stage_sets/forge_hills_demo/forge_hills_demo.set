# Hills demo (World Forge terrain, prologue P1): a keep on a round hill, a ridge behind, a stream valley with water in
# front, distant mountains. Build: tools\world_forge\run_world_forge.ps1 build forge_hills_demo   (stills: sheet)
set forge_hills_demo  size=60x50  ground=grass  light=dawn  seed=5  title="Hills demo"
budget draws<=150 lights<=0

# terrain: grid 2 m, 60 m of hills beyond the set edges so wide shots never see the edge
terrain  step=2  smooth=2  noise=0.3  extend=60  rock=stone
hill   crown   at=(0,-12)  r=18  h=7  flat=0.45
hill   knoll   at=(-24,4)  r=10  h=3.5
ridge  north   poly=[(-90,-45),(-20,-62),(40,-55),(95,-35)]  width=40  h=22  jag=0.4
ridge  east    poly=[(40,-30),(62,10),(70,60)]  width=26  h=12  jag=0.5
valley stream  poly=[(-90,22),(-15,16),(20,24),(90,14)]  width=14  depth=3
water  lake    level=-1.2
sky    mountains=2  dist=190  height=40

# the keep on the hill top (pad = flat ground under it), a wall round the plateau, a road down
place kit:fire_keep  at=(0,-12)  tag=keep  lights=off  pad=11
wall  ring  poly=[(-8,-20),(-8,-4),(8,-4),(8,-20)]  height=3.5  thick=1.2  gate=(0,-4)  gate_width=4
path  hill_road  poly=[(0,-4),(1,3),(-2,10),(-4,16),(-5,25)]  width=3.2  kit=road
place forge:brazier  at=(-2.6,-2.6)
place forge:brazier  at=(2.6,-2.6)

# trees and rocks over the hills (scatter follows the terrain and never lands in the water)
zone  keep_hill  circle((0,-12),11)
scatter kit:pine     area=rect((-85,-80),(85,12))  count=70  gap=4  seed=3  avoid=cams,keep_hill  scale=0.9..1.4
scatter kit:birch    area=rect((-40,4),(40,40))   count=18  gap=4  seed=4  avoid=cams  scale=0.9..1.2
scatter kit:boulder  area=rect((-30,-24),(30,24)) count=14  gap=4  seed=6  avoid=cams,keep_hill  scale=0.6..1.2

# the cast
actor vessa  kit:vessa  at=(0.5,0)  yaw=0  lights=off  pad=2.5

# marks: ground=rel = y above the terrain under each point
mark H01  from=(-6,3,30)  to=(-4,3.5,26)  look=(0,6,-12)  ground=rel  subject=keep  fov=40  dur=6
mark H02  from=(34,24,46)  look=(0,8,-12)  subject=keep  fov=46  dur=5
mark H03  from=(-5.5,1.8,-1.5)  look=(0.5,1.5,0)  ground=rel  subject=vessa  fov=34  dur=4
mark H04  from=(-40,3.5,31)  to=(-34,3.5,31)  look=(10,0,17)  fov=42  dur=5
