# Prologue P4: Vessa of Fire (docs/design/prologue-3min.md S08, S14-S17 + a units-in-action shot S15U).
# Strength = fire power (she burned a door through the wall, her army pours through behind her); weakness =
# recklessness (she is 8 m ahead of everyone, the fire runs wild behind her by the wall and the keep's banners);
# love = she laughs among sparks. Young Vessa lights her first spark in a burnt corner (S14, south-west).
# The cinder dragon overhead (S15) comes from the P3 flock (a whole dragon model costs 44 draws).
# Draws: ~200 budget, every model is 20-35 surfaces: one grown Vessa, one young, three soldiers.
# P5 cues (hooks on the puppets; the models draw their own cast flares, 0 lights):
#   S14 at 1.0 anim vessa_young play_cast arg=kindle (first spark); S15 at 0.3 anim vessa play_cast arg=fireball (match-cut)
#   S15U at 0.5 anim scorchbow play_attack, 0.8 anim adept play_cast, 1.2 anim guard play_attack
#   S16 at 0.2 move vessa to=(1.5, 0, 11) speed=3 (she charges ahead alone) + anim vessa play_cast arg=ember_step
#   S17 at 0.5 anim vessa play_level_up (laughing among sparks). Hide vessa_young outside S14.
# Build: tools\world_forge\run_world_forge.ps1 build forge_intro_vessa   (stills: ... sheet forge_intro_vessa)
# Axis rule: every camera stays on the south (+z) side of the breached wall.
set forge_intro_vessa  size=60x50  ground=ash  light=dusk  seed=21  title="Vessa, of Fire"
budget draws<=200 lights<=0

# the Fire keep behind its curtain wall; the gate is the door she burned through (ember sill + trail)
place kit:fire_keep  at=(0,-15)  yaw=0  tag=keep  lights=off
wall  curtain  poly=[(-18,-24),(-18,-5),(18,-5),(18,-24)]  height=5  thick=1.5  gate=(0,-5)  gate_width=5  color=#4a3f3a
path  breach  poly=[(0,-8),(0,-3),(0.3,4),(0.8,12),(2.5,22)]  width=3.2  kit=ember
path  court   poly=[(0,-6),(0,-11)]  width=3  kit=flagstone
place forge:brazier  at=(-3.6,-2.6)
place forge:brazier  at=(3.6,-2.6)
row   forge:stake  poly=[(-16,-3.4),(-8,-3.4)]  spacing=4
row   forge:stake  poly=[(8,-3.4),(16,-3.4)]  spacing=4
row   kit:ruin_pillar  from=(11,9) to=(11,9)  count=1  yaw=25
# the fire that runs wild: at the wall foot by the banners, and on the trail right behind her
place res://art/environment/biomes/ash/ash_scar_fx.tscn  at=(-7.5,-1.6)  scale=2.4  tag=wildfire
place res://art/environment/biomes/ash/ash_scar_fx.tscn  at=(1.4,-0.4)  scale=1.0  tag=runfire
place res://art/environment/biomes/ash/ash_scar_fx.tscn  at=(-17,12.5)  scale=0.5  tag=sparks

# charred wilds (biome kit: ash) - baked, one draw per material
zone  keep_court  rect((-19,-25),(19,-4))
scatter res://art/cinematics/stage_sets/forge_intro_vessa/kits/ash_charred_wood.tscn  area=rect((-29,-3),(29,24))  count=18  gap=3.5  seed=3  avoid=cams,keep_court  scale=0.9..1.3
scatter res://art/cinematics/stage_sets/forge_intro_vessa/kits/ash_burnt_grass.tscn  area=rect((-29,-3),(29,24))  count=70  gap=1.2  seed=4  avoid=cams,keep_court  scale=0.9..1.4
scatter kit:pine     area=rect((-29,-24),(-20,24))  count=9  gap=3.5  seed=5  avoid=cams  scale=0.9..1.3
scatter kit:pine     area=rect((20,-24),(29,24))    count=9  gap=3.5  seed=6  avoid=cams  scale=0.9..1.3
scatter kit:boulder  area=rect((-28,-3),(28,24))    count=8  gap=4    seed=7  avoid=cams,keep_court  scale=0.6..1.1
scatter kit:shards   area=rect((-28,-3),(28,24))    count=6  gap=4    seed=8  avoid=cams  scale=0.7..1.0

# the cast
actor vessa        kit:vessa  at=(0,6)  yaw=0  lights=off
actor vessa_young  kit:vessa  at=(-15,15.5)  yaw=30  scale=0.62  lights=off
actor guard      kit:flame_guard  at=(-1.5,-3.2)  yaw=0
actor scorchbow  res://art/units/fire/scorchbow/scorchbow.tscn  at=(-4.6,-1.2)  yaw=15
actor adept      res://art/units/fire/pyre_adept/pyre_adept.tscn  at=(3.4,-1.6)  yaw=-10

# camera marks (Lens words = the intent; coordinates tuned and written here)
mark S08   from=(1.2,0.6,13.5)  to=(0.7,0.8,11)  look=(0,2.2,6)  look_to=(0,2.6,6)  fov=40  subject=vessa  dur=3  lens="ms on vessa, front, low, push 0.3"
mark S14   from=(-13.2,1.15,18.6)  to=(-13.6,1.1,18.0)  look=(-15,1.05,15.5)  fov=32  subject=vessa_young  dur=7  lens="cu on vessa_young, 3/4 right, eye, push 0.2"
mark S15   from=(6,0.7,12)  to=(2.5,0.8,13)  look=(0.5,2.2,3)  look_to=(0,2.4,2)  fov=44  subject=vessa  dur=7  lens="fs on vessa, 3/4 right, low, truck -3.5"
mark S15U  from=(-7.5,1.2,4.5)  to=(-6,1.3,4)  look=(-1.5,1.5,-1.8)  look_to=(-0.5,1.7,-2)  fov=46  subject=scorchbow  dur=5  lens="ws on scorchbow and adept, 3/4 left, low"
mark S16   from=(3,11,28)  to=(3.5,10,25)  look=(0,0.8,3)  look_to=(0,0.9,2.5)  fov=42  subject=vessa  dur=7  lens="ws on vessa, front, high, push 0.1"
mark S17   from=(0.9,1.6,8.9)  to=(0.7,1.62,8.5)  look=(0,1.72,6)  fov=30  subject=vessa  dur=6  lens="cu on vessa, 3/4 right, eye"
