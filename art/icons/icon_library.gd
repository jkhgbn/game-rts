class_name IconLibrary
extends RefCounted
## HUD icons generated by art/icons/render_icons.gd: res://art/icons/<kind>/<id>.png, 128 x 128, transparent,
## no frame (the UI draws rims). `IconLibrary.icon_for(&"spells", &"fireball")` -> Texture2D with mipmaps
## (use texture_filter LINEAR_WITH_MIPMAPS), or null if there is no icon (show the abbreviation then).
## Kinds: spells, items, orders, units, buildings, abilities (singular forms accepted). Results are cached, misses too.
## Order ids: move, stop, hold, attack_move, attack, gather, build, rally, cancel, back.
## Champions: units/<champion_id> (bust portraits), abilities/<ability_id> (champions.md 4.3), from
## art/icons/render_champion_icons.gd.
## Trade (10.V12, art/icons/render_trade_icons.gd): units/caravan|magpie|greywater_tracker,
## buildings/<kingdom>_market|magpie_den|greywater_lodge, orders/trade|route|wares, posts/<post_id>,
## wares/<ware_id>, contracts/outriders|sweep, ui/gold_coin|exchange_crystals|exchange_essence|crest_bazaar|crest_lodge.

const ROOT := "res://art/icons/"
const KIND_ALIASES := {
	&"spell": &"spells", &"item": &"items", &"order": &"orders", &"unit": &"units", &"building": &"buildings",
	&"ability": &"abilities", &"post": &"posts", &"ware": &"wares", &"contract": &"contracts",
}

static var _cache: Dictionary = {}


static func icon_for(kind: StringName, id: StringName) -> Texture2D:
	var k: StringName = KIND_ALIASES.get(kind, kind)
	var key: String = "%s/%s" % [k, id]
	if _cache.has(key):
		return _cache[key]
	var path: String = ROOT + key + ".png"
	var img: Image = null
	if ResourceLoader.exists(path):
		var t := load(path) as Texture2D
		if t != null:
			img = t.get_image()
	elif FileAccess.file_exists(path):
		img = Image.load_from_file(path)  # generated but not imported yet
	var tex: Texture2D = null
	if img != null and not img.is_empty():
		if img.is_compressed():
			img.decompress()
		if not img.has_mipmaps():
			img.generate_mipmaps()
		tex = ImageTexture.create_from_image(img)
	_cache[key] = tex
	return tex


static func has_icon(kind: StringName, id: StringName) -> bool:
	return icon_for(kind, id) != null


## Call after regenerating icons while the game runs (editor tools only).
static func clear_cache() -> void:
	_cache.clear()
