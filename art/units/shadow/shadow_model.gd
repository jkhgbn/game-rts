class_name ShadowModel
extends CharacterModel
## Shadow army + Ruin Warden extras on top of the shared kit (task 4.V3, polished in A.5; art-units.md 5 / 6).
## The scenes are generated by `_build_shadow.gd`; this script adds what the kit does not do:
## - per-unit flavour layered on the kit's walk / attacks (shade prowl, knight heavy stomp and two-handed chop with a
##   ground slam, warden stomp, nightbolt keeps its caster level, hound trot / bound with lifted paws and a pounce);
## - dissolve deaths for the Shadow units: the kit's `sink` still runs (and emits `death_finished` at 1.0 s), on top
##   the body flares violet (hit_flash instance uniform), thins into a column, fades (`transparency`) over a violet
##   pool (blob_color), glows flare before they die, motes + smoke rise;
## - warden crumble: head topples, arms drop, rubble chunks burst at 0.3 s, fade out at the end;
## - thrall lantern pendulum / mining / crystals, nightbolt bolt reload + muzzle puff, hound jaw + tail, knight
##   sparks, warden no team colour.
## Everything is per-instance (instance uniforms, transparency); no material is created or duplicated.
## Faces (face rework 2026-09-28): _build_parts gives the thrall, shade, nightbolt, knight and hound a FaceKit rig
## (ShadowFaces: a gaunt pale face painted on the dark head part, glowing violet eyes that replace the old glowing eye
## bar, expressions; the hound gets beast eyes). Subclasses that build their own parts set `_face` themselves; this
## script ticks it (_extra_process) and resets it on revive. The warden (a stone construct) has none.

## thrall, shade, nightbolt, hound, knight, warden
@export var unit_kind: StringName = &""
## Per-unit multiplier on the glow parts (the palette energies are material-wide), times veterancy / haste.
@export var glow_gain: float = 1.0

const DISSOLVE_FLASH := Vector3(0.48, 0.16, 1.0)
## Hit flash (kit hit_flash_*): a lilac flash at 55 % instead of the kit's full white (in-game grade 2026-09-30:
## white flashes turned knights and steeds into white blobs mid-fight).
const HIT_FLASH_LILAC := Vector3(0.75, 0.5, 1.0)
const HIT_FLASH_SCALE := 0.55
const POOL := Color(0.34, 0.10, 0.60, 0.72)
## The face's glowing eyes are small next to the old glowing eye bars: their glow_boost is written here (own_glow) at
## this multiple of glow_level() so they still make the unit's glow point at 40 m.
const EYE_GLOW := 4.0

var _lantern: Node3D
var _lantern_orb: GeometryInstance3D
var _crystals: Node3D
var _crystal_parts: Array[Node3D] = []
var _bolt: Node3D
var _puff: GPUParticles3D
var _sparks: GPUParticles3D
var _slam: GPUParticles3D
var _mine_sparks: GPUParticles3D
var _rubble: GPUParticles3D
var _death_smoke: GPUParticles3D
var _jaw: Node3D
var _tail: Node3D
var _lantern_pulsing: bool = false
var _jaw_last: float = 0.0
var _face: FaceRig
var _eye_glow_written: float = -1.0
var _tail_last: Vector3 = Vector3.ZERO

# Dissolve / crumble state (only touched while dying).
var _body: Array[GeometryInstance3D] = []
var _body_alpha: PackedFloat32Array = PackedFloat32Array()
var _blob_color: Color = Color(0.05, 0.03, 0.02, 0.45)
var _fade_written: float = 0.0
var _dflash_written: float = 0.0
var _rubble_fired: bool = false


func _build_parts() -> void:
	match unit_kind:
		&"thrall":
			_base_face("Root/Chest/Head", "MeshInstance3D2", "MeshInstance3D4", {"preset": &"hollow", "detail": &"low",
				"eye": {"c": Vector2(0.040, 0.018), "hw": 0.023, "top": 0.019, "bot": 0.012, "ir": 0.012},
				"brow": {"inner": Vector2(0.017, 0.043), "mid": Vector2(0.040, 0.052), "outer": Vector2(0.062, 0.044),
					"w": Vector3(0.0050, 0.0048, 0.0020)},
				"mouth": {"c": Vector2(0.0, -0.048), "hw": 0.020, "lip": 0.0022},
				"x": NatureFaces.lean_x(1.1, {&"neutral": {"mouth": {"kind": "frown", "curve": 0.6, "open": 0.0}}})},
				Vector2(0, -0.004), Vector2(0.074, 0.094), 0.0)
		&"shade":
			_base_face("Root/Chest/Head", "MeshInstance3D3", "MeshInstance3D4", {"preset": &"hollow", "detail": &"low", "sparks": 0.03,
				"eye": {"c": Vector2(0.046, -0.004), "hw": 0.028, "top": 0.018, "bot": 0.011, "ir": 0.013, "tilt": 0.012},
				"brow": {"inner": Vector2(0.020, 0.022), "mid": Vector2(0.046, 0.030), "outer": Vector2(0.072, 0.024),
					"w": Vector3(0.0055, 0.0052, 0.0022)},
				"mouth": {"c": Vector2(0.0, -0.074), "hw": 0.024, "lip": 0.0024},
				"x": NatureFaces.lean_x(1.1, {&"neutral": {"mouth": {"kind": "smirk"}, "cut_in": 0.25}})},
				Vector2(0, -0.024), Vector2(0.085, 0.100), 0.0)
		&"nightbolt":
			var hc := _model_xf(get_node("Root/Chest/Head/MeshInstance3D") as Node3D).origin
			_base_face("Root/Chest/Head", "MeshInstance3D", "MeshInstance3D5", {"preset": &"hollow", "detail": &"low",
				"eye": {"c": Vector2(0.050, 0.020), "hw": 0.030, "top": 0.022, "bot": 0.013, "ir": 0.015},
				"brow": {"inner": Vector2(0.022, 0.050), "mid": Vector2(0.050, 0.060), "outer": Vector2(0.078, 0.052),
					"w": Vector3(0.006, 0.0056, 0.0024)},
				"mouth": {"c": Vector2(0.0, -0.060), "hw": 0.026, "lip": 0.0024},
				"x": NatureFaces.lean_x(1.1),
				"hair_fn": func(acc: Dictionary) -> void:
					ShadowFaces.strands(acc, [hc + Vector3(0.15, 0.09, 0.06), hc + Vector3(-0.15, 0.09, 0.06),
						hc + Vector3(0.17, 0.08, -0.06), hc + Vector3(-0.17, 0.08, -0.06)], 0.24, 0.035,
						ShadowFaces.SILVER, ShadowFaces.SILVER_TIP, Vector3(0.03, 0, -0.02))},
				Vector2(0, -0.006), Vector2(0.098, 0.118), 0.0)
		&"knight":
			_base_face("Root/Chest/Head", "MeshInstance3D", "MeshInstance3D6", {"preset": &"stern", "detail": &"low",
				"radius": 0.25, "center_dy": 0.0,
				"eye": {"c": Vector2(0.044, 0.018), "hw": 0.027, "top": 0.018, "bot": 0.011, "ir": 0.013, "tilt": 0.01},
				"brow": {"inner": Vector2(0.018, 0.046), "mid": Vector2(0.044, 0.054), "outer": Vector2(0.070, 0.046),
					"w": Vector3(0.0075, 0.007, 0.003)},
				"mouth": {"c": Vector2(0.0, -0.058), "hw": 0.026, "lip": 0.0026},
				"x": NatureFaces.lean_x(1.15, {&"neutral": {"mouth": {"kind": "frown", "curve": 0.5, "open": 0.0}, "cut_in": 0.2}})},
				Vector2(0, -0.004), Vector2(0.072, 0.090), 0.016)
		&"hound":
			_base_face("Root/Mount/Head", "MeshInstance3D", "MeshInstance3D4", {"preset": &"stern", "detail": &"low",
				"radius": 0.12, "center_dy": 0.02, "center_dz": -0.02, "beast": true,
				"eye": {"c": Vector2(0.056, 0.030), "hw": 0.040, "top": 0.028, "bot": 0.020, "ir": 0.021, "tilt": 0.014},
				"brow": {"inner": Vector2(0.024, 0.066), "mid": Vector2(0.056, 0.076), "outer": Vector2(0.090, 0.066),
					"w": Vector3(0.007, 0.0065, 0.003)},
				"mouth": NatureFaces.beast_mouth(Vector2(0, -0.16)),
				"x": NatureFaces.lean_x(1.2, {&"neutral": {"cut_in": 0.4}})},
				Vector2.ZERO, Vector2.ZERO, 0.0)
	# G-C (docs/art/gc_shadow_units.md): shaped parts replace the generated primitives, after the face canvases are read.
	ShadowUnitDress.apply(self)


## G-C soul wisps (knight blade, thrall lantern): built only at this graphics quality or better, emitting only while
## the camera is within the kit's tier-0 range (30 m), the model is on-screen, not frozen and alive (wisps_should_emit).
## The gate runs on the particle node itself (shadow_wisps.gd): this model's _extra_process stops while it is frozen
## off-screen, and the wisps stay out of the kit's _loop_fx so a tier change never turns them on. Tests force the
## quality with the override.
const WISP_QUALITY := 2
static var wisp_quality_override: int = -1
var _wisps: GPUParticles3D


## True while the soul wisps may emit: camera within 30 m (kit tier 0), on-screen, animating (not frozen), alive and
## glows on. Polled by the SoulWisps node (shadow_wisps.gd).
func wisps_should_emit() -> bool:
	return _tier == 0 and not _offscreen and not _frozen and not _dead and not _glows_off


## True once this scene type's merged pivot meshes are cached (later instances skip building static parts).
func is_type_merged() -> bool:
	return _merged.has(_type_key + "|Root")


## A FaceKit face on an authored head part (`face_node` under `head_path`: its mesh + model transform are the canvas),
## the old glowing eye bar (`eye_node`) removed (the glowing irises are the glow point now). `oval_r` > 0 paints a pale
## face oval first (+ a dark rim `rim` wide: helm openings). spec: FaceKit spec keys + radius / center_dy / center_dz /
## beast (bone skull, no oval, the kit mouth hidden).
func _base_face(head_path: String, face_node: String, eye_node: String, spec: Dictionary, oval_c: Vector2, oval_r: Vector2,
		rim: float) -> void:
	var head := get_node_or_null(head_path) as Node3D
	var fn := get_node_or_null(head_path + "/" + face_node) as MeshInstance3D
	if head == null or fn == null:
		return
	var eb := get_node_or_null(head_path + "/" + eye_node)
	if eb:
		eb.get_parent().remove_child(eb)
		eb.free()
	var xf := _model_xf(fn)
	var m := fn.mesh
	var r: float = spec.get("radius", (m as SphereMesh).radius if m is SphereMesh else 0.2)
	var c := xf.origin + Vector3(0, spec.get("center_dy", 0.0), spec.get("center_dz", 0.0))
	var beast: bool = spec.get("beast", false)
	var skin: Color = ShadowFaces.BONE if beast else ShadowFaces.PALE
	var full := {"center": c, "radius": r, "skin": skin, "hair": ShadowFaces.INK, "eyes": ShadowFaces.GLOW,
		"palette": ShadowFaces.pal(skin)}
	for k: String in spec:
		if not k in ["radius", "center_dy", "center_dz", "beast", "sparks"]:
			full[k] = spec[k]
	var st := FaceKit.style_from(full)
	var cv := ShadowFaces.node_canvas(c, r, m, xf, 0.004)
	st["canvas"] = cv
	var spark: float = spec.get("sparks", 0.0)
	if spark > 0.0:
		var geo: Callable = st["geo"]
		var ec: Vector2 = spec["eye"]["c"]
		st["geo"] = func(acc: Dictionary) -> void:
			geo.call(acc)
			ShadowFaces.sparks(acc, cv, ec, spark, spark * 0.6)
	if oval_r != Vector2.ZERO:
		st["base"] = func(acc: Dictionary, _id: StringName) -> void:
			ShadowFaces.base_oval(acc, cv, oval_c, oval_r, skin, rim)
	_face = FaceKit.attach(self, head, String(scene_file_path.get_file().get_basename()) if scene_file_path != "" else String(unit_kind), st)


## Eye glow (own_glow on the Face node): glow_level() x EYE_GLOW, flaring with the unit's other glows (haste,
## veterancy, frenzy...), off once the kit turns the glows off in a death.
func _write_eye_glow() -> void:
	if not _face.has_meta(&"own_glow"):
		_face.set_meta(&"own_glow", true)
		_glow_nodes.erase(_face)
	var g: float = 0.0 if _glows_off else glow_level() * EYE_GLOW
	if absf(g - _eye_glow_written) > 0.01:
		_eye_glow_written = g
		_face.set_instance_shader_parameter(&"glow_boost", g)


## Model-space rest transform of an authored node (the pivots are unrotated at rest).
func _model_xf(n: Node3D) -> Transform3D:
	var xf := Transform3D.IDENTITY
	var c: Node = n
	while c and c != self:
		xf = (c as Node3D).transform * xf
		c = c.get_parent()
	return xf


func _after_ready() -> void:
	hit_flash_color = HIT_FLASH_LILAC
	hit_flash_scale = HIT_FLASH_SCALE
	_lantern = get_node_or_null(^"Root/Chest/ArmR/Lantern") as Node3D
	_lantern_orb = get_node_or_null(^"Root/Chest/ArmR/Lantern/LanternOrb") as GeometryInstance3D
	_crystals = get_node_or_null(^"Root/Chest/Crystals") as Node3D
	if _crystals:
		for c: Node in _crystals.get_children():
			_crystal_parts.append(c as Node3D)
	_bolt = get_node_or_null(^"Root/Chest/ArmR/Bolt") as Node3D
	_puff = get_node_or_null(^"Root/Chest/ArmR/FirePuff") as GPUParticles3D
	_sparks = get_node_or_null(^"Root/Chest/ArmR/Sparks") as GPUParticles3D
	_slam = get_node_or_null(^"Root/Chest/ArmR/Slam") as GPUParticles3D
	_mine_sparks = get_node_or_null(^"Root/Chest/ArmR/MineSparks") as GPUParticles3D
	_rubble = get_node_or_null(^"Fx/Rubble") as GPUParticles3D
	_death_smoke = get_node_or_null(^"Fx/DeathSmoke") as GPUParticles3D
	_jaw = get_node_or_null(^"Root/Mount/Head/Jaw") as Node3D
	_tail = get_node_or_null(^"Root/Mount/Tail") as Node3D
	var root := get_node_or_null(^"Root")
	if root:
		_collect_body(root)
	var q: int = wisp_quality_override if wisp_quality_override >= 0 else GameSettings.effective_graphics_quality()
	if q >= WISP_QUALITY:
		_wisps = ShadowUnitDress.add_wisps(self)
	if _shadow:
		var bc: Variant = _shadow.get_instance_shader_parameter(&"blob_color")
		if bc is Color:
			_blob_color = bc


func _collect_body(n: Node) -> void:
	for c: Node in n.get_children():
		if c is MeshInstance3D:
			_body.append(c as GeometryInstance3D)
		if not c is GPUParticles3D:
			_collect_body(c)


## The warden has no team colour (art-units.md 5.6).
func set_team_color(c: Color) -> void:
	if unit_kind == &"warden":
		return
	super.set_team_color(c)


func glow_level() -> float:
	return super.glow_level() * glow_gain


func play_death() -> void:
	if _dead:
		return
	_body_alpha.resize(_body.size())
	for i: int in _body.size():
		_body_alpha[i] = _body[i].transparency
	_fade_written = 0.0
	_dflash_written = 0.0
	_rubble_fired = false
	super.play_death()


func _on_action_event(ev: StringName) -> void:
	match ev:
		&"release":
			if _bolt:
				_bolt.visible = false
			if _puff:
				_puff.restart()
			if _sparks:
				_sparks.restart()
			if _slam:
				_slam.restart()
		&"attack_end":
			if _bolt:
				_bolt.visible = true
		&"mine_hit":
			if _mine_sparks:
				_mine_sparks.restart()
		&"death_glow_off":
			if _death_smoke:
				_death_smoke.restart()


func _on_revive() -> void:
	if _face:
		_face.reset()
		_eye_glow_written = -1.0
	if _bolt:
		_bolt.visible = true
	if _jaw:
		_jaw.rotation.x = 0.0
		_jaw_last = 0.0
	for i: int in _body.size():
		_body[i].transparency = _body_alpha[i] if i < _body_alpha.size() else 0.0
	for gi: GeometryInstance3D in _flash_all_targets:
		gi.set_instance_shader_parameter(&"hit_flash", 0.0)
		gi.set_instance_shader_parameter(&"flash_color", WHITE)
	_fade_written = 0.0
	_dflash_written = 0.0
	if _shadow:
		_shadow.set_instance_shader_parameter(&"blob_color", _blob_color)


# ================================================================ per frame (after the kit's pose)


func _extra_process(_dt: float) -> void:
	if _face:
		_face.auto(self)
		_write_eye_glow()
	if _dead:
		if unit_kind == &"warden":
			_crumble_extra(_death_t)
		else:
			_dissolve_extra(_death_t)
		return
	match unit_kind:
		&"thrall":
			_thrall_extra()
		&"nightbolt":
			if _bolt and _action == &"attack" and _action_t >= 0.5 and not _bolt.visible:
				_bolt.visible = true
		&"hound":
			_hound_extra()
	if _walk_w > 0.0:
		_walk_extra(_walk_w)
	if _action == &"attack":
		_attack_extra(_action_t)


## Walk flavour added on top of the kit cycle (s = the kit's leg phase; |s| = 1 when the legs are furthest apart).
func _walk_extra(w: float) -> void:
	var s: float = sin(TAU * _walk_p)
	var a: float = absf(s)
	match unit_kind:
		&"shade":
			# Low prowl: leaning in, blades trailing behind.
			rot(P_CHEST, Vector3(14.0 * DEG * w, 0, 0))
			rot(P_HEAD, Vector3(-10.0 * DEG * w, 0, 0))
			rot(P_ARM_L, Vector3(22.0 * DEG * w, 0, 0))
			rot(P_ARM_R, Vector3(22.0 * DEG * w, 0, 0))
			pos(P_ROOT, Vector3(0, -0.05 * w, 0))
		&"knight":
			# Heavy stomp: high at mid-stance, a hard dip on each footfall, rolling shoulders.
			pos(P_ROOT, Vector3(0, (-walk_bounce * a + 0.05 * (1.0 - a) - 0.06 * pow(a, 8.0)) * w, 0))
			rot(P_CHEST, Vector3(6.0 * DEG * w, 0, 3.0 * DEG * s * w))
			rot(P_HEAD, Vector3(-5.0 * DEG * w, 0, -3.0 * DEG * s * w))
		&"warden":
			pos(P_ROOT, Vector3(0, (-walk_bounce * a + 0.05 * (1.0 - a) - 0.08 * pow(a, 8.0)) * w, 0))
			rot(P_CHEST, Vector3(4.0 * DEG * w, 0, 5.0 * DEG * s * w))
			rot(P_ARM_L, Vector3(-10.0 * DEG * s * w, 0, 0))
		&"nightbolt":
			# Keeps the dusk-caster level (cancels the kit's arm swing), leaning slightly into the walk.
			rot(P_ARM_R, Vector3(-8.0 * DEG * s * w, 0, 0))
			rot(P_ARM_L, Vector3(18.0 * DEG * s * w, 0, 0))
			rot(P_CHEST, Vector3(5.0 * DEG * w, 0, 0))
		&"thrall":
			rot(P_CHEST, Vector3(8.0 * DEG * w, 0, 0))
			rot(P_HEAD, Vector3(-12.0 * DEG * w, 0, 0))
			pos(P_ROOT, Vector3(0, -0.02 * w, 0))


## Body motion layered on the kit's attack timelines (strike frames unchanged).
func _attack_extra(t: float) -> void:
	match unit_kind:
		&"knight":
			# Rear back and load (0-0.08), throw the whole body into the chop (0.08-0.14), hold the impact, recover.
			rot(P_CHEST, Vector3(_kh(t, 0.0, 0.08, 0.14, 0.34, 0.9, -14.0, 26.0) * DEG,
				_kh(t, 0.0, 0.08, 0.14, 0.34, 0.9, 22.0, -12.0) * DEG, 0))
			rot(P_HEAD, Vector3(_kh(t, 0.0, 0.08, 0.14, 0.34, 0.9, -8.0, 10.0) * DEG, 0, 0))
			pos(P_ROOT, Vector3(0, _kh(t, 0.0, 0.08, 0.14, 0.34, 0.9, 0.05, -0.05),
				_kh(t, 0.0, 0.08, 0.14, 0.34, 0.9, -0.08, 0.30)))
			rot(P_LEG_L, Vector3(_kh(t, 0.0, 0.08, 0.14, 0.34, 0.9, -8.0, -30.0) * DEG, 0, 0))
			rot(P_LEG_R, Vector3(_kh(t, 0.0, 0.08, 0.14, 0.34, 0.9, 6.0, 22.0) * DEG, 0, 0))
		&"shade":
			rot(P_CHEST, Vector3(_k3(t, 0.0, 0.06, 0.22, 0.45, -6.0, 18.0) * DEG, 0, 0))
			rot(P_LEG_L, Vector3(_k3(t, 0.0, 0.06, 0.20, 0.45, -10.0, -28.0) * DEG, 0, 0))
			rot(P_LEG_R, Vector3(_k3(t, 0.0, 0.06, 0.20, 0.45, 5.0, 18.0) * DEG, 0, 0))
			pos(P_ROOT, Vector3(0, _k3(t, 0.0, 0.06, 0.20, 0.45, 0.02, -0.07), 0))
		&"hound":
			# Pounce: nose up and front paws reaching, then the snap with the back legs pushing.
			rot(P_ROOT, Vector3(_k3(t, 0.0, 0.06, 0.12, 0.40, -12.0, 8.0) * DEG, 0, 0))
			pos(P_ROOT, Vector3(0, _k3(t, 0.0, 0.06, 0.12, 0.40, 0.10, 0.0), 0))
			var f: float = _k3(t, 0.0, 0.06, 0.12, 0.40, -42.0, -20.0) * DEG
			var b: float = _k3(t, 0.0, 0.06, 0.12, 0.40, 30.0, 16.0) * DEG
			rot(P_LEG_FL, Vector3(f, 0, 0)); rot(P_LEG_FR, Vector3(f, 0, 0))
			rot(P_LEG_BL, Vector3(b, 0, 0)); rot(P_LEG_BR, Vector3(b, 0, 0))
		&"nightbolt":
			# The left hand follows the lifted caster; recoil kicks the shoulders back at the release.
			var rl: float = attack_windup
			rot(P_ARM_L, Vector3(_k3(t, 0.0, rl, rl, 0.5, -25.0, -25.0) * DEG, 0, 0))
			rot(P_CHEST, Vector3(_k3(t, rl, rl + 0.04, rl + 0.10, 0.5, -9.0, -4.0) * DEG, 0, 0))
			rot(P_HEAD, Vector3(_k3(t, rl, rl + 0.04, rl + 0.10, 0.5, -6.0, -2.0) * DEG, 0, 0))
		&"warden":
			rot(P_CHEST, Vector3(_k3(t, 0.0, 0.06, 0.14, 0.45, -12.0, 18.0) * DEG, 0, 0))
			pos(P_ROOT, Vector3(0, _k3(t, 0.06, 0.12, 0.16, 0.45, -0.08, -0.08), 0))
		&"thrall":
			rot(P_CHEST, Vector3(_k3(t, 0.0, 0.06, 0.12, 0.40, -8.0, 14.0) * DEG, 0, 0))


## 0 -> v1 (t0..t1) -> v2 (t1..t2), hold v2 (t2..t3), -> 0 (t3..t4), smooth.
static func _kh(t: float, t0: float, t1: float, t2: float, t3: float, t4: float, v1: float, v2: float) -> float:
	if t <= t0 or t >= t4:
		return 0.0
	if t < t1:
		return v1 * _ease_out((t - t0) / maxf(t1 - t0, 0.0001))
	if t < t2:
		return lerpf(v1, v2, _ease_out((t - t1) / maxf(t2 - t1, 0.0001)))
	if t < t3:
		return v2
	return v2 * (1.0 - smoothstep(0.0, 1.0, (t - t3) / maxf(t4 - t3, 0.0001)))


# ================================================================ hound gait

## Grave Hound: a trot (diagonal pairs, the swinging paw lifts, the head counter-bobs, the body rolls) that turns
## into a bounding gallop (front pair / back pair, the spine pitches) above 1.25 x its base speed (haste).
func _pose_walk(w: float, rate: float) -> void:
	if unit_kind != &"hound":
		super._pose_walk(w, rate)
		return
	var ph: float = TAU * _walk_p
	var s: float = sin(ph)
	var c: float = cos(ph)
	if rate < 1.25:
		var q: float = 30.0 * DEG * s * w
		rot(P_LEG_FL, Vector3(q, 0, 0)); rot(P_LEG_BR, Vector3(q, 0, 0))
		rot(P_LEG_FR, Vector3(-q, 0, 0)); rot(P_LEG_BL, Vector3(-q, 0, 0))
		# The leg swinging forward (angle decreasing) lifts its paw off the ground.
		var la: float = 0.07 * maxf(0.0, -c) * w
		var lb: float = 0.07 * maxf(0.0, c) * w
		pos(P_LEG_FL, Vector3(0, la, 0)); pos(P_LEG_BR, Vector3(0, la, 0))
		pos(P_LEG_FR, Vector3(0, lb, 0)); pos(P_LEG_BL, Vector3(0, lb, 0))
		pos(P_ROOT, Vector3(0, walk_bounce * absf(c) * w, 0))
		rot(P_ROOT, Vector3(2.0 * DEG * s * w, 0, 0))
		rot(P_MOUNT, Vector3(0, 3.0 * DEG * s * w, 4.0 * DEG * s * w))
		rot(P_MOUNT_HEAD, Vector3(-6.0 * DEG * cos(2.0 * ph) * w, -4.0 * DEG * s * w, 0))
	else:
		var fq: float = 42.0 * DEG * s * w
		var bq: float = 42.0 * DEG * sin(ph + PI * 0.9) * w
		rot(P_LEG_FL, Vector3(fq, 0, 0)); rot(P_LEG_FR, Vector3(42.0 * DEG * sin(ph + 0.35) * w, 0, 0))
		rot(P_LEG_BL, Vector3(bq, 0, 0)); rot(P_LEG_BR, Vector3(42.0 * DEG * sin(ph + PI * 0.9 + 0.35) * w, 0, 0))
		pos(P_ROOT, Vector3(0, 0.09 * maxf(0.0, s) * w, 0))
		rot(P_ROOT, Vector3(-8.0 * DEG * c * w, 0, 0))
		rot(P_MOUNT_HEAD, Vector3(8.0 * DEG * c * w, 0, 0))


func _hound_extra() -> void:
	if _tail and _tier == 0:
		# Wags at idle, streams back and up when running.
		var r := Vector3(-28.0 * DEG * _walk_w, 15.0 * DEG * sin(_t * (5.0 + 8.0 * _walk_w)) * (1.0 - 0.5 * _walk_w), 0)
		if r != _tail_last:
			_tail_last = r
			_tail.rotation = r
	if _jaw:
		var j: float = 0.0
		if _action == &"attack":
			j = _k3(_action_t, 0.0, 0.06, 0.06, 0.12, 30.0, 30.0) * DEG
		if j != _jaw_last:
			_jaw_last = j
			_jaw.rotation.x = j


# ================================================================ deaths

## Shadow dissolve (on top of the kit's `sink`, same 1.0 s and the same death_finished).
func _dissolve_extra(t: float) -> void:
	var bh: float = body_height
	var s: float = _ease_in(clampf((t - 0.25) / 0.75, 0.0, 1.0))
	pos(P_ROOT, Vector3(0, (bh - 0.15) * s * 0.6, 0))   # keep ~40 % of the kit's sink: it melts, not drops
	var thin: float = smoothstep(0.3, 1.0, t)
	_root_scale *= Vector3(1.0 - 0.55 * thin, 1.0 + 0.3 * thin, 1.0 - 0.55 * thin)
	var flash: float = smoothstep(0.10, 0.40, t) * (1.0 - 0.5 * smoothstep(0.7, 1.0, t))
	_write_dissolve(flash * 0.4, smoothstep(0.35, 0.97, t))
	if not _glows_off:
		# The glows flare before the kit turns them off at 0.4 s.
		var g: float = glow_level() * (1.0 + 2.5 * smoothstep(0.05, 0.35, t))
		for gi: GeometryInstance3D in _glow_nodes:
			gi.set_instance_shader_parameter(&"glow_boost", g)
	if _shadow:
		_shadow.set_instance_shader_parameter(&"blob_color", _blob_color.lerp(POOL, smoothstep(0.1, 0.5, t)))


## Warden crumble (on top of the kit's `crumble`): the head topples off, the arms fall away, rubble bursts.
func _crumble_extra(t: float) -> void:
	var k: float = smoothstep(0.1, 0.6, t)
	rot(P_HEAD, Vector3(60.0 * DEG * k, 0, 25.0 * DEG * k))
	pos(P_HEAD, Vector3(0.10 * k, -0.30 * k, 0.28 * k))
	rot(P_ARM_L, Vector3(-15.0 * DEG * k, 0, -40.0 * DEG * k))
	rot(P_ARM_R, Vector3(-25.0 * DEG * k, 0, 40.0 * DEG * k))
	rot(P_CHEST, Vector3(20.0 * DEG * k, 0, -6.0 * DEG * k))
	if t >= 0.3 and not _rubble_fired:
		_rubble_fired = true
		if _rubble:
			_rubble.restart()
	_write_dissolve(0.0, smoothstep(0.72, 1.0, t))


func _write_dissolve(flash: float, fade: float) -> void:
	if absf(flash - _dflash_written) > 0.004:
		_dflash_written = flash
		for gi: GeometryInstance3D in _flash_all_targets:
			gi.set_instance_shader_parameter(&"hit_flash", flash)
			gi.set_instance_shader_parameter(&"flash_color", DISSOLVE_FLASH)
	if absf(fade - _fade_written) > 0.004:
		_fade_written = fade
		for i: int in _body.size():
			_body[i].transparency = lerpf(_body_alpha[i] if i < _body_alpha.size() else 0.0, 1.0, fade)


# ================================================================ Gloom Thrall

func _thrall_extra() -> void:
	# Lantern pendulum: +-10 deg at the walk rate, a slow sway at idle.
	if _lantern and _tier < 2:
		var sw: float = 10.0 * DEG * sin(TAU * _walk_p) * _walk_w + 3.0 * DEG * sin(_t * 1.7) * (1.0 - _walk_w)
		_lantern.rotation = Vector3(sw * 0.4, 0.0, sw)
	# Mining: crystals appear one by one at 1.3 / 2.6 / 3.9 s, lantern pulses at 2 Hz. Attacking: the lantern flares.
	var mining: bool = _action == &"mine"
	var hitting: bool = _action == &"attack"
	if mining:
		var elapsed: float = float(4 - _mine_left) + _action_t
		if _crystals:
			_crystals.visible = true
		var shown: int = clampi(int(elapsed / 1.3), 0, 3)
		for k: int in _crystal_parts.size():
			_crystal_parts[k].visible = k < shown
		if _lantern_orb:
			_lantern_orb.set_instance_shader_parameter(&"glow_boost", glow_level() * (1.3 + 0.7 * sin(_t * TAU * 2.0)))
		_lantern_pulsing = true
	elif hitting:
		if _lantern_orb:
			_lantern_orb.set_instance_shader_parameter(&"glow_boost",
				glow_level() * (1.0 + 2.0 * _k3(_action_t, 0.06, 0.12, 0.14, 0.40, 1.0, 1.0)))
		_lantern_pulsing = true
	elif _lantern_pulsing:
		_lantern_pulsing = false
		if _crystals:
			_crystals.visible = _carrying
		for c: Node3D in _crystal_parts:
			c.visible = true
		_apply_glow(true)


func set_carrying(on: bool) -> void:
	super.set_carrying(on)
	if on:
		for c: Node3D in _crystal_parts:
			c.visible = true


## Gloom Thrall: holds the lantern toward the node instead of swinging a pick.
func _pose_mine(t: float) -> void:
	if unit_kind != &"thrall":
		super._pose_mine(t)
		return
	var hold: float = 1.0
	if _mine_left == 4 and t < 0.25:
		hold = _ease_out(t / 0.25)
	rot(P_ARM_R, Vector3(-60.0 * DEG * hold, 0, 0))
	rot(P_CHEST, Vector3(8.0 * DEG * hold, 0, 0))
