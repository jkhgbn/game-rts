class_name FireKeepModel
extends Node3D
## Visual model of Vessa's Fire Keep ("Ember Bastion"), art-keep.md sections 3, 6, 7, 8 (polished in task A.7).
## The geometry is generated by art/buildings/fire_keep_build.gd (run it WINDOWED to regenerate the .tscn).
## Gameplay never touches the children; it calls the hooks below (docs/design/art-keep.md 8.8):
##   set_team_color(c), set_construction_progress(p), set_health_ratio(r), play_training_pulse(),
##   play_destroyed() (emits `destroyed_finished` after 3.0 s; the wreck stays until freed), set_selected(on).
## Every hook is safe before _ready (values are cached) and after the node is freed mid-sequence
## (no tweens or timers: the whole state machine runs in the one _process).
## Each static section under "Body" is one mesh with a surface per material; ground contact (scorch,
## rune circle, rubble) stays at the root. Collision is Building's (6 x 6 m).

signal destroyed_finished

const RING_Y := 14.0
const HEART_Y := 16.2
const RING_SPEED_DEG := 12.0
const RING_LIMP_DEG := 6.0
const RUNE_SPEED_DEG := -24.0
const CRYSTAL_SPIN_DEG := 45.0
const RIM_IDLE := Color(0.55, 0.65, 0.85)
const KINGDOM_COLOR := Color(0.85, 0.30, 0.12)
const FIRE_GLOW := Color(1.0, 0.6, 0.18)
const PULSE_TIME := 0.6
const DESTROY_TIME := 3.0
const PLINTH_TOP := 1.1
const SMOKE_COLOR := Color(0.16, 0.14, 0.13)
const DUST_COLOR := Color(0.24, 0.21, 0.19)
## Sections that never sink in the collapse (the ground-level plinth and lava stay as the wreck's base).
const NO_COLLAPSE: Array[StringName] = [&"Plinth", &"Lava", &"Spire"]
## Sections hidden at 1.6 s into the collapse (roofs, banners, braziers go down with the walls).
const HIDE_AT_16: Array[StringName] = [&"Roofs", &"RoofLost", &"BannersGate", &"BannersSide", &"Braziers"]
## Construction (8.2): the build height range over which a section rises, when its own bottom / top would
## let it float above the unfinished part it sits on (roofs wait for the tower crowns, banners and
## braziers for the parapet). Other sections use their own bottom / top.
const RISE := {
	&"Towers": Vector2(0.0, 9.5), &"Roofs": Vector2(9.5, 13.7), &"RoofLost": Vector2(9.5, 13.7),
	&"Braziers": Vector2(7.7, 8.6), &"BannersSide": Vector2(7.7, 8.4), &"BannersGate": Vector2(9.5, 10.0),
}
## The wreck (8.5): Vector2(height kept, pivot y) per section (default 0.25 about the plinth top):
## broken tower stumps stand above the walls (towers and what hangs on them sink about the ground),
## the donjon caves in behind the walls.
const WRECK := {
	&"Towers": Vector2(0.4, 0.0), &"Roofs": Vector2(0.4, 0.0), &"RoofLost": Vector2(0.4, 0.0),
	&"BannersGate": Vector2(0.4, 0.0), &"Walls": Vector2(0.3, PLINTH_TOP), &"Windows": Vector2(0.3, PLINTH_TOP),
	&"Braziers": Vector2(0.3, PLINTH_TOP), &"BannersSide": Vector2(0.3, PLINTH_TOP), &"Donjon": Vector2(0.06, PLINTH_TOP),
}

## Art Lab budget pass (art-keep.md 9, <= 8 materials): the keep draws with ONE painted material
## (fire_keep_painted.gdshader, palette slots S O D M T in uniform arrays) and ONE glow material
## (fire_keep_glow.gdshader: coals, gate, windows, heart, crystals, lava, doorway, build outline), plus the
## runes, banner, ground decal and the two particle quads. The exports below point into those: gate / crystal /
## heart / lava = the glow material, cap = the painted one (its team slot).
const TEAM_SLOT := 4
const STONE_SLOT := 0
const DARK_SLOT := 2
const OUTLINE_KIND := 7
## G-B Fire (docs/art/gb_fire_buildings.md): the Fire paint tier, tier looks (set_tier), the upgrade scaffold
## (set_upgrading), the tier-up flourish (play_tier_up) and heat haze. The tier kit is loaded at run time (it uses
## the keep builder's mesh kit, which preloads this script).
const GBF := preload("res://art/buildings/fire/fire_building_look.gd")
const TIERS_PATH := "res://art/buildings/fire/fire_keep_tiers.gd"
const TIER_UP_TIME := 1.4

@export var painted_materials: Array[ShaderMaterial] = []
@export var glow_materials: Array[ShaderMaterial] = []
@export var gate_material: ShaderMaterial
@export var cap_material: ShaderMaterial
@export var banner_material: ShaderMaterial
@export var crystal_material: ShaderMaterial
@export var heart_material: ShaderMaterial
@export var ground_material: ShaderMaterial
@export var lava_material: ShaderMaterial
@export var rune_material: ShaderMaterial

@onready var _body: Node3D = $Body
@onready var _ring: Node3D = $Body/Ring
@onready var _crystals: Array[Node3D] = [$Body/Ring/Crystal1, $Body/Ring/Crystal2, $Body/Ring/Crystal3]
@onready var _heart_light: OmniLight3D = $Body/HeartLight
@onready var _gate_light: OmniLight3D = $Body/GateLight
@onready var _spire: Node3D = $Body/Spire
@onready var _heart: Node3D = $Body/EmberHeart
@onready var _rune_tilt: Node3D = $Body/RuneTilt
@onready var _runes: Node3D = $Body/RuneTilt/RuneRing
@onready var _windows: Node3D = $Body/Windows
@onready var _rubble: Node3D = $Rubble
@onready var _lost_roof: Node3D = $Body/RoofLost
@onready var _gate_banners: Node3D = $Body/BannersGate
@onready var _idle_fx: Array[GPUParticles3D] = [$Body/BrazierFire, $Body/Embers, $Body/ChimneySmoke, $Body/HeartSparks]

# Structure parts (direct mesh children of Body): rest transform, bottom and top in Body space.
var _parts: Array[GeometryInstance3D] = []
var _part_xf: Array[Transform3D] = []
var _part_b: PackedFloat32Array = PackedFloat32Array()
var _part_t: PackedFloat32Array = PackedFloat32Array()
var _rise: PackedVector2Array = PackedVector2Array()
var _wreck: PackedVector2Array = PackedVector2Array()
var _collapse_idx: PackedInt32Array = PackedInt32Array()
var _hide_at_16: Array[Node3D] = []
var _height: float = 18.5
var _spire_xf: Transform3D
var _rune_tilt_base: Vector3

# State particles and helpers (built once in _ready).
var _smoke: Array[GPUParticles3D] = []
var _blaze: Array[GPUParticles3D] = []
var _train_burst: GPUParticles3D
var _build_ring: GPUParticles3D
var _build_flash: GPUParticles3D
var _crystal_burst: GPUParticles3D
var _dust: GPUParticles3D
var _outline: MultiMeshInstance3D
var _outline_mat: ShaderMaterial
var _rubble2: MultiMeshInstance3D
var _debris: MultiMeshInstance3D
var _team_ramps: Array[Gradient] = []

var _t: float = 0.0
var _ready_done: bool = false
var _team_color: Color = KINGDOM_COLOR
var _progress: float = 1.0
var _was_building: bool = false
var _ring_appear: float = 1.0
var _outline_fade: float = 0.0
var _health_ratio: float = 1.0
var _ring_speed_deg: float = RING_SPEED_DEG
var _flicker_amp: float = 0.1
var _wobble: float = 0.0
var _pulse_left: float = 0.0
var _selected: bool = false
var _sel_k: float = 0.0
var _destroyed: bool = false
var _destroy_t: float = 0.0
var _destroy_step: int = 0
var _spire_down: bool = false
var _stone_crack: float = 0.55
var _slot_colors: PackedColorArray = PackedColorArray()
var _slot_cracks: PackedFloat32Array = PackedFloat32Array()
# G-B tiers / upgrade.
var _tier: int = 1
var _upgrading: bool = false
var _tier_nodes: Dictionary = {}
var _tier_up_left: float = 0.0
var _hazes: Array[Node3D] = []
var _smoke_base := Vector3.INF   ## ChimneySmoke rest position (tier 3 raises the chimney 3.1 m)


func _ready() -> void:
	_ready_done = true
	_t = randf() * 10.0
	_rune_tilt_base = _rune_tilt.rotation
	if cap_material:
		_slot_colors = PackedColorArray(cap_material.get_shader_parameter(&"base_colors"))
	if painted_materials.size() > 0:
		_slot_cracks = PackedFloat32Array(painted_materials[0].get_shader_parameter(&"crack_strengths"))
		if _slot_cracks.size() > STONE_SLOT:
			_stone_crack = _slot_cracks[STONE_SLOT]
	_collect_parts()
	_build_state_nodes()
	_gb_setup()
	set_team_color(_team_color)
	set_construction_progress(_progress)
	_sel_k = 1.0 if _selected else 0.0
	_apply_rim_and_glow()
	if _destroyed:
		_destroyed = false
		play_destroyed()


func _process(delta: float) -> void:
	_t += delta
	if _destroyed:
		_process_destroyed(delta)
		return
	_gb_process(delta)
	# Crystal ring: rotates (x3 during a training pulse) and bobs; crystals spin on themselves.
	var ring_mult: float = 3.0 if _pulse_left > 0.0 else 1.0
	_ring.rotation.y += deg_to_rad(_ring_speed_deg) * ring_mult * delta
	_ring.position.y = RING_Y + 0.2 * sin(_t * 2.09)
	if _ring_appear < 1.0:
		_ring_appear = minf(_ring_appear + delta / 0.5, 1.0)
		var s: float = maxf(ease(_ring_appear, 0.4), 0.01)
		_ring.scale = Vector3.ONE * s
		_heart.scale = Vector3.ONE * s
		_rune_tilt.scale = Vector3.ONE * s
	var spin: float = deg_to_rad(CRYSTAL_SPIN_DEG) * delta
	for c: Node3D in _crystals:
		c.rotation.y += spin
	# The heart floats and breathes inside the claws; its rune band turns (and wobbles when hurt).
	_heart.position.y = HEART_Y + 0.12 * sin(_t * 1.6)
	_rune_tilt.position.y = _heart.position.y
	_runes.rotation.y += deg_to_rad(RUNE_SPEED_DEG) * ring_mult * delta
	if _wobble > 0.0:
		_rune_tilt.rotation = _rune_tilt_base + Vector3(sin(_t * 5.3), 0.0, cos(_t * 4.1)) * _wobble
	# Fire flicker (amplitude x3 below 25 % HP).
	var n: float = sin(_t * 8.1) * 0.5 + sin(_t * 13.7) * 0.5
	var flicker: float = 1.0 - _flicker_amp + _flicker_amp * n
	_heart_light.light_energy = 3.0 * flicker * _progress
	var gate_mult: float = 1.0
	if _pulse_left > 0.0:
		_pulse_left = maxf(_pulse_left - delta, 0.0)
		var k: float = 1.0 - _pulse_left / PULSE_TIME
		var boost: float = 1.0 + 2.0 * (k / 0.17) if k < 0.17 else 1.0 + 2.0 * pow(1.0 - (k - 0.17) / 0.83, 2.0)
		if gate_material:
			gate_material.set_shader_parameter(&"gate_boost", boost)  # x the selection boost in the shader
		gate_mult = 2.0 if _pulse_left > 0.3 else 1.0
	_gate_light.light_energy = 1.8 * flicker * gate_mult * _progress
	# Selection fade (0.15 s in, 0.25 s out); only touches materials while it moves.
	var target: float = 1.0 if _selected else 0.0
	if _sel_k != target:
		_sel_k = move_toward(_sel_k, target, delta / (0.15 if _selected else 0.25))
		_apply_rim_and_glow()
	# Construction outline fades out over 0.5 s once the keep is complete.
	if _outline_fade > 0.0:
		_outline_fade = maxf(_outline_fade - delta / 0.5, 0.0)
		_outline_mat.set_shader_parameter(&"outline_energy", 2.0 * _outline_fade)
		if _outline_fade <= 0.0:
			_outline.visible = false


# --- Hooks ---

## Construction progress 0..1 (art-keep.md 8.2): glowing outline at 0, parts rise from the ground in
## height order, the heart, runes and crystal ring scale in at >= 0.95, the forge windows light at 1.
func set_construction_progress(p: float) -> void:
	_progress = clampf(p, 0.0, 1.0)
	if not _ready_done or _destroyed:
		return
	var building: bool = _progress < 1.0
	var h: float = _progress * _height
	for i: int in _parts.size():
		var part: GeometryInstance3D = _parts[i]
		if not building:
			part.transform = _part_xf[i]
			part.visible = true
			continue
		var r: Vector2 = _rise[i]
		if h < r.x:
			part.visible = false
			continue
		part.visible = true
		_squash(i, clampf((h - r.x) / maxf(r.y - r.x, 0.01), 0.05, 1.0), _part_b[i], Vector3.ZERO)
	# The forge only lights up once the keep stands.
	_windows.visible = not building
	var floating: bool = _progress >= 0.95
	if floating and not _ring.visible:
		_ring_appear = 0.0 if building or _was_building else 1.0
		var s: float = 0.01 if _ring_appear < 1.0 else 1.0
		_ring.scale = Vector3.ONE * s
		_heart.scale = Vector3.ONE * s
		_rune_tilt.scale = Vector3.ONE * s
	_ring.visible = floating
	_heart.visible = floating
	_rune_tilt.visible = floating
	for fx: GPUParticles3D in _idle_fx:
		fx.emitting = not building
	_build_ring.emitting = building
	if building:
		_outline.visible = true
		_outline_fade = 0.0
		_outline_mat.set_shader_parameter(&"outline_energy", 2.0)
	elif _was_building:
		_outline_fade = 1.0
		_fire(_build_flash)
	else:
		_outline.visible = false
	_was_building = building
	for hz: Node3D in _hazes:
		hz.visible = not building
	_apply_tier()
	_apply_health()
	_apply_rim_and_glow()


## A unit popped out of the gate (8.3): 0.6 s gate flash, gate light x2, burst, rings x3. Restarts if retriggered.
func play_training_pulse() -> void:
	if _destroyed:
		return
	_pulse_left = PULSE_TIME
	if _ready_done and _progress >= 1.0:
		_fire(_train_burst)


## HP ratio 0..1 (8.4): smoke + lost roof below 50 %, fire + fallen crystal below 25 %. Reverts when healed.
func set_health_ratio(r: float) -> void:
	_health_ratio = clampf(r, 0.0, 1.0)
	if _ready_done and not _destroyed:
		_apply_health()


## Collapse (8.5): 3.0 s sequence, then `destroyed_finished`; the smoking wreck stays until freed.
func play_destroyed() -> void:
	if _destroyed:
		return
	_destroyed = true
	if not _ready_done:
		return
	_destroy_t = 0.0
	_destroy_step = 0
	# Snap to the finished keep first (a site can die mid-construction).
	for i: int in _parts.size():
		_parts[i].transform = _part_xf[i]
		if _progress < 1.0:
			_parts[i].visible = true
	_outline.visible = false
	_build_ring.emitting = false
	for hz: Node3D in _hazes:
		hz.visible = false
	if not _tier_nodes.is_empty():
		(_tier_nodes["scaffold"] as Node3D).visible = false
	for fx: GPUParticles3D in _idle_fx:
		fx.emitting = false
	for s: GPUParticles3D in _smoke:
		s.emitting = true
	for b: GPUParticles3D in _blaze:
		b.emitting = true
	for m: ShaderMaterial in painted_materials:
		m.set_shader_parameter(&"damage", 1.0)
	if lava_material:
		lava_material.set_shader_parameter(&"lava_agitation", 1.0)
	_ring.visible = true
	_ring.scale = Vector3.ONE
	_heart.visible = true
	_heart.scale = Vector3.ONE
	_rune_tilt.visible = true
	_rune_tilt.scale = Vector3.ONE


## Selection (8.6): team rim on every painted material, glow boost 1.4 on glow parts.
func set_selected(on: bool) -> void:
	_selected = on


## Team colour (8.7): roofs, banners, selection rim, crystals, runes, construction / training glows.
func set_team_color(c: Color) -> void:
	_team_color = c
	if not _ready_done:
		return
	if cap_material and _slot_colors.size() > TEAM_SLOT:
		_slot_colors[TEAM_SLOT] = c
		cap_material.set_shader_parameter(&"base_colors", _slot_colors)
	if banner_material:
		banner_material.set_shader_parameter(&"cloth_color", c)
	var glow: Color = FIRE_GLOW if c.is_equal_approx(KINGDOM_COLOR) else c.lightened(0.35)
	if crystal_material:
		crystal_material.set_shader_parameter(&"team_glow", glow)  # crystals + build outline
	if rune_material:
		rune_material.set_shader_parameter(&"glow_color", glow)
	for g: Gradient in _team_ramps:
		g.set_color(0, Color(glow, 1.0))
		g.set_color(1, Color(glow, 0.0))
	_apply_rim_and_glow()


## G-B: keep tier 1-3 (Keep._show_tier): tier 2 Stronghold, tier 3 Citadel additions. Safe before _ready.
func set_tier(t: int) -> void:
	_tier = clampi(t, 1, 3)
	_apply_tier()


## G-B: an upgrade is running (Keep.upgrade / cancel_upgrade / set_tier_now): scaffold cage round the donjon, a
## glowing forging band climbing it, the construction sparks on the plinth.
func set_upgrading(on: bool) -> void:
	_upgrading = on
	_apply_tier()


## G-B: the tier was reached (not on quiet campaign starts): a flash from the heart, a crystal burst, the heart and
## crystals flare for TIER_UP_TIME s.
func play_tier_up() -> void:
	if not _ready_done or _destroyed or _progress < 1.0:
		return
	_tier_up_left = TIER_UP_TIME
	_fire(_build_flash)
	_crystal_burst.position = _ring.position
	_fire(_crystal_burst)


# --- Internals ---

## G-B: paint tier, the banner glyph under the bloom (Art Lab R5), the tier kit, heat haze over the chimney.
func _gb_setup() -> void:
	for m: ShaderMaterial in painted_materials:
		GBF.set_detail(m)
	if GBF.legacy:
		return
	if banner_material:
		banner_material.set_shader_parameter(&"glyph_energy", 0.35)
	var body_mat: ShaderMaterial = cap_material if cap_material else (painted_materials[0] if painted_materials.size() > 0 else null)
	var scr: GDScript = load(TIERS_PATH) as GDScript
	if scr and body_mat and glow_materials.size() > 0:
		_tier_nodes = scr.call(&"build", _body, _spire, body_mat, glow_materials[0], banner_material)
		for k: String in ["t2", "t3"]:
			_hide_at_16.append(_tier_nodes[k] as Node3D)
	var hz: MeshInstance3D = GBF.add_heat_haze(_body, Vector3(-2.6, 14.75, 2.6), Vector2(1.7, 3.6))
	if hz:
		_hazes.append(hz)


func _apply_tier() -> void:
	if not _ready_done or _tier_nodes.is_empty() or _destroyed:
		return
	var standing: bool = _progress >= 1.0
	(_tier_nodes["t2"] as Node3D).visible = standing and _tier >= 2
	(_tier_nodes["t3"] as Node3D).visible = standing and _tier >= 3
	(_tier_nodes["t3_spire"] as Node3D).visible = standing and _tier >= 3
	(_tier_nodes["scaffold"] as Node3D).visible = standing and _upgrading
	var cs: Node3D = _idle_fx[2]   # ChimneySmoke
	if _smoke_base == Vector3.INF:
		_smoke_base = cs.position
	var lift := Vector3(0, 3.1 if _tier >= 3 else 0.0, 0)
	cs.position = _smoke_base + lift
	for hz: Node3D in _hazes:
		hz.position = Vector3(-2.6, 14.75, 2.6) + lift
	_build_ring.emitting = not standing or _upgrading


## G-B: the forging band climbs the donjon while upgrading; the tier-up flare fades.
func _gb_process(delta: float) -> void:
	if _upgrading and not _tier_nodes.is_empty() and _progress >= 1.0:
		var band: Node3D = _tier_nodes["band"]
		band.position.y = 6.4 + fmod(_t * 1.4, 6.2)
	if _tier_up_left > 0.0:
		_tier_up_left = maxf(_tier_up_left - delta, 0.0)
		var k: float = _tier_up_left / TIER_UP_TIME
		var boost: float = 1.0 + 2.2 * k * k
		if crystal_material:
			crystal_material.set_shader_parameter(&"core_boost", boost)
		if heart_material:
			heart_material.set_shader_parameter(&"core_boost", boost)

func _collect_parts() -> void:
	for child: Node in _body.get_children():
		if not (child is MeshInstance3D or child is MultiMeshInstance3D):
			continue
		var g: GeometryInstance3D = child as GeometryInstance3D
		if g == _heart:
			continue
		var box: AABB = g.transform * (g as VisualInstance3D).get_aabb()
		_parts.append(g)
		_part_xf.append(g.transform)
		_part_b.append(box.position.y)
		_part_t.append(box.end.y)
		var nm := StringName(g.name)
		_rise.append(RISE.get(nm, Vector2(box.position.y, box.end.y)))
		_wreck.append(WRECK.get(nm, Vector2(0.25, PLINTH_TOP)))
		_height = maxf(_height, box.end.y)
		if nm in NO_COLLAPSE:
			continue
		_collapse_idx.append(_parts.size() - 1)
		if StringName(g.name) in HIDE_AT_16:
			_hide_at_16.append(g)
	_spire_xf = _spire.transform


## Squash part i vertically about height `b` (Body space), with an optional offset (rumble).
func _squash(i: int, s: float, b: float, offset: Vector3) -> void:
	var sq := Transform3D(Basis.from_scale(Vector3(1.0, s, 1.0)), Vector3(0.0, b * (1.0 - s), 0.0) + offset)
	_parts[i].transform = sq * _part_xf[i]


func _apply_health() -> void:
	var r: float = _health_ratio
	var built: bool = _progress >= 1.0
	var smoke: bool = built and r < 0.5
	var fire: bool = built and r < 0.25
	var dmg: float = (1.0 - r) * 0.5
	if r < 0.25:
		dmg = 1.0
	elif r < 0.5:
		dmg = 0.6
	for m: ShaderMaterial in painted_materials:
		m.set_shader_parameter(&"damage", dmg)
	for s: GPUParticles3D in _smoke:
		s.emitting = smoke
	for b: GPUParticles3D in _blaze:
		b.emitting = fire
	# Lost roof (the near-left tower in the 1v1 view) with rubble around that corner.
	_lost_roof.visible = not smoke and (built or _lost_roof.visible)
	_rubble2.visible = smoke
	_ring_speed_deg = RING_LIMP_DEG if smoke else RING_SPEED_DEG
	_flicker_amp = 0.3 if fire else 0.1
	_wobble = 0.35 if fire else (0.12 if smoke else 0.0)
	if _wobble == 0.0:
		_rune_tilt.rotation = _rune_tilt_base
	if lava_material:
		lava_material.set_shader_parameter(&"lava_agitation", 1.0 if fire else (0.45 if smoke else 0.0))
	if heart_material:
		heart_material.set_shader_parameter(&"heart_pulse_speed", 9.0 if fire else (6.0 if smoke else 4.2))
	_crystals[0].visible = not fire
	_gate_banners.visible = not fire and (built or _gate_banners.visible)


func _sel_boost() -> float:
	return lerpf(1.0, 1.4, _sel_k)


func _apply_rim_and_glow() -> void:
	if not _ready_done:
		return
	var k: float = _sel_k
	if _progress < 1.0 and not _destroyed:
		k = maxf(k, 0.65)  # sites glow in the team colour while they rise
	var rim_col: Color = RIM_IDLE.lerp(_team_color, k)
	var rim_str: float = lerpf(0.25, 0.9, k)
	for m: ShaderMaterial in painted_materials:
		m.set_shader_parameter(&"rim_color", rim_col)
		m.set_shader_parameter(&"rim_strength", rim_str)
	if banner_material:
		banner_material.set_shader_parameter(&"rim_color", _team_color.lightened(0.3))
		banner_material.set_shader_parameter(&"rim_strength", 0.6 * _sel_k)
	var boost: float = _sel_boost()
	for m: ShaderMaterial in glow_materials:
		m.set_shader_parameter(&"boost", boost)


func _process_destroyed(delta: float) -> void:
	_destroy_t += delta
	var t: float = _destroy_t
	# 0.0-0.6: crystals, runes and heart overload, the ring rises 1.5 m and shakes.
	if t < 0.6:
		var k: float = t / 0.6
		var shake := Vector3(sin(t * 125.7) * 0.15, 0.0, cos(t * 113.1) * 0.15)
		_ring.position = shake + Vector3(0.0, RING_Y + 1.5 * k, 0.0)
		_ring.rotation.y += deg_to_rad(RING_SPEED_DEG * 4.0) * delta
		_heart.position = shake * 0.6 + Vector3(0.0, HEART_Y + 0.8 * k, 0.0)
		_rune_tilt.position = _heart.position
		_runes.rotation.y += deg_to_rad(RUNE_SPEED_DEG * 6.0) * delta
		_rune_tilt.scale = Vector3.ONE * (1.0 + 0.5 * k)
		crystal_material.set_shader_parameter(&"core_boost", 1.0 + 2.0 * k)  # crystals + heart
		heart_material.set_shader_parameter(&"core_boost", 1.0 + 2.0 * k)
		if rune_material:
			rune_material.set_shader_parameter(&"boost", 1.0 + 2.0 * k)
	elif _destroy_step == 0:
		_destroy_step = 1
		_ring.visible = false
		_heart.visible = false
		_rune_tilt.visible = false
		_crystal_burst.position = _ring.position
		_fire(_crystal_burst)
		_dust.position = Vector3(0.0, 12.0, 0.0)
		_fire(_dust)
	# 0.6-1.5: the spire and its claws topple toward the gate (-Z) and end up lying across the wreck.
	if t >= 0.6 and not _spire_down:
		var k2: float = clampf((t - 0.6) / 0.9, 0.0, 1.0)
		var kk: float = k2 * k2
		_spire.transform = Transform3D(Basis(Vector3.RIGHT, deg_to_rad(-78.0) * kk),
			_spire_xf.origin + Vector3(0.0, -9.3 * kk, -1.2 * kk))
		if k2 >= 1.0:
			_spire_down = true
	# 1.0: the forge goes dark. 1.0-2.2: donjon, towers, walls sink to 25 % height with a rumble.
	if t >= 1.0 and _windows.visible:
		_windows.visible = false
	if t >= 1.0 and _destroy_step < 3:
		var k3: float = clampf((t - 1.0) / 1.2, 0.0, 1.0)
		var e: float = 1.0 - pow(1.0 - k3, 2.0)
		var jitter := Vector3(sin(t * 94.2) * 0.08, 0.0, cos(t * 87.9) * 0.08) if k3 < 1.0 else Vector3.ZERO
		for i: int in _collapse_idx:
			_squash(i, lerpf(1.0, _wreck[i].x, e), _wreck[i].y, jitter)
		if k3 >= 1.0:
			_destroy_step = 3
	if t >= 1.6 and _destroy_step < 2:
		_destroy_step = 2
		for n: Node3D in _hide_at_16:
			n.visible = false
		_dust.position = Vector3(0.0, 1.2, 0.0)
		_fire(_dust)
		_debris.visible = true
	# Lights: a 0.15 s flash, then embers; 2.2-3.0 fade to the wreck look; the lava cools and crusts over.
	var k4: float = clampf((t - 2.2) / 0.8, 0.0, 1.0)
	_heart_light.light_energy = 6.0 if t < 0.15 else lerpf(3.0, 0.4, k4)
	_gate_light.light_energy = lerpf(1.8, 0.2, k4)
	_rubble.scale = Vector3.ONE * lerpf(1.0, 1.25, k4)
	_debris.scale = Vector3(1.0, lerpf(0.5, 1.0, clampf((t - 1.6) / 0.6, 0.0, 1.0)), 1.0)
	ground_material.set_shader_parameter(&"darkness", k4)
	if painted_materials.size() > 0 and _slot_cracks.size() > STONE_SLOT:
		_slot_cracks[STONE_SLOT] = lerpf(_stone_crack, _stone_crack * 0.4, k4)
		painted_materials[0].set_shader_parameter(&"crack_strengths", _slot_cracks)
	if lava_material:
		lava_material.set_shader_parameter(&"lava_cool", clampf((t - 1.0) / 2.0, 0.0, 1.0) * 0.75)
	if t >= DESTROY_TIME:
		set_process(false)
		destroyed_finished.emit()


func _fire(p: GPUParticles3D) -> void:
	p.restart()
	p.emitting = true


func _build_state_nodes() -> void:
	var add_quad: Mesh = ($Body/BrazierFire as GPUParticles3D).draw_pass_1
	var mix_quad: Mesh = ($Body/ChimneySmoke as GPUParticles3D).draw_pass_1
	var fire_ramp: Texture2D = (($Body/BrazierFire as GPUParticles3D).process_material as ParticleProcessMaterial).color_ramp
	var smoke_ramp: Texture2D = _ramp(Color(SMOKE_COLOR, 0.8), Color(SMOKE_COLOR, 0.0), false)
	# Damage columns (8.4 / 7.3): out of the broken tower top and off the donjon.
	for pos: Vector3 in [Vector3(2.6, 9.6, 2.6), Vector3(-0.9, 12.3, -0.7)]:
		var pm := _pm(Vector3.UP, 12.0, 1.2, 1.8, Vector3(0.25, 0.1, 0.0), 0.7, 2.6, smoke_ramp)
		pm.emission_shape = ParticleProcessMaterial.EMISSION_SHAPE_SPHERE
		pm.emission_sphere_radius = 0.45
		_smoke.append(_particles("Smoke%d" % (_smoke.size() + 1), _body, pos, 30, 3.5, pm, mix_quad, false))
	for pos: Vector3 in [Vector3(-1.7, 6.9, -1.5), Vector3(1.0, 12.3, 0.9)]:
		var pm := _pm(Vector3.UP, 15.0, 1.6, 2.6, Vector3.ZERO, 0.95, 0.3, fire_ramp)
		pm.emission_shape = ParticleProcessMaterial.EMISSION_SHAPE_SPHERE
		pm.emission_sphere_radius = 0.5
		_blaze.append(_particles("Blaze%d" % (_blaze.size() + 1), _body, pos, 24, 1.0, pm, add_quad, false))
	# Training burst out of the gate (8.3).
	var tb := _pm(Vector3(0, 0.3, -1), 60.0, 2.0, 4.0, Vector3(0, -2.0, 0), 0.28, 0.08, _ramp(FIRE_GLOW, FIRE_GLOW, true))
	_train_burst = _particles("TrainBurst", _body, Vector3(0, 2.2, -3.5), 24, 0.8, tb, add_quad, true)
	# Construction: ring of rising sparks on the outline, and the completion flash from the top.
	var br := _pm(Vector3.UP, 10.0, 0.8, 1.8, Vector3.ZERO, 0.22, 0.06, _ramp(FIRE_GLOW, FIRE_GLOW, true))
	br.emission_shape = ParticleProcessMaterial.EMISSION_SHAPE_RING
	br.emission_ring_axis = Vector3.UP
	br.emission_ring_radius = 4.1
	br.emission_ring_inner_radius = 3.9
	br.emission_ring_height = 0.05
	_build_ring = _particles("BuildRing", self, Vector3(0, 0.1, 0), 40, 1.2, br, add_quad, false)
	var bf := _pm(Vector3.UP, 180.0, 3.0, 6.0, Vector3(0, -3.0, 0), 0.4, 0.1, _ramp(FIRE_GLOW, FIRE_GLOW, true))
	_build_flash = _particles("BuildFlash", _body, Vector3(0, HEART_Y, 0), 40, 1.0, bf, add_quad, true)
	# Collapse: crystal burst (72 sparks, fire ramp) and stone dust.
	var cb := _pm(Vector3.UP, 180.0, 3.0, 6.5, Vector3(0, -4.0, 0), 0.26, 0.06, fire_ramp)
	cb.emission_shape = ParticleProcessMaterial.EMISSION_SHAPE_RING
	cb.emission_ring_axis = Vector3.UP
	cb.emission_ring_radius = 3.3
	cb.emission_ring_inner_radius = 0.2
	cb.emission_ring_height = 2.0
	_crystal_burst = _particles("CrystalBurst", _body, Vector3(0, RING_Y, 0), 72, 1.0, cb, add_quad, true)
	var du := _pm(Vector3.UP, 80.0, 1.0, 3.0, Vector3(0, -0.5, 0), 1.0, 3.0,
		_ramp(Color(DUST_COLOR, 0.6), Color(DUST_COLOR, 0.0), false))
	du.emission_shape = ParticleProcessMaterial.EMISSION_SHAPE_BOX
	du.emission_box_extents = Vector3(2.8, 0.5, 2.8)
	_dust = _particles("CollapseDust", _body, Vector3(0, 12, 0), 60, 2.5, du, mix_quad, true)
	# Glowing construction outline: 4 thin emissive bars around the plinth, at ground level. It draws with
	# the keep's glow material (kind "outline", no extra material).
	_outline_mat = glow_materials[0]
	_outline_mat.set_shader_parameter(&"outline_energy", 2.0)
	var bar := BoxMesh.new()
	bar.size = Vector3(8.4, 0.06, 0.3)
	var mm := MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_3D
	mm.mesh = bar
	mm.instance_count = 4
	for i: int in 4:
		var yaw: float = PI * 0.5 * i
		var dir := Vector3(sin(yaw), 0.0, cos(yaw))
		mm.set_instance_transform(i, Transform3D(Basis(Vector3.UP, yaw), dir * 4.05 + Vector3(0, 0.06, 0)))
	_outline = MultiMeshInstance3D.new()
	_outline.name = "BuildOutline"
	_outline.multimesh = mm
	_outline.material_override = _outline_mat
	_outline.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_outline.visible = false
	add_child(_outline)
	_outline.set_instance_shader_parameter(&"kind_override", OUTLINE_KIND)
	# Rubble2 (the lost roof's tower, < 50 % HP: chunks on its broken top and at its foot) and Debris
	# (the wreck), both dark stone, in Body space.
	var rng := RandomNumberGenerator.new()
	rng.seed = 7331
	_rubble2 = _cubes("Rubble2", [Vector3(3.9, 0.15, 3.0), Vector3(3.0, 0.15, 3.95), Vector3(3.3, 1.35, 3.2),
		Vector3(4.2, 0.1, 3.9), Vector3(2.3, 9.65, 2.9), Vector3(2.95, 9.7, 2.3), Vector3(2.7, 9.9, 2.75)], 0.55, rng)
	# The wreck's rubble heaps: over the sunken walls (top ~2.8 m) and on the tower stumps (~3.8 m).
	var pts: Array[Vector3] = []
	for i: int in 14:
		pts.append(Vector3(rng.randf_range(-2.4, 2.4), 2.75 + rng.randf_range(0.0, 0.35), rng.randf_range(-2.4, 2.4)))
	for i: int in 8:
		var c := Vector3(2.6 if i % 2 == 0 else -2.6, 3.8, 2.6 if (i >> 1) % 2 == 0 else -2.6)
		pts.append(c + Vector3(rng.randf_range(-0.5, 0.5), rng.randf_range(0.0, 0.3), rng.randf_range(-0.5, 0.5)))
	_debris = _cubes("Debris", pts, 0.85, rng)
	_rubble2.visible = false
	_debris.visible = false


func _cubes(nm: String, points: Array, size: float, rng: RandomNumberGenerator) -> MultiMeshInstance3D:
	var box := BoxMesh.new()
	box.size = Vector3.ONE * size
	var mm := MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_3D
	mm.mesh = box
	mm.instance_count = points.size()
	for i: int in points.size():
		var b := Basis(Vector3.UP, rng.randf() * TAU) * Basis(Vector3.RIGHT, deg_to_rad(rng.randf_range(10.0, 25.0)))
		mm.set_instance_transform(i, Transform3D(b.scaled(Vector3.ONE * rng.randf_range(0.7, 1.2)), points[i]))
	var mmi := MultiMeshInstance3D.new()
	mmi.name = nm
	mmi.multimesh = mm
	mmi.material_override = painted_materials[0] if painted_materials.size() > 0 else null
	_body.add_child(mmi)
	mmi.set_instance_shader_parameter(&"ao_bottom", -0.3)
	mmi.set_instance_shader_parameter(&"ao_height", 2.0)
	mmi.set_instance_shader_parameter(&"slot_override", DARK_SLOT)  # BoxMesh has no UV2: dark stone slot
	return mmi


func _ramp(a: Color, b: Color, team: bool) -> GradientTexture1D:
	var g := Gradient.new()
	g.set_color(0, a)
	g.set_color(1, Color(b, 0.0))
	if team:
		_team_ramps.append(g)
	var tex := GradientTexture1D.new()
	tex.gradient = g
	return tex


func _pm(dir: Vector3, spread: float, vmin: float, vmax: float, gravity: Vector3,
		size_start: float, size_end: float, ramp: Texture2D) -> ParticleProcessMaterial:
	var pm := ParticleProcessMaterial.new()
	pm.direction = dir.normalized()
	pm.spread = spread
	pm.initial_velocity_min = vmin
	pm.initial_velocity_max = vmax
	pm.gravity = gravity
	var base: float = maxf(size_start, size_end)
	pm.scale_min = base
	pm.scale_max = base
	var curve := Curve.new()
	curve.add_point(Vector2(0.0, size_start / base))
	curve.add_point(Vector2(1.0, size_end / base))
	var ct := CurveTexture.new()
	ct.curve = curve
	pm.scale_curve = ct
	pm.color_ramp = ramp
	return pm


func _particles(nm: String, parent: Node3D, pos: Vector3, amount: int, life: float,
		pm: ParticleProcessMaterial, quad: Mesh, one_shot: bool) -> GPUParticles3D:
	var p := GPUParticles3D.new()
	p.name = nm
	p.amount = amount
	p.lifetime = life
	p.one_shot = one_shot
	p.explosiveness = 1.0 if one_shot else 0.0
	p.fixed_fps = 30
	p.interpolate = true
	p.local_coords = true
	p.process_material = pm
	p.draw_pass_1 = quad
	p.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	p.visibility_aabb = AABB(Vector3(-8, -4, -8), Vector3(16, 24, 16))
	p.position = pos
	p.emitting = false
	parent.add_child(p)
	return p
