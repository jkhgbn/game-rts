extends Node3D
## Visual model of Ysolde's Heartwood, a living-tree citadel (kingdom-nature.md 7.1, art-keep.md sections 0 and 6-9;
## epic pass in task A2.5). The geometry is generated by art/buildings/nature_keep_build.gd (run it WINDOWED to
## regenerate the .tscn). Gameplay never touches the children; it calls the hooks below (art-keep.md 8.8):
##   set_team_color(c), set_construction_progress(p), set_health_ratio(r), play_training_pulse(),
##   play_destroyed() (emits `destroyed_finished` after 3.0 s; the wreck stays until freed), set_selected(on).
## Every hook is safe before _ready (values are cached) and after the node is freed mid-sequence (no tweens or
## timers: the whole state machine runs in the one _process). Gate on local -Z; collision is Building's (6 x 6 m).
## The gentle ambient particles (pollen, falling leaves, bloom petals) only run while a camera is within 45 m
## (art-units.md 8: looping particles only near the camera); without a camera (headless) they count as near.

signal destroyed_finished

const KINGDOM_COLOR := Color(0.35, 0.70, 0.25)
const GLOW_DEFAULT := Color(0.75, 1.00, 0.40)
const STRIPE_DEFAULT := Color(0.15, 0.40, 0.15)
const RIM_IDLE := Color(0.72, 0.88, 0.55)
const RIM_IDLE_STRENGTH := 0.25
## Where the trunk breaks when the keep dies: TrunkLow (with the roots) stays as the stump.
const SPLIT_Y := 6.2
## The canopy meshes' origin: the thinning (damage) scales them about this point.
const CANOPY_PIVOT := Vector3(0.0, 12.4, 0.0)
const SWING := deg_to_rad(8.0)
const SWING_SPEED := TAU / 3.0
const BLOOM_SPIN_DEG := 7.0
const PULSE_TIME := 0.6
const DESTROY_TIME := 3.0
const NEAR_ON := 45.0
const NEAR_OFF := 50.0
const CROWN_LIGHT := 1.6
const GATE_LIGHT := 1.1
## Sections that never sink in the collapse (the stump, the plinth, and what falls with the crown).
const NO_COLLAPSE: Array[StringName] = [&"Plinth", &"TrunkLow", &"TrunkHigh", &"Canopy", &"CanopyLost"]
## What falls back (+Z) with the crown when the trunk breaks.
const CROWN: Array[StringName] = [&"TrunkHigh", &"Canopy", &"CanopyLost"]
## Construction (8.2): build-height range over which a section rises when its own bottom / top would let it float
## (the canopy waits for the limbs, banners for their rods / poles).
const RISE := {
	&"Canopy": Vector2(10.0, 16.6), &"CanopyLost": Vector2(10.0, 16.6), &"BannersSide": Vector2(3.6, 4.1),
	&"BannersGate": Vector2(4.9, 5.6), &"TrunkHigh": Vector2(SPLIT_Y - 0.3, 14.0),
}
## The wreck (8.5): Vector2(height kept, pivot y) per sinking section.
const WRECK := {
	&"Rampart": Vector2(0.45, 0.9), &"BannersSide": Vector2(0.45, 0.9), &"BannersGate": Vector2(0.4, 0.5),
}

@export var painted_materials: Array[ShaderMaterial] = []
@export var card_materials: Array[ShaderMaterial] = []
@export var glow_materials: Array[ShaderMaterial] = []
@export var bark_material: ShaderMaterial
@export var leaves_material: ShaderMaterial
@export var leafcard_material: ShaderMaterial
@export var blossom_material: ShaderMaterial
@export var petal_material: ShaderMaterial
@export var heart_material: ShaderMaterial
@export var gate_material: ShaderMaterial
@export var lantern_material: ShaderMaterial
@export var banner_material: ShaderMaterial
@export var ground_material: ShaderMaterial
@export var outline_material: ShaderMaterial
@export var bloom_position: Vector3 = Vector3(0.0, 15.0, -0.3)
@export var knot_position: Vector3 = Vector3(0.0, 5.25, -1.28)

@onready var _model: Node3D = $Model
@onready var _canopy: Node3D = $Model/Canopy
@onready var _canopy_lost: Node3D = $Model/CanopyLost
@onready var _bloom: Node3D = $Model/Bloom
@onready var _lanterns: Node3D = $Model/Lanterns
@onready var _pivots: Array[Node3D] = [$Model/Lanterns/Lantern0, $Model/Lanterns/Lantern1, $Model/Lanterns/Lantern2]
@onready var _stump: Node3D = $Model/Stump
@onready var _rubble2: Node3D = $Model/Rubble2
@onready var _debris: Node3D = $Model/Debris
@onready var _banners_gate: Node3D = $Model/BannersGate
@onready var _banners_side: Node3D = $Model/BannersSide
@onready var _rubble: Node3D = $Rubble
@onready var _outline: Node3D = $Outline
@onready var _crown_light: OmniLight3D = $CrownLight
@onready var _gate_light: OmniLight3D = $GateLight
@onready var _ambient: Array[GPUParticles3D] = [$Pollen, $Leaves, $Petals]
@onready var _smoke: Array[GPUParticles3D] = [$Smoke1, $Smoke2]
@onready var _wither: Array[GPUParticles3D] = [$Wither1, $Wither2]
@onready var _train_burst: GPUParticles3D = $TrainBurst
@onready var _build_ring: GPUParticles3D = $BuildRing
@onready var _build_flash: GPUParticles3D = $BuildFlash
@onready var _bloom_burst: GPUParticles3D = $BloomBurst
@onready var _lantern_burst: GPUParticles3D = $LanternBurst
@onready var _dust: GPUParticles3D = $CollapseDust
@onready var _shatter: GPUParticles3D = $Shatter

# Structure parts (direct mesh children of Model): rest transform, rise range, wreck values.
var _parts: Array[GeometryInstance3D] = []
var _part_xf: Array[Transform3D] = []
var _part_b: PackedFloat32Array = PackedFloat32Array()
var _rise: PackedVector2Array = PackedVector2Array()
var _collapse_idx: PackedInt32Array = PackedInt32Array()
var _wreck: PackedVector2Array = PackedVector2Array()
var _height: float = 15.5
var _canopy_xf: Transform3D
var _lost_xf: Transform3D
var _bloom_xf: Transform3D
var _team_glow_ramps: Array[Gradient] = []
var _team_leaf_ramps: Array[Gradient] = []

var _t: float = 0.0
var _ready_done: bool = false
var _team_color: Color = KINGDOM_COLOR
var _progress: float = 1.0
var _was_building: bool = false
var _float_appear: float = 1.0
var _outline_fade: float = 0.0
var _health_ratio: float = 1.0
var _canopy_k: float = 1.0
var _canopy_target: float = 1.0
var _bloom_health: float = 1.0
var _agitated: bool = false
var _swing_phase: float = 0.0
var _pulse_left: float = 0.0
var _selected: bool = false
var _sel_k: float = 0.0
var _ambient_on: bool = false
var _cam_check: float = 0.0
var _destroyed: bool = false
var _destroy_t: float = 0.0
var _destroy_step: int = 0
var _fall: Node3D


func _ready() -> void:
	_ready_done = true
	_t = randf() * 10.0
	_canopy_xf = _canopy.transform
	_lost_xf = _canopy_lost.transform
	_bloom_xf = _bloom.transform
	_collect_parts()
	_own_particle_ramps()
	set_team_color(_team_color)
	set_construction_progress(_progress)
	_sel_k = 1.0 if _selected else 0.0
	_apply_rim_and_glow()
	if _destroyed:
		_destroyed = false
		play_destroyed()


func _process(delta: float) -> void:
	_t += delta
	if _destroyed:
		_process_destroyed(delta)
		return
	_cam_check -= delta
	if _cam_check <= 0.0:
		_cam_check = 0.5
		_update_ambient()
	var fast: float = 3.0 if _pulse_left > 0.0 else 1.0
	# Seed-lanterns swing +-8 deg over 3 s (faster in a training pulse, wider and jittery when agitated).
	_swing_phase += SWING_SPEED * fast * delta
	var amp: float = SWING * (1.8 if _agitated else 1.0)
	for i: int in 3:
		var ph: float = _swing_phase + float(i) * 2.1
		var jit: float = sin(_t * 17.0 + float(i)) * 0.03 if _agitated else 0.0
		_pivots[i].rotation = Vector3(sin(ph) * amp + jit, 0.0, cos(ph * 0.8 + float(i)) * amp * 0.6)
	# Floating parts scale in when construction reaches 95 %.
	if _float_appear < 1.0:
		_float_appear = minf(_float_appear + delta / 0.5, 1.0)
		_lanterns.scale = Vector3.ONE * maxf(ease(_float_appear, 0.4), 0.01)
	# The Crown Bloom turns slowly and breathes (droops when the keep is nearly dead).
	var br: float = sin(_t * 1.3)
	var s: float = maxf(ease(_float_appear, 0.4), 0.01) * _bloom_health
	_bloom.transform = Transform3D(Basis(Vector3.UP, _t * deg_to_rad(BLOOM_SPIN_DEG) * fast).scaled(
		Vector3(1.0 + 0.04 * br, 1.0 - 0.035 * br, 1.0 + 0.04 * br) * s), _bloom_xf.origin)
	# The canopy thins toward its damage target.
	if _progress >= 1.0 and _canopy_k != _canopy_target:
		_canopy_k = move_toward(_canopy_k, _canopy_target, delta * 0.35)
		_apply_canopy_scale()
	# Lights: slow breath (a nervous flicker when agitated), gate light x2 during a pulse.
	var breath: float = 0.9 + 0.1 * sin(_t * 2.5)
	if _agitated:
		breath = 0.72 + 0.14 * sin(_t * 19.0) + 0.14 * sin(_t * 31.0)
	_crown_light.light_energy = CROWN_LIGHT * breath * _progress
	var gate_mult: float = 1.0
	if _pulse_left > 0.0:
		_pulse_left = maxf(_pulse_left - delta, 0.0)
		var k: float = 1.0 - _pulse_left / PULSE_TIME
		var boost: float = 1.0 + 2.0 * (k / 0.17) if k < 0.17 else 1.0 + 2.0 * pow(1.0 - (k - 0.17) / 0.83, 2.0)
		if gate_material:
			gate_material.set_shader_parameter(&"boost", boost * _sel_boost())
		gate_mult = 2.0 if _pulse_left > 0.3 else 1.0
	_gate_light.light_energy = GATE_LIGHT * (0.92 + 0.08 * sin(_t * 1.7)) * gate_mult * _progress
	# Selection fade (0.15 s in, 0.25 s out); only touches materials while it moves.
	var target: float = 1.0 if _selected else 0.0
	if _sel_k != target:
		_sel_k = move_toward(_sel_k, target, delta / (0.15 if _selected else 0.25))
		_apply_rim_and_glow()
	# Construction outline fades out over 0.5 s once the keep is complete.
	if _outline_fade > 0.0:
		_outline_fade = maxf(_outline_fade - delta / 0.5, 0.0)
		(_outline as GeometryInstance3D).set_instance_shader_parameter(&"energy", 2.0 * _outline_fade)
		if _outline_fade <= 0.0:
			_outline.visible = false


# --- Hooks (art-keep.md 8.8) ---

## Construction progress 0..1 (8.2): glowing outline at 0, parts rise from the ground in height order, the
## Crown Bloom and the seed-lanterns scale in at >= 0.95, a flash from the bloom at 1.
func set_construction_progress(p: float) -> void:
	_progress = clampf(p, 0.0, 1.0)
	if not _ready_done or _destroyed:
		return
	var building: bool = _progress < 1.0
	var h: float = _progress * _height
	for i: int in _parts.size():
		var part: GeometryInstance3D = _parts[i]
		if not building:
			part.transform = _part_xf[i]
			part.visible = true
			continue
		var r: Vector2 = _rise[i]
		if h < r.x or _progress <= 0.0:
			part.visible = false
			continue
		part.visible = true
		_squash(i, clampf((h - r.x) / maxf(r.y - r.x, 0.01), 0.05, 1.0), _part_b[i], Vector3.ZERO)
	if not building:
		_canopy_k = 1.0
		_apply_canopy_scale()
	var floating: bool = _progress >= 0.95
	if floating and not _lanterns.visible:
		_float_appear = 0.0 if building or _was_building else 1.0
	_lanterns.visible = floating
	_bloom.visible = floating
	_build_ring.emitting = building
	if ground_material:
		ground_material.set_shader_parameter(&"build", _progress)
	if building:
		_outline.visible = true
		_outline_fade = 0.0
		(_outline as GeometryInstance3D).set_instance_shader_parameter(&"energy", 2.0)
		_set_ambient(false)
	elif _was_building:
		_outline_fade = 1.0
		_fire(_build_flash)
	else:
		_outline.visible = false
	_was_building = building
	if not building:
		_cam_check = 0.0
	_apply_health()
	_apply_rim_and_glow()


## A unit sprouted out of the gate (8.3): 0.6 s gate flash, gate light x2, burst, lanterns and bloom x3.
func play_training_pulse() -> void:
	if _destroyed:
		return
	_pulse_left = PULSE_TIME
	if _ready_done and _progress >= 1.0:
		_fire(_train_burst)


## HP ratio 0..1 (8.4): below 50 % smoke, a torn-off limb, one lantern fallen, the canopy thins and browns;
## below 25 % dead leaves pour down, the bloom droops, the gate banners fall, the lights flicker. Reverts when healed.
func set_health_ratio(r: float) -> void:
	_health_ratio = clampf(r, 0.0, 1.0)
	if _ready_done and not _destroyed:
		_apply_health()


## Collapse (8.5): 3.0 s sequence, then `destroyed_finished`; the smoking stump stays until freed.
func play_destroyed() -> void:
	if _destroyed:
		return
	_destroyed = true
	if not _ready_done:
		return
	_destroy_t = 0.0
	_destroy_step = 0
	# Snap to the finished keep first (a site can die mid-construction).
	for i: int in _parts.size():
		_parts[i].transform = _part_xf[i]
		if _progress < 1.0:
			_parts[i].visible = true
	_canopy_k = _canopy_target
	_apply_canopy_scale()
	_outline.visible = false
	_build_ring.emitting = false
	_set_ambient(false)
	for s: GPUParticles3D in _smoke:
		s.emitting = true
	for m: ShaderMaterial in painted_materials:
		m.set_shader_parameter(&"damage", 1.0)
	_lanterns.visible = true
	_lanterns.scale = Vector3.ONE
	_bloom.visible = true
	_float_appear = 1.0
	# The crown (upper trunk, limbs, canopy, lanterns) falls back (+Z) about a hinge on the break.
	_fall = Node3D.new()
	_fall.name = "FallPivot"
	_fall.position = Vector3(0.0, SPLIT_Y, 0.9)
	_model.add_child(_fall)
	for nm: StringName in CROWN:
		var n: Node3D = _model.get_node(NodePath(nm))
		n.reparent(_fall, true)
	_lanterns.reparent(_fall, true)


## Selection (8.6): team rim on every painted surface, glow boost 1.4 on glow parts.
func set_selected(on: bool) -> void:
	_selected = on


## Team colour (8.7): leaves, banners, every glow (sap, heart, bloom, lanterns, runes), particle ramps, lights.
func set_team_color(c: Color) -> void:
	_team_color = c
	if not _ready_done:
		return
	var glow: Color = _glow_color()
	var is_default: bool = c.is_equal_approx(KINGDOM_COLOR)
	if leaves_material:
		leaves_material.set_shader_parameter(&"base_color", c)
	if leafcard_material:
		leafcard_material.set_shader_parameter(&"base_color", c)
		leafcard_material.set_shader_parameter(&"glow_color", glow)
	for m: ShaderMaterial in [blossom_material, petal_material]:
		if m:
			m.set_shader_parameter(&"glow_color", glow)
	if banner_material:
		banner_material.set_shader_parameter(&"cloth_color", c)
		banner_material.set_shader_parameter(&"stripe_color", STRIPE_DEFAULT if is_default else c.darkened(0.55))
		banner_material.set_shader_parameter(&"glyph_color", glow)
	for m: ShaderMaterial in glow_materials:
		m.set_shader_parameter(&"glow_color", glow)
	if outline_material:
		outline_material.set_shader_parameter(&"glow_color", glow)
	if bark_material:
		bark_material.set_shader_parameter(&"sap_color", glow)
	if ground_material:
		ground_material.set_shader_parameter(&"glow_color", glow)
	for g: Gradient in _team_glow_ramps:
		for i: int in g.get_point_count():
			g.set_color(i, Color(glow, g.get_color(i).a))
	for g: Gradient in _team_leaf_ramps:
		for i: int in g.get_point_count():
			var col: Color = c.darkened(0.25 * g.get_offset(i))
			g.set_color(i, Color(col, g.get_color(i).a))
	_crown_light.light_color = glow
	_gate_light.light_color = glow
	_apply_rim_and_glow()


# --- Internals ---

func _collect_parts() -> void:
	for child: Node in _model.get_children():
		if not (child is MeshInstance3D):
			continue
		var g: GeometryInstance3D = child as GeometryInstance3D
		if g == _bloom or g == _stump or g == _rubble2 or g == _debris:
			continue
		var box: AABB = g.transform * (g as VisualInstance3D).get_aabb()
		var nm := StringName(g.name)
		_parts.append(g)
		_part_xf.append(g.transform)
		_part_b.append(box.position.y)
		_rise.append(RISE.get(nm, Vector2(box.position.y, box.end.y)))
		_wreck.append(WRECK.get(nm, Vector2(1.0, 0.0)))
		_height = maxf(_height, box.end.y)
		if not (nm in NO_COLLAPSE):
			_collapse_idx.append(_parts.size() - 1)


## The particle materials in the .tscn are shared by every instance: give this keep its own copies of the
## team-coloured ones (so a mirror match can recolour one keep without the other).
func _own_particle_ramps() -> void:
	for p: GPUParticles3D in [$Pollen, _train_burst, _build_ring, _build_flash, _lantern_burst] as Array[GPUParticles3D]:
		p.process_material = p.process_material.duplicate(true)
		var ramp := (p.process_material as ParticleProcessMaterial).color_ramp as GradientTexture1D
		if ramp and ramp.gradient:
			_team_glow_ramps.append(ramp.gradient)
	var lv: GPUParticles3D = $Leaves
	lv.process_material = lv.process_material.duplicate(true)
	var lramp := (lv.process_material as ParticleProcessMaterial).color_ramp as GradientTexture1D
	if lramp and lramp.gradient:
		_team_leaf_ramps.append(lramp.gradient)


## Squash part i vertically about height `b` (Model space), with an optional offset (rumble).
func _squash(i: int, s: float, b: float, offset: Vector3) -> void:
	var sq := Transform3D(Basis.from_scale(Vector3(1.0, s, 1.0)), Vector3(0.0, b * (1.0 - s), 0.0) + offset)
	_parts[i].transform = sq * _part_xf[i]


func _apply_canopy_scale() -> void:
	var s: float = _canopy_k
	_canopy.transform = Transform3D(_canopy_xf.basis.scaled(Vector3(s, s, s)), _canopy_xf.origin)
	_canopy_lost.transform = Transform3D(_lost_xf.basis.scaled(Vector3(s, s, s)), _lost_xf.origin)


func _apply_health() -> void:
	var r: float = _health_ratio
	var built: bool = _progress >= 1.0
	var hurt: bool = built and r < 0.5
	var dying: bool = built and r < 0.25
	var dmg: float = (1.0 - r) * 0.5
	if r < 0.25:
		dmg = 1.0
	elif r < 0.5:
		dmg = 0.6
	for m: ShaderMaterial in painted_materials:
		m.set_shader_parameter(&"damage", dmg)
	for m: ShaderMaterial in card_materials:
		m.set_shader_parameter(&"damage", dmg * 0.8)
	if banner_material:
		banner_material.set_shader_parameter(&"damage", dmg)
	if ground_material:
		ground_material.set_shader_parameter(&"damage", dmg)
	for s: GPUParticles3D in _smoke:
		s.emitting = hurt
	for s: GPUParticles3D in _wither:
		s.emitting = dying
	# A limb with two clumps is torn off (it lies at the +X / +Z corner); one lantern has fallen.
	_canopy_lost.visible = not hurt and (built or _canopy_lost.visible)
	_rubble2.visible = hurt
	_pivots[2].visible = not hurt
	# The canopy thins and browns, the blossoms fall.
	var wither: float = 0.38 if dying else (0.2 if hurt else 0.0)
	if leaves_material:
		leaves_material.set_shader_parameter(&"wither", wither)
	if leafcard_material:
		leafcard_material.set_shader_parameter(&"wither", wither * 0.9)
		leafcard_material.set_shader_parameter(&"drop", 0.55 if dying else (0.28 if hurt else 0.0))
	if blossom_material:
		blossom_material.set_shader_parameter(&"drop", 0.85 if dying else (0.5 if hurt else 0.0))
	_canopy_target = 0.86 if dying else (0.93 if hurt else 1.0)
	# The heart races, the bloom droops and dims, the gate banners fall, the lights get nervous.
	if heart_material:
		heart_material.set_shader_parameter(&"beat_period", 0.9 if dying else (1.6 if hurt else 2.5))
	if petal_material:
		petal_material.set_shader_parameter(&"glow_energy", 1.4 if dying else (2.1 if hurt else 2.6))
	_bloom_health = 0.82 if dying else 1.0
	_agitated = dying
	_banners_gate.visible = not dying and (built or _banners_gate.visible)


func _update_ambient() -> void:
	var near: bool = true
	var cam: Camera3D = get_viewport().get_camera_3d() if is_inside_tree() else null
	if cam:
		var d: float = cam.global_position.distance_to(global_position + Vector3(0.0, 6.0, 0.0))
		near = d < (NEAR_OFF if _ambient_on else NEAR_ON)
	_set_ambient(near and _progress >= 1.0 and not _destroyed)


func _set_ambient(on: bool) -> void:
	if on == _ambient_on:
		return
	_ambient_on = on
	for p: GPUParticles3D in _ambient:
		p.emitting = on


func _sel_boost() -> float:
	return lerpf(1.0, 1.4, _sel_k)


func _glow_color() -> Color:
	return GLOW_DEFAULT if _team_color.is_equal_approx(KINGDOM_COLOR) else _team_color.lightened(0.35)


func _apply_rim_and_glow() -> void:
	if not _ready_done:
		return
	var k: float = _sel_k
	if _progress < 1.0 and not _destroyed:
		k = maxf(k, 0.65)  # sites glow in the team colour while they rise
	var rim_col: Color = RIM_IDLE.lerp(_team_color.lightened(0.2), k)
	var rim_str: float = lerpf(RIM_IDLE_STRENGTH, 0.9, k)
	for m: ShaderMaterial in painted_materials:
		m.set_shader_parameter(&"rim_color", rim_col)
		m.set_shader_parameter(&"rim_strength", rim_str)
	for m: ShaderMaterial in card_materials:
		m.set_shader_parameter(&"rim_color", rim_col)
		m.set_shader_parameter(&"rim_strength", rim_str * 0.8)
	if banner_material:
		banner_material.set_shader_parameter(&"rim_color", _team_color.lightened(0.3))
		banner_material.set_shader_parameter(&"rim_strength", 0.6 * _sel_k)
	var boost: float = _sel_boost()
	for m: ShaderMaterial in [heart_material, gate_material, blossom_material, petal_material]:
		if m:
			m.set_shader_parameter(&"boost", boost)
	if lantern_material:
		lantern_material.set_shader_parameter(&"boost_mult", boost)


func _process_destroyed(delta: float) -> void:
	_destroy_t += delta
	var t: float = _destroy_t
	# 0.0-0.6: the Crown Bloom closes and flares, the heart races, the lanterns swing wildly.
	if t < 0.6:
		var k: float = t / 0.6
		var shake := Vector3(sin(t * 125.7) * 0.1, 0.0, cos(t * 113.1) * 0.1)
		_bloom.transform = Transform3D(Basis(Vector3.UP, _t * 3.0).scaled(Vector3(1.0 - 0.35 * k, 1.0 + 0.25 * k, 1.0 - 0.35 * k)),
			_bloom_xf.origin + Vector3(0.0, 0.9 * k, 0.0) + shake)
		for m: ShaderMaterial in [heart_material, petal_material]:
			if m:
				m.set_shader_parameter(&"boost", 1.0 + 2.0 * k)
		for i: int in 3:
			_pivots[i].rotation = Vector3(sin(t * 14.0 + float(i) * 2.0) * 0.6 * k, 0.0, cos(t * 11.0 + float(i)) * 0.4 * k)
	elif _destroy_step == 0:
		_destroy_step = 1
		# 0.6: the bloom bursts into petals, the lanterns burst into sparks.
		_bloom.visible = false
		_bloom_burst.position = _bloom_xf.origin + Vector3(0.0, 0.9, 0.0)
		_fire(_bloom_burst)
		_fire(_lantern_burst) # emission points = the three pods at rest (the crown has barely moved yet)
		_lanterns.visible = false
	# 0.5-1.5: the trunk breaks, the stump shows, the crown falls back (+Z) and drops.
	if t >= 0.5 and not _stump.visible:
		_stump.visible = true
		_dust.position = Vector3(0.0, SPLIT_Y, 0.0)
		_fire(_dust)
	if t >= 0.5 and _fall.visible:
		var k2: float = clampf((t - 0.5) / 1.0, 0.0, 1.0)
		var kk: float = k2 * k2
		_fall.rotation.x = deg_to_rad(78.0) * kk
		_fall.position = Vector3(0.0, SPLIT_Y - 1.6 * kk, 0.9 + 0.8 * kk)
		if t >= 1.0:
			for s: GPUParticles3D in _wither:
				s.emitting = true
		if k2 >= 1.0:
			# 1.5: it hits the ground and breaks up: splinters, dust, the withered remains.
			_fall.visible = false
			_fire(_shatter)
			_dust.position = Vector3(0.0, 1.0, 4.6)
			_fire(_dust)
			_debris.visible = true
	# 1.0-2.2: the rampart sinks to 45 % with a rumble; banners fall at 1.6.
	if t >= 1.0 and _destroy_step < 3:
		var k3: float = clampf((t - 1.0) / 1.2, 0.0, 1.0)
		var e: float = 1.0 - pow(1.0 - k3, 2.0)
		var jitter := Vector3(sin(t * 94.2) * 0.08, 0.0, cos(t * 87.9) * 0.08) if k3 < 1.0 else Vector3.ZERO
		for i: int in _collapse_idx:
			_squash(i, lerpf(1.0, _wreck[i].x, e), _wreck[i].y, jitter)
		if k3 >= 1.0:
			_destroy_step = 3
			for s: GPUParticles3D in _wither:
				s.emitting = false
	if t >= 1.6 and _banners_side.visible:
		_banners_side.visible = false
		_banners_gate.visible = false
		_dust.position = Vector3(0.0, 1.2, 0.0)
		_fire(_dust)
	# 2.2-3.0: lights fade to embers, the moss withers, the sap dims, the debris settles.
	var k4: float = clampf((t - 2.2) / 0.8, 0.0, 1.0)
	_crown_light.light_energy = 5.0 if t < 0.15 else lerpf(CROWN_LIGHT, CROWN_LIGHT * 0.3, k4)
	_gate_light.light_energy = lerpf(GATE_LIGHT, GATE_LIGHT * 0.3, k4)
	_rubble.scale = Vector3.ONE * lerpf(1.0, 1.2, k4)
	if _debris.visible:
		_debris.scale = Vector3(1.0, lerpf(0.3, 1.0, clampf((t - 1.5) / 0.4, 0.0, 1.0)), 1.0)
	if ground_material:
		ground_material.set_shader_parameter(&"scorch", k4)
	if leaves_material:
		leaves_material.set_shader_parameter(&"wither", lerpf(0.7, 1.0, k4))
	if bark_material:
		bark_material.set_shader_parameter(&"sap", lerpf(1.0, 0.15, k4))
	if heart_material and t >= 0.6:
		heart_material.set_shader_parameter(&"boost", lerpf(1.0, 0.3, k4))
	if t >= DESTROY_TIME:
		set_process(false)
		destroyed_finished.emit()


func _fire(p: GPUParticles3D) -> void:
	p.restart()
	p.emitting = true
